#!/bin/bash
# ============================================================
#  NiiX Arch Installer  //  niixa.org
#  Modes   : Dual-boot (next to Windows)  |  Single-boot (a whole drive)
#  Stack   : LUKS2 - Btrfs - Limine - CachyOS - GNOME (customised)
#  Desktop : dash-to-panel + ArcMenu (clean desktop, no icons)
#  Extras  : Auto GPU drivers (most powerful GPU always used) - Gaming
#            (Steam/Lutris/Heroic) - Game controllers (also drive the
#            desktop) - Wi-Fi hotspot
#
#  This one file is everything: the installer, the graphical installer and
#  the ISO builder.
#    Build the ISO (any Linux PC, ~40 GB free):  sudo bash install --build-iso
#
#  Requirements:
#    - The NiiX live ISO (built from this file with --build-iso)
#    - UEFI system (not legacy BIOS)
#    - A CPU with x86-64-v3 (AVX2): Intel Core 4th gen (2013) / AMD Ryzen or
#      newer - NiiX is built from CachyOS's v3 packages (v4 CPUs get v4)
#    - Secure Boot OFF  (Limine does not support it)
#    - Dual-boot : free/unallocated space OR a deletable partition
#    - Single-boot : a drive you are willing to completely wipe
#    - Internet connection (for updates newer than the ISO, the NVIDIA
#      driver, GE-Proton and the Flatpak apps)
#
#  Fixed choices:
#    Locale     : en_GB.UTF-8   (keyboard and timezone are asked)
#    Mirrors    : fastest near the chosen timezone
#    Desktop    : GNOME
#    Bootloader : Limine (UEFI)
#    Encryption : LUKS2
#    Filesystem : Btrfs  (@  @home  @snapshots  @var_log)
#    Kernel     : linux-cachyos
#    Swap       : ZRAM (zstd, sized from RAM)
#
#  Adapts to the hardware it finds: drivers and the most powerful GPU,
#  desktop / laptop / handheld / virtual machine, X3D and hybrid CPUs,
#  monitor refresh rate and VRR, controllers.
#
#  The live ISO already holds the complete system: the install copies it to
#  the disk, then downloads only what is newer than the ISO and what depends
#  on the hardware. Everything is finished before the first boot.
#
#  HOW TO RUN on the NiiX live ISO: the "Install NiiX" icon on the desktop,
#  or in a terminal:  sudo bash /usr/local/lib/niix/install
#  It checks itself against the checksum recorded when the ISO was built.
# ============================================================

set -uo pipefail

# -- Logging --------------------------------------------------
# --probe and --check-account only report back to the GUI installer.
case "${1:-}" in
    --probe|--check-account|--build-iso)
        LOGFILE=/dev/null ;;
    *)
        LOGFILE="/root/niixarch-install-$(date +%Y%m%d-%H%M%S).log"
        exec > >(tee -a "$LOGFILE") 2>&1 ;;
esac

# -- Colours: the niixa.org palette (green #0aff9e, pink #ff0a6c) -----
# White text with green and pink accents; red and amber only for errors and
# warnings, so those always stand out.
GREEN=$'\033[38;5;118m'
PINK=$'\033[38;5;205m'
WHITE=$'\033[38;5;255m'
CYAN=$'\033[36m'
RED=$'\033[38;5;203m'
YELLOW=$'\033[38;5;215m'
DIM=$'\033[2m'
BOLD=$'\033[1m'
NC=$'\033[0m'

# -- Settings ---------------------------------------------------
KB_NAME=(); KB_XKB=(); KB_VAR=(); KB_KM=()   # the layout table, see load_keyboards
KEYMAP="us"                    # console keymap (vconsole.conf, the disk password prompt)
KEYMAP_X11="us"                # desktop layout
KEYMAP_X11_VARIANT=""          # desktop layout variant (e.g. dvorak)
KEYBOARD_NAME="English (US)"   # as shown in the summary
LOCALE="en_GB.UTF-8"
MAPPER="cryptroot"
BTRFS_OPTS="noatime,compress=zstd,space_cache=v2"
NIIX_MIN_GIB=40    # smallest space NiiX is installed into (system ~20 GB, the rest for games)
NIIX_BUILD="2026-10-19-r59"  # bump on every change - printed on the banner to verify freshness

# -- Install mode ---------------------------------------------
INSTALL_MODE=""    # "dualboot" | "singleboot"
SINGLE_DRIVE=""    # target drive for single-boot (entire drive wiped)

# -- Detected at runtime --------------------------------------
EFI_PART=""
EFI_DRIVE=""
EFI_PART_NUM=""
TARGET_DRIVE=""
LUKS_PART=""
LUKS_UUID=""

# -- User input -----------------------------------------------
HOSTNAME=""; USERNAME=""; USER_PASS=""; LUKS_PASS=""; TIMEZONE=""
FREE_START=""; FREE_END=""
USE_MITIGATIONS=false
HOTSPOT_SSID=""; HOTSPOT_PASS=""   # empty: no hotspot

# -- Set during the install -----------------------------------
USER_UID=""; USER_GID=""   # the new user, for files written from outside the chroot
CLEAN_OK=false             # the @clean fallback snapshot exists
DL_DIR=/mnt/var/tmp/niix-downloads   # downloads that run alongside the install
DL_PIDS=()
STEP_NAME=""; STEP_START=0; STEP_TIMES=()   # how long each step took, for the log

# -- GUI installer ---------------------------------------------
# With --answers every answer comes from the GUI (one KEY=VALUE per line on
# stdin) and nothing is asked here. Lines starting with @@ are for the GUI.
GUI_MODE=false
declare -A ANS=()

# -- Hardware (detected at runtime) ---------------------------
CPU_VENDOR=""; CPU_MODEL=""; GPU_VENDOR=""; GPU_MODEL=""; GPU_KIND=""
HAS_NVIDIA=0; HAS_AMD=0; HAS_INTEL=0; GPU_COUNT=0; IS_HYBRID=false
FORM=""; HANDHELD=""; VIRT=""; CPU_X3D=no; CPU_HYBRID=no
MEM_TOTAL_GB=0

# -- Output ---------------------------------------------------
ui_hr()    { printf '  %s────────────────────────────────────────────────%s\n' "$GREEN" "$NC"; }
ui_title() { printf '\n  %s▸%s  %s%s%s\n' "$PINK" "$NC" "$BOLD$WHITE" "$*" "$NC"; ui_hr; }
ui_ok()    { printf '  %s✔%s  %s%s%s\n' "$GREEN" "$NC" "$WHITE" "$*" "$NC"; }
ui_info()  { printf '  %s•%s  %s%s%s\n' "$PINK"  "$NC" "$WHITE" "$*" "$NC"; }
ui_warn()  { printf '  %s!%s  %s%s%s\n' "$YELLOW"   "$NC" "$WHITE" "$*" "$NC"; }

log()  { ui_ok "$@"; }
warn() { ui_warn "$@"; }
info() { ui_info "$@"; }

# Offer to save the logs to USB, then leave a clean slate: no half-open LUKS
# container or dangling /mnt mounts. The logs go first - the installed
# system's copy is only readable while /mnt is still mounted.
unwind_target() {
    copy_logs_to_usb 2>/dev/null || true
    release_target
}

release_target() {
    stop_downloads
    gpgconf --homedir /mnt/etc/pacman.d/gnupg --kill all 2>/dev/null || true
    swapoff -a 2>/dev/null || true
    umount -R /mnt 2>/dev/null || true
    cryptsetup close "$MAPPER" 2>/dev/null || true
}

err() {
    $GUI_MODE && printf '@@error %s\n' "$*"
    printf '\n  %s✗%s  %sERROR%s  %s%s%s\n' "$RED" "$NC" "$RED" "$NC" "$WHITE" "$*" "$NC"
    dump_state "ERROR: $*" 2>/dev/null || true
    info "Log saved to: ${LOGFILE}"
    unwind_target
    exit 1
}

# Ctrl+C / kill during the install. Reset before the final reboot prompt so
# Ctrl+C there still drops the user to a shell with /mnt intact.
cleanup_on_fail() {
    trap - INT TERM
    echo
    warn "Interrupted - cleaning up (unmounting target, closing encryption)..."
    unwind_target
    exit 130
}

ask()  { printf '\n  %s?%s  %s%s%s ' "$PINK" "$NC" "$BOLD$WHITE" "$*" "$NC"; }

# hr TITLE : starts a section (and tells the GUI which step is running);
# without a title just a rule.
hr() {
    if [[ -z "${1:-}" ]]; then
        printf '\n'; ui_hr; printf '\n'
        return
    fi
    step_done
    STEP_NAME=$1
    STEP_START=$SECONDS
    $GUI_MODE && printf '@@step %s\n' "$1"
    ui_title "$1"
}

step_done() {
    local took
    [[ -n "$STEP_NAME" ]] || return 0
    took=$(( SECONDS - STEP_START ))
    STEP_TIMES+=("$(printf '%3dm %02ds  %s' $(( took / 60 )) $(( took % 60 )) "$STEP_NAME")")
    STEP_NAME=""
}

# dbg TEXT : into the log only.
dbg() {
    echo "[DBG $(date +%H:%M:%S)] $*" >> "$LOGFILE"
}

# dump_state LABEL : drives, mounts and boot entries into the log.
dump_state() {
    local label="$1"
    {
        echo ""
        echo "================================================"
        echo "  DEBUG DUMP: $label"
        echo "  $(date)"
        echo "================================================"
        echo ""
        echo "--- lsblk -f ---"
        lsblk -f 2>&1 || true
        echo ""
        echo "--- blkid ---"
        blkid 2>&1 || true
        echo ""
        echo "--- efibootmgr ---"
        efibootmgr -v 2>&1 || true
        echo ""
        echo "--- df -h (mounted) ---"
        df -h 2>&1 || true
        echo ""
        echo "--- mount ---"
        mount 2>&1 || true
        echo ""
        echo "--- Script variables ---"
        echo "EFI_PART=$EFI_PART"
        echo "EFI_DRIVE=$EFI_DRIVE"
        echo "EFI_PART_NUM=$EFI_PART_NUM"
        echo "TARGET_DRIVE=$TARGET_DRIVE"
        echo "LUKS_PART=$LUKS_PART"
        echo "LUKS_UUID=$LUKS_UUID"
        echo "FREE_START=${FREE_START:-}"
        echo "FREE_END=${FREE_END:-}"
        echo "MAPPER=$MAPPER"
        echo ""
        echo "================================================"
        echo ""
    } >> "$LOGFILE" 2>&1
}

# copy_logs_to_usb : offers to save the logs (and the LUKS header backup) to
# a USB drive - text mode only, the GUI has its own button.
copy_logs_to_usb() {
    $GUI_MODE && return 0      # the GUI shows the log itself
    hr "Save Logs to USB"
    info "Looking for a USB drive to copy logs to..."

    # The drive the live ISO runs from is never offered. Its partition's
    # parents are followed up to the disk (Ventoy nests one level deeper).
    local iso_dev="" mnt src parent up
    for mnt in /run/archiso/bootmnt /run/archiso/airootfs; do
        src=$(findmnt -n -o SOURCE "$mnt" 2>/dev/null | head -1)
        [[ -n "$src" ]] || continue
        parent=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1)
        while [[ -n "$parent" ]]; do
            up=$(lsblk -no PKNAME "/dev/$parent" 2>/dev/null | head -1)
            [[ -n "$up" ]] || break
            parent=$up
        done
        [[ -n "$parent" ]] && { iso_dev="/dev/$parent"; break; }
    done
    dbg "ISO drive: ${iso_dev:-unknown}"

    # Partitions with a filesystem on removable or USB disks
    local -a parts=()
    local disk type rm tran part fstype size label
    while read -r disk type rm tran; do
        [[ "$type" == disk && ( "$rm" == 1 || "$tran" == usb ) && "$disk" != "$iso_dev" ]] || continue
        while read -r part type; do
            [[ "$type" == part ]] || continue
            fstype=$(lsblk -no FSTYPE "$part" 2>/dev/null | head -1)
            [[ -n "$fstype" ]] || continue
            size=$(lsblk -no SIZE "$part" 2>/dev/null | head -1)
            label=$(lsblk -no LABEL "$part" 2>/dev/null | head -1)
            parts+=("${part}|${size}|${fstype}|${label:-no label}")
        done < <(lsblk -ln -o PATH,TYPE "$disk" 2>/dev/null)
    done < <(lsblk -dn -o PATH,TYPE,RM,TRAN 2>/dev/null)

    if (( ${#parts[@]} == 0 )); then
        warn "No other USB drive found. Logs saved to:"
        echo -e "    ${YELLOW}${LOGFILE}${NC}  (live ISO - lost on reboot)"
        echo -e "    ${YELLOW}/var/log/niixarch-install.log${NC}  (installed system)"
        return
    fi

    local target choice dev i
    if (( ${#parts[@]} == 1 )); then
        target=${parts[0]}
        IFS='|' read -r dev size fstype label <<< "$target"
        log "Found USB: $dev ($size, $fstype, $label)"
    else
        echo
        echo -e "${BOLD}  Multiple USB partitions found:${NC}"
        echo
        for i in "${!parts[@]}"; do
            IFS='|' read -r dev size fstype label <<< "${parts[i]}"
            printf "  ${CYAN}[%s]${NC}  %-16s  %6s  %s  (%s)\n" "$i" "$dev" "$size" "$label" "$fstype"
        done
        echo
        ask "Copy logs to which USB? Enter the number (or 's' to skip):"
        read -rp "  > " choice
        [[ "$choice" == "s" ]] && { info "Skipped."; return; }
        [[ "$choice" =~ ^[0-9]+$ && -n "${parts[choice]:-}" ]] || { warn "Invalid choice. Skipped."; return; }
        target=${parts[choice]}
    fi
    IFS='|' read -r dev _ _ label <<< "$target"

    local usb_mnt="/mnt_usb_log"
    mkdir -p "$usb_mnt"
    if ! mount "$dev" "$usb_mnt" 2>/dev/null; then
        warn "Could not mount $dev - logs not copied to USB"
        return
    fi
    log "Mounted $dev at $usb_mnt"
    # The installed system's log only exists once configure_system has run.
    cp "$LOGFILE" "$usb_mnt/" 2>/dev/null && log "Copied $(basename "$LOGFILE") to USB"
    cp /mnt/var/log/niixarch-install.log "$usb_mnt/" 2>/dev/null && log "Copied niixarch-install.log to USB"
    cp /root/niixarch-luks-header-backup.img "$usb_mnt/" 2>/dev/null && log "Copied LUKS header backup to USB"
    sync
    umount "$usb_mnt" 2>/dev/null
    rmdir "$usb_mnt" 2>/dev/null || true
    log "Logs saved to USB ($label)"
}

# part_path /dev/DISK N : the device name of partition N on that disk
# (NVMe and MMC put a 'p' between disk and number).
part_path() {
    if [[ "$1" == *nvme* || "$1" == *mmcblk* ]]; then
        printf '%sp%s' "$1" "$2"
    else
        printf '%s%s' "$1" "$2"
    fi
}

# part_number /dev/PARTITION : its partition number (from the kernel, or the
# trailing digits of the name when lsblk has nothing).
part_number() {
    local num
    num=$(lsblk -no PARTN "$1" 2>/dev/null | head -1 | tr -d '[:space:]')
    [[ -n "$num" ]] || num=$(grep -o '[0-9]*$' <<< "$1")
    printf '%s' "$num"
}

# big_enough DRIVE : 0 when the drive holds at least NIIX_MIN_GIB.
big_enough() {
    local bytes
    bytes=$(lsblk -bdno SIZE "$1" 2>/dev/null | head -1 | tr -d '[:space:]')
    (( ${bytes:-0} >= NIIX_MIN_GIB * 1073741824 ))
}

# internal_disks : every whole internal disk, one path per line (no USB,
# removable, loop, zram or optical drives).
internal_disks() {
    local path type
    while read -r path type; do
        [[ "$type" == disk ]] || continue
        is_removable "$path" || printf '%s\n' "$path"
    done < <(lsblk -dn -o PATH,TYPE 2>/dev/null)
}

# is_removable DRIVE : 0 for USB and removable drives and for virtual ones
# (loop, RAM, device-mapper, zram, network, RAID) - never install targets.
is_removable() {
    local dev
    dev=$(basename "$1")
    case "$dev" in
        loop*|ram*|dm-*|zram*|nbd*|md*) return 0 ;;
    esac
    [[ "$(cat "/sys/block/$dev/removable" 2>/dev/null)" == 1 ]] && return 0
    # USB drives may report themselves as fixed
    [[ "$(lsblk -dn -o TRAN "/dev/$dev" 2>/dev/null | tr -d '[:space:]')" == usb ]]
}

banner() {
    clear 2>/dev/null || true
    local g=$GREEN p=$PINK n=$NC w=$WHITE d=$DIM b=$BOLD r=$RED
    printf '\n'
    printf '  %s███╗   ██╗██╗██╗██╗  ██╗ █████╗ %s██████╗ ███████╗%s\n' "$g" "$p" "$n"
    printf '  %s████╗  ██║██║██║╚██╗██╔╝██╔══██╗%s██╔═══██╗██╔════╝%s\n' "$g" "$p" "$n"
    printf '  %s██╔██╗ ██║██║██║ ╚███╔╝ ███████║%s██║   ██║███████╗%s\n' "$g" "$p" "$n"
    printf '  %s██║╚██╗██║██║██║ ██╔██╗ ██╔══██║%s██║   ██║╚════██║%s\n' "$g" "$p" "$n"
    printf '  %s██║ ╚████║██║██║██╔╝ ██╗██║  ██║%s╚██████╔╝███████║%s\n' "$g" "$p" "$n"
    printf '  %s╚═╝  ╚═══╝╚═╝╚═╝╚═╝  ╚═╝╚═╝  ╚═╝%s ╚═════╝ ╚══════╝%s\n' "$g" "$p" "$n"
    printf '\n'
    printf '  %s%sArch Installer%s   %sluks2 · cachyos · limine · btrfs · gnome%s\n' "$b" "$w" "$n" "$d" "$n"
    printf '  %sbuild %s%s\n' "$g" "$NIIX_BUILD" "$n"
    ui_hr
    printf '\n'
    printf '  %s▸%s  %s%sRequired before running%s\n' "$p" "$n" "$b" "$w" "$n"
    printf '  %s✗%s  %sSecure Boot must be OFF in BIOS%s\n' "$r" "$n" "$w" "$n"
    printf '  %s✗%s  %sLimine does not support Secure Boot%s\n' "$r" "$n" "$w" "$n"
    printf '\n'
}

# -- niix-gpu: picks the most powerful GPU ---------------------
# Used twice: on the live ISO to show which card will be used, and installed
# as /usr/local/bin/niix-gpu, where a boot service applies the choice before
# the login screen starts.
niix_gpu_script() {
    cat <<'NIIXGPUEOF'
#!/bin/bash
# niix-gpu - find the most powerful graphics card and make the desktop use it.
#
#   niix-gpu status       list every GPU and show which one is in use
#   niix-gpu apply        pick the GPU and apply it (runs at every boot)
#   niix-gpu run CMD...   run one command with the chosen GPU's settings
#   niix-gpu flatpak-gl   fetch the Flatpak NVIDIA driver matching the host
#   niix-gpu detect       print the choice as KEY=VALUE lines (the installer)
#
# How the card is chosen: a discrete card always beats an integrated one, and
# between two cards of the same kind the one with more video memory wins. A
# card only counts when a working driver is loaded for it. An NVIDIA card on
# nouveau is not picked over the integrated GPU - on most NVIDIA cards nouveau
# is slower than a modern iGPU. Once the proprietary driver runs, it wins.
#
# What "use it" means:
#   - every app, game and Vulkan program renders on that card
#     (/etc/environment.d/90-niix-gpu.conf, read at login)
#   - GNOME draws the desktop on it too (a udev tag Mutter reads at start-up).
#     The one exception is an NVIDIA card with no screen plugged into it: a
#     laptop panel wired to the integrated GPU stays there, and games still
#     render on NVIDIA - the same way Windows handles those laptops.
#   - GameMode's GPU tweaks are pointed at that card (/etc/gamemode.ini)
#
# Turn it off: GPU_MODE=off in /etc/niix/gpu.conf. If the desktop ever fails
# to start, press E on the NiiX entry in the Limine menu and add niix.gpu=off
# to the cmdline line - that boot then uses the default GPU.
set -uo pipefail

SYS=${NIIX_SYSFS:-/sys}     # overridable so the logic can be tested
CONF=/etc/niix/gpu.conf
ENV_FILE=/etc/environment.d/90-niix-gpu.conf
RULE_FILE=/run/udev/rules.d/61-niix-gpu.rules
STATE_FILE=/run/niix/gpu.state
GAMEMODE_FILE=/etc/gamemode.ini
MASK_MARKER=/etc/niix/.switcheroo-masked

GPU_MODE=auto
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

CPU_IS_AMD=false
grep -qm1 AuthenticAMD /proc/cpuinfo 2>/dev/null && CPU_IS_AMD=true

G_SLOT=(); G_VENDOR=(); G_DRIVER=(); G_CARD=(); G_BOOT=(); G_VRAM=()
G_KIND=(); G_NAME=(); G_SCREEN=(); G_SCORE=(); G_RANK=()
CHOSEN=-1

vendor_name() {
    case "$1" in
        0x10de) echo nvidia ;;
        0x1002) echo amd ;;
        0x8086) echo intel ;;
        *)      echo other ;;
    esac
}

# Mesa drivers take DRI_PRIME; NVIDIA's own driver takes its PRIME variables.
is_mesa_driver() {
    case "$1" in amdgpu|radeon|i915|xe|nouveau) return 0 ;; esac
    return 1
}

gpu_name() {
    local slot=$1 vendor=$2 device=$3 line
    if command -v lspci >/dev/null 2>&1; then
        line=$(lspci -s "$slot" 2>/dev/null | head -1)
        line=${line#*: }
        [ -n "$line" ] && { printf '%s' "$line"; return; }
    fi
    printf '%s:%s' "${vendor#0x}" "${device#0x}"
}

nvidia_vram_mib() {
    local slot=$1 bus mem
    command -v nvidia-smi >/dev/null 2>&1 || { echo 0; return; }
    # nvidia-smi prints an 8-digit PCI domain, sysfs a 4-digit one - compare
    # only the bus:device.function part.
    while IFS=', ' read -r bus mem; do
        bus=${bus,,}
        if [ "${bus: -7}" = "${slot: -7}" ] && [[ "$mem" =~ ^[0-9]+$ ]]; then
            echo "$mem"; return
        fi
    done < <(nvidia-smi --query-gpu=pci.bus_id,memory.total --format=csv,noheader,nounits 2>/dev/null)
    echo 0
}

# Fills the G_* arrays with every display controller on the PCI bus.
#   $1 = hardware   score by what the card IS (the installer: nouveau or no
#                   driver at all must not hide an NVIDIA card)
#   $1 = runtime    score by what the card can do right now
collect_gpus() {
    local mode=$1 dev class slot vendor device driver card c boot vram kind status
    local i amd_count=0 amd_discrete=0 best=-1 best_vram=-1
    G_SLOT=(); G_VENDOR=(); G_DRIVER=(); G_CARD=(); G_BOOT=(); G_VRAM=()
    G_KIND=(); G_NAME=(); G_SCREEN=(); G_SCORE=(); G_RANK=()

    for dev in "$SYS"/bus/pci/devices/*; do
        class=$(cat "$dev/class" 2>/dev/null) || continue
        case "$class" in 0x0300*|0x0302*|0x0380*) ;; *) continue ;; esac
        slot=${dev##*/}
        vendor=$(vendor_name "$(cat "$dev/vendor" 2>/dev/null)")
        device=$(cat "$dev/device" 2>/dev/null)

        driver=""
        [ -e "$dev/driver" ] && driver=$(basename "$(readlink -f "$dev/driver")")

        card=""
        status=no
        for c in "$dev"/drm/card[0-9]*; do
            [ -d "$c" ] || continue
            card=${c##*/}
            if grep -qx connected "$c"/"$card"-*/status 2>/dev/null; then
                status=yes
            fi
            break
        done

        boot=$(cat "$dev/boot_vga" 2>/dev/null || echo 0)

        vram=0
        if [ "$driver" = amdgpu ] && [ -r "$dev/mem_info_vram_total" ]; then
            vram=$(( $(cat "$dev/mem_info_vram_total") / 1048576 ))
        elif [ "$driver" = nvidia ]; then
            vram=$(nvidia_vram_mib "$slot")
        fi

        case "$vendor" in
            nvidia)
                kind=discrete ;;
            intel)
                # Intel's integrated GPU always sits at 00:02.0; Arc cards don't.
                if [ "${slot#*:}" = "00:02.0" ]; then kind=integrated; else kind=discrete; fi ;;
            amd)
                # With an Intel CPU any Radeon is a separate card. With a Ryzen
                # CPU it may be the APU's graphics: amdgpu only reports a VRAM
                # vendor for cards with their own memory chips.
                if [ "$CPU_IS_AMD" = false ] || [ -e "$dev/mem_info_vram_vendor" ]; then
                    kind=discrete
                else
                    kind=integrated
                fi
                amd_count=$(( amd_count + 1 ))
                [ "$kind" = discrete ] && amd_discrete=$(( amd_discrete + 1 )) ;;
            *)
                kind=basic ;;
        esac

        G_SLOT+=("$slot"); G_VENDOR+=("$vendor"); G_DRIVER+=("$driver")
        G_CARD+=("$card"); G_BOOT+=("$boot"); G_VRAM+=("$vram")
        G_KIND+=("$kind"); G_SCREEN+=("$status")
        G_NAME+=("$(gpu_name "$slot" "$(cat "$dev/vendor" 2>/dev/null)" "$device")")
    done

    # Two Radeons with a Ryzen CPU and neither reported its memory vendor:
    # the one with more VRAM is the separate card.
    if [ "$amd_count" -ge 2 ] && [ "$amd_discrete" -eq 0 ]; then
        for i in "${!G_SLOT[@]}"; do
            [ "${G_VENDOR[i]}" = amd ] || continue
            if [ "${G_VRAM[i]}" -gt "$best_vram" ]; then best=$i; best_vram=${G_VRAM[i]}; fi
        done
        [ "$best" -ge 0 ] && G_KIND[best]=discrete
    fi

    score_gpus "$mode"
}

# Score = kind first, then VRAM, then the card the firmware booted on.
# 0 means "can't be used".
score_gpus() {
    local mode=$1 i rank score
    CHOSEN=-1
    for i in "${!G_SLOT[@]}"; do
        case "${G_KIND[i]}" in
            discrete)   rank=3 ;;
            integrated) rank=2 ;;
            *)          rank=1 ;;
        esac
        if [ "$mode" = runtime ]; then
            case "${G_DRIVER[i]}" in
                "")      rank=0 ;;
                nouveau) rank=2 ;;
                vfio-pci|pci-stub) rank=0 ;;
            esac
        fi
        score=0
        if [ "$rank" -gt 0 ]; then
            score=$(( rank * 1000000000 + G_VRAM[i] * 10 + G_BOOT[i] ))
        fi
        G_SCORE[i]=$score
        G_RANK[i]=$rank
        if [ "$score" -gt 0 ] && { [ "$CHOSEN" -lt 0 ] || [ "$score" -gt "${G_SCORE[CHOSEN]}" ]; }; then
            CHOSEN=$i
        fi
    done
}

usable_count() {
    local i n=0
    for i in "${!G_SCORE[@]}"; do
        [ "${G_SCORE[i]}" -gt 0 ] && n=$(( n + 1 ))
    done
    echo "$n"
}

need_root() {
    [ "$(id -u)" -eq 0 ] || { echo "niix-gpu $1 must run as root (try: sudo niix-gpu $1)" >&2; exit 1; }
}

# The boot service starts before the login screen; give the GPU drivers (the
# NVIDIA module in particular) a moment to finish loading first.
wait_for_drivers() {
    local dev vendor ready loaded_nvidia_drm=false
    command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=10 2>/dev/null
    for _ in $(seq 1 20); do
        ready=true
        for dev in "$SYS"/bus/pci/devices/*; do
            case "$(cat "$dev/class" 2>/dev/null)" in 0x0300*|0x0302*|0x0380*) ;; *) continue ;; esac
            vendor=$(cat "$dev/vendor" 2>/dev/null)
            case "$vendor" in 0x10de|0x1002|0x8086) ;; *) continue ;; esac
            if [ ! -e "$dev/driver" ]; then
                ready=false
            elif ! compgen -G "$dev/drm/card[0-9]*" >/dev/null; then
                # The NVIDIA driver only creates its DRM device once
                # nvidia-drm is loaded.
                if [ "$(basename "$(readlink -f "$dev/driver")")" = nvidia ] && [ "$loaded_nvidia_drm" = false ]; then
                    modprobe -q nvidia_drm 2>/dev/null
                    loaded_nvidia_drm=true
                fi
                ready=false
            fi
        done
        [ "$ready" = true ] && return 0
        sleep 0.5
    done
    echo "niix-gpu: not every GPU driver was ready after 10s - using what is there"
    return 0
}

write_if_changed() {
    local file=$1 content=$2
    if [ -f "$file" ] && [ "$(cat "$file")" = "$content" ]; then
        return 1
    fi
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$content" > "$file.tmp" && chmod 644 "$file.tmp" && mv -f "$file.tmp" "$file"
    return 0
}

reload_drm_rules() {
    command -v udevadm >/dev/null 2>&1 || return 0
    udevadm control --reload 2>/dev/null
    udevadm trigger --action=change --subsystem-match=drm 2>/dev/null
    udevadm settle --timeout=10 2>/dev/null
    return 0
}

set_switcheroo() {
    # switcheroo-control makes GNOME launch some apps on the "other" GPU -
    # which is the integrated one on a desktop that booted on its graphics
    # card. With one GPU forced for everything it can only get in the way.
    local want=$1
    systemctl cat switcheroo-control.service >/dev/null 2>&1 || return 0
    if [ "$want" = off ] && [ ! -e "$MASK_MARKER" ]; then
        systemctl mask --now switcheroo-control.service >/dev/null 2>&1 \
            && mkdir -p "$(dirname "$MASK_MARKER")" && touch "$MASK_MARKER"
    elif [ "$want" = on ] && [ -e "$MASK_MARKER" ]; then
        systemctl unmask switcheroo-control.service >/dev/null 2>&1
        rm -f "$MASK_MARKER"
    fi
}

clear_settings() {
    local reason=$1
    rm -f "$ENV_FILE"
    if [ -e "$RULE_FILE" ]; then
        rm -f "$RULE_FILE"
        reload_drm_rules
    fi
    set_switcheroo on
    write_if_changed "$STATE_FILE" "mode=default
reason=$reason" >/dev/null
    echo "niix-gpu: $reason - nothing to force"
}

do_apply() {
    need_root apply
    mkdir -p /run/niix
    wait_for_drivers
    collect_gpus runtime

    if grep -qw 'niix.gpu=off' /proc/cmdline 2>/dev/null; then
        clear_settings "turned off on the kernel command line (niix.gpu=off)"
        return 0
    fi
    if [ "$GPU_MODE" = off ]; then
        clear_settings "turned off in $CONF"
        return 0
    fi

    # GameMode tweaks the card by its DRM number - not always card0, since
    # the boot framebuffer can take that number first.
    if [ "$CHOSEN" -ge 0 ] && [ -n "${G_CARD[CHOSEN]}" ]; then
        write_if_changed "$GAMEMODE_FILE" "; Written at every boot by niix-gpu: the card GameMode's GPU tweaks apply to.
[gpu]
gpu_device=${G_CARD[CHOSEN]#card}" >/dev/null
    fi

    if [ "$(usable_count)" -lt 2 ]; then
        clear_settings "only one usable GPU"
        return 0
    fi
    # Best usable card is an integrated one (e.g. the NVIDIA driver is not
    # running yet): the default choice is already right.
    if [ "${G_RANK[CHOSEN]}" -lt 3 ]; then
        clear_settings "no discrete GPU with a working driver yet"
        return 0
    fi

    local i=$CHOSEN slot driver env tag=no
    slot=${G_SLOT[i]}
    driver=${G_DRIVER[i]}

    if [ "$driver" = nvidia ]; then
        env="__NV_PRIME_RENDER_OFFLOAD=1
__NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
__GLX_VENDOR_LIBRARY_NAME=nvidia
__VK_LAYER_NV_optimus=NVIDIA_only"
        [ "${G_SCREEN[i]}" = yes ] && tag=yes
    elif is_mesa_driver "$driver"; then
        env="DRI_PRIME=pci-${slot//[:.]/_}"
        [ "$driver" != nouveau ] && tag=yes
    else
        clear_settings "the chosen GPU uses a driver niix-gpu does not know ($driver)"
        return 0
    fi

    write_if_changed "$ENV_FILE" "# Written at every boot by niix-gpu - every app renders on:
# ${G_NAME[i]} ($slot)
$env" >/dev/null

    if [ "$tag" = yes ]; then
        write_if_changed "$RULE_FILE" "# niix-gpu: GNOME draws the desktop on ${G_NAME[i]}
SUBSYSTEM==\"drm\", KERNEL==\"card[0-9]*\", KERNELS==\"$slot\", TAG+=\"mutter-device-preferred-primary\"" \
            && reload_drm_rules
    elif [ -e "$RULE_FILE" ]; then
        rm -f "$RULE_FILE"
        reload_drm_rules
    fi

    set_switcheroo off

    write_if_changed "$STATE_FILE" "mode=forced
slot=$slot
name=${G_NAME[i]}
driver=$driver
desktop=$tag" >/dev/null

    echo "niix-gpu: using ${G_NAME[i]} ($slot, $driver) for everything$([ "$tag" = yes ] && echo ', desktop included')"
}

do_status() {
    local i mark vram
    collect_gpus runtime
    printf '  %-13s %-11s %-9s %-8s %-6s %s\n' SLOT KIND DRIVER VRAM SCREEN NAME
    for i in "${!G_SLOT[@]}"; do
        mark=" "; [ "$i" -eq "$CHOSEN" ] && mark="*"
        vram="-"; [ "${G_VRAM[i]}" -gt 0 ] && vram="$(( G_VRAM[i] / 1024 ))G"
        [ "${G_VRAM[i]}" -gt 0 ] && [ "${G_VRAM[i]}" -lt 1024 ] && vram="${G_VRAM[i]}M"
        printf '%s %-13s %-11s %-9s %-8s %-6s %s\n' "$mark" "${G_SLOT[i]}" "${G_KIND[i]}" \
            "${G_DRIVER[i]:-none}" "$vram" "${G_SCREEN[i]}" "${G_NAME[i]}"
    done
    echo
    if [ -r "$STATE_FILE" ]; then
        if grep -q '^mode=forced' "$STATE_FILE"; then
            echo "In use for everything: $(sed -n 's/^name=//p' "$STATE_FILE")"
            grep -q '^desktop=yes' "$STATE_FILE" \
                && echo "GNOME draws the desktop on it as well." \
                || echo "GNOME draws on the GPU wired to the built-in screen; apps and games render on the card above."
        else
            echo "Not forcing a GPU: $(sed -n 's/^reason=//p' "$STATE_FILE")"
        fi
    else
        echo "niix-gpu has not run since boot (sudo niix-gpu apply)."
    fi
    if [ "$CHOSEN" -ge 0 ] && [ -r "$STATE_FILE" ] && grep -q '^mode=forced' "$STATE_FILE" \
        && [ "$(sed -n 's/^slot=//p' "$STATE_FILE")" != "${G_SLOT[CHOSEN]}" ]; then
        echo "A different card would be chosen now - it takes over at the next boot."
    fi
}

do_run() {
    [ $# -ge 1 ] || { echo "usage: niix-gpu run COMMAND [ARGS...]" >&2; exit 1; }
    if [ -r "$ENV_FILE" ]; then
        set -a
        # shellcheck source=/dev/null
        . "$ENV_FILE"
        set +a
    fi
    exec "$@"
}

# Flatpak apps bring their own copy of the NVIDIA user-space driver, and it
# has to be the same version as the kernel module. Flatpak fetches the right
# one by itself on 'flatpak update' - but only while the module is loaded,
# which is never the case during installation. Runs at every boot (cheap when
# nothing is missing), in the background.
do_flatpak_gl() {
    need_root flatpak-gl
    local ver ext
    [ -r /sys/module/nvidia/version ] || exit 0
    command -v flatpak >/dev/null 2>&1 || exit 0
    flatpak list --system --app --columns=application 2>/dev/null | grep -q . || exit 0
    ver=$(cat /sys/module/nvidia/version)
    ext="org.freedesktop.Platform.GL.nvidia-${ver//./-}"
    flatpak list --system --runtime --columns=application 2>/dev/null | grep -qxF "$ext" && exit 0

    echo "niix-gpu: Flatpak apps need $ext - waiting for the network..."
    for _ in $(seq 1 60); do
        curl -fsI --max-time 10 https://dl.flathub.org/repo/config >/dev/null 2>&1 && break
        sleep 10
    done
    if flatpak update --system -y --noninteractive; then
        echo "niix-gpu: Flatpak NVIDIA driver is up to date"
    else
        echo "niix-gpu: flatpak update failed - it is retried at the next boot"
        exit 1
    fi
}

do_detect() {
    local i v nvidia=0 amd=0 intel=0
    collect_gpus hardware
    for v in "${G_VENDOR[@]}"; do
        case "$v" in
            nvidia) nvidia=$(( nvidia + 1 )) ;;
            amd)    amd=$(( amd + 1 )) ;;
            intel)  intel=$(( intel + 1 )) ;;
        esac
    done
    echo "GPU_COUNT=${#G_SLOT[@]}"
    echo "GPU_NVIDIA=$nvidia"
    echo "GPU_AMD=$amd"
    echo "GPU_INTEL=$intel"
    [ "$CHOSEN" -ge 0 ] || return 0
    i=$CHOSEN
    echo "GPU_SLOT=${G_SLOT[i]}"
    echo "GPU_VENDOR=${G_VENDOR[i]}"
    echo "GPU_KIND=${G_KIND[i]}"
    echo "GPU_NAME=${G_NAME[i]}"
}

case "${1:-status}" in
    apply)      do_apply ;;
    status)     do_status ;;
    run)        shift; do_run "$@" ;;
    flatpak-gl) do_flatpak_gl ;;
    detect)     do_detect ;;
    *)
        echo "Usage: niix-gpu {status|apply|run COMMAND...|flatpak-gl|detect}" >&2
        exit 1 ;;
esac
NIIXGPUEOF
}

# -- niix-hardware: what kind of machine this is ---------------------
niix_hardware_script() {
    cat <<'NIIXHWEOF'
#!/bin/bash
# niix-hardware - what kind of machine this is, and the settings that follow.
#
#   niix-hardware detect   print the profile as KEY=VALUE lines (the installer)
#   niix-hardware apply    refresh /etc/niix/hardware.conf and apply it (every boot)
#   niix-hardware status   show the profile
#
# Profile:
#   FORM      desktop | laptop | handheld | vm
#   HANDHELD  steamdeck | rog-ally | legion-go | msi-claw | other  (handhelds only)
#   VIRT      the hypervisor in a virtual machine (kvm, oracle, vmware, ...)
#   CPU       amd | intel | other
#   CPU_X3D   yes on Ryzen X3D chips with two core groups (7900X3D, 7950X3D,
#             9900X3D, 9950X3D) - only one group has the extra game cache
#   CPU_HYBRID yes on Intel chips with performance and efficiency cores
#   BATTERY   yes | no
#
# Applied at every boot:
#   - X3D: games are steered to the cores with the big cache (amd_x3d_mode),
#     which is where they run fastest. X3D_MODE=frequency in
#     /etc/niix/hardware-overrides.conf turns that around.
set -uo pipefail

SYS=${NIIX_SYSFS:-/sys}
PROFILE=/etc/niix/hardware.conf
OVERRIDES=/etc/niix/hardware-overrides.conf

X3D_MODE=cache
# shellcheck source=/dev/null
[ -r "$OVERRIDES" ] && . "$OVERRIDES"

dmi() {
    local value
    value=$(cat "$SYS/class/dmi/id/$1" 2>/dev/null) || return 0
    printf '%s' "${value,,}"
}

has_battery() {
    local supply
    for supply in "$SYS"/class/power_supply/*; do
        # scope=Device marks batteries inside mice, keyboards and controllers
        [ "$(cat "$supply/type" 2>/dev/null)" = Battery ] || continue
        [ "$(cat "$supply/scope" 2>/dev/null)" = Device ] && continue
        return 0
    done
    return 1
}

handheld_model() {
    local id
    id="$(dmi sys_vendor)|$(dmi product_name)|$(dmi product_family)|$(dmi product_version)|$(dmi board_name)"
    case "$id" in
        valve\|jupiter*|valve\|galileo*)                  echo steamdeck ;;
        asus*rog\ ally*|asus*\|rc71l*|asus*\|rc72l*)     echo rog-ally ;;
        lenovo*legion\ go*|lenovo\|83e1*|lenovo\|83l3*|lenovo\|83n6*|lenovo\|83q2*|lenovo\|83q3*)
                                                          echo legion-go ;;
        micro-star*claw*)                                 echo msi-claw ;;
        ayaneo\|*|ayadevice\|*|one-netbook\|*|gpd\|*)     echo other ;;
    esac
}

virt_type() {
    local virt
    virt=$(systemd-detect-virt --vm 2>/dev/null) || return 0
    [ "$virt" = none ] || printf '%s' "$virt"
}

detect() {
    local virt handheld chassis form cpu x3d=no hybrid=no battery=no

    virt=$(virt_type)
    handheld=$(handheld_model)
    chassis=$(dmi chassis_type)
    has_battery && battery=yes

    if [ -n "$virt" ]; then
        form=vm
    elif [ -n "$handheld" ]; then
        form=handheld
    else
        # Chassis types from the SMBIOS spec: portable, laptop, notebook,
        # hand-held, sub-notebook, tablet, convertible, detachable. Some
        # boards leave the type empty - a built-in battery decides then.
        form=desktop
        case "$chassis" in
            8|9|10|11|14|30|31|32) form=laptop ;;
            "") [ "$battery" = yes ] && form=laptop ;;
        esac
    fi

    case "$(grep -m1 '^vendor_id' /proc/cpuinfo 2>/dev/null)" in
        *AuthenticAMD*) cpu=amd ;;
        *GenuineIntel*) cpu=intel ;;
        *) cpu=other ;;
    esac
    compgen -G "$SYS/bus/platform/drivers/amd_x3d_vcache/*/amd_x3d_mode" >/dev/null && x3d=yes
    [ -d "$SYS/devices/cpu_core" ] && [ -d "$SYS/devices/cpu_atom" ] && hybrid=yes

    echo "FORM=$form"
    echo "HANDHELD=$handheld"
    echo "VIRT=$virt"
    echo "CPU=$cpu"
    echo "CPU_X3D=$x3d"
    echo "CPU_HYBRID=$hybrid"
    echo "BATTERY=$battery"
}

apply_x3d() {
    local node current
    for node in "$SYS"/bus/platform/drivers/amd_x3d_vcache/*/amd_x3d_mode; do
        [ -w "$node" ] || continue
        current=$(cat "$node")
        [ "$current" = "$X3D_MODE" ] && continue
        if echo "$X3D_MODE" > "$node"; then
            echo "niix-hardware: X3D cores prioritised for $X3D_MODE"
        else
            echo "niix-hardware: could not set amd_x3d_mode to '$X3D_MODE'" >&2
        fi
    done
}

do_apply() {
    [ "$(id -u)" -eq 0 ] || { echo "niix-hardware apply must run as root" >&2; exit 1; }
    local profile
    profile="# Written at every boot by niix-hardware - do not edit (see $OVERRIDES)
$(detect)"
    if [ ! -f "$PROFILE" ] || [ "$(cat "$PROFILE")" != "$profile" ]; then
        mkdir -p "${PROFILE%/*}"
        printf '%s\n' "$profile" > "$PROFILE.tmp" && mv -f "$PROFILE.tmp" "$PROFILE"
    fi
    apply_x3d
}

case "${1:-status}" in
    detect) detect ;;
    apply)  do_apply ;;
    status)
        if [ -r "$PROFILE" ]; then grep -v '^#' "$PROFILE"; else detect; fi ;;
    *)
        echo "Usage: niix-hardware {status|detect|apply}" >&2
        exit 1 ;;
esac
NIIXHWEOF
}

# -- niix-display: monitors at full resolution and refresh rate ------
niix_display_script() {
    cat <<'NIIXDISPEOF'
#!/usr/bin/env python3
"""niix-display - every monitor at its full resolution and highest refresh rate.

Runs in the desktop session (systemd user service). The first time a monitor
is connected, it switches that monitor to its native resolution at the
highest refresh rate it offers, with variable refresh rate (FreeSync /
G-Sync / Adaptive-Sync) on where the monitor supports it. GNOME on its own
starts most 144/165/240 Hz monitors at 60 Hz.

A monitor is only set up once. Whatever is chosen for it afterwards in
Settings -> Displays is kept.

If a monitor is capable of more than 60 Hz (going by its own EDID data) but
the computer only offers 60 Hz, a notification explains the likely cause -
usually the cable or the port it is plugged into.

  niix-display            watch for monitors (the login service)
  niix-display status     list monitors, modes in use and what they support
  niix-display reset      set up every connected monitor again

Settings: /etc/niix/display.conf   (VRR=on|off)
Log:      journalctl --user -u niix-display
"""
import glob
import json
import os
import subprocess
import sys

from gi.repository import Gio, GLib

BUS_NAME = "org.gnome.Mutter.DisplayConfig"
OBJ_PATH = "/org/gnome/Mutter/DisplayConfig"
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "niix")
STATE_FILE = os.path.join(STATE_DIR, "display-setup-v2.json")
CONF_FILE = "/etc/niix/display.conf"
GPU_STATE = "/run/niix/gpu.state"

PROPER_DRIVERS = {"amdgpu", "radeon", "i915", "xe", "nvidia", "nouveau"}


def log(msg):
    print("niix-display: " + msg, flush=True)


def notify(title, body):
    try:
        subprocess.Popen(["notify-send", "-a", "NiiX", "-i", "video-display", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def read_conf():
    conf = {"VRR": "on"}
    try:
        with open(CONF_FILE) as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    key, value = line.split("=", 1)
                    conf[key.strip()] = value.strip().strip('"\'').lower()
    except OSError:
        pass
    return conf


def load_state():
    try:
        with open(STATE_FILE) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(state):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(state, fh, indent=1, sort_keys=True)
        os.replace(tmp, STATE_FILE)
    except OSError as exc:
        log("could not save state: %s" % exc)


def monitor_key(spec, modes):
    connector, vendor, product, serial = spec
    # The same monitor on another port is still the same monitor; monitors that
    # report no serial are told apart by port. When VRR modes appear later (on
    # older GNOME they only show up after a restart) the monitor counts as new,
    # so VRR is switched on then.
    key = "%s|%s|%s" % (vendor, product,
                        serial if serial and serial not in ("0x00000000", "0") else connector)
    return key + "|vrr" if any(is_vrr(m) for m in modes) else key


# -- What the monitor itself says it can do (EDID) ---------------------------

def sysfs_connectors(connector):
    """The connector's folders in /sys/class/drm. Mutter and the kernel name
    most ports the same (DP-1, eDP-1), but HDMI differs: Mutter's HDMI-1 is
    the kernel's HDMI-A-1 (HDMI-B on the rare type B port)."""
    names = [connector]
    kind, _, number = connector.rpartition("-")
    if kind == "HDMI" and number.isdigit():
        names += ["HDMI-A-" + number, "HDMI-B-" + number]
    paths = []
    for name in names:
        paths += glob.glob("/sys/class/drm/card*-%s" % name)
    return paths


def edid_max_refresh(connector):
    """Highest refresh rate in the monitor's EDID range-limits block, or 0."""
    best = 0
    for path in [os.path.join(p, "edid") for p in sysfs_connectors(connector)]:
        try:
            with open(path, "rb") as fh:
                edid = fh.read()
        except OSError:
            continue
        if len(edid) < 128 or edid[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
            continue
        for start in range(54, 126, 18):
            block = edid[start:start + 18]
            if block[0:3] == b"\x00\x00\x00" and block[3] == 0xFD:
                max_v = block[6] + (255 if block[4] & 0x02 else 0)
                best = max(best, max_v)
    return best


def connector_info(connector):
    """(driver name, PCI slot) of the GPU this connector belongs to."""
    for path in sysfs_connectors(connector):
        card = os.path.basename(path).split("-", 1)[0]
        dev = os.path.realpath("/sys/class/drm/%s/device" % card)
        driver = ""
        if os.path.exists(os.path.join(dev, "driver")):
            driver = os.path.basename(os.path.realpath(os.path.join(dev, "driver")))
        return driver, os.path.basename(dev)
    return "", ""


def forced_gpu_slot():
    try:
        with open(GPU_STATE) as fh:
            values = dict(line.strip().split("=", 1) for line in fh if "=" in line)
    except OSError:
        return ""
    return values.get("slot", "") if values.get("mode") == "forced" else ""


def why_only_60(connector, best_rate):
    driver, slot = connector_info(connector)
    if driver and driver not in PROPER_DRIVERS:
        return ("The graphics driver isn't running, so the screen uses a basic "
                "fallback mode. Restart once; if it stays, run 'niix-gpu status'.")
    strong = forced_gpu_slot()
    if strong and slot and slot != strong:
        return ("This monitor is plugged into the motherboard. Plug it into the "
                "graphics card's ports instead - that also makes games much faster.")
    if connector.startswith("HDMI"):
        return ("The HDMI cable or port only carries %d Hz at this resolution. Use "
                "DisplayPort, or a cable marked 'High Speed' / HDMI 2.0 or newer." % round(best_rate))
    return ("The cable or port only carries %d Hz at this resolution. Try another "
            "cable (DisplayPort 1.4 or newer) or another port on the graphics card." % round(best_rate))


def native_held_back(connector, native_w, native_h, native_rate, fast):
    """Why native resolution runs at 60 Hz while a lower one gets the high rate."""
    driver, slot = connector_info(connector)
    strong = forced_gpu_slot()
    lower = "%dx%d at %.0f Hz" % (fast[1], fast[2], fast[3])
    if strong and slot and slot != strong:
        return ("This monitor is plugged into the motherboard. Plug it into the "
                "graphics card's ports instead - that also makes games much faster.")
    if connector.startswith("HDMI") and driver in ("amdgpu", "radeon"):
        return ("%dx%d only runs at %.0f Hz over HDMI: AMD's Linux driver has no HDMI 2.1, "
                "and HDMI 2.0 can't carry more. Use a DisplayPort cable for the full refresh "
                "rate at %dx%d - or pick %s in Settings -> Displays."
                % (native_w, native_h, native_rate, native_w, native_h, lower))
    if connector.startswith("HDMI"):
        return ("%dx%d only runs at %.0f Hz on this HDMI link. Higher needs the monitor's "
                "HDMI 2.1 port and an 'Ultra High Speed' cable - or use DisplayPort. Until "
                "then, %s is available in Settings -> Displays."
                % (native_w, native_h, native_rate, lower))
    return ("%dx%d only runs at %.0f Hz on this link. Try a DisplayPort 1.4 (or newer) "
            "cable, or another port on the graphics card - or pick %s in Settings -> Displays."
            % (native_w, native_h, native_rate, lower))


def refresh_problem(connector, modes):
    """(title, explanation) when the monitor can't reach its refresh rate here, else None."""
    if not modes:
        return None
    fastest = max(modes, key=lambda m: m[3])
    capable = edid_max_refresh(connector)
    if capable >= 100 and fastest[3] < 75:
        return ("limited to %.0f Hz" % fastest[3],
                "This monitor supports up to %d Hz. %s" % (capable, why_only_60(connector, fastest[3])))
    native = best_mode(modes, False)
    if native and native[3] < 75 and fastest[3] >= 100:
        return ("at %.0f Hz at full resolution" % native[3],
                native_held_back(connector, native[1], native[2], native[3], fastest))
    return None


# -- Choosing the mode ----------------------------------------------------------

def current_mode(modes):
    return next((m for m in modes if m[6].get("is-current", False)), None)


def is_vrr(mode):
    return mode[6].get("refresh-rate-mode", "fixed") == "variable"


def best_mode(modes, want_vrr):
    """Native resolution at the highest refresh; the VRR variant if wanted."""
    if not modes:
        return None
    # Native is the preferred mode's size. Many 1080p/1440p high-refresh
    # monitors also accept a bigger 4K signal at 60 Hz and scale it down -
    # that bigger size is NOT native and must never cost refresh rate. A
    # bigger size only wins when it runs at least as fast.
    def top(size):
        rates = [m[3] for m in modes if (m[1], m[2]) == size and not m[6].get("is-interlaced", False)]
        return max(rates, default=0)

    biggest = max(modes, key=lambda m: m[1] * m[2])
    preferred = next((m for m in modes if m[6].get("is-preferred", False)), biggest)
    ref = preferred
    if (biggest[1] * biggest[2] > preferred[1] * preferred[2]
            and top((biggest[1], biggest[2])) >= top((preferred[1], preferred[2])) - 0.5):
        ref = biggest
    same_size = [m for m in modes if m[1] == ref[1] and m[2] == ref[2]
                 and not m[6].get("is-interlaced", False)]
    if not same_size:
        return None
    top_rate = max(m[3] for m in same_size)
    fastest = [m for m in same_size if m[3] >= top_rate - 0.5]
    if want_vrr:
        vrr = [m for m in fastest if is_vrr(m)]
        if vrr:
            return max(vrr, key=lambda m: m[3])
    fixed = [m for m in fastest if not is_vrr(m)] or fastest
    return max(fixed, key=lambda m: m[3])


def build_layout(logical, by_connector, changes):
    """The current layout with the new modes in it, or None if it can't be."""
    out = []
    for x, y, scale, transform, primary, mons, _props in logical:
        connectors = [spec[0] for spec in mons]
        if len(connectors) > 1 and any(c in changes for c in connectors):
            return None     # mirrored screens must keep matching sizes
        entries = []
        for conn in connectors:
            if conn not in by_connector:
                return None
            mode = changes.get(conn) or current_mode(by_connector[conn][1])
            if mode is None:
                return None
            entries.append((conn, mode))
        mode = entries[0][1]
        supported = mode[5]
        if supported and scale not in supported:
            scale = mode[4] if mode[4] in supported else min(supported, key=lambda v: abs(v - scale))
        out.append((x, y, scale, transform, primary, [(c, m[0], {}) for c, m in entries], mode))
    return out


def side_by_side(layout, layout_mode):
    """Same monitors and order, lined up left to right with no gaps."""
    packed, x = [], 0
    for item in sorted(layout, key=lambda i: (i[0], i[1])):
        _x, _y, scale, transform, primary, mons, mode = item
        width, height = mode[1], mode[2]
        if transform % 2:           # rotated by 90 or 270 degrees
            width = height
        if layout_mode == 1:        # logical layout: sizes are divided by the scale
            width = int(round(width / scale))
        packed.append((x, 0, scale, transform, primary, mons, mode))
        x += width
    return packed


class Display:
    def __init__(self):
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.proxy = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None,
                                            BUS_NAME, OBJ_PATH, BUS_NAME, None)
        self.pending = 0

    def state(self):
        return self.proxy.call_sync("GetCurrentState", None, Gio.DBusCallFlags.NONE,
                                    10000, None).unpack()

    def apply(self, serial, layout, method):
        logical = [item[:6] for item in layout]
        self.proxy.call_sync(
            "ApplyMonitorsConfig",
            GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})", (serial, method, logical, {})),
            Gio.DBusCallFlags.NONE, 10000, None)

    def try_apply(self, serial, layout, layout_mode):
        # Same positions first; if a monitor got bigger and now overlaps its
        # neighbour, line them up side by side instead. Each one is checked
        # (method 0) before it is made permanent (method 2).
        for candidate in (layout, side_by_side(layout, layout_mode)):
            try:
                self.apply(serial, candidate, 0)
            except GLib.Error:
                continue
            try:
                self.apply(serial, candidate, 2)
                return True
            except GLib.Error as exc:
                log("apply failed: %s" % exc.message)
                return False
        return False

    def setup_new_monitors(self, force=False):
        try:
            self._setup(force)
        except GLib.Error as exc:
            log("display settings unavailable: %s" % exc.message)

    def _setup(self, force):
        want_vrr = read_conf().get("VRR", "on") != "off"
        serial, monitors, logical, props = self.state()
        saved = load_state()

        by_connector = {spec[0]: (spec, modes, mprops) for spec, modes, mprops in monitors
                        if not mprops.get("is-for-lease", False)}
        keyed = [(monitor_key(spec, modes), spec, modes, mprops)
                 for spec, modes, mprops in by_connector.values()]
        new = [item for item in keyed if force or item[0] not in saved]
        if not new:
            return

        changes = {}
        for _key, spec, modes, _mprops in new:
            pick = best_mode(modes, want_vrr)
            current = current_mode(modes)
            if pick and (current is None or pick[0] != current[0]):
                changes[spec[0]] = pick

        failed = set()
        if changes:
            layout = build_layout(logical, by_connector, changes)
            if layout and self.try_apply(serial, layout, props.get("layout-mode", 1)):
                for conn, mode in changes.items():
                    log("%s -> %dx%d @ %.2f Hz%s" % (conn, mode[1], mode[2], mode[3],
                                                     ", VRR on" if is_vrr(mode) else ""))
            else:
                # Not marked as set up: tried again at the next monitor
                # change and at the next login, instead of never.
                failed = set(changes)
                log("could not switch %s - trying again later" % ", ".join(sorted(failed)))

        for key, spec, modes, mprops in new:
            connector = spec[0]
            if connector in failed:
                continue
            fastest = max((m[3] for m in modes), default=0)
            capable = edid_max_refresh(connector)
            saved[key] = {"connector": connector, "max_offered": round(fastest, 2),
                          "edid_max": capable}
            problem = refresh_problem(connector, modes)
            if problem:
                name = mprops.get("display-name", connector)
                log("%s is %s: %s" % (name, problem[0], problem[1]))
                notify("%s is %s" % (name, problem[0]), problem[1])
        save_state(saved)

    def status(self):
        monitors = self.state()[1]
        saved = load_state()
        for spec, modes, mprops in monitors:
            connector = spec[0]
            current = current_mode(modes)
            fastest = max((m[3] for m in modes), default=0)
            capable = edid_max_refresh(connector)
            driver, slot = connector_info(connector)
            print("%s  %s" % (connector, mprops.get("display-name", "")))
            if current:
                print("  in use      %dx%d @ %.2f Hz%s" % (current[1], current[2], current[3],
                                                          "  VRR on" if is_vrr(current) else ""))
            print("  fastest     %.2f Hz offered%s" % (fastest, ", VRR supported"
                                                       if any(is_vrr(m) for m in modes) else ""))
            if capable:
                print("  monitor     up to %d Hz (EDID)" % capable)
            print("  GPU         %s %s" % (driver or "?", slot))
            print("  set up      %s" % ("yes" if monitor_key(spec, modes) in saved else "not yet"))
            problem = refresh_problem(connector, modes)
            if problem:
                print("  !           " + problem[1])
            print()

    def watch(self):
        self.setup_new_monitors()
        self.proxy.connect("g-signal", self._on_signal)
        GLib.MainLoop().run()

    def _on_signal(self, _proxy, _sender, signal, _params):
        # Monitor changes arrive in bursts (and our own change adds one):
        # wait until things have been quiet for 2 seconds.
        if signal != "MonitorsChanged":
            return
        if self.pending:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add_seconds(2, self._on_quiet)

    def _on_quiet(self):
        self.pending = 0
        self.setup_new_monitors()
        return GLib.SOURCE_REMOVE


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "watch"
    if cmd not in ("watch", "status", "reset"):
        print("Usage: niix-display [watch|status|reset]", file=sys.stderr)
        sys.exit(1)
    try:
        display = Display()
    except GLib.Error as exc:
        log("GNOME display service not reachable: %s" % exc.message)
        sys.exit(1)    # the service retries; GNOME may not be up yet
    if cmd == "watch":
        display.watch()
    elif cmd == "status":
        display.status()
    else:
        save_state({})
        display.setup_new_monitors(force=True)
        print("Every connected monitor was set up again.")


if __name__ == "__main__":
    main()
NIIXDISPEOF
}

# -- rip: the dedication, scrolled like film credits ---------------------
niix_rip_script() {
    cat <<'RIPEOF'
#!/bin/bash
# rip - the NiiX dedication, scrolled slowly like film credits.
#   rip              play it (Ctrl+C stops)
#   RIP_DELAY=0.1 rip  faster or slower: seconds per line
set -u

delay=${RIP_DELAY:-0.3}
[[ "$delay" =~ ^[0-9]*\.?[0-9]+$ ]] || delay=0.3

# Only the names are coloured, one colour per person.
reset=$'\033[0m'
names=(
    "ALAN MATHISON TURING" "Alan Turing"              $'\033[38;5;81m'
    "TERRY ANDREW DAVIS"   "Terry Davis" "- Terry"    $'\033[38;5;220m'
    "AARON HILLEL SWARTZ"  "Aaron Swartz"             $'\033[38;5;205m'
    "SIR NICHOLAS WINTON"  "Nicholas Winton"          $'\033[38;5;118m'
)

colour_names() {
    local line=$1 item colour="" i
    # Walk the list backwards so each name meets its colour first.
    for (( i = ${#names[@]} - 1; i >= 0; i-- )); do
        item=${names[i]}
        if [[ "$item" == $'\033'* ]]; then
            colour=$item
        else
            line=${line//"$item"/"$colour$item$reset"}
        fi
    done
    printf '%s\n' "$line"
}

if [ -t 1 ]; then
    printf '\033[?25l'                        # hide the cursor
    trap 'printf "%s\033[?25h\n" "$reset"; exit 130' INT TERM
    trap 'printf "%s\033[?25h" "$reset"' EXIT
    clear
    printf '\n%.0s' $(seq "$(( $(tput lines 2>/dev/null || echo 24) - 1 ))")
else
    delay=0                                   # piped or redirected: no waiting
fi

while IFS= read -r line; do
    colour_names "$line"
    sleep "$delay"
done <<'RIPTEXT'
============================================================================

  If you are reading this, you found the temple.
  It was built for four people who did what needed doing.
  This comment does nothing. That was always the point.


                             
                            /\
                           //\\
                          //  \\
                         //  W \\
                        //   T  \\
                       //    D   \\
                      //     S    \\
                     //____________\\
                    //              \\
                   //  ___       ___ \\
                  //  |   |     |   | \\
                 //   | A |     | T |  \\
                //    |   |     |   |   \\
               //     |___|     |___|    \\
              //       | |       | |      \\
             //   ___  | |  ___  | |  ___  \\
            //   |   | | | |   | | | |   |  \\
           //    | A | | | |   | | | | T |   \\
          //     |   | | | |   | | | |   |    \\
         //      |___| | | |___| | | |___|     \\
        //        | |  | |  | |  | |  | |       \\
       //    ___  | |  | |  | |  | |  | |  ___   \\
      //    |   | | |  | |  | |  | |  | | |   |   \\
     //     | A | | |  | |  | |  | |  | | | N |    \\
    //      |   | | |  | |  | |  | |  | | |   |     \\
   //       |___| | |  | |  | |  | |  | | |___|      \\
  //__________________________________________________\\
  |                                                    |
  |          T E M P L E   O F   T H E   R A M         |
  |                                                    |
  |____________________________________________________|
  |||  |||  |||  |||  |||  |||   |||  |||  |||  |||  |||
  |||  |||  |||  |||  |||  |||   |||  |||  |||  |||  |||

  A = Alan Turing      T = Terry Davis
  A = Aaron Swartz     N = Nicholas Winton

============================================================================

ALAN MATHISON TURING  //  1912 - 1954

============================================================================

  He asked whether machines could think before anyone
  had built one worth asking about.
  He broke Enigma. He shortened the war by years.
  He saved millions of lives and was never allowed to know
  that he had, because it was classified.

  The country he saved chemically castrated him
  for being gay. He died at 41, alone, an apple beside him.
  Every computer that has ever run anything
  is a footnote to his 1936 paper.

  "We can only see a short distance ahead,
   but we can see plenty there that needs to be done."

============================================================================

TERRY ANDREW DAVIS  //  1969 - 2018

============================================================================

  He built an entire operating system alone.
  640x480. One process. No multitasking. Talked to God
  in a language he wrote himself, on a machine he trusted
  completely because he understood every layer of it.

  TempleOS was not a joke. It was a cathedral.
  He finished it. That is more than most people do.

  "The compiler is proof that God loves us."

============================================================================

AARON HILLEL SWARTZ  //  1986 - 2013

============================================================================

  He was 14 when he helped draft RSS.
  He helped build Creative Commons. He built Tor2web.
  He co-founded Reddit and walked away from the money.
  He believed that knowledge locked behind a paywall
  was a violence done to the world, and he was right.

  They offered him 35 years for downloading journal articles.
  He was 26. He had already changed the internet twice.

  "Information is power. But like all power, there are
   those who want to keep it for themselves."

============================================================================

SIR NICHOLAS WINTON  //  1909 - 2015

============================================================================

  Not a builder of machines. A builder of something harder.

  In 1938, a 29-year-old stockbroker cancelled his skiing
  holiday and went to Prague instead.
  He found Jewish families desperate to get their children
  out before the Nazis arrived.

  He organised eight trains.
  669 children. Forged documents. Bribes. Paperwork.
  He did it with a scrapbook and a typewriter
  and told nobody for fifty years.

  His wife found the scrapbook in the attic in 1988.
  He was in the audience of a BBC programme.
  The host asked if anyone recognised the names
  in the book she was holding.
  Every person in the room stood up.
  They were his children.

  He lived to 106. He never thought he had done
  anything particularly remarkable.

  "If something is not impossible, there must be
   a way to do it."

============================================================================

  Four people. None of them asked for recognition.
  One proved the machine was possible.
  One talked to God inside it.
  One tried to make sure it belonged to everyone.
  One just went to Prague and got to work.
  The world is better for all four of them.
  Read the source. Keep it open. Keep building.
  And if something is not impossible - do it.

                   +-------------------------+
                   |   "You are loved."      |
                   |        - Terry          |
                   +-------------------------+
RIPTEXT
RIPEOF
}

machine_description() {
    local text
    case "$FORM" in
        laptop)   text="laptop" ;;
        handheld) text="handheld (${HANDHELD:-unknown model})" ;;
        vm)       text="virtual machine (${VIRT:-unknown})" ;;
        *)        text="desktop" ;;
    esac
    [[ "$CPU_X3D" == yes ]] && text+=", Ryzen X3D (games kept on the cache cores)"
    [[ "$CPU_HYBRID" == yes ]] && text+=", Intel performance + efficiency cores"
    printf '%s' "$text"
}

# -- Hardware detection (runs from live ISO) ------------------
detect_hardware() {
    hr "Hardware Detection"
    info "Detecting hardware..."

    # CPU
    CPU_MODEL=$(grep -m1 "model name" /proc/cpuinfo | cut -d: -f2 | xargs)
    if grep -qi "AuthenticAMD" /proc/cpuinfo; then
        CPU_VENDOR="amd"
    elif grep -qi "GenuineIntel" /proc/cpuinfo; then
        CPU_VENDOR="intel"
    else
        CPU_VENDOR="unknown"
    fi
    log "CPU: $CPU_MODEL ($CPU_VENDOR)"

    # GPU: every card on the PCI bus is scored by niix-gpu - the same tool the
    # installed system runs at every boot - so the installer and the system
    # always agree on which card is the most powerful one.
    local key value
    niix_gpu_script > /tmp/niix-gpu
    while IFS='=' read -r key value; do
        case "$key" in
            GPU_COUNT)  GPU_COUNT=$value ;;
            GPU_NVIDIA) HAS_NVIDIA=$value ;;
            GPU_AMD)    HAS_AMD=$value ;;
            GPU_INTEL)  HAS_INTEL=$value ;;
            GPU_VENDOR) GPU_VENDOR=$value ;;
            GPU_KIND)   GPU_KIND=$value ;;
            GPU_NAME)   GPU_MODEL=$value ;;
        esac
    done < <(bash /tmp/niix-gpu detect 2>/dev/null)
    for key in GPU_COUNT HAS_NVIDIA HAS_AMD HAS_INTEL; do
        [[ "${!key}" =~ ^[0-9]+$ ]] || printf -v "$key" '%s' 0
    done
    [[ "$GPU_VENDOR" == other ]] && GPU_VENDOR=""

    IS_HYBRID=false
    [[ "$GPU_COUNT" -ge 2 ]] && IS_HYBRID=true
    if [[ -n "$GPU_VENDOR" ]]; then
        log "GPU: $GPU_MODEL ($GPU_VENDOR)"
        [[ "$IS_HYBRID" == true ]] \
            && log "$GPU_COUNT GPUs found - the one above is the most powerful and will be used for everything"
    else
        warn "Could not detect the GPU - basic graphics drivers only"
    fi

    # What kind of machine: desktop, laptop, handheld or virtual machine -
    # the same tool the installed system runs at every boot.
    niix_hardware_script > /tmp/niix-hardware
    while IFS='=' read -r key value; do
        case "$key" in
            FORM)       FORM=$value ;;
            HANDHELD)   HANDHELD=$value ;;
            VIRT)       VIRT=$value ;;
            CPU_X3D)    CPU_X3D=$value ;;
            CPU_HYBRID) CPU_HYBRID=$value ;;
        esac
    done < <(bash /tmp/niix-hardware detect 2>/dev/null)
    log "Machine: $(machine_description)"

    # RAM
    local mem_kb
    mem_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    MEM_TOTAL_GB=$(( mem_kb / 1024 / 1024 ))
    log "RAM: ~${MEM_TOTAL_GB}GB"

}

# internet_up TRIES : 0 once archlinux.org answers, 1 after TRIES attempts.
internet_up() {
    local i
    for (( i = 1; i <= $1; i++ )); do
        ping -c1 -W3 archlinux.org &>/dev/null && return 0
        sleep 2
    done
    return 1
}

# -- WiFi connection - used by pre-flight when there's no link yet -----
# Text mode only (the graphical installer asks for the network menu instead).
# Interactive: scans, asks for SSID + password, connects with NetworkManager,
# and verifies real internet before returning.
connect_wifi() {
    command -v rfkill &>/dev/null && rfkill unblock wifi 2>/dev/null || true

    local wifi_if d
    wifi_if=$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')
    if [ -z "$wifi_if" ]; then
        for d in /sys/class/net/wl*; do [ -e "$d" ] && { wifi_if=$(basename "$d"); break; }; done
    fi
    if [ -z "$wifi_if" ]; then
        warn "No WiFi adapter detected."
        return 1
    fi
    systemctl is-active --quiet NetworkManager 2>/dev/null || systemctl start NetworkManager 2>/dev/null || true
    if ! systemctl is-active --quiet NetworkManager 2>/dev/null; then
        warn "NetworkManager is not running - connect with the network menu instead."
        return 1
    fi
    info "WiFi adapter: $wifi_if"

    local ssid wpass again
    local -a pass=()
    while true; do
        echo
        info "Scanning for networks..."
        nmcli device wifi rescan ifname "$wifi_if" 2>/dev/null || nmcli device wifi rescan 2>/dev/null || true
        sleep 3
        nmcli -t -f SSID,SIGNAL,SECURITY device wifi list 2>/dev/null \
            | awk -F: 'length($1){printf "     %-32s  %3s%%  %s\n",$1,$2,($3==""?"open":$3)}' \
            | sort -u | head -25

        echo
        read -rp "  WiFi network name (SSID) - or 'skip' to cancel: " ssid
        if [ -z "$ssid" ]; then continue; fi
        if [ "$ssid" = "skip" ]; then warn "WiFi setup skipped."; return 1; fi
        read -rsp "  WiFi password (leave blank if open): " wpass; echo

        pass=()
        [ -n "$wpass" ] && pass=(password "$wpass")
        info "Connecting to '$ssid'..."
        nmcli device wifi connect "$ssid" "${pass[@]}" ifname "$wifi_if" 2>&1 | sed 's/^/     /'

        if internet_up 5; then
            log "Connected to '$ssid' - internet is up"
            return 0
        fi

        warn "Still no internet on '$ssid' (wrong password, weak signal, or captive portal?)."
        read -rp "  Try a different network / retry? [Y/n]: " again
        case "${again,,}" in n|no) warn "WiFi setup cancelled."; return 1 ;; esac
    done
}

# -- Ensure internet, bringing up WiFi if there's no active link ------
ensure_internet() {
    info "Checking internet connection..."
    if internet_up 3; then
        log "Internet connection detected"
        return 0
    fi

    $GUI_MODE && err "No internet connection - connect to a network first."
    warn "No wired/active connection found - let's set up WiFi."
    connect_wifi && return 0
    err "No internet connection. Connect Ethernet or WiFi, then re-run the installer."
}

# -- Pre-flight checks ----------------------------------------
check_prereqs() {
    hr "Pre-flight Checks"
    info "Running pre-flight checks..."

    [ "$EUID" -eq 0 ]        || err "Please run as root"
    [ -f /etc/niix-live ]    || err "Start the installer from the NiiX live ISO - it copies the system from there."
    (( $(cpu_level) >= 3 ))  || err "This CPU is too old for NiiX - it needs x86-64-v3 (AVX2): Intel Core 4th generation (2013) or AMD Ryzen / 2015 or newer."

    ensure_internet

    [ -d /sys/firmware/efi ] || err "Not booted in UEFI mode - enable UEFI in BIOS"

    # Secure Boot must be OFF - Limine doesn't support it. Fail now with a
    # clear message rather than a confusing boot failure after a full install.
    if command -v mokutil &>/dev/null; then
        if mokutil --sb-state 2>/dev/null | grep -qi "SecureBoot enabled"; then
            err "Secure Boot is ON - disable it in BIOS/UEFI settings, then re-run this installer (Limine does not support Secure Boot)"
        fi
    elif [[ -d /sys/firmware/efi/efivars ]]; then
        local sb_var
        sb_var=$(find /sys/firmware/efi/efivars -maxdepth 1 -name 'SecureBoot-*' 2>/dev/null | head -1)
        if [[ -n "$sb_var" ]]; then
            local sb_byte
            sb_byte=$(od -An -tu1 "$sb_var" 2>/dev/null | awk '{print $NF}')
            [[ "$sb_byte" == "1" ]] && err "Secure Boot is ON - disable it in BIOS/UEFI settings, then re-run this installer (Limine does not support Secure Boot)"
        fi
    fi

    for cmd in cryptsetup parted mkfs.btrfs python3 efibootmgr lsblk blkid rsync findmnt arch-chroot; do
        command -v "$cmd" &>/dev/null || err "$cmd not found on live ISO"
    done

    if on_console; then
        loadkeys "$KEYMAP"   # US until a layout is chosen in gather_input
    fi
    log "All checks passed"
}

# -- EFI partition (internal drives only) --------------------
# locate_efi : the EFI System Partition on an internal drive - sets EFI_PART,
# EFI_DRIVE and EFI_PART_NUM, or returns 1 when there is none.
locate_efi() {
    local dev parent drive partnum
    # Primary: match EFI System Partition GUID, skip USB drives
    while IFS= read -r dev; do
        [[ -b "$dev" ]] || continue
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        if [[ -n "$parent" ]] && is_removable "/dev/$parent"; then
            continue
        fi
        EFI_PART="$dev"
        break
    done < <(blkid -t PART_ENTRY_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" \
                   -o device 2>/dev/null)

    # Fallback: find FAT32 partition with esp flag on internal drives
    if [[ -z "$EFI_PART" ]]; then
        while IFS= read -r drive; do
            [[ -b "$drive" ]] || continue
            is_removable "$drive" && continue
            partnum=$(parted -m "$drive" print 2>/dev/null \
                | awk -F: '$7 ~ /esp/ || $7 ~ /boot/ {print $1; exit}')
            if [[ -n "$partnum" ]]; then
                EFI_PART=$(part_path "$drive" "$partnum")
                break
            fi
        done < <(lsblk -dn -o PATH 2>/dev/null)
    fi

    [[ -n "$EFI_PART" && -b "$EFI_PART" ]] || return 1
    EFI_DRIVE="/dev/$(lsblk -no PKNAME "$EFI_PART" 2>/dev/null)"
    EFI_PART_NUM=$(part_number "$EFI_PART")
}

detect_efi() {
    hr "EFI Partition Detection"
    info "Detecting EFI System Partition..."
    locate_efi || err "Could not find EFI System Partition on any internal drive."

    local efi_size efi_bytes answer
    efi_size=$(lsblk -no SIZE "$EFI_PART" 2>/dev/null)
    log "EFI partition : $EFI_PART  (${efi_size:-?})"
    log "EFI drive     : $EFI_DRIVE  (partition $EFI_PART_NUM)"

    # Warn if EFI partition is small - kernels + initramfs need ~150 MiB
    efi_bytes=$(lsblk -bno SIZE "$EFI_PART" 2>/dev/null | head -1 | tr -d '[:space:]')
    if (( ${efi_bytes:-0} < 209715200 )); then   # < 200 MiB
        warn "EFI partition is only ${efi_size:-?} - this may be too small"
        warn "for Linux kernels + initramfs. Consider resizing it first."
        $GUI_MODE && return 0       # the GUI showed this warning already
        ask "Continue anyway? (y/N):"
        read -rp "  > " answer
        [[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
    fi
}

# -- Where NiiX goes in dual-boot: free space or a deleted partition --
# list_free_regions : free space of NIIX_MIN_GIB or more on internal disks,
# one per line: DRIVE|START_MIB|END_MIB|SIZE_GIB|MODEL
list_free_regions() {
    local drive model
    while IFS= read -r drive; do
        model=$(lsblk -dn -o MODEL "$drive" 2>/dev/null)
        # parted can hang on odd drives - never for more than 5 seconds
        timeout 5 parted -m "$drive" unit MiB print free 2>/dev/null \
            | awk -F: -v drive="$drive" -v model="${model:-Unknown}" -v min=$(( NIIX_MIN_GIB * 1024 )) '
                $NF ~ /free/ {
                    start = $2; end = $3
                    sub(/MiB/, "", start); sub(/MiB/, "", end)
                    if (end - start >= min)
                        printf "%s|%.0f|%.0f|%.1f|%s\n", drive, start, end, (end - start) / 1024, model
                }'
    done < <(internal_disks)
}

# list_deletable_partitions : partitions that may be deleted to make room
# (never EFI, Windows, MSR or recovery), one per line: PATH|SIZE|LABEL|DRIVE
list_deletable_partitions() {
    local -a disks
    mapfile -t disks < <(internal_disks)
    (( ${#disks[@]} )) || return 0
    lsblk -J -b -o PATH,SIZE,FSTYPE,PARTTYPE,TYPE "${disks[@]}" 2>/dev/null \
        | NIIX_MIN_GIB=$NIIX_MIN_GIB python3 -c '
import json, os, sys

MIN_BYTES = int(os.environ["NIIX_MIN_GIB"]) << 30
efi_part = sys.argv[1]
# EFI System, Microsoft Reserved, Windows Recovery
PROTECTED_TYPES = {"c12a7328-f81f-11d2-ba4b-00a0c93ec93b", "e3c9e316-0b5c-4db8-817d-f92df00215ae",
                   "de94bba4-06d1-4d40-a16a-bfd50179d6ac"}
PROTECTED_FS = {"ntfs", "vfat"}


def human(size):
    return f"{size / 2**40:.1f}T" if size >= 2**40 else f"{size / 2**30:.0f}G"


for disk in json.load(sys.stdin).get("blockdevices", []):
    for part in disk.get("children") or []:
        fstype = (part.get("fstype") or "").lower()
        if (part.get("type") != "part" or part["path"] == efi_part
                or (part.get("parttype") or "").lower() in PROTECTED_TYPES
                or fstype in PROTECTED_FS or (part.get("size") or 0) < MIN_BYTES):
            continue
        print("|".join((part["path"], human(part["size"]), fstype or "unknown", disk["path"])))
' "$EFI_PART"
}

# use_region LINE : install into this free-space region (a list_free_regions line)
use_region() {
    local gib model
    IFS='|' read -r TARGET_DRIVE FREE_START FREE_END gib model <<< "$1"
    log "Selected: $TARGET_DRIVE  (~${gib} GiB)  [$model]"
}

# delete_partition LINE : delete this partition (a list_deletable_partitions
# line) and install into the free space it leaves.
delete_partition() {
    local part size label drive num mapper_name free_region gib
    IFS='|' read -r part size label drive <<< "$1"
    num=$(part_number "$part")
    [[ -n "$num" ]] || err "Could not determine partition number for $part"

    # Close a LUKS container that is open on it, and unmount it
    if blkid -o value -s TYPE "$part" 2>/dev/null | grep -q "crypto_LUKS"; then
        mapper_name=$(lsblk -lno NAME,TYPE "$part" 2>/dev/null | awk '$2 == "crypt" {print $1}')
        if [[ -n "$mapper_name" ]]; then
            info "Closing LUKS container /dev/mapper/$mapper_name..."
            cryptsetup close "$mapper_name" 2>/dev/null || true
        fi
    fi
    umount "$part" 2>/dev/null || true

    info "Deleting partition $part (partition $num on $drive)..."
    parted -s "$drive" rm "$num" || err "Could not delete $part"
    partprobe "$drive"
    sleep 2
    log "Partition deleted"

    # Use the largest free region the drive now has
    info "Scanning $drive for freed space..."
    free_region=$(parted -m "$drive" unit MiB print free 2>/dev/null \
        | awk -F: '$NF ~ /free/ {
            start = $2; end = $3;
            gsub(/MiB/, "", start); gsub(/MiB/, "", end);
            size = end - start;
            if (size > max) { max = size; best_start = start; best_end = end }
        } END { if (max > 0) printf "%s|%s|%s", best_start, best_end, max/1024 }')
    [[ -n "$free_region" ]] || err "Could not find free space on $drive after deletion"
    IFS='|' read -r FREE_START FREE_END gib <<< "$free_region"
    TARGET_DRIVE=$drive
    log "Using freed space: $TARGET_DRIVE  (~${gib%.*} GiB)"
}

detect_free_spaces() {
    hr "Free Space / Partition Selection"
    info "Scanning internal drives for free space (${NIIX_MIN_GIB} GiB or more)..."
    echo

    local -a regions parts
    local line i choice path size label drive confirm gib model
    mapfile -t regions < <(list_free_regions)

    if $GUI_MODE; then
        if [[ -n "${ANS[TARGET_REGION]:-}" ]]; then
            for line in "${regions[@]}"; do
                [[ "$line" == "${ANS[TARGET_REGION]}|"* ]] && { use_region "$line"; return; }
            done
            err "The chosen free space is no longer there - start the installer again."
        fi
        mapfile -t parts < <(list_deletable_partitions)
        for line in "${parts[@]}"; do
            [[ "${line%%|*}" == "${ANS[DELETE_PART]:-}" ]] && { delete_partition "$line"; return; }
        done
        err "The partition chosen for deletion is no longer there - start the installer again."
    fi

    if (( ${#regions[@]} )); then
        echo -e "  ${WHITE}${BOLD}Available free space regions:${NC}"
        echo
        for i in "${!regions[@]}"; do
            IFS='|' read -r drive _ _ gib model <<< "${regions[i]}"
            printf "  ${CYAN}[%s]${NC}  %-16s  %6.1f GiB  (%s)\n" "$i" "$drive" "$gib" "$model"
        done
        echo
        ask "Which free space should NiiX use? Enter the number:"
        read -rp "  > " choice
        [[ "$choice" =~ ^[0-9]+$ && -n "${regions[choice]:-}" ]] || err "Invalid choice: $choice"
        use_region "${regions[choice]}"
        return
    fi

    # -- No free space found - offer partition deletion ------
    warn "No free space of ${NIIX_MIN_GIB} GiB or more found on any internal drive."
    info "You can delete an existing partition to make room."
    echo
    echo -e "  ${RED}${BOLD}  Protected partitions (will NOT be listed):${NC}"
    echo -e "    - EFI System Partition"
    echo -e "    - Windows / NTFS partitions"
    echo -e "    - Microsoft Reserved (MSR)"
    echo -e "    - Recovery partitions"
    echo

    mapfile -t parts < <(list_deletable_partitions)
    (( ${#parts[@]} )) \
        || err "No deletable partitions found.\nShrink a Windows volume in Disk Management first, then re-run."

    echo -e "  ${WHITE}${BOLD}Deletable partitions:${NC}"
    echo
    for i in "${!parts[@]}"; do
        IFS='|' read -r path size label drive <<< "${parts[i]}"
        printf "  ${CYAN}[%s]${NC}  %-16s  %8s  (%s)\n" "$i" "$path" "$size" "$label"
    done
    echo
    echo -e "  ${RED}${BOLD}WARNING: The selected partition will be PERMANENTLY DELETED.${NC}"
    ask "Which partition should be deleted for NiiX? Enter the number:"
    read -rp "  > " choice
    [[ "$choice" =~ ^[0-9]+$ && -n "${parts[choice]:-}" ]] || err "Invalid choice: $choice"
    IFS='|' read -r path size label drive <<< "${parts[choice]}"

    echo
    echo -e "  ${RED}${BOLD}You are about to DELETE:  $path  ($size, $label)${NC}"
    echo -e "  ${RED}${BOLD}This CANNOT be undone.${NC}"
    echo
    ask "Type  DELETE  (uppercase) to confirm:"
    read -rp "  > " confirm
    [[ "$confirm" == "DELETE" ]] || { echo "Aborted. Nothing was changed."; exit 0; }
    delete_partition "${parts[choice]}"
}

# -- Questions (text mode) -----------------------------------
# Prints pre-formatted entries in columns, filled top-to-bottom so an
# alphabetical list reads naturally down each column.
_columns() {
    local width=$1; shift
    printf '%s\n' "$@" | awk -v W="$width" '
        { item[NR] = $0; if (length($0) > m) m = length($0) }
        END {
            if (NR == 0) exit
            cw = m + 3; cols = int((W - 2) / cw); if (cols < 1) cols = 1
            rows = int((NR + cols - 1) / cols)
            for (r = 1; r <= rows; r++) {
                line = "  "
                for (c = 0; c < cols; c++) {
                    i = r + c * rows
                    if (i <= NR) line = line sprintf("%-" cw "s", item[i])
                }
                sub(/ +$/, "", line); print line
            }
        }'
}

# _pick TITLE ENTER_LABEL ITEM...
# Numbered picker that always fits the screen: long lists are paged (n/p),
# and typing 2+ letters searches. Numbers never change while paging or
# searching, so what you type is what you saw.
# Result in PICK: 1..N = that item, 0 = Enter, -1 = typed text containing "/"
# (left in PICK_TEXT for callers that accept a full name).
_pick() {
    local title=$1 enter_label=$2; shift 2
    local -a items=("$@") view=()
    local n=$# width height d i maxlen cols rows per pages page=0 filter="" input
    width=$(tput cols 2>/dev/null) || width=0
    [[ "$width" =~ ^[0-9]+$ ]] && (( width >= 40 )) || width=80
    height=$(tput lines 2>/dev/null) || height=0
    [[ "$height" =~ ^[0-9]+$ ]] && (( height >= 12 )) || height=24
    d=${#n}
    PICK=0; PICK_TEXT=""
    while true; do
        view=(); maxlen=0
        for (( i = 1; i <= n; i++ )); do
            if [[ -z "$filter" || "${items[i-1],,}" == *"${filter,,}"* ]]; then
                view+=("$(printf "[%${d}d] %s" "$i" "${items[i-1]}")")
                (( ${#view[-1]} > maxlen )) && maxlen=${#view[-1]}
            fi
        done
        cols=$(( (width - 2) / (maxlen + 3) )); (( cols >= 1 )) || cols=1
        rows=$(( height - 8 )); (( rows >= 4 )) || rows=4
        per=$(( cols * rows ))
        pages=$(( (${#view[@]} + per - 1) / per ))
        (( page >= pages )) && page=$(( pages - 1 ))
        (( page < 0 )) && page=0

        echo
        echo -e "  ${WHITE}${BOLD}${title}${NC}${filter:+  (search: $filter)}$( (( pages > 1 )) && echo "  - page $(( page + 1 ))/$pages")"
        echo
        _columns "$width" "${view[@]:page*per:per}"
        echo
        local hint="number"
        (( pages > 1 )) && hint+=", n/p = next/previous page"
        hint+=", letters = search"
        [[ -n "$filter" ]] && hint+=", Enter = clear search" || hint+=", Enter = $enter_label"
        read -rp "  Choose ($hint): " input
        input=${input#"${input%%[![:space:]]*}"}; input=${input%"${input##*[![:space:]]}"}

        if [[ -z "$input" ]]; then
            if [[ -n "$filter" ]]; then filter=""; page=0; continue; fi
            PICK=0; return
        elif [[ "$input" =~ ^[0-9]+$ ]]; then
            if (( input >= 1 && input <= n )); then PICK=$input; return; fi
            warn "Please type a number from 1 to $n."
        elif [[ "$input" == n || "$input" == N ]]; then
            (( page + 1 < pages )) && page=$(( page + 1 ))
        elif [[ "$input" == p || "$input" == P ]]; then
            (( page > 0 )) && page=$(( page - 1 ))
        elif [[ "$input" == */* ]]; then
            PICK=-1; PICK_TEXT=$input; return
        elif (( ${#input} < 2 )); then
            warn "Type at least 2 letters to search."
        else
            local hit=0
            for (( i = 0; i < n; i++ )); do
                [[ "${items[i],,}" == *"${input,,}"* ]] && { hit=1; break; }
            done
            if (( hit )); then filter=$input; page=0; else warn "Nothing matches '$input'."; fi
        fi
    done
}

# on_console : 0 on a text console (Ctrl+Alt+F3), 1 in a desktop terminal.
on_console() {
    [[ "$(tty 2>/dev/null)" == /dev/tty[0-9]* ]]
}

# match_desktop_layout LAYOUT[+VARIANT] : switch the live desktop's keyboard,
# so the passwords typed in this installer are the same keystrokes the
# disk-unlock prompt will expect at boot.
match_desktop_layout() {
    local source=$1 user=${SUDO_USER:-} uid
    [[ -n "$user" && "$user" != root ]] || return 0
    uid=$(id -u "$user") || return 0
    if runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            gsettings set org.gnome.desktop.input-sources sources "[('xkb', '$source')]" 2>/dev/null; then
        info "Desktop keyboard switched to '$source' - type your passwords with it"
    fi
}

# keyboard_table : NAME|CONSOLE_KEYMAPS|XKB_LAYOUTS|XKB_VARIANTS, one per line.
# Console names are Arch kbd names; several candidates are tried in order.
keyboard_table() {
    cat <<'KBEOF'
Belgian|be-latin1|be|
Brazilian (ABNT2)|br-abnt2|br|
Bulgarian (+ English)|us|us,bg|
Canadian French|cf|ca|
Canadian Multilingual|cf|ca|multix
Croatian|croat|hr|
Czech|cz-qwertz cz|cz|
Danish|dk-latin1|dk|
Dutch|nl|nl|
English (UK)|uk|gb|
English (US)|us|us|
English (US, Colemak)|colemak|us|colemak
English (US, Dvorak)|dvorak|us|dvorak
English (US, International)|us-acentos|us|intl
Estonian|et|ee|
Finnish|fi|fi|
French|fr-latin1|fr|
French (Bepo)|fr-bepo-latin9|fr|bepo
French (Swiss)|fr_CH-latin1|ch|fr
German|de-latin1|de|
German (Austria)|de-latin1|at|
German (Neo 2)|neo|de|neo
German (Swiss)|de_CH-latin1|ch|
Greek (+ English)|us|us,gr|
Hungarian|hu|hu|
Icelandic|is-latin1|is|
Irish|uk|ie|
Italian|it|it|
Japanese (106)|jp106|jp|
Latin American|la-latin1|latam|
Latvian|lv|lv|
Lithuanian|lt|lt|
Norwegian|no-latin1|no|
Polish|pl2|pl|
Portuguese|pt-latin1|pt|
Romanian|ro|ro|
Russian (+ English)|us|us,ru|
Serbian (Latin)|sr-latin|rs|latin
Slovak|sk-qwertz|sk|
Slovenian|slovene|si|
Spanish|es|es|
Swedish|sv-latin1|se|
Turkish (F)|trf|tr|f
Turkish (Q)|trq|tr|
Ukrainian (+ English)|us|us,ua|
KBEOF
}

# load_keyboards : fills KB_NAME, KB_XKB, KB_VAR and KB_KM (the console keymap
# this ISO really ships for each layout, empty when it has none).
load_keyboards() {
    local name cons xkb var cand available
    KB_NAME=(); KB_XKB=(); KB_VAR=(); KB_KM=()
    available=$(localectl list-keymaps --no-pager 2>/dev/null)
    while IFS='|' read -r name cons xkb var; do
        [[ -n "$name" ]] || continue
        KB_NAME+=("$name"); KB_XKB+=("$xkb"); KB_VAR+=("$var")
        local km=""
        for cand in $cons; do
            if [[ -z "$available" ]] || grep -qxF "$cand" <<< "$available"; then
                km=$cand
                break
            fi
        done
        KB_KM+=("$km")
    done < <(keyboard_table)
}

# typing_layout IDX : the desktop layout whose keystrokes match what the
# disk-unlock prompt expects at boot (US when the console stays US).
typing_layout() {
    local km=${KB_KM[$1]:-us} xkb=${KB_XKB[$1]%%,*} var=${KB_VAR[$1]%%,*}
    if [[ "$km" == us ]]; then
        printf 'us'
    else
        printf '%s%s' "$xkb" "${var:++$var}"
    fi
}

# apply_keyboard IDX : use this layout for the console, the boot prompt and
# the installed desktop.
apply_keyboard() {
    local idx=$1 km=${KB_KM[$1]}
    # On a text console loadkeys is the final word: it is exactly what the
    # boot prompt will use. From a desktop terminal there is no console to
    # load it into - the check against the ISO's keymaps has to do.
    if [[ -z "$km" ]] || { on_console && ! loadkeys "$km" >/dev/null 2>&1; }; then
        warn "The console keymap for '${KB_NAME[$idx]}' is not available on this ISO."
        warn "The console and disk-unlock prompt will use US English; the desktop still gets ${KB_NAME[$idx]}."
        KB_KM[idx]=us
        km=us
        on_console && loadkeys us >/dev/null 2>&1
    fi
    # In a desktop terminal, switch the desktop too so the passwords typed
    # here match the boot prompt. (The GUI does this itself, earlier.)
    on_console || $GUI_MODE || match_desktop_layout "$(typing_layout "$idx")"

    KEYBOARD_NAME=${KB_NAME[$idx]}
    KEYMAP=$km
    KEYMAP_X11=${KB_XKB[$idx]}
    KEYMAP_X11_VARIANT=${KB_VAR[$idx]}
    log "Keyboard: $KEYBOARD_NAME (console: $KEYMAP, desktop: $KEYMAP_X11${KEYMAP_X11_VARIANT:+ / $KEYMAP_X11_VARIANT})"
}

# Keyboard: console keymap (TTY + the disk-unlock prompt at boot) and desktop
# layout are chosen together, because the LUKS passphrase is typed on the
# console keymap both now and at every boot - they must never differ.
choose_keyboard() {
    local i def=0
    load_keyboards
    for i in "${!KB_NAME[@]}"; do
        [[ "${KB_NAME[i]}" == "English (US)" ]] && def=$(( i + 1 ))
    done
    echo -e "  ${DIM}Layouts marked (+ English) keep US English for the console and the disk${NC}"
    echo -e "  ${DIM}unlock prompt; on the desktop switch between both with Super+Space.${NC}"
    while true; do
        _pick "Keyboard Layout" "English (US)" "${KB_NAME[@]}"
        (( PICK == 0 )) && { apply_keyboard $(( def - 1 )); return; }
        (( PICK > 0 )) && { apply_keyboard $(( PICK - 1 )); return; }
        warn "Please choose a number from the list."
    done
}

# Timezone: pick a region, then a city - both numbered and alphabetical. A
# full name like Europe/Paris can be typed at either prompt. The list comes
# from the ISO itself, so it is always complete and valid.
choose_timezone() {
    local -a all=() regions=() zones=() labels=()
    local default="Europe/Zurich" region z
    mapfile -t all < <(timedatectl list-timezones --no-pager 2>/dev/null)
    if (( ${#all[@]} == 0 )) && [[ -r /usr/share/zoneinfo/tzdata.zi ]]; then
        mapfile -t all < <(awk '$1 == "Z" || $1 == "L" { print ($1 == "Z" ? $2 : $3) }' \
            /usr/share/zoneinfo/tzdata.zi | sort -u)
    fi
    if (( ${#all[@]} == 0 )); then
        # Last resort: typed entry, validated against the zoneinfo files.
        while true; do
            ask "Timezone (press Enter for $default):"
            read -rp "  > " TIMEZONE
            TIMEZONE=${TIMEZONE:-$default}
            [[ "$TIMEZONE" != *..* && -f "/usr/share/zoneinfo/$TIMEZONE" ]] && break
            warn "Unknown timezone '$TIMEZONE' - try again (e.g. Europe/Zurich)."
        done
        log "Timezone: $TIMEZONE"
        return
    fi

    # Only the ten real regions; legacy alias folders (US/, Canada/, Brazil/ ...)
    # just duplicate America/*, and can still be typed as a full name.
    mapfile -t regions < <(printf '%s\n' "${all[@]}" | awk -F/ '
        NF > 1 && $1 ~ /^(Africa|America|Antarctica|Arctic|Asia|Atlantic|Australia|Europe|Indian|Pacific)$/ { print $1 }' | sort -u)
    regions+=("UTC")

    while true; do
        TIMEZONE=""
        _pick "Timezone - region" "$default" "${regions[@]}"
        if (( PICK == 0 )); then
            TIMEZONE=$default
        elif (( PICK == -1 )); then
            if printf '%s\n' "${all[@]}" | grep -qxF -- "$PICK_TEXT"; then
                TIMEZONE=$PICK_TEXT
            else
                warn "Unknown timezone '$PICK_TEXT'."; continue
            fi
        else
            region=${regions[PICK-1]}
            if [[ "$region" == "UTC" ]]; then
                TIMEZONE=UTC
            else
                mapfile -t zones < <(printf '%s\n' "${all[@]}" | grep "^${region}/" | sort)
                labels=()
                for z in "${zones[@]}"; do
                    z=${z#"$region"/}
                    labels+=("${z//_/ }")
                done
                _pick "Timezone - $region" "back to regions" "${labels[@]}"
                (( PICK > 0 )) || continue
                TIMEZONE=${zones[PICK-1]}
            fi
        fi
        # It must exist as a zone file: /etc/localtime is symlinked to it.
        [[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] && break
        warn "'$TIMEZONE' has no zone file on this ISO - please pick another."
    done
    log "Timezone: $TIMEZONE"
}

# hostname_problem NAME / username_problem NAME : print what is wrong with
# it (and return 1), or nothing.
hostname_problem() {
    [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] && return 0
    echo "Use only letters, digits and hyphens (not at the start or end), at most 63 characters."
    return 1
}

username_problem() {
    if [[ -z "$1" ]]; then
        echo "The username cannot be empty."
    elif [[ ! "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
        echo "Start with a lowercase letter or underscore; use only lowercase letters, digits, - and _."
    else
        # Names taken by the base system or created later by packages (gdm,
        # polkitd, ...) - caught before the disk is touched, not at useradd.
        case "$1" in
            root|bin|daemon|mail|ftp|http|nobody|dbus|polkitd|rtkit|gdm|colord|\
            avahi|geoclue|usbmux|flatpak|git|dnsmasq|saned|tss|uuidd|alpm|ntp|\
            cups|lp|games|kvm|render|video|audio|input|wheel|users|storage|\
            optical|adm|log|utmp|tty|disk|floppy|scanner|rfkill|sgx|\
            systemd-*|nm-*)
                echo "'$1' is reserved by the system - please choose another." ;;
            *)
                if getent passwd "$1" >/dev/null 2>&1 || getent group "$1" >/dev/null 2>&1; then
                    echo "'$1' is already a system account - please choose another."
                else
                    return 0
                fi ;;
        esac
    fi
    return 1
}

# The GUI's answers, checked with the same rules as the questions below.
apply_answers() {
    local i problem
    load_keyboards
    for i in "${!KB_NAME[@]}"; do
        [[ "${KB_NAME[i]}" == "${ANS[KEYBOARD]:-}" ]] && { apply_keyboard "$i"; break; }
    done
    [[ -n "$KEYBOARD_NAME" && "$KEYBOARD_NAME" == "${ANS[KEYBOARD]:-}" ]] \
        || err "Unknown keyboard layout: '${ANS[KEYBOARD]:-}'"

    HOSTNAME=${ANS[HOSTNAME]:-niixarch}
    problem=$(hostname_problem "$HOSTNAME") || err "Computer name: $problem"
    USERNAME=${ANS[USERNAME]:-}
    problem=$(username_problem "$USERNAME") || err "Username: $problem"
    USER_PASS=${ANS[USER_PASS]:-}
    [[ -n "$USER_PASS" ]] || err "The password cannot be empty."
    LUKS_PASS=${ANS[LUKS_PASS]:-}
    (( ${#LUKS_PASS} >= 8 )) || err "The disk password must be at least 8 characters."
    TIMEZONE=${ANS[TIMEZONE]:-}
    [[ "$TIMEZONE" != *..* && -f "/usr/share/zoneinfo/$TIMEZONE" ]] || err "Unknown timezone: '$TIMEZONE'"
    case "${ANS[MITIGATIONS]:-}" in
        off) USE_MITIGATIONS=false ;;
        on)  USE_MITIGATIONS=true ;;
        *)   err "CPU mitigations must be 'on' or 'off'." ;;
    esac
    HOTSPOT_SSID=${ANS[HOTSPOT_SSID]:-}
    HOTSPOT_PASS=${ANS[HOTSPOT_PASS]:-}
    if [[ -n "$HOTSPOT_SSID" || -n "$HOTSPOT_PASS" ]]; then
        problem=$(hotspot_problem "$HOTSPOT_SSID" "$HOTSPOT_PASS") || err "Hotspot: $problem"
    fi
    log "Keyboard $KEYBOARD_NAME, timezone $TIMEZONE, user $USERNAME, mitigations ${ANS[MITIGATIONS]}"
    [[ -n "$HOTSPOT_SSID" ]] && log "Wi-Fi hotspot: '$HOTSPOT_SSID'"
}

# hotspot_problem SSID PASSWORD : why the hotspot settings can't be used (and
# non-zero), or nothing. Names stay plain so NetworkManager's profile file
# and every phone show them the same; WPA2 passwords are 8-63 ASCII characters.
hotspot_problem() (
    LC_ALL=C
    local name_re='^[A-Za-z0-9._-]([A-Za-z0-9 ._-]{0,30}[A-Za-z0-9._-])?$' pass_re='^[ -~]{8,63}$'
    if [[ ! "$1" =~ $name_re ]]; then
        echo "The name must be 1-32 letters, digits, spaces, dots, dashes or underscores (no space at the start or end)."
        return 1
    fi
    if [[ ! "$2" =~ $pass_re || "$2" == " "* || "$2" == *" " ]]; then
        echo "The password must be 8-63 characters (letters, digits and symbols - no space at the start or end)."
        return 1
    fi
)

# wifi_can_host : 0 when a Wi-Fi card here can run an access point.
wifi_can_host() {
    local net phy
    command -v iw &>/dev/null || return 1
    for net in /sys/class/net/*/phy80211; do
        [[ -e "$net" ]] || continue
        phy=$(basename "$(readlink -f "$net")")
        iw phy "$phy" info 2>/dev/null | awk '
            /Supported interface modes:/ { modes = 1; next }
            modes && /^\t\t \* / { if ($2 == "AP") found = 1; next }
            modes { modes = 0 }
            END { exit !found }' && return 0
    done
    return 1
}

random_password() {
    local p
    p=$(tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 16) || true
    printf '%s' "$p"
}

gather_input() {
    local pass2 mit problem
    hr "Installation Config"
    if $GUI_MODE; then
        apply_answers
        return
    fi
    echo -e "  ${WHITE}${BOLD}Configure your NiiX Arch install:${NC}"
    echo

    # -- Keyboard layout --------------------------------------
    # Chosen first and applied to the live ISO immediately, so the passwords
    # below are typed on the same layout the boot-time unlock prompt uses.
    choose_keyboard

    while true; do
        ask "Hostname (e.g. archbox, press Enter for 'niixarch'):"
        read -rp "  > " HOSTNAME
        HOSTNAME=${HOSTNAME:-niixarch}
        problem=$(hostname_problem "$HOSTNAME") && break
        warn "Invalid hostname '$HOSTNAME': $problem"
    done

    while true; do
        ask "Username:"
        read -rp "  > " USERNAME
        problem=$(username_problem "$USERNAME") && break
        warn "$problem"
    done

    echo
    while true; do
        ask "User & root password:"
        read -rsp "  > " USER_PASS; echo
        if [[ -z "$USER_PASS" ]]; then
            warn "Password cannot be empty - please try again."
            continue
        fi
        ask "Confirm password:"
        read -rsp "  > " pass2; echo
        if [[ "$USER_PASS" != "$pass2" ]]; then
            warn "Passwords do not match - please try again."
        else
            break
        fi
    done

    echo
    warn "Disk password (LUKS) - typed every time NiiX starts:"
    while true; do
        ask "LUKS passphrase:"
        read -rsp "  > " LUKS_PASS; echo
        if [[ ${#LUKS_PASS} -lt 8 ]]; then
            warn "LUKS passphrase must be at least 8 characters - it is the only thing protecting the disk."
            continue
        fi
        ask "Confirm LUKS passphrase:"
        read -rsp "  > " pass2; echo
        if [[ "$LUKS_PASS" != "$pass2" ]]; then
            warn "LUKS passphrases do not match - please try again."
        else
            break
        fi
    done

    choose_timezone

    echo
    echo -e "  ${WHITE}${BOLD}CPU Vulnerability Mitigations${NC}"
    echo -e "  ${DIM}Disabling gives ~5-10% more FPS but reduces side-channel protection.${NC}"
    echo -e "  ${GREEN}[1]${NC}  ${WHITE}OFF${NC}  - Max performance  (mitigations=off)"
    echo -e "  ${GREEN}[2]${NC}  ${WHITE}ON${NC}   - Keep protections  (safer for banking/crypto)"
    while true; do
        read -rp "  Choose [1/2]: " mit
        case "$mit" in
            1) USE_MITIGATIONS=false; log "Mitigations: OFF"; break ;;
            2) USE_MITIGATIONS=true;  log "Mitigations: ON";  break ;;
            *) warn "Please type 1 or 2 - there is no silent default for a security setting." ;;
        esac
    done

    if wifi_can_host; then
        local yn
        echo
        echo -e "  ${WHITE}${BOLD}Wi-Fi hotspot${NC}"
        echo -e "  ${DIM}Shares this computer's internet with phones and other devices - it comes on by itself whenever this computer is online.${NC}"
        read -rp "  Set up a hotspot? [y/N]: " yn
        if [[ "$yn" == [yY]* ]]; then
            while true; do
                ask "Hotspot name (Enter for 'NiiX Arch'):"
                read -rp "  > " HOTSPOT_SSID
                HOTSPOT_SSID=${HOTSPOT_SSID:-NiiX Arch}
                ask "Hotspot password (8-63 characters, Enter for a random one):"
                read -rp "  > " HOTSPOT_PASS
                if [[ -z "$HOTSPOT_PASS" ]]; then
                    HOTSPOT_PASS=$(random_password)
                    info "Hotspot password: $HOTSPOT_PASS  (show it again later: niix-hotspot password)"
                fi
                problem=$(hotspot_problem "$HOTSPOT_SSID" "$HOTSPOT_PASS") && break
                warn "$problem"
            done
        fi
    fi
}

# -- Summary --------------------------------------------------
confirm() {
    hr "Summary & Confirmation"
    echo -e "  ${WHITE}${BOLD}Review carefully before continuing:${NC}"
    echo
    echo -e "  ${PINK}-- Hardware --------------------------------------${NC}"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "CPU:"  "$CPU_MODEL ($CPU_VENDOR)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "GPU:"  "${GPU_MODEL:-not detected}${GPU_VENDOR:+ ($GPU_VENDOR)}"
    if [[ "$IS_HYBRID" == true ]]; then
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "" "most powerful of $GPU_COUNT GPUs - used for the desktop, apps and games"
    fi
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Machine:"  "$(machine_description)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Displays:"  "native resolution, highest refresh rate, VRR where supported"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Controllers:"  "Xbox, PlayStation, Switch, 8BitDo... - also work as a mouse"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "RAM:"  "~${MEM_TOTAL_GB}GB"
    echo
    echo -e "  ${PINK}-- Install mode ----------------------------------${NC}"
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Mode:"            "Dual-boot  (Windows preserved)"
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "EFI (/boot):"     "$EFI_PART  (reused, NOT reformatted)"
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "New partition:"   "$TARGET_DRIVE  (free space)"
    else
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Mode:"            "Single-boot  (NiiX only)"
        printf "  ${RED}x${NC}  %-22s ${RED}%s${NC}\n"   "WIPE target:"     "$SINGLE_DRIVE  - ENTIRE DRIVE WIPED"
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "EFI partition:"   "512 MiB  (new, created on $SINGLE_DRIVE)"
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Root partition:"  "Remaining space on $SINGLE_DRIVE"
    fi
    echo
    echo -e "  ${PINK}-- Configuration ---------------------------------${NC}"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Bootloader:"    "Limine (UEFI)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Keyboard:"      "$KEYBOARD_NAME  (console: $KEYMAP)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Kernel:"        "linux-cachyos"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Encryption:"    "LUKS2"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Filesystem:"    "Btrfs  -  @  @home  @snapshots  @var_log"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Swap:"          "ZRAM (zstd, sized from RAM)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Hostname:"      "$HOSTNAME"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Username:"      "$USERNAME"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Desktop:"       "GNOME"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Mitigations:"   "$([ "$USE_MITIGATIONS" = true ] && echo ON || echo OFF)"
    echo
    echo -e "  ${PINK}-- Security trade-offs you are accepting -------${NC}"
    printf "  ${YELLOW}!${NC}  %-22s ${WHITE}%s${NC}\n" "Auto-login:" "ON - after the LUKS passphrase, the desktop opens as"
    printf "  ${YELLOW} ${NC}  %-22s ${WHITE}%s${NC}\n" "" "'$USERNAME' (sudo-capable) with no second password"
    if [[ "$USE_MITIGATIONS" == false ]]; then
        printf "  ${YELLOW}!${NC}  %-22s ${WHITE}%s${NC}\n" "CPU mitigations:" "OFF - side-channel protections disabled for FPS"
    fi
    if [[ -n "$HOTSPOT_SSID" ]]; then
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Wi-Fi hotspot:" "'$HOTSPOT_SSID' - on whenever this computer is online"
    else
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Wi-Fi hotspot:" "off (set one up later: niix-hotspot start)"
    fi
    echo
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        warn "Only the selected free space will be touched - Windows is safe."
    else
        warn "ALL data on $SINGLE_DRIVE will be permanently destroyed."
        warn "This includes any OS, files, or partitions on that drive."
    fi
    echo
    $GUI_MODE && return 0
    echo -e "  ${RED}${BOLD}Type  YES  (uppercase) to begin - this cannot be undone:${NC}"
    local answer
    read -rp "  > " answer
    [[ "$answer" == "YES" ]] || { echo "  Aborted. Nothing was changed."; exit 0; }
}

# -- Disk: partition, encryption, file system ----------------
create_partition() {
    hr "Partition Creation"
    info "Creating partition on $TARGET_DRIVE..."

    local before new_name="" try
    before=$(lsblk -lno NAME "$TARGET_DRIVE" 2>/dev/null | sort)

    parted -s "$TARGET_DRIVE" mkpart primary "${FREE_START}MiB" "$(( ${FREE_END%.*} - 1 ))MiB" \
        || err "Failed to create partition on $TARGET_DRIVE"
    partprobe "$TARGET_DRIVE" 2>/dev/null || true

    # Wait for the kernel AND udev to publish the new node (up to ~10s)
    # instead of a fixed sleep that is too short on some controllers.
    for (( try = 0; try < 20; try++ )); do
        udevadm settle --timeout=5 2>/dev/null || true
        new_name=$(comm -13 <(printf '%s\n' "$before") \
                            <(lsblk -lno NAME "$TARGET_DRIVE" 2>/dev/null | sort) | head -1)
        [[ -n "$new_name" && -b "/dev/$new_name" ]] && break
        sleep 0.5
    done

    [[ -n "$new_name" ]] || err "Could not identify new partition. Run: lsblk $TARGET_DRIVE"
    LUKS_PART="/dev/$new_name"
    [[ -b "$LUKS_PART" ]] || err "New partition $LUKS_PART is not a block device"

    # Set Linux filesystem type GUID on GPT
    parted -s "$TARGET_DRIVE" type "$(part_number "$LUKS_PART")" \
        "0FC63DAF-8483-4772-8E79-3D69D8477DE4" 2>/dev/null \
        || true   # older parted may not support 'type'; harmless

    log "New partition: $LUKS_PART"
}

setup_luks() {
    hr "LUKS2 Encryption Setup"
    log "Formatting $LUKS_PART with LUKS2..."

    printf '%s' "$LUKS_PASS" | cryptsetup luksFormat \
        --batch-mode \
        --type luks2 \
        "$LUKS_PART" \
        --key-file=- \
        || err "cryptsetup luksFormat failed on $LUKS_PART"

    # Back up the header immediately - a corrupted LUKS header on an
    # otherwise-healthy disk is unrecoverable without one, and right after
    # formatting (before there's any real data at risk) is exactly when to
    # take it. Saved alongside the install log so it rides along on the same
    # USB copy offered at the end of the install (or on failure via err()).
    LUKS_HEADER_BACKUP="/root/niixarch-luks-header-backup.img"
    if cryptsetup luksHeaderBackup "$LUKS_PART" --header-backup-file "$LUKS_HEADER_BACKUP" 2>/dev/null; then
        chmod 600 "$LUKS_HEADER_BACKUP"
        log "LUKS header backed up to $LUKS_HEADER_BACKUP (copied to USB alongside the install log)"
        info "Keep that backup private: it opens the disk with THIS passphrase even after you"
        info "change it later. If the passphrase is ever exposed, change it AND delete the backup."
    else
        warn "Could not back up the LUKS header - you can run 'cryptsetup luksHeaderBackup' manually later"
    fi

    LUKS_UUID=$(blkid -s UUID -o value "$LUKS_PART")
    [[ -n "$LUKS_UUID" ]] || err "Could not read UUID from $LUKS_PART"
    log "LUKS2 UUID: $LUKS_UUID"

    log "Opening container as /dev/mapper/$MAPPER..."
    printf '%s' "$LUKS_PASS" | cryptsetup open \
        "$LUKS_PART" "$MAPPER" \
        --key-file=- \
        || err "cryptsetup open failed on $LUKS_PART"

    [[ -b "/dev/mapper/$MAPPER" ]] || err "Failed to open LUKS container"
    log "Container open at /dev/mapper/$MAPPER"
}

setup_btrfs() {
    hr "Btrfs Filesystem"
    log "Formatting /dev/mapper/$MAPPER as Btrfs..."
    mkfs.btrfs -f /dev/mapper/$MAPPER || err "mkfs.btrfs failed on /dev/mapper/$MAPPER"

    log "Creating subvolumes..."
    mount /dev/mapper/$MAPPER /mnt || err "Failed to mount /dev/mapper/$MAPPER"
    btrfs subvolume create /mnt/@          || err "Failed to create subvolume @"
    btrfs subvolume create /mnt/@home      || err "Failed to create subvolume @home"
    btrfs subvolume create /mnt/@snapshots || err "Failed to create subvolume @snapshots"
    btrfs subvolume create /mnt/@var_log   || err "Failed to create subvolume @var_log"
    umount /mnt || err "Failed to unmount /mnt after subvolume creation"

    log "Mounting subvolumes..."
    mount -o "${BTRFS_OPTS},subvol=@"          /dev/mapper/$MAPPER /mnt || err "Failed to mount @"
    mkdir -p /mnt/{boot,home,.snapshots,var/log}
    mount "$EFI_PART" /mnt/boot || err "Failed to mount EFI partition $EFI_PART"
    mount -o "${BTRFS_OPTS},subvol=@home"      /dev/mapper/$MAPPER /mnt/home       || err "Failed to mount @home"
    mount -o "${BTRFS_OPTS},subvol=@snapshots" /dev/mapper/$MAPPER /mnt/.snapshots || err "Failed to mount @snapshots"
    mount -o "${BTRFS_OPTS},subvol=@var_log"   /dev/mapper/$MAPPER /mnt/var/log    || err "Failed to mount @var_log"

    log "Btrfs mounted"
}

# esp_kernels DIR : the kernel and initramfs files at the root of the ESP
# mounted at DIR (stock and cachyos names alike).
esp_kernels() {
    local f
    for f in "$1"/vmlinuz-linux* "$1"/initramfs-linux*.img; do
        [[ -e "$f" ]] && printf '%s\n' "$f"
    done
}

# niix_owns_esp DIR : 0 when the Limine config on the ESP at DIR is NiiX's.
niix_owns_esp() {
    grep -qs 'NiiX Arch' "$1"/limine.conf "$1"/limine.cfg \
        "$1"/limine/limine.conf "$1"/limine/limine.cfg \
        "$1"/EFI/limine/limine.conf "$1"/EFI/limine/limine.cfg \
        "$1"/EFI/BOOT/limine.conf "$1"/EFI/BOOT/limine.cfg
}

# clean_efi : boot files and entries of earlier installs off the EFI
# partition - never Windows', and another system's only with consent.
clean_efi() {
    hr "EFI Partition Cleanup"
    info "Removing what earlier installs left on the EFI partition (Windows is never touched)..."

    # Kernels and initramfs (stock + cachyos) at the ESP root. A previous NiiX
    # install is recognised by its Limine branding and cleaned silently. Any
    # other Arch-family install that keeps its kernels at the ESP root (e.g.
    # another Limine-based distro in a triple-boot) would lose them - and this
    # install writes the same filenames anyway - so that case needs consent.
    local -a stale_kernels
    local f answer
    mapfile -t stale_kernels < <(esp_kernels /mnt/boot)
    if (( ${#stale_kernels[@]} )); then
        if niix_owns_esp /mnt/boot; then
            info "Removing kernels left by a previous NiiX install..."
        else
            warn "Found Linux kernel files on this EFI partition that do NOT belong to a previous NiiX install:"
            for f in "${stale_kernels[@]}"; do echo "    $f"; done
            warn "If another Linux install boots from these, it will stop booting (NiiX uses the same filenames)."
            if $GUI_MODE; then
                answer=${ANS[REPLACE_KERNELS]:-no}
            else
                ask "Delete them and continue? [y/N]:"
                read -rp "  > " answer
            fi
            [[ "$answer" =~ ^([Yy]|yes)$ ]] \
                || err "Aborted at your request - the other install's kernel files were left untouched."
        fi
        rm -f "${stale_kernels[@]}"
    fi

    # Limine's files: only Limine uses these paths.
    rm -rf /mnt/boot/limine
    rm -f  /mnt/boot/limine.cfg
    rm -f  /mnt/boot/limine.conf
    rm -rf /mnt/boot/EFI/limine

    # GRUB, systemd-boot and unified kernel images may belong to another
    # system that boots from this partition - removed only on request.
    local -a foreign=()
    local path
    for path in /mnt/boot/EFI/GRUB /mnt/boot/grub /mnt/boot/EFI/systemd /mnt/boot/loader /mnt/boot/EFI/Linux; do
        [ -e "$path" ] && foreign+=("$path")
    done
    if (( ${#foreign[@]} )); then
        warn "Found other bootloader files on this EFI partition (could be another Linux install sharing this drive):"
        printf '    %s\n' "${foreign[@]}"
        if $GUI_MODE; then
            log "Left other bootloader files untouched"
        else
            ask "Delete these too? Only say yes if you're sure they're stale NiiX/Arch leftovers, not another OS. [y/N]:"
            read -rp "  > " answer
            if [[ "$answer" =~ ^[Yy]$ ]]; then
                rm -rf "${foreign[@]}"
                log "Removed other bootloader files"
            else
                log "Left other bootloader files untouched"
            fi
        fi
    fi

    log "EFI partition cleaned"
    remove_boot_entries "limine|arch"
}

# remove_boot_entries REGEX : delete every UEFI boot entry whose label matches.
# Entries left by earlier installs point at partitions that no longer exist
# and shadow the new one in the boot order.
remove_boot_entries() {
    local bootnum
    while IFS= read -r bootnum; do
        efibootmgr -b "$bootnum" -B >/dev/null 2>&1 && log "Removed UEFI entry Boot${bootnum}"
    done < <(efibootmgr 2>/dev/null | grep -iE "$1" | grep -oP '^Boot\K[0-9A-Fa-f]{4}')
}

# timezone_country : the two-letter country of the chosen time zone (zone.tab
# maps every zone to one), or nothing for UTC and the like.
timezone_country() {
    awk -F'\t' -v tz="$TIMEZONE" '$3 == tz { print $1; exit }' /usr/share/zoneinfo/zone.tab 2>/dev/null
}

# -- Mirrors near the user ---------------------------------------
# Updates and drivers come from the fastest mirrors in the country of the
# chosen time zone; countries with few or no Arch mirrors use the fastest
# ones worldwide.
pick_mirrors() {
    local country servers=0 list=/etc/pacman.d/mirrorlist
    command -v reflector &>/dev/null \
        || { warn "reflector unavailable - using the ISO's mirrors"; return 0; }

    country=$(timezone_country)
    cp "$list" "$list.iso"
    if [[ -n "$country" ]]; then
        info "Finding the fastest mirrors in $country..."
        reflector --country "$country" --protocol https --age 24 --latest 10 \
            --sort rate --threads 4 --download-timeout 4 --connection-timeout 4 \
            --save "$list" 2>/dev/null
        servers=$(grep -c '^Server' "$list")
    fi
    if (( servers < 3 )); then
        info "Finding the fastest mirrors worldwide..."
        country=""
        reflector --protocol https --age 12 --latest 25 --fastest 10 \
            --threads 4 --download-timeout 4 --connection-timeout 4 \
            --save "$list" 2>/dev/null
        servers=$(grep -c '^Server' "$list")
    fi
    if (( servers > 0 )); then
        log "Mirrors: the $servers fastest${country:+ in $country}"
    else
        cp "$list.iso" "$list"
        warn "Mirror ranking failed - using the ISO's mirror list"
    fi
}

# -- What NiiX installs ---------------------------------------
# The package list the ISO is built from (an install copies the ISO, so this
# is what every NiiX system has):
#   name     a package from the repos (Arch + CachyOS)
#   ?name    only if the repos have it (Arch keeps dropping and re-adding
#            some lib32 packages)
#   @group   every package of the group...
#   !name    ...except these
niix_packages() {
    cat <<'NIIXPKGSEOF'
# Base system, kernel and boot
base
base-devel
linux-cachyos
linux-cachyos-headers
linux-firmware
amd-ucode
intel-ucode
limine
efibootmgr
cryptsetup
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
ntfsprogs
mtools
sudo
nano
git
