def compose(glyph, pink):
    color = PINK if pink else TEAL
    inner = GLYPHS.get(glyph, GLYPHS["app-window"])
    return (
'<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">'
+ AUTO_MARK +
'<rect x="14" y="14" width="228" height="228" rx="58" fill="%s" stroke="%s" stroke-width="2"/>'
'<g transform="translate(64,64) scale(5.3333)" fill="none" stroke="%s" stroke-width="1.6" '
'stroke-linecap="round" stroke-linejoin="round">%s</g></svg>\n'
) % (TILE_FILL, TILE_BORDER, color, inner)

def pick(primary, secondary):
    # Match the app's own icon-name + Name first; fall back to Categories.
    # This stops generic category words (e.g. "AudioVideo") from outranking
    # a more specific match on the application's actual name.
    for hay in (primary, secondary):
        for rx, glyph, pink in RULES:
            if re.search(rx, hay):
                return glyph, pink
    return "app-window", False

def read_desktops():
    seen = {}
    for d in DESKTOP_DIRS:
        for path in glob.glob(os.path.join(d, "*.desktop")):
            try:
                icon = name = cats = ""
                with open(path, encoding="utf-8", errors="ignore") as fh:
                    in_entry = False
                    for line in fh:
                        s = line.strip()
                        if s.startswith("["):
                            in_entry = (s == "[Desktop Entry]")
                            continue
                        if not in_entry:
                            continue
                        if s.startswith("Icon=") and not icon:
                            icon = s[5:].strip()
                        elif s.startswith("Name=") and not name:
                            name = s[5:].strip()
                        elif s.startswith("Categories=") and not cats:
                            cats = s[11:].strip()
                if icon and icon not in seen:
                    seen[icon] = (name, cats)
            except Exception:
                pass
    return seen

def is_auto(path):
    try:
        with open(path, encoding="utf-8", errors="ignore") as fh:
            return AUTO_MARK in fh.read(200)
    except Exception:
        return False

def main():
    args = sys.argv[1:]
    quiet = "--quiet" in args
    force = "--force" in args

    if "--list-glyphs" in args:
        print(" ".join(sorted(GLYPHS))); return
    if "--help" in args or "-h" in args:
        print(__doc__); return

    os.makedirs(THEME_DIR, exist_ok=True)

    if "--add" in args:
        i = args.index("--add")
        rest = [a for a in args[i+1:] if not a.startswith("-")]
        if len(rest) < 2:
            print("usage: niix-iconify --add NAME GLYPH [pink|teal]"); sys.exit(1)
        nm, gl = rest[0], rest[1]
        pink = len(rest) > 2 and rest[2].lower() == "pink"
        if not NAME_RE.match(nm):
            print("refused: unsafe icon name"); sys.exit(1)
        if gl not in GLYPHS:
            print("unknown glyph '%s' (see --list-glyphs)" % gl); sys.exit(1)
        open(os.path.join(THEME_DIR, nm + ".svg"), "w").write(compose(gl, pink))
        if not quiet: print("added %s -> %s" % (nm, gl))
        update_cache(); return

    desktops = read_desktops()
    referenced = set()
    added = 0
    for icon, (name, cats) in desktops.items():
        # skip absolute paths / names with slashes - those apps ship their own icon
        if "/" in icon or icon.startswith(".") or not NAME_RE.match(icon):
            continue
        referenced.add(icon)
        dest = os.path.join(THEME_DIR, icon + ".svg")
        if os.path.exists(dest):
            if not (force and is_auto(dest)):
                continue  # keep curated + existing
        glyph, pink = pick(" ".join((icon, name)).lower(), cats.lower())
        try:
            open(dest, "w").write(compose(glyph, pink))
            added += 1
            if not quiet:
                print("  + %-40s %s%s" % (icon, glyph, " (pink)" if pink else ""))
        except Exception as e:
            if not quiet: print("  ! %s: %s" % (icon, e))

    pruned = 0
    if "--prune" in args:
        for f in glob.glob(os.path.join(THEME_DIR, "*.svg")):
            nm = os.path.basename(f)[:-4]
            if nm not in referenced and is_auto(f):
                os.remove(f); pruned += 1
                if not quiet: print("  - %s (pruned)" % nm)

    if added or pruned:
        update_cache()
    if not quiet:
        print("niix-iconify: %d added, %d pruned (%d apps scanned)"
              % (added, pruned, len(referenced)))

def update_cache():
    try:
        subprocess.run(["gtk-update-icon-cache", "-f", "/usr/share/icons/NiiX"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except Exception:
        pass

if __name__ == "__main__":
    main()
NIIX_ICONIFY_EOF
    chmod +x /mnt/usr/local/bin/niix-iconify

    # pacman hook - fires on any package that ships a .desktop launcher
    mkdir -p /mnt/etc/pacman.d/hooks
    cat > /mnt/etc/pacman.d/hooks/niix-iconify.hook <<'HOOKEOF'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/applications/*.desktop
Target = usr/local/share/applications/*.desktop

[Action]
Description = Generating NiiX icons for new apps...
When = PostTransaction
Exec = /usr/local/bin/niix-iconify --quiet
HOOKEOF

    # systemd: run once at boot, and on flatpak/local-app changes
    cat > /mnt/etc/systemd/system/niix-iconify.service <<'SVCEOF'
[Unit]
Description=Generate NiiX flat icons for installed apps

[Service]
Type=oneshot
ExecStart=/usr/local/bin/niix-iconify --quiet

[Install]
WantedBy=multi-user.target
SVCEOF

    # Pre-create the watched directories - a systemd .path unit fails to start
    # if a watched path does not exist yet (flatpak only creates exports/ on
    # its first app install).
    mkdir -p /mnt/var/lib/flatpak/exports/share/applications \
             /mnt/usr/local/share/applications

    cat > /mnt/etc/systemd/system/niix-iconify.path <<'PATHEOF'
[Unit]
Description=Watch app directories for NiiX icon generation

[Path]
PathChanged=/var/lib/flatpak/exports/share/applications
PathChanged=/usr/local/share/applications
Unit=niix-iconify.service

[Install]
WantedBy=multi-user.target
PATHEOF

    arch-chroot /mnt systemctl enable niix-iconify.service niix-iconify.path 2>/dev/null || true
    log "Auto-iconify installed (pacman hook + boot/flatpak watchers)"
}

# -- GNOME desktop + branding ---------------------------------
install_desktop() {
    hr "GNOME + Branding"
    log "Installing GNOME (minimal - no gnome-extra bloat)..."
    # gnome-extra is a huge group full of GNOME games, maps, weather, etc., so
    # only the 'gnome' group is used - minus the apps below. They are never
    # downloaded; one that another package still needs comes in as a
    # dependency, and its menu entry is hidden at first boot. Papers is the
    # PDF viewer, so Evince isn't needed.
    local -a gnome_pkgs=() gnome_skip=(gnome-tour epiphany gnome-maps gnome-contacts
        gnome-characters gnome-connections gnome-font-viewer simple-scan yelp
        gnome-user-share gnome-color-manager evince)
    mapfile -t gnome_pkgs < <(arch-chroot /mnt pacman -Sgq gnome 2>/dev/null \
        | grep -vxF -f <(printf '%s\n' "${gnome_skip[@]}"))
    (( ${#gnome_pkgs[@]} > 10 )) || gnome_pkgs=(gnome)
    pac_install_retry \
        "${gnome_pkgs[@]}" \
        gdm \
        gnome-terminal \
        gnome-tweaks \
        gnome-shell-extensions \
        gnome-menus \
        gnome-disk-utility \
        || err "GNOME failed to install after retries"

    # Extras that are NOT required for a working desktop go through the
    # per-package fallback, so one renamed or temporarily unavailable package
    # can never abort the whole install.
    chroot_install \
        gnome-text-editor \
        ttf-hack-nerd \
        gvfs-mtp gvfs-gphoto2 gvfs-afc gvfs-smb

    # Fonts: without these, Chinese/Japanese/Korean text, emoji and many
    # other scripts render as empty boxes.
    #   noto-fonts        Latin/Greek/Cyrillic plus most other scripts
    #                     (Arabic, Hebrew, Thai, Indic, ...)
    #   noto-fonts-cjk    Chinese, Japanese, Korean (~300 MB, unavoidable)
    #   noto-fonts-emoji  colour emoji
    #   wqy-zenhei        CJK fallback Steam and Wine/Proton games pick up
    chroot_install noto-fonts noto-fonts-cjk noto-fonts-emoji wqy-zenhei

    setup_maintenance

    # Quoted heredoc + explicit env (same reasoning as configure_system).
    arch-chroot /mnt env NX_USERNAME="$USERNAME" NX_KEYMAP_X11="$KEYMAP_X11" \
        NX_KEYMAP_X11_VARIANT="$KEYMAP_X11_VARIANT" \
        bash <<'CHROOT'
set -e
systemctl enable gdm

# GDM autologin. Trade-off (shown on the confirmation screen): the LUKS
# passphrase is then the ONLY secret between power-on and a logged-in,
# sudo-capable session - anyone who knows it gets the desktop too. The screen
# lock and sudo still require the user password.
mkdir -p /etc/gdm
cat > /etc/gdm/custom.conf <<GDMEOF
[daemon]
AutomaticLoginEnable=True
AutomaticLogin=${NX_USERNAME}
GDMEOF

mkdir -p /etc/X11/xorg.conf.d
# systemd-localed reads this file, and GNOME builds the user's input sources
# from it on first login ("us,ru" becomes two switchable layouts).
{
    echo 'Section "InputClass"'
    echo '    Identifier "system-keyboard"'
    echo '    MatchIsKeyboard "on"'
    echo "    Option \"XkbLayout\" \"${NX_KEYMAP_X11}\""
    if [ -n "${NX_KEYMAP_X11_VARIANT:-}" ]; then
        echo "    Option \"XkbVariant\" \"${NX_KEYMAP_X11_VARIANT}\""
    fi
    echo 'EndSection'
} > /etc/X11/xorg.conf.d/00-keyboard.conf

# NOTE: localectl is deliberately NOT used here - it needs a running systemd/dbus
# and always fails inside a chroot (which would abort this set -e block).
# The X11 keymap is already configured via 00-keyboard.conf above.
CHROOT
    local rc=$?
    (( rc == 0 )) || err "GDM/desktop chroot configuration failed (exit $rc) - check the log"

    # Default app for text and script files: GNOME Text Editor, not vim.
    # A system-wide /etc/xdg/mimeapps.list beats the defaults packages ship
    # with, and each user can still override it in ~/.config/mimeapps.list.
    mkdir -p /mnt/etc/xdg
    cat > /mnt/etc/xdg/mimeapps.list <<'MIMEEOF'
[Default Applications]
text/plain=org.gnome.TextEditor.desktop
text/markdown=org.gnome.TextEditor.desktop
text/x-log=org.gnome.TextEditor.desktop
text/csv=org.gnome.TextEditor.desktop
text/xml=org.gnome.TextEditor.desktop
application/xml=org.gnome.TextEditor.desktop
application/json=org.gnome.TextEditor.desktop
application/x-yaml=org.gnome.TextEditor.desktop
application/toml=org.gnome.TextEditor.desktop
application/x-shellscript=org.gnome.TextEditor.desktop
text/x-shellscript=org.gnome.TextEditor.desktop
application/x-sh=org.gnome.TextEditor.desktop
application/x-perl=org.gnome.TextEditor.desktop
text/x-python=org.gnome.TextEditor.desktop
text/x-lua=org.gnome.TextEditor.desktop
text/x-ruby=org.gnome.TextEditor.desktop
text/x-php=org.gnome.TextEditor.desktop
text/x-java=org.gnome.TextEditor.desktop
text/javascript=org.gnome.TextEditor.desktop
application/javascript=org.gnome.TextEditor.desktop
text/css=org.gnome.TextEditor.desktop
text/html=org.gnome.TextEditor.desktop
text/x-csrc=org.gnome.TextEditor.desktop
text/x-chdr=org.gnome.TextEditor.desktop
text/x-c++src=org.gnome.TextEditor.desktop
text/x-c++hdr=org.gnome.TextEditor.desktop
text/x-makefile=org.gnome.TextEditor.desktop
text/x-cmake=org.gnome.TextEditor.desktop
text/x-diff=org.gnome.TextEditor.desktop
text/x-patch=org.gnome.TextEditor.desktop
text/x-sql=org.gnome.TextEditor.desktop
text/x-ini=org.gnome.TextEditor.desktop
application/x-desktop=org.gnome.TextEditor.desktop
application/x-executable=org.gnome.TextEditor.desktop
application/octet-stream=org.gnome.TextEditor.desktop
MIMEEOF
    chmod 644 /mnt/etc/xdg/mimeapps.list
    arch-chroot /mnt update-desktop-database /usr/share/applications 2>/dev/null || true
    log "Text Editor set as the default for text, script and unknown (.bin) files"

    # Console editor for sudoedit/visudo/git: nano (vim is not installed).
    grep -q '^EDITOR=' /mnt/etc/environment 2>/dev/null || {
        printf 'EDITOR=nano\nVISUAL=nano\n' >> /mnt/etc/environment
    }

    disable_donation_prompts
    # A missing display-manager link means the machine boots to a text console.
    [[ -L /mnt/etc/systemd/system/display-manager.service ]] \
        && [[ "$(readlink /mnt/etc/systemd/system/display-manager.service)" == */gdm.service ]] \
        || err "GDM was not enabled as the display manager - check the log"

    # -- NiiX Arch branding -----------------------------------
    log "Applying NiiX Arch branding..."

    # os-release (LOGO= is the icon GNOME's About page shows)
    sed -i -e 's/^NAME=.*/NAME="NiiX Arch"/' -e 's/^PRETTY_NAME=.*/PRETTY_NAME="NiiX Arch"/' /mnt/etc/os-release
    if grep -q '^LOGO=' /mnt/etc/os-release; then
        sed -i 's/^LOGO=.*/LOGO=niixarch-logo/' /mnt/etc/os-release
    else
        echo 'LOGO=niixarch-logo' >> /mnt/etc/os-release
    fi

    write_logo
    # NiiX flat icon theme (overrides every installed app icon)
    write_icons
    # Auto-iconify for any app installed later
    setup_auto_icons

    # Drop-down terminal: ddterm (a GNOME Shell extension, Wayland-native) is
    # installed and configured in the first-boot phase, since it needs the AUR.

    # -- Hide-app helpers: tidy the menu without uninstalling -----
    # Many apps are pulled in as GNOME dependencies and can't be removed, but you
    # can hide them from the menu with a per-user NoDisplay override (reversible).
    cat > /mnt/usr/local/bin/niix-hide-app <<'HIDEEOF'
#!/bin/bash
# Hide one or more apps from the menu (does NOT uninstall). Reverse: niix-unhide-app
#   niix-hide-app org.gnome.Tour gnome-system-monitor ...
set -uo pipefail
A="$HOME/.local/share/applications"; mkdir -p "$A"
[ $# -ge 1 ] || { echo "usage: niix-hide-app <desktop-id> [more...]"; exit 1; }
for id in "$@"; do
    id="${id%.desktop}"; src=""
    for d in /usr/share/applications /usr/local/share/applications \
             /var/lib/flatpak/exports/share/applications \
             "$HOME/.local/share/flatpak/exports/share/applications"; do
        [ -f "$d/$id.desktop" ] && { src="$d/$id.desktop"; break; }
    done
    if [ -n "$src" ]; then
        cp -f "$src" "$A/$id.desktop"
        if grep -q '^NoDisplay=' "$A/$id.desktop"; then
            sed -i 's/^NoDisplay=.*/NoDisplay=true/' "$A/$id.desktop"
        else
            sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$A/$id.desktop"
        fi
    else
        printf '[Desktop Entry]\nType=Application\nName=%s\nNoDisplay=true\nHidden=true\n' "$id" > "$A/$id.desktop"
    fi
    echo "hidden: $id"
done
update-desktop-database "$A" 2>/dev/null || true
HIDEEOF
    chmod +x /mnt/usr/local/bin/niix-hide-app

    cat > /mnt/usr/local/bin/niix-unhide-app <<'UNHIDEEOF'
#!/bin/bash
# Un-hide apps previously hidden with niix-hide-app
set -uo pipefail
A="$HOME/.local/share/applications"
[ $# -ge 1 ] || { echo "usage: niix-unhide-app <desktop-id> [more...]"; exit 1; }
for id in "$@"; do id="${id%.desktop}"; rm -f "$A/$id.desktop" && echo "shown: $id"; done
update-desktop-database "$A" 2>/dev/null || true
UNHIDEEOF
    chmod +x /mnt/usr/local/bin/niix-unhide-app
    log "Menu hide/unhide helpers installed (niix-hide-app / niix-unhide-app)"

    # /etc/issue
    echo "NiiX Arch \r (\l)" > /mnt/etc/issue

    # MOTD - kept plain text to avoid GDM/PAM rendering Unicode box art as
    # garbage characters on the graphical login screen (pam_motd displays this).
    # The NiiX Arch ASCII logo is shown via fastfetch in the terminal instead.
    cat > /mnt/etc/motd <<'MOTDEOF'

  Welcome to NiiX Arch
  Run 'fastfetch' for system info.

MOTDEOF

    # Branding persistence hook
    mkdir -p /mnt/etc/pacman.d/hooks
    cat > /mnt/etc/pacman.d/hooks/niixarch-branding.hook <<'HOOKEOF'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Re-applying NiiX Arch branding...
When = PostTransaction
Exec = /bin/bash -c "sed -i 's/^NAME=.*/NAME=\"NiiX Arch\"/' /etc/os-release; sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME=\"NiiX Arch\"/' /etc/os-release; grep -q '^LOGO=' /etc/os-release && sed -i 's/^LOGO=.*/LOGO=niixarch-logo/' /etc/os-release || echo 'LOGO=niixarch-logo' >> /etc/os-release"
HOOKEOF

    # Shell performance vars (for all users)
    cat > /mnt/etc/profile.d/niixarch-gaming.sh <<'SHEOF'
export DXVK_ASYNC=1
export mesa_glthread=true
export WINEFSYNC=1
export WINEESYNC=1
export WINE_FULLSCREEN_FSR=1
export MESA_SHADER_CACHE_MAX_SIZE=10G
export PROTON_ENABLE_NTSYNC=1
SHEOF
    # NVIDIA-only additions (its shader cache settings are in /etc/environment)
    if [[ "$GPU_VENDOR" == "nvidia" ]]; then
        cat >> /mnt/etc/profile.d/niixarch-gaming.sh <<'NVEOF'
export __GL_THREADED_OPTIMIZATIONS=1
export PROTON_ENABLE_NVAPI=1
export PROTON_HIDE_NVIDIA_GPU=0
NVEOF
    fi

    log "GNOME + branding installed"
}

# -- Step: firmware updates + niix-update ------------------------------------
setup_maintenance() {
    info "Setting up firmware updates and niix-update..."
    # fwupd pulls in its UEFI helper (fwupd-efi); udisks2 (installed) is what
    # it needs for UEFI capsule updates. GNOME Software shows firmware updates
    # once fwupd is present. The refresh timer keeps the LVFS metadata current.
    chroot_install fwupd pacman-contrib
    if arch-chroot /mnt systemctl enable fwupd-refresh.timer 2>/dev/null; then
        log "Firmware updates: fwupd + LVFS (GNOME Software or niix-update --firmware)"
    else
        warn "Could not enable fwupd-refresh.timer - firmware metadata refreshes on demand only"
    fi

    cat > /mnt/usr/local/bin/niix-update <<'NIIXUPDEOF'
#!/bin/bash
# niix-update - update everything on NiiX Arch, in the order that is safe:
#   1. Arch news   anything new that may need a manual step BEFORE upgrading
#                  is shown first (the most common way Arch installs break)
#   2. System      pacman -Syu  (snap-pac takes a snapshot before and after)
#   3. AUR         yay - only if the system upgrade succeeded, so the AUR
#                  never builds against a half-upgraded system
#   4. Flatpak     apps and runtimes, then unused runtimes are removed
#   5. Firmware    lists available updates (fwupd/LVFS); installs on request
#   6. Report      config files to review (.pacnew), whether to reboot
#
#   niix-update                interactive (asks before each step's changes)
#   niix-update --yes          no questions for packages (news is still shown)
#   niix-update --firmware     also install firmware updates (always confirmed)
#   niix-update --clean        also remove orphaned packages and old caches
#   niix-update --no-aur | --no-flatpak
set -uo pipefail

YES=0; FIRMWARE=0; CLEAN=0; DO_AUR=1; DO_FLATPAK=1
for arg in "$@"; do
    case "$arg" in
        -y|--yes)    YES=1 ;;
        --firmware)  FIRMWARE=1 ;;
        --clean)     CLEAN=1 ;;
        --no-aur)    DO_AUR=0 ;;
        --no-flatpak) DO_FLATPAK=0 ;;
        -h|--help)   sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)           echo "Unknown option: $arg (see niix-update --help)" >&2; exit 1 ;;
    esac
done

G=$'\033[38;5;118m'; P=$'\033[38;5;205m'; Y=$'\033[1;33m'; R=$'\033[0;31m'
W=$'\033[1;37m'; N=$'\033[0m'
step() { echo; echo "${P}== $* ${N}"; }
ok()   { echo "  ${G}[ok]${N} $*"; }
note() { echo "  ${Y}[!!]${N} $*"; }
bad()  { echo "  ${R}[xx]${N} $*"; }
indent() { sed 's/^/     /'; }
ask()  { # ask "question" default(y|n) -> 0 for yes
    local q=$1 def=${2:-y} a
    [ "$YES" = 1 ] && return 0
    if [ "$def" = y ]; then read -rp "  $q [Y/n] " a; [[ -z "$a" || "$a" =~ ^[Yy] ]]
    else read -rp "  $q [y/N] " a; [[ "$a" =~ ^[Yy] ]]; fi
}

# yay refuses to run as root, and per-user Flatpaks belong to the user.
if [ "$(id -u)" -eq 0 ]; then
    echo "Run niix-update as your normal user - it uses sudo where needed." >&2
    exit 1
fi

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/niix-update"
mkdir -p "$STATE"
# (No output capture: pacman, yay and fwupdmgr keep their colours, progress
# bars and prompts only when they talk to the terminal directly.)

# One run at a time, and never while pacman is busy (e.g. first boot).
exec 8>"$STATE/lock"
flock -n 8 || { bad "niix-update is already running."; exit 1; }
if [ -e /var/lib/pacman/db.lck ]; then
    bad "Another package operation is running (/var/lib/pacman/db.lck). Try again when it finishes."
    exit 1
fi

sudo -v || { bad "sudo is needed for system updates."; exit 1; }
FAILED=0

# -- 1. Arch news ---------------------------------------------------------
step "Arch Linux news"
SEEN_FILE="$STATE/news-seen"
seen=$(cat "$SEEN_FILE" 2>/dev/null || echo 0)
[[ "$seen" =~ ^[0-9]+$ ]] || seen=0
feed=$(mktemp); trap 'rm -f "$feed"' EXIT
if curl -fsSL --max-time 20 --retry 2 -o "$feed" https://archlinux.org/feeds/news/; then
    if ! news=$(python3 - "$feed" "$seen" <<'PY'
import sys, time, xml.etree.ElementTree as ET
from email.utils import parsedate_to_datetime
path, seen = sys.argv[1], int(sys.argv[2])
# First run: show the last 30 days, so a recent manual step is not missed.
floor = seen if seen else int(time.time()) - 30 * 86400
newest = seen
for item in ET.parse(path).getroot().iter("item"):
    try:
        ts = int(parsedate_to_datetime(item.findtext("pubDate", "")).timestamp())
    except Exception:
        continue
    newest = max(newest, ts)
    if ts > floor:
        print("ITEM\t%s\t%s\t%s" % (time.strftime("%Y-%m-%d", time.localtime(ts)),
              (item.findtext("title") or "").strip(), (item.findtext("link") or "").strip()))
print("NEWEST\t%d" % newest)
PY
)
    then
        news=""
    fi
    if [ -z "$news" ]; then
        note "Could not read the news feed - check https://archlinux.org/news/ yourself."
        ask "Continue with the update?" n || exit 1
    else
        newest=$(printf '%s\n' "$news" | awk -F'\t' '$1=="NEWEST"{print $2}')
        if printf '%s\n' "$news" | grep -q '^ITEM'; then
            note "New Arch news since your last update - read before upgrading:"
            printf '%s\n' "$news" | awk -F'\t' '$1=="ITEM"{printf "     %s  %s\n                 %s\n", $2, $3, $4}'
            echo
            if [ "$YES" = 1 ]; then
                note "--yes given: continuing. If an item above needs a manual step, do it now."
            else
                ask "Read them? Continue with the update?" n || { echo "  Stopped - nothing was changed."; exit 0; }
            fi
        else
            ok "Nothing new"
        fi
        [ -n "$newest" ] && echo "$newest" > "$SEEN_FILE"
    fi
else
    note "Arch news unreachable - check https://archlinux.org/news/ before upgrading."
    ask "Continue anyway?" n || exit 1
fi

# -- 2. System packages ----------------------------------------------------
step "System packages (pacman)"
pac_args=(-Syu); [ "$YES" = 1 ] && pac_args+=(--noconfirm)
SYSTEM_OK=0
if sudo pacman "${pac_args[@]}"; then
    SYSTEM_OK=1; ok "System up to date (snapshots taken by snap-pac)"
else
    FAILED=1; bad "System upgrade failed - fix the message above, then run niix-update again."
fi

# -- 3. AUR ----------------------------------------------------------------
if [ "$DO_AUR" = 1 ]; then
    step "AUR packages (yay)"
    if ! command -v yay >/dev/null 2>&1; then
        note "yay is not installed - skipped"
    elif [ "$SYSTEM_OK" != 1 ]; then
        note "Skipped: building AUR packages on a half-upgraded system can break them."
    else
        yay_args=(-Sua); [ "$YES" = 1 ] && yay_args+=(--noconfirm --answerdiff None --answerclean None --answeredit None)
        if yay "${yay_args[@]}"; then ok "AUR packages up to date"; else FAILED=1; bad "AUR update failed (see above)"; fi
    fi
fi

# -- 4. Flatpak --------------------------------------------------------------
if [ "$DO_FLATPAK" = 1 ] && command -v flatpak >/dev/null 2>&1; then
    step "Flatpak apps"
    if sudo flatpak update --system -y --noninteractive; then ok "System Flatpaks up to date"
    else FAILED=1; bad "Flatpak update failed (see above)"; fi
    if flatpak list --user --columns=application 2>/dev/null | grep -q .; then
        flatpak update --user -y --noninteractive || { FAILED=1; bad "User Flatpak update failed"; }
    fi
    sudo flatpak uninstall --system --unused -y --noninteractive >/dev/null 2>&1 \
        && ok "Unused runtimes removed"
fi

# -- 5. Firmware -------------------------------------------------------------
if command -v fwupdmgr >/dev/null 2>&1; then
    step "Firmware (fwupd / LVFS)"
    sudo fwupdmgr refresh --force >/dev/null 2>&1 || true
    fw=$(fwupdmgr get-updates --no-unreported-check --no-metadata-check 2>&1); fw_rc=$?
    if [ "$fw_rc" -eq 0 ]; then
        printf '%s\n' "$fw" | indent
        # Firmware is never applied silently: it can reboot into a flasher.
        if [ "$FIRMWARE" = 1 ] || { [ "$YES" != 1 ] && ask "Install these firmware updates now?" n; }; then
            sudo fwupdmgr update || { FAILED=1; bad "Firmware update failed (see above)"; }
        else
            note "Firmware updates available - install with: niix-update --firmware (or GNOME Software)"
        fi
    else
        ok "No firmware updates"
    fi
fi

# -- Optional clean-up ---------------------------------------------------------
if [ "$CLEAN" = 1 ]; then
    step "Clean-up"
    orphans=$(pacman -Qdtq 2>/dev/null)
    if [ -n "$orphans" ]; then
        printf '%s\n' "$orphans" | indent
        if ask "Remove these unused packages?" y; then
            # shellcheck disable=SC2086
            sudo pacman -Rns --noconfirm $orphans && ok "Orphans removed"
        fi
    else
        ok "No orphaned packages"
    fi
    if command -v paccache >/dev/null 2>&1; then
        sudo paccache -rk2 >/dev/null && sudo paccache -ruk0 >/dev/null && ok "Package cache trimmed (last 2 versions kept)"
    fi
fi

# -- 6. Report -------------------------------------------------------------------
step "Summary"
if command -v pacdiff >/dev/null 2>&1; then
    pn=$(pacdiff -o 2>/dev/null)
    if [ -n "$pn" ]; then
        note "Config files with a new default version to review (sudo DIFFPROG=meld pacdiff, or merge by hand):"
        printf '%s\n' "$pn" | indent
    fi
fi
if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
    note "The running kernel was updated - ${W}reboot${N} to use it (and before plugging in new hardware)."
fi
if [ "$FAILED" = 0 ]; then ok "Everything is up to date."; else bad "Finished with errors - see above."; fi
exit "$FAILED"
NIIXUPDEOF
    chmod 755 /mnt/usr/local/bin/niix-update

    # Menu entry: runs it in a terminal and keeps the window open at the end.
    cat > /mnt/usr/share/applications/niix-update.desktop <<'NIIXUPDDTEOF'
[Desktop Entry]
Type=Application
Name=NiiX Update
Comment=Update system, AUR and Flatpak apps and firmware - after checking Arch news
Exec=bash -c 'niix-update; echo; read -rp "Press Enter to close..."'
Icon=software-update-available
Terminal=true
Categories=System;Settings;
Keywords=update;upgrade;pacman;yay;flatpak;firmware;
NIIXUPDDTEOF
    chmod 644 /mnt/usr/share/applications/niix-update.desktop
    log "niix-update installed (menu: NiiX Update)"
}

# -- Step: donation prompts permanently off ---------------------------------
# Written at install time (not first boot) so nothing can appear even at the
# very first login, and LOCKED so neither the user nor an extension/app can
# switch them back on. Every key below was verified against upstream source:
#   GNOME 49+    gnome-settings-daemon "housekeeping": twice-a-year reminder
#   ArcMenu      its "vNN Released!" notification IS the donation request
#                (Donate button). Both the switch and the "last version shown"
#                counter are pinned, so even a renamed switch in a future
#                ArcMenu can't make the version check fire.
#   LibreOffice  "Donate" and "Get involved" infobars, finalized in a system
#                .xcd layer (the documented admin method, LibreOffice 7.0+).
# Checked and needing nothing: Dash to Panel, Tiling Assistant, ddterm,
# screen-rotate, AppIndicator, Whatsie, Signal - none shows a donation prompt.
disable_donation_prompts() {
    info "Disabling donation prompts (GNOME, ArcMenu, LibreOffice)..."
    mkdir -p /mnt/etc/dconf/profile /mnt/etc/dconf/db/local.d/locks
    if ! grep -qs 'system-db:local' /mnt/etc/dconf/profile/user; then
        printf 'user-db:user\nsystem-db:local\n' > /mnt/etc/dconf/profile/user
    fi
    cat > /mnt/etc/dconf/db/local.d/10-niix-nonags <<'NONAGEOF'
[org/gnome/settings-daemon/plugins/housekeeping]
donation-reminder-enabled=false

[org/gnome/shell/extensions/arcmenu]
update-notifier-enabled=false
update-notifier-project-version=2147483647
NONAGEOF
    cat > /mnt/etc/dconf/db/local.d/locks/10-niix-nonags <<'NONAGLOCKEOF'
/org/gnome/settings-daemon/plugins/housekeeping/donation-reminder-enabled
/org/gnome/shell/extensions/arcmenu/update-notifier-enabled
/org/gnome/shell/extensions/arcmenu/update-notifier-project-version
NONAGLOCKEOF
    chmod 644 /mnt/etc/dconf/db/local.d/10-niix-nonags /mnt/etc/dconf/db/local.d/locks/10-niix-nonags
    if arch-chroot /mnt dconf update 2>/dev/null; then
        log "GNOME + ArcMenu donation notifications: off and locked"
    else
        warn "dconf update failed - the donation settings apply after first boot's dconf update"
    fi

    # Not owned by any package, so LibreOffice updates never touch it; the
    # directory is created even if LibreOffice installs later.
    mkdir -p /mnt/usr/lib/libreoffice/share/registry
    cat > /mnt/usr/lib/libreoffice/share/registry/niix-nonags.xcd <<'XCDEOF'
<?xml version="1.0" encoding="UTF-8"?>
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
<dependency file="main"/>
<oor:component-data xmlns:install="http://openoffice.org/2004/installation" oor:name="Infobar" oor:package="org.openoffice.Office.UI">
 <node oor:name="Enabled">
  <prop oor:name="Donate" oor:finalized="true"><value>false</value></prop>
  <prop oor:name="GetInvolved" oor:finalized="true"><value>false</value></prop>
 </node>
</oor:component-data>
</oor:data>
XCDEOF
    chmod 644 /mnt/usr/lib/libreoffice/share/registry/niix-nonags.xcd
    log "LibreOffice Donate / Get involved banners: off and locked"
}

# -- Step: storage - NTFS usable out of the box, removable media writable --
setup_storage() {
    hr "Storage: NTFS and removable media"

    # Internal NTFS volumes: mounted read-write under /media at boot (and when
    # a disk is attached later) by a small root service, so GNOME Files shows
    # them in the sidebar and they are usable without a click. Hibernated or
    # unclean volumes fall back to read-only rather than risking the data.
    # Filesystem tools and the automount backend. Non-fatal on purpose: none of
    # them is needed to boot, and GNOME already pulled in udisks2 and gvfs.
    chroot_install ntfsprogs exfatprogs e2fsprogs mtools udisks2 gvfs

    info "Installing NTFS auto-mount..."
    cat > /mnt/usr/local/bin/niix-ntfs <<'NTFSEOF'
#!/bin/bash
# niix-ntfs - make NTFS volumes usable out of the box.
#   niix-ntfs mount        mount every internal NTFS volume under /media (default)
#   niix-ntfs status       show what is mounted and how
#   niix-ntfs umount-all   unmount everything this tool mounted
#   niix-ntfs list         list NTFS volumes found, and why any were skipped
# Runs at boot and whenever a disk appears (niix-ntfs-mount.service + udev).
# USB sticks and other removable media are deliberately left to GNOME/udisks2,
# which mounts them per-user under /run/media/$USER.
# Settings: /etc/niix-ntfs.conf
set -uo pipefail

ENABLED=1
MOUNT_ROOT=/media
NTFS_UID=""
NTFS_GID=""
NTFS_UMASK=0022
EXCLUDE_UUIDS=""
INCLUDE_REMOVABLE=0
EXTRA_OPTIONS=""
WINDOWS_RW=0
CONF=/etc/niix-ntfs.conf
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

STATE_DIR=/run/niix-ntfs
LOCKFILE=/run/lock/niix-ntfs.lock
ACTION="${1:-mount}"

msg()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }

need_root() {
    [ "$(id -u)" -eq 0 ] || { echo "niix-ntfs $ACTION must run as root (try: sudo niix-ntfs $ACTION)" >&2; exit 1; }
}

# Lowest regular account - the desktop user the installer created.
resolve_owner() {
    local u
    if [ -z "$NTFS_UID" ]; then
        u=$(getent passwd | awk -F: '$3>=1000 && $3<65000 {print $3}' | sort -n | head -1)
        NTFS_UID="${u:-0}"
    fi
    if [ -z "$NTFS_GID" ]; then
        NTFS_GID=$(getent passwd | awk -F: -v u="$NTFS_UID" '$3==u {print $4; exit}')
        NTFS_GID="${NTFS_GID:-$NTFS_UID}"
    fi
}

# USB / SD / FireWire media are udisks2's job, not ours.
disk_is_removable() {
    local disk="$1" tran
    [ -n "$disk" ] || return 1
    [ "$(cat "/sys/block/$disk/removable" 2>/dev/null)" = "1" ] && return 0
    tran=$(lsblk -dno TRAN "/dev/$disk" 2>/dev/null | tr -d ' ')
    case "$tran" in usb|mmc|ieee1394) return 0 ;; esac
    return 1
}

sanitize() {
    printf '%s' "$1" \
        | tr -c 'A-Za-z0-9._ -' '_' \
        | sed -e 's/^[ .]*//' -e 's/[ ]*$//' -e 's/ \+/_/g' \
        | cut -c1-48
}

excluded() {
    local uuid="$1" x
    for x in $EXCLUDE_UUIDS; do
        [ "$x" = "$uuid" ] && return 0
    done
    return 1
}

# Every NTFS partition on the machine, one device path per line.
ntfs_parts() {
    local dev
    while IFS= read -r dev; do
        [ -b "$dev" ] || continue
        [ "$(blkid -s TYPE -o value "$dev" 2>/dev/null)" = "ntfs" ] && printf '%s\n' "$dev"
    done < <(lsblk -lno PATH,TYPE 2>/dev/null | awk '$2=="part"{print $1}')
}

# Prints a skip reason, or nothing when the volume should be mounted.
skip_reason() {
    local dev="$1" uuid="$2" parent
    [ -n "$uuid" ] || { echo "no UUID"; return; }
    excluded "$uuid" && { echo "excluded in $CONF"; return; }
    parent=$(lsblk -no PKNAME "$dev" 2>/dev/null | head -1 | tr -d ' ')
    if [ "$INCLUDE_REMOVABLE" != "1" ] && disk_is_removable "$parent"; then
        echo "removable - handled by GNOME/udisks2"
        return
    fi
    if grep -qsE "^[^#]*\\b(UUID=)?$uuid\\b" /etc/fstab; then
        echo "already in /etc/fstab"
        return
    fi
    if findmnt -rn -S "$dev" >/dev/null 2>&1; then
        echo "already mounted at $(findmnt -rn -o TARGET -S "$dev" | head -1)"
        return
    fi
}

# Looks inside the volume (read-only, briefly) once, and sets:
#   PROBE_WINDOWS  true when it holds an installed Windows (\Windows\System32)
#   PROBE_NAME     the mount-point name: the label, else "Windows" for a
#                  Windows system volume, else NTFS-<uuid>; made unique.
probe_volume() {
    local dev="$1" uuid="$2" label probe
    PROBE_WINDOWS=false
    probe="$STATE_DIR/probe"
    mkdir -p "$probe"
    if mount -t ntfs3 -o ro "$dev" "$probe" 2>/dev/null 9>&- \
        || mount -t ntfs-3g -o ro "$dev" "$probe" 2>/dev/null 9>&-; then
        [ -d "$probe/Windows/System32" ] && PROBE_WINDOWS=true
        umount "$probe" 2>/dev/null
    fi
    rmdir "$probe" 2>/dev/null

    label=$(blkid -s LABEL -o value "$dev" 2>/dev/null)
    PROBE_NAME=$(sanitize "$label")
    if [ -z "$PROBE_NAME" ]; then
        if [ "$PROBE_WINDOWS" = true ]; then
            PROBE_NAME=Windows
        else
            PROBE_NAME="NTFS-${uuid:0:8}"
        fi
    fi
    # Keep names unique: a second volume with the same label gets its UUID.
    if mountpoint -q "$MOUNT_ROOT/$PROBE_NAME" 2>/dev/null || [ -e "$MOUNT_ROOT/$PROBE_NAME" ]; then
        if ! [ -d "$MOUNT_ROOT/$PROBE_NAME" ] || [ -n "$(ls -A "$MOUNT_ROOT/$PROBE_NAME" 2>/dev/null)" ]; then
            PROBE_NAME="${PROBE_NAME}-${uuid:0:8}"
        fi
    fi
}

# Read-write with the kernel driver first, then the FUSE driver, then
# read-only. A volume left hibernated by Windows Fast Startup cannot be
# written safely, and both drivers refuse it - read-only is the correct,
# non-destructive outcome there.
# mount_one DEVICE TARGET [ro]   - "ro" skips the read-write attempts
mount_one() {
    local dev="$1" target="$2" want="${3:-rw}" common driver=""
    common="noatime,nosuid,nodev,uid=$NTFS_UID,gid=$NTFS_GID,umask=$NTFS_UMASK,windows_names"
    [ -n "$EXTRA_OPTIONS" ] && common="$common,$EXTRA_OPTIONS"

    # 9>&- on every mount: the ntfs-3g FUSE daemon stays alive for the life of
    # the mount and would otherwise inherit the lock fd and hold it forever,
    # deadlocking every later run of this script.
    if [ "$want" != ro ] && mount -t ntfs3 -o "rw,$common" "$dev" "$target" 2>/dev/null 9>&-; then
        driver=ntfs3
    elif [ "$want" != ro ] && mount -t ntfs-3g -o "rw,$common" "$dev" "$target" 2>/dev/null 9>&-; then
        driver=ntfs-3g
    elif mount -t ntfs3 -o "ro,$common" "$dev" "$target" 2>/dev/null 9>&-; then
        driver=ntfs3
    elif mount -t ntfs-3g -o "ro,$common" "$dev" "$target" 2>/dev/null 9>&-; then
        driver=ntfs-3g
    else
        warn "could not mount $dev - see: dmesg | tail"
        return 1
    fi

    # Report what the kernel actually gave us: asking for rw does not always
    # get it (a hibernated volume, a dirty volume, or read-only hardware).
    if [ "$want" = ro ]; then
        msg "mounted $dev -> $target ($driver, read-only: Windows system drive)"
        msg "  Protects Windows from accidental changes. To allow writing, set"
        msg "  WINDOWS_RW=1 in $CONF (Fast Startup must be off in Windows)."
    elif findmnt -rn -o OPTIONS -M "$target" 2>/dev/null | grep -qE '(^|,)ro(,|$)'; then
        msg "mounted $dev -> $target ($driver, READ-ONLY)"
        msg "  Writing is blocked because the volume is hibernated, was not shut down"
        msg "  cleanly, or the disk itself is read-only. In Windows turn off Fast Startup"
        msg "  (Power Options > Choose what the power buttons do) and shut down fully."
        msg "  Check/repair from here: sudo ntfsfix $dev"
    else
        msg "mounted $dev -> $target ($driver, read-write)"
    fi
    return 0
}

do_mount() {
    need_root
    [ "$ENABLED" = "1" ] || { msg "disabled in $CONF"; return 0; }
    resolve_owner
    mkdir -p "$MOUNT_ROOT" "$STATE_DIR"
    local dev uuid reason target want mounted=0

    while IFS= read -r dev; do
        uuid=$(blkid -s UUID -o value "$dev" 2>/dev/null)
        reason=$(skip_reason "$dev" "$uuid")
        [ -n "$reason" ] && continue
        probe_volume "$dev" "$uuid"
        target="$MOUNT_ROOT/$PROBE_NAME"
        want=rw
        [ "$PROBE_WINDOWS" = true ] && [ "$WINDOWS_RW" != "1" ] && want=ro
        mkdir -p "$target" || { warn "could not create $target"; continue; }
        if mount_one "$dev" "$target" "$want"; then
            printf '%s\n' "$target" >> "$STATE_DIR/mounts"
            mounted=$((mounted + 1))
        else
            rmdir "$target" 2>/dev/null
        fi
    done < <(ntfs_parts)

    [ "$mounted" -eq 0 ] && msg "no new NTFS volumes to mount"
    return 0
}

do_list() {
    resolve_owner
    local dev uuid label reason found=0
    printf '%-12s %-18s %-18s %s\n' DEVICE LABEL UUID STATUS
    while IFS= read -r dev; do
        found=1
        uuid=$(blkid -s UUID -o value "$dev" 2>/dev/null)
        label=$(blkid -s LABEL -o value "$dev" 2>/dev/null)
        reason=$(skip_reason "$dev" "$uuid")
        printf '%-12s %-18s %-18s %s\n' "$dev" "${label:-(no label)}" "$uuid" "${reason:-will be mounted under $MOUNT_ROOT}"
    done < <(ntfs_parts)
    [ "$found" -eq 0 ] && msg "no NTFS volumes found"
    return 0
}

do_status() {
    local any=0 line
    while IFS= read -r line; do
        any=1; printf '%s\n' "$line"
    done < <(findmnt -rn -t ntfs3,ntfs-3g,ntfs,fuseblk -o SOURCE,TARGET,FSTYPE,OPTIONS 2>/dev/null \
             | awk '{printf "%-14s %-28s %-8s %s\n", $1, $2, $3, ($4 ~ /(^|,)ro(,|$)/ ? "read-only" : "read-write")}')
    [ "$any" -eq 0 ] && msg "no NTFS volumes mounted"
    return 0
}

do_umount_all() {
    need_root
    local target
    [ -s "$STATE_DIR/mounts" ] || { msg "nothing mounted by niix-ntfs"; return 0; }
    while IFS= read -r target; do
        [ -n "$target" ] || continue
        if mountpoint -q "$target"; then
            if umount "$target" 2>/dev/null; then
                msg "unmounted $target"
            else
                warn "$target is busy - close anything using it (lsof +f -- $target)"
                continue
            fi
        fi
        rmdir "$target" 2>/dev/null
    done < "$STATE_DIR/mounts"
    : > "$STATE_DIR/mounts"
    return 0
}

case "$ACTION" in
    mount)
        # Serialise: udev can fire several times while disks are being probed.
        mkdir -p "$(dirname "$LOCKFILE")"
        exec 9>"$LOCKFILE" || exit 1
        # Bounded wait: if another run really is stuck, this one gives up
        # quietly instead of hanging the boot service or a udev trigger.
        if ! flock -w 120 9; then
            echo "niix-ntfs: another run is in progress - skipping" >&2
            exit 0
        fi
        do_mount
        ;;
    list)       do_list ;;
    status)     do_status ;;
    umount-all) do_umount_all ;;
    *)
        echo "Usage: niix-ntfs {mount|list|status|umount-all}"
        exit 1
        ;;
esac
NTFSEOF
    chmod 755 /mnt/usr/local/bin/niix-ntfs

    if [[ ! -f /mnt/etc/niix-ntfs.conf ]]; then
        cat > /mnt/etc/niix-ntfs.conf <<'NTFSCONFEOF'
# NiiX NTFS auto-mount settings. Apply changes with: sudo niix-ntfs mount
# List volumes and their UUIDs with: niix-ntfs list

# Turn auto-mounting of internal NTFS volumes off entirely.
#ENABLED=0

# Where volumes are mounted. /media is what GNOME Files shows in the sidebar.
#MOUNT_ROOT=/media

# Who owns the files. Defaults to the first regular account on the system.
#NTFS_UID=1000
#NTFS_GID=1000

# 0022 = owner read/write, everyone else read-only. Use 0002 to share with
# other accounts in the same group, 0077 to keep it entirely private.
#NTFS_UMASK=0022

# Volumes to leave alone, by UUID, space-separated.
#EXCLUDE_UUIDS="1234ABCD5678EF90 ABCD12345678EF90"

# Also auto-mount USB/SD NTFS media. Off by default: GNOME already mounts
# removable media per-user under /run/media, with safe-eject in Files.
#INCLUDE_REMOVABLE=1

# Extra mount options appended to the defaults.
#EXTRA_OPTIONS="prealloc"

# A drive holding an installed Windows (\Windows\System32) is mounted
# read-only, so nothing on the Linux side can damage it by accident. Data
# drives are always read-write. Set to 1 to make the Windows drive writable
# too - only with Fast Startup turned off in Windows.
#WINDOWS_RW=1

# Repair dirty USB filesystems (NTFS/FAT/exFAT) when they are plugged in, so
# they mount read-write instead of read-only. Set to 0 to never touch them.
#USB_AUTOFIX=0
NTFSCONFEOF
        chmod 644 /mnt/etc/niix-ntfs.conf
    fi

    cat > /mnt/etc/systemd/system/niix-ntfs-mount.service <<'NTFSUNITEOF'
[Unit]
Description=NiiX: mount internal NTFS volumes under /media
Documentation=man:niix-ntfs
After=local-fs.target
Wants=local-fs.target
ConditionPathExists=/usr/local/bin/niix-ntfs

[Service]
Type=oneshot
ExecStart=/usr/local/bin/niix-ntfs mount
RemainAfterExit=no
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
NTFSUNITEOF

    mkdir -p /mnt/etc/udev/rules.d
    cat > /mnt/etc/udev/rules.d/99-niix-ntfs.rules <<'NTFSUDEVEOF'
# Mount internal NTFS volumes as soon as they appear, so a drive attached
# after boot is usable without a reboot. niix-ntfs itself skips removable
# media (GNOME/udisks2 handles those) and anything already mounted.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_FS_TYPE}=="ntfs", TAG+="systemd", ENV{SYSTEMD_WANTS}+="niix-ntfs-mount.service"
NTFSUDEVEOF

    if arch-chroot /mnt systemctl enable niix-ntfs-mount.service 2>/dev/null; then
        log "NTFS volumes will be mounted under /media at every boot"
    else
        warn "Could not enable niix-ntfs-mount.service - run 'sudo niix-ntfs mount' by hand"
    fi

    # Removable media (USB sticks, SD cards, phones) are GNOME's job: udisks2
    # mounts them per-user under /run/media with safe-eject in Files. Out of
    # the box udisks mounts foreign filesystems root-owned, so the desktop
    # user cannot write to them - this config fixes exactly that.
    mkdir -p /mnt/etc/udisks2
    if [[ ! -f /mnt/etc/udisks2/mount_options.conf ]]; then
        cat > /mnt/etc/udisks2/mount_options.conf <<'UDISKSEOF'
# Removable media mounted by GNOME Files / udisks2.
# Out of the box udisks mounts foreign filesystems root-owned, so the desktop
# user can read but not write them. $UID/$GID are placeholders udisks fills in
# with the user doing the mounting - they are NOT shell variables.
# Key names and driver names must match udisks' own builtin_mount_options.conf:
# the drivers are "ntfs" (ntfs-3g FUSE / legacy kernel) and "ntfs3" (kernel).
[defaults]

# Prefer ntfs-3g on removable media: slower than ntfs3, but the more forgiving
# of the two with half-unplugged sticks and unclean Windows shutdowns. Falls
# back to the kernel ntfs3 driver if ntfs-3g is missing.
ntfs_drivers=ntfs,ntfs3
ntfs:ntfs_defaults=uid=$UID,gid=$GID,noatime,windows_names,big_writes
ntfs:ntfs_allow=uid=$UID,gid=$GID,umask,dmask,fmask,locale,norecover,ignore_case,windows_names,compression,nocompression,big_writes
ntfs:ntfs3_defaults=uid=$UID,gid=$GID,noatime,windows_names
ntfs:ntfs3_allow=uid=$UID,gid=$GID,umask,dmask,fmask,iocharset,discard,nodiscard,sparse,nosparse,hidden,nohidden,sys_immutable,nosys_immutable,showmeta,noshowmeta,prealloc,noprealloc,hide_dot_files,nohide_dot_files,windows_names,nocase,case

# errors=continue keeps a stick writable through a transient error instead of
# flipping it read-only mid-copy; the filesystem is marked dirty and niix-usb-
# autofix repairs it on the next plug-in. "errors" is not in udisks' builtin
# allow list for these filesystems, so it is added below.
vfat_defaults=uid=$UID,gid=$GID,shortname=mixed,utf8=1,showexec,flush,errors=continue
vfat_allow=uid=$UID,gid=$GID,flush,utf8,shortname,umask,dmask,fmask,codepage,iocharset,usefree,showexec,errors
exfat_defaults=uid=$UID,gid=$GID,iocharset=utf8,errors=continue
exfat_allow=uid=$UID,gid=$GID,umask,dmask,fmask,allow_utime,iocharset,errors,discard,keep_last_dots,sys_tz,time_offset,zero_size_dir,namecase,codepage
UDISKSEOF
        chmod 644 /mnt/etc/udisks2/mount_options.conf
    fi

    # A stick left dirty by Windows, or yanked out mid-write, otherwise mounts
    # read-only and every copy to it fails. This repairs it at plug-in time,
    # before udisks mounts it - checking first and only writing when the check
    # reports a problem. Disable with USB_AUTOFIX=0 in /etc/niix-ntfs.conf.
    cat > /mnt/usr/local/bin/niix-usb-autofix <<'USBFIXEOF'
#!/bin/bash
# niix-usb-autofix DEVICE FSTYPE
# Run from udev the moment a USB filesystem appears and before udisks mounts
# it, so a stick left dirty by Windows (or by being yanked out) is repaired and
# mounts read-write instead of read-only.
# Deliberately conservative:
#   - never touches a filesystem that is already mounted
#   - checks first, and only writes when the check reports a problem
#   - a volume hibernated by Windows is left alone: clearing its dirty flag
#     would not make writing safe, and both NTFS drivers refuse it anyway
#   - every tool runs under a timeout so a udev worker can never wedge
# Turn it off with USB_AUTOFIX=0 in /etc/niix-ntfs.conf
# Log: journalctl -t niix-usb-autofix
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

USB_AUTOFIX=1
CONF=/etc/niix-ntfs.conf
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
[ "${USB_AUTOFIX:-1}" = "1" ] || exit 0

DEV="${1:-}"
FS="${2:-}"
[ -b "$DEV" ] || exit 0

say() { logger -t niix-usb-autofix -- "$*" 2>/dev/null || true; }

# Anything already mounted is off limits - repairing a mounted filesystem
# corrupts it.
findmnt -rn -S "$DEV" >/dev/null 2>&1 && exit 0

case "$FS" in
    ntfs)
        command -v ntfsfix >/dev/null 2>&1 || exit 0
        # Without the probe there is no safe way to tell "unclean" from
        # "hibernated", so do nothing rather than guess.
        command -v ntfs-3g.probe >/dev/null 2>&1 || exit 0
        timeout 20 ntfs-3g.probe --readwrite "$DEV" >/dev/null 2>&1
        rc=$?
        # ntfs-3g.probe(8): 0 mountable, 14 hibernated, 15 not cleanly
        # unmounted. Only 15 is repaired: that is the yanked-out / Windows-
        # crashed case ntfsfix exists for. Hibernated (Fast Startup), corrupt,
        # in-use or unknown volumes are left untouched.
        case "$rc" in
            0)  exit 0 ;;
            14) say "$DEV: hibernated by Windows - left alone (turn off Fast Startup and shut down fully)"
                exit 0 ;;
            15) ;;
            *)  say "$DEV: not repairable automatically (ntfs-3g.probe code $rc) - left alone"
                exit 0 ;;
        esac
        if out=$(timeout 45 ntfsfix -d "$DEV" 2>&1); then
            say "$DEV: NTFS was not cleanly unmounted - repaired, mounts read-write now"
        else
            say "$DEV: ntfsfix failed: $(printf '%s' "$out" | tail -1)"
        fi
        ;;
    vfat)
        command -v fsck.fat >/dev/null 2>&1 || exit 0
        timeout 20 fsck.fat -n "$DEV" >/dev/null 2>&1 && exit 0
        if out=$(timeout 45 fsck.fat -a "$DEV" 2>&1); then
            say "$DEV: FAT repaired"
        else
            say "$DEV: fsck.fat could not repair it: $(printf '%s' "$out" | tail -1)"
        fi
        ;;
    exfat)
        command -v fsck.exfat >/dev/null 2>&1 || exit 0
        timeout 20 fsck.exfat -n "$DEV" >/dev/null 2>&1 && exit 0
        if out=$(timeout 45 fsck.exfat -p "$DEV" 2>&1); then
            say "$DEV: exFAT repaired"
        else
            say "$DEV: fsck.exfat could not repair it: $(printf '%s' "$out" | tail -1)"
        fi
        ;;
esac
exit 0
USBFIXEOF
    chmod 755 /mnt/usr/local/bin/niix-usb-autofix

    cat > /mnt/etc/udev/rules.d/99-niix-usb-autofix.rules <<'USBUDEVEOF'
# Repair a dirty USB filesystem the moment it is plugged in, before udisks
# mounts it - otherwise it mounts read-only and copying to it fails.
# "add" only, so an already-mounted filesystem is never touched. The helper
# checks before it writes and gives up rather than blocking a udev worker.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="ntfs|vfat|exfat", RUN+="/usr/bin/timeout 55 /usr/local/bin/niix-usb-autofix $env{DEVNAME} $env{ID_FS_TYPE}"
USBUDEVEOF
    chmod 644 /mnt/etc/udev/rules.d/99-niix-usb-autofix.rules

    log "Removable media: auto-mounted read-write by GNOME, dirty filesystems repaired on plug-in"
}

# -- Game controllers ------------------------------------------
# Wired and Bluetooth Xbox, PlayStation and Switch Pro controllers are handled
# by the kernel's own drivers (xpad, hid-playstation, hid-nintendo) - nothing
# to install for those. Extra drivers that need the AUR (xpadneo, xone, more
# udev rules) are added at first boot. This step makes controllers usable on
# the desktop itself: niix-padnav turns any controller into a mouse and
# keyboard while no game is running.
setup_controllers() {
    hr "Game Controllers"

    chroot_install python-evdev libnotify

    # /dev/uinput lets niix-padnav (and Steam Input) create the virtual mouse
    # and keyboard. uaccess gives it to the user at the screen - and only them.
    echo "uinput" > /mnt/etc/modules-load.d/uinput.conf
    mkdir -p /mnt/etc/udev/rules.d
    cat > /mnt/etc/udev/rules.d/60-niix-uinput.rules <<'UINPUTEOF'
# Controller-as-mouse (niix-padnav) and Steam Input write through uinput.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
UINPUTEOF

    cat > /mnt/usr/local/bin/niix-padnav <<'NIIXPADEOF'
#!/usr/bin/env python3
"""niix-padnav - use a game controller as mouse and keyboard on the desktop.

Runs in the desktop session (systemd user service) and works with anything the
kernel sees as a gamepad: Xbox, PlayStation, Switch Pro, 8BitDo and most
others, wired or over Bluetooth.

  left stick          move the pointer       right stick         scroll
  A / Cross           left click             B / Circle          right click
  X, Y / Square,      Enter                  d-pad               arrow keys
    Triangle
  LB / RB             previous / next item   RT / LT             left / right click
                      (Shift+Tab / Tab)
  Start / Options     open the NiiX menu     Back / Share        Escape
  left stick click    switch window          right stick click   on-screen keyboard
  Guide / PS / Home   turn the controller mouse off and on

It steps aside by itself:
  - while a game is running (Steam, Lutris, Heroic, Wine/Proton, emulators)
  - while Steam is open and signed in - Steam's own desktop layout drives the
    desktop then, and two of them at once would fight over the pointer
The controller is never grabbed, so games and browsers always see it.

Log: journalctl --user -u niix-padnav
"""
import os
import re
import selectors
import signal
import subprocess
import sys
import time

try:
    import evdev
    from evdev import ecodes as e
except ImportError:
    print("niix-padnav: python-evdev is missing (sudo pacman -S python-evdev)", file=sys.stderr)
    sys.exit(0)

POINTER_SPEED = 1400.0   # pixels per second with the stick pushed all the way
SCROLL_SPEED = 1800.0    # hi-res wheel units per second (120 = one notch)
DEADZONE = 0.20
TRIGGER_PRESS = 0.55     # an analog trigger counts as pressed past this point
TRIGGER_RELEASE = 0.35
TICK = 1 / 120
RESCAN_EVERY = 2.0
CHECK_EVERY = 1.5

STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "niix")
OFF_FLAG = os.path.join(STATE_DIR, "padnav-off")
OWN_PREFIX = "NiiX controller"

# Process names (as in /proc/PID/comm, cut to 15 characters) that mean a game
# is running. Steam starts every game through "reaper".
GAME_PROCESSES = {
    "reaper", "gamescope", "gamescope-wl", "wineserver", "wine64-preloade",
    "wine-preloader", "retroarch", "dolphin-emu", "pcsx2-qt", "rpcs3",
    "duckstation-qt", "ppssppsdl", "ppssppqt", "cemu", "ryujinx", "xemu",
    "melonds", "azahar", "shadps4", "eden", "citron", "mgba-qt", "flycast",
}

HI_RES_WHEEL = getattr(e, "REL_WHEEL_HI_RES", None)
HI_RES_HWHEEL = getattr(e, "REL_HWHEEL_HI_RES", None)
MOUSE_BUTTONS = (e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE)

MOUSE, KEYS, TOGGLE, OSK = "mouse", "keys", "toggle", "osk"

BUTTONS = {
    e.BTN_SOUTH: (MOUSE, (e.BTN_LEFT,)),
    e.BTN_EAST: (MOUSE, (e.BTN_RIGHT,)),
    e.BTN_NORTH: (KEYS, (e.KEY_ENTER,)),
    e.BTN_WEST: (KEYS, (e.KEY_ENTER,)),
    e.BTN_TL: (KEYS, (e.KEY_LEFTSHIFT, e.KEY_TAB)),
    e.BTN_TR: (KEYS, (e.KEY_TAB,)),
    e.BTN_TL2: (MOUSE, (e.BTN_RIGHT,)),
    e.BTN_TR2: (MOUSE, (e.BTN_LEFT,)),
    e.BTN_START: (KEYS, (e.KEY_LEFTMETA,)),
    e.BTN_SELECT: (KEYS, (e.KEY_ESC,)),
    e.BTN_THUMBL: (KEYS, (e.KEY_LEFTALT, e.KEY_TAB)),
    e.BTN_THUMBR: (OSK, ()),
    e.BTN_MODE: (TOGGLE, ()),
    e.BTN_DPAD_UP: (KEYS, (e.KEY_UP,)),
    e.BTN_DPAD_DOWN: (KEYS, (e.KEY_DOWN,)),
    e.BTN_DPAD_LEFT: (KEYS, (e.KEY_LEFT,)),
    e.BTN_DPAD_RIGHT: (KEYS, (e.KEY_RIGHT,)),
}

# The d-pad arrives as a hat axis on most pads: (axis, direction) -> button.
HAT = {
    (e.ABS_HAT0X, -1): e.BTN_DPAD_LEFT, (e.ABS_HAT0X, 1): e.BTN_DPAD_RIGHT,
    (e.ABS_HAT0Y, -1): e.BTN_DPAD_UP, (e.ABS_HAT0Y, 1): e.BTN_DPAD_DOWN,
}

KEYBOARD_KEYS = sorted({k for kind, codes in BUTTONS.values() if kind == KEYS for k in codes})

STICK_LX, STICK_LY, STICK_RX, STICK_RY, TRIGGER_L, TRIGGER_R = range(6)


def log(msg):
    print("niix-padnav: " + msg, flush=True)


def notify(title, body):
    try:
        subprocess.Popen(["notify-send", "-a", "NiiX", "-t", "2500", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


class Pad:
    def __init__(self, path, dev):
        self.path = path
        self.dev = dev
        caps = dev.capabilities()
        info = dict(caps.get(e.EV_ABS, []))
        keys = set(caps.get(e.EV_KEY, []))

        # Most drivers put the right stick on RX/RY and the triggers on Z/RZ.
        # Generic HID pads without RX use Z/RZ for the right stick instead.
        roles = {e.ABS_X: STICK_LX, e.ABS_Y: STICK_LY}
        if e.ABS_RX in info:
            roles.update({e.ABS_RX: STICK_RX, e.ABS_RY: STICK_RY})
            # Pads that also report the triggers as buttons: use the buttons,
            # so one pull isn't counted twice.
            if not (e.BTN_TL2 in keys and e.BTN_TR2 in keys):
                roles.update({e.ABS_Z: TRIGGER_L, e.ABS_RZ: TRIGGER_R})
        else:
            roles.update({e.ABS_Z: STICK_RX, e.ABS_RZ: STICK_RY})

        self.axes = {}            # event code -> (role, min, max)
        for code, role in roles.items():
            if code in info and info[code].max > info[code].min:
                self.axes[code] = (role, info[code].min, info[code].max)
        self.values = [0.0] * 6
        self.trigger_down = {TRIGGER_L: False, TRIGGER_R: False}
        self.hat = {e.ABS_HAT0X: 0, e.ABS_HAT0Y: 0}

    def set_axis(self, code, raw):
        role, low, high = self.axes[code]
        if role in (TRIGGER_L, TRIGGER_R):
            value = (raw - low) / (high - low)
            self.values[role] = max(0.0, min(1.0, value))
        else:
            value = (raw - (low + high) / 2) / ((high - low) / 2)
            self.values[role] = max(-1.0, min(1.0, value))
        return role

    def stick(self, x_role, y_role):
        x, y = self.values[x_role], self.values[y_role]
        mag = (x * x + y * y) ** 0.5
        if mag < DEADZONE:
            return 0.0, 0.0
        strength = min(1.0, (mag - DEADZONE) / (1 - DEADZONE)) ** 2
        return x / mag * strength, y / mag * strength


def is_gamepad(dev):
    if dev.name.startswith(OWN_PREFIX):
        return False
    caps = dev.capabilities(absinfo=False)
    keys = set(caps.get(e.EV_KEY, []))
    axes = set(caps.get(e.EV_ABS, []))
    return e.BTN_SOUTH in keys and e.ABS_X in axes and e.ABS_Y in axes


def game_running():
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return False
    for pid in pids:
        try:
            with open("/proc/%s/comm" % pid) as fh:
                if fh.read().strip().lower() in GAME_PROCESSES:
                    return True
        except OSError:
            continue
    return False


def steam_signed_in():
    try:
        with open(os.path.expanduser("~/.steam/registry.vdf"), errors="ignore") as fh:
            text = fh.read()
    except OSError:
        return False
    pid = re.search(r'"pid"\s+"(\d+)"', text)
    user = re.search(r'"ActiveUser"\s+"(\d+)"', text)
    if not pid or not user or user.group(1) == "0":
        return False
    # registry.vdf survives a Steam crash - make sure that pid really is Steam.
    try:
        with open("/proc/%s/comm" % pid.group(1)) as fh:
            return fh.read().strip().startswith("steam")
    except OSError:
        return False


class Navigator:
    def __init__(self):
        self.selector = selectors.DefaultSelector()
        self.pads = {}            # device path -> Pad
        self.ignored = set()      # device paths that are not gamepads
        self.mouse = None
        self.keyboard = None
        self.uinput_failed_at = None
        self.held = {}            # output code -> how many buttons hold it
        self.pressed = {}         # (path, button) -> output codes, for release
        self.move_rest = [0.0, 0.0]
        self.wheel_rest = [0.0, 0.0]
        self.notch_rest = [0, 0]
        self.manual_off = os.path.exists(OFF_FLAG)
        self.paused = None        # why it is stepping aside, or None
        self.running = True

    # -- virtual mouse and keyboard ---------------------------------------
    def outputs_ready(self):
        if self.mouse and self.keyboard:
            return True
        if self.uinput_failed_at and time.monotonic() - self.uinput_failed_at < 10:
            return False
        rel = [e.REL_X, e.REL_Y, e.REL_WHEEL, e.REL_HWHEEL]
        rel += [c for c in (HI_RES_WHEEL, HI_RES_HWHEEL) if c is not None]
        try:
            self.mouse = evdev.UInput({e.EV_KEY: list(MOUSE_BUTTONS), e.EV_REL: rel},
                                      name=OWN_PREFIX + " mouse")
            self.keyboard = evdev.UInput({e.EV_KEY: KEYBOARD_KEYS},
                                         name=OWN_PREFIX + " keyboard")
        except Exception as exc:
            self.close_outputs()
            if self.uinput_failed_at is None:
                log("cannot open /dev/uinput (%s) - retrying every 10s" % exc)
            self.uinput_failed_at = time.monotonic()
            return False
        self.uinput_failed_at = None
        return True

    def close_outputs(self):
        for dev in (self.mouse, self.keyboard):
            if dev:
                try:
                    dev.close()
                except Exception:
                    pass
        self.mouse = self.keyboard = None

    def emit_key(self, code, down):
        # Only the first press and the last release reach the desktop, so two
        # controllers holding the same button don't confuse it.
        before = self.held.get(code, 0)
        after = before + 1 if down else max(0, before - 1)
        self.held[code] = after
        if (before == 0) == (after == 0) or not self.outputs_ready():
            return
        target = self.mouse if code in MOUSE_BUTTONS else self.keyboard
        target.write(e.EV_KEY, code, 1 if down else 0)
        target.syn()

    def release_all(self):
        for key in list(self.pressed):
            self.press(key, False)
        for code in [c for c, n in self.held.items() if n > 0]:
            self.held[code] = 1
            self.emit_key(code, False)
        self.move_rest = [0.0, 0.0]
        self.wheel_rest = [0.0, 0.0]
        self.notch_rest = [0, 0]

    def press(self, key, down):
        if down:
            codes = BUTTONS[key[1]][1]
            if key in self.pressed:
                return
            self.pressed[key] = codes
            for code in codes:
                self.emit_key(code, True)
        else:
            codes = self.pressed.pop(key, None)
            for code in reversed(codes or ()):
                self.emit_key(code, False)

    # -- controllers coming and going ---------------------------------------
    def rescan(self):
        try:
            paths = set(evdev.list_devices())
        except OSError:
            paths = set()
        for path in list(self.pads):
            if path not in paths:
                self.drop(path)
        self.ignored &= paths
        for path in sorted(paths - set(self.pads) - self.ignored):
            try:
                dev = evdev.InputDevice(path)
            except OSError:
                continue          # no permission (yet) or already gone
            if not is_gamepad(dev):
                dev.close()
                self.ignored.add(path)
                continue
            self.pads[path] = Pad(path, dev)
            self.selector.register(dev, selectors.EVENT_READ, path)
            log("controller connected: " + dev.name)

    def drop(self, path):
        pad = self.pads.pop(path, None)
        if not pad:
            return
        try:
            self.selector.unregister(pad.dev)
        except (KeyError, ValueError):
            pass
        try:
            pad.dev.close()
        except OSError:
            pass
        for key in [k for k in self.pressed if k[0] == path]:
            self.press(key, False)
        log("controller disconnected: " + path)

    # -- stepping aside for games and Steam -----------------------------------
    def check_pause(self):
        reason = None
        if game_running():
            reason = "a game is running"
        elif steam_signed_in():
            reason = "Steam is driving the controller"
        if reason != self.paused:
            self.paused = reason
            if reason:
                self.release_all()
                log("paused: " + reason)
            else:
                log("active")

    def set_manual_off(self, off):
        self.manual_off = off
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            if off:
                open(OFF_FLAG, "w").close()
            elif os.path.exists(OFF_FLAG):
                os.remove(OFF_FLAG)
        except OSError:
            pass
        if off:
            self.release_all()
            notify("Controller mouse off", "Press the Guide / PS / Home button to turn it back on.")
        else:
            notify("Controller mouse on", "Left stick moves the pointer, A clicks.")

    # -- input -----------------------------------------------------------------
    @staticmethod
    def toggle_osk():
        key = ["org.gnome.desktop.a11y.applications", "screen-keyboard-enabled"]
        try:
            now = subprocess.run(["gsettings", "get"] + key, capture_output=True,
                                 text=True, timeout=5).stdout.strip()
            subprocess.run(["gsettings", "set"] + key + ["false" if now == "true" else "true"],
                           timeout=5, check=False)
        except (OSError, subprocess.SubprocessError):
            pass

    def on_button(self, path, button, down):
        action = BUTTONS.get(button)
        if action is None:
            return
        kind = action[0]
        if kind == TOGGLE:
            if down and not self.paused:
                self.set_manual_off(not self.manual_off)
            return
        if down and (self.manual_off or self.paused):
            return
        if kind == OSK:
            if down:
                self.toggle_osk()
            return
        self.press((path, button), down)

    def on_event(self, pad, ev):
        if ev.type == e.EV_KEY:
            if ev.value in (0, 1):
                self.on_button(pad.path, ev.code, ev.value == 1)
        elif ev.type == e.EV_ABS:
            if ev.code in pad.hat:
                old, new = pad.hat[ev.code], ev.value
                if old != new:
                    pad.hat[ev.code] = new
                    if old:
                        self.on_button(pad.path, HAT[(ev.code, old)], False)
                    if new in (-1, 1):
                        self.on_button(pad.path, HAT[(ev.code, new)], True)
            elif ev.code in pad.axes:
                role = pad.set_axis(ev.code, ev.value)
                if role in (TRIGGER_L, TRIGGER_R):
                    button = e.BTN_TL2 if role == TRIGGER_L else e.BTN_TR2
                    value = pad.values[role]
                    if not pad.trigger_down[role] and value > TRIGGER_PRESS:
                        pad.trigger_down[role] = True
                        self.on_button(pad.path, button, True)
                    elif pad.trigger_down[role] and value < TRIGGER_RELEASE:
                        pad.trigger_down[role] = False
                        self.on_button(pad.path, button, False)

    def motion(self, dt):
        """Moves the pointer and scrolls; returns True while a stick is pushed."""
        mx = my = sx = sy = 0.0
        for pad in self.pads.values():
            x, y = pad.stick(STICK_LX, STICK_LY)
            mx += x
            my += y
            x, y = pad.stick(STICK_RX, STICK_RY)
            sx += x
            sy += y
        if not (mx or my or sx or sy):
            return False
        if self.manual_off or self.paused or not self.outputs_ready():
            return True

        self.move_rest[0] += mx * POINTER_SPEED * dt
        self.move_rest[1] += my * POINTER_SPEED * dt
        dx, dy = int(self.move_rest[0]), int(self.move_rest[1])
        self.move_rest[0] -= dx
        self.move_rest[1] -= dy
        if dx:
            self.mouse.write(e.EV_REL, e.REL_X, dx)
        if dy:
            self.mouse.write(e.EV_REL, e.REL_Y, dy)

        # Stick up scrolls up; the wheel counts "up" as positive.
        self.wheel_rest[0] += -sy * SCROLL_SPEED * dt
        self.wheel_rest[1] += sx * SCROLL_SPEED * dt
        for i, (hires, notch) in enumerate(((HI_RES_WHEEL, e.REL_WHEEL),
                                            (HI_RES_HWHEEL, e.REL_HWHEEL))):
            step = int(self.wheel_rest[i])
            if not step:
                continue
            self.wheel_rest[i] -= step
            if hires is not None:
                self.mouse.write(e.EV_REL, hires, step)
            self.notch_rest[i] += step
            notches = int(self.notch_rest[i] / 120)
            if notches:
                self.notch_rest[i] -= notches * 120
                self.mouse.write(e.EV_REL, notch, notches)
        self.mouse.syn()
        return True

    # -- main loop -------------------------------------------------------------
    def run(self):
        log("started" + (" (switched off - Guide button turns it on)" if self.manual_off else ""))
        next_scan = next_check = 0.0
        last = time.monotonic()
        moving = False
        while self.running:
            now = time.monotonic()
            if now >= next_scan:
                self.rescan()
                next_scan = now + RESCAN_EVERY
            if now >= next_check:
                if self.pads:
                    self.check_pause()
                next_check = now + CHECK_EVERY

            timeout = TICK if moving else 0.5
            for key, _ in self.selector.select(timeout):
                pad = self.pads.get(key.data)
                if not pad:
                    continue
                try:
                    for ev in pad.dev.read():
                        self.on_event(pad, ev)
                except BlockingIOError:
                    pass
                except OSError:
                    self.drop(pad.path)

            now = time.monotonic()
            moving = self.motion(min(now - last, 0.05))
            last = now

        self.release_all()
        self.close_outputs()
        for path in list(self.pads):
            self.drop(path)


def main():
    nav = Navigator()

    def stop(_signum, _frame):
        nav.running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    nav.run()


if __name__ == "__main__":
    main()
NIIXPADEOF
    chmod 755 /mnt/usr/local/bin/niix-padnav

    mkdir -p /mnt/etc/systemd/user
    cat > /mnt/etc/systemd/user/niix-padnav.service <<'PADUNITEOF'
[Unit]
Description=NiiX: game controllers move the pointer on the desktop
Documentation=file:///usr/local/bin/niix-padnav
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/niix-padnav
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
PADUNITEOF

    if arch-chroot /mnt systemctl --global enable niix-padnav.service 2>/dev/null; then
        log "Controllers drive the desktop when no game is running (Guide/PS button turns it off)"
    else
        warn "Could not enable niix-padnav - run: systemctl --user enable --now niix-padnav"
    fi
}

# -- Hardware profile and displays ------------------------------------
# niix-hardware works out what kind of machine this is at every boot and
# applies what follows from it (X3D cache cores). niix-display sets every
# monitor to its native resolution, highest refresh rate and VRR the first
# time it is connected.
setup_hardware_tools() {
    hr "Hardware Profile and Displays"

    niix_hardware_script > /mnt/usr/local/bin/niix-hardware
    niix_display_script > /mnt/usr/local/bin/niix-display
    chmod 755 /mnt/usr/local/bin/niix-hardware /mnt/usr/local/bin/niix-display

    cat > /mnt/etc/systemd/system/niix-hardware.service <<'HWSVCEOF'
[Unit]
Description=NiiX: detect the hardware and apply its settings
After=systemd-modules-load.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/niix-hardware apply

[Install]
WantedBy=multi-user.target
HWSVCEOF

    mkdir -p /mnt/etc/systemd/user
    cat > /mnt/etc/systemd/user/niix-display.service <<'DISPSVCEOF'
[Unit]
Description=NiiX: monitors at native resolution and highest refresh rate
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/niix-display
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
DISPSVCEOF

    if [[ ! -f /mnt/etc/niix/display.conf ]]; then
        mkdir -p /mnt/etc/niix
        cat > /mnt/etc/niix/display.conf <<'DISPCONFEOF'
# niix-display settings. Check the monitors with: niix-display status
#
#   VRR=on    variable refresh rate (FreeSync / G-Sync / Adaptive-Sync) on
#             monitors that support it
#   VRR=off   fixed refresh rate - use this if a monitor flickers
#
# Only monitors connected for the first time are set up; to apply a change
# to the ones already set up, run: niix-display reset
VRR=on
DISPCONFEOF
    fi

    if arch-chroot /mnt systemctl enable niix-hardware.service 2>/dev/null \
        && arch-chroot /mnt systemctl --global enable niix-display.service 2>/dev/null; then
        log "Hardware profile: $(machine_description)"
        log "Displays: native resolution, highest refresh rate, VRR where supported (niix-display status)"
    else
        warn "Could not enable niix-hardware / niix-display"
    fi
}

# -- Final initramfs build (MUST run after ALL packages) ------
rebuild_initramfs() {
    hr "Initramfs Rebuild"
    log "Writing final mkinitcpio.conf..."

    # mkinitcpio hooks. NOTE: NVIDIA modules are deliberately NOT forced here -
    # DKMS builds reliably only against the running kernel at first boot, so adding
    # them now risks an unbootable "module not found: nvidia" initramfs. The first
    # boot adds them once the module is confirmed built. The first boot runs on
    # nouveau, which is fine for reaching the desktop.
    cat > /mnt/etc/mkinitcpio.conf <<'MKINIT'
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap block encrypt btrfs filesystems fsck)
MKINIT
    # No 'consolefont' hook: no FONT= is configured in vconsole.conf, so the hook
    # would add nothing and only emit a warning on every rebuild.

    log "mkinitcpio.conf:"
    cat /mnt/etc/mkinitcpio.conf

    log "Rebuilding initramfs (final - after all packages)..."
    arch-chroot /mnt mkinitcpio -P \
        || err "initramfs build failed (mkinitcpio -P) - the system would not boot. Check the log."

    # Verify the image exists and really contains cryptsetup. The listing is
    # captured first (not piped into grep -q): under pipefail, grep exiting
    # early would SIGPIPE lsinitcpio and turn a match into a false failure.
    [[ -s /mnt/boot/initramfs-linux.img ]] \
        || err "initramfs-linux.img is missing or empty after mkinitcpio - check the log"
    local initrd_list
    initrd_list=$(arch-chroot /mnt lsinitcpio /boot/initramfs-linux.img 2>&1) || true
    if grep -q "cryptsetup" <<<"$initrd_list"; then
        log "initramfs contains cryptsetup - LUKS prompt will work"
    else
        {
            echo "--- lsinitcpio initramfs-linux.img ---"
            printf '%s\n' "$initrd_list"
        } >> "$LOGFILE" 2>&1
        err "cryptsetup NOT found in the initramfs - the encrypted root could not be unlocked. Check the log."
    fi
}

# -- Limine bootloader ----------------------------------------
install_limine() {
    hr "Limine Bootloader"
    log "Installing Limine bootloader..."

    # -- 1. Copy EFI binary -----------------------------------
    mkdir -p /mnt/boot/EFI/limine /mnt/boot/EFI/BOOT \
        || err "Could not create Limine directories on the EFI partition"
    cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/limine/BOOTX64.EFI \
        || err "Could not copy Limine to the EFI partition (full ESP?)"
    # Also install as the UEFI fallback path - many BIOSes boot this
    # automatically when no NVRAM entry is found or has been cleared
    cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/BOOT/BOOTX64.EFI \
        || err "Could not copy the Limine fallback loader to the EFI partition"
    log "BOOTX64.EFI copied (\EFI\limine\ + fallback \EFI\BOOT\)"

    # -- 2. Build kernel cmdline ------------------------------
    local CMDLINE="cryptdevice=UUID=${LUKS_UUID}:${MAPPER} root=/dev/mapper/${MAPPER} rootflags=subvol=@ rootfstype=btrfs rw"

    case "$CPU_VENDOR" in
        amd)   CMDLINE+=" amd_pstate=active split_lock_detect=off" ;;
        intel) CMDLINE+=" intel_pstate=active split_lock_detect=off" ;;
    esac
    [[ "$USE_MITIGATIONS" == false ]] && CMDLINE+=" mitigations=off"
    CMDLINE+=" usbhid.mousepoll=1"
    # quiet + loglevel=3: no kernel text scrolling past (faster on slow consoles,
    # and the disk password prompt is still shown). nowatchdog: no lockup
    # watchdog running on every core. zswap off: swap is already compressed
    # RAM (ZRAM) - compressing it a second time only costs CPU.
    CMDLINE+=" quiet loglevel=3 nowatchdog zswap.enabled=0"
    # Unlocks overclocking/undervolting (CoreCtrl) on AMD graphics cards: the
    # kernel default 0xfff7bfff plus the overdrive bit. 0xffffffff would also
    # turn on a power feature AMD keeps off on purpose (GPU hangs).
    [[ "$GPU_VENDOR" == amd && "$GPU_KIND" == discrete ]] && CMDLINE+=" amdgpu.ppfeaturemask=0xfff7ffff"
    # NVIDIA's modeset/fbdev options are set at first boot in modprobe.d (part
    # of the initramfs), once the driver is really installed.

    # -- 3. Write Limine config -------------------------------
    # Limine 8+ uses volume-relative paths - no boot() macro.
    # /boot IS the EFI partition, so vmlinuz-linux is at the EFI root.
    # Dual-boot: Windows is entry 1 and NiiX the default entry 2, with more
    # time to choose. default_entry is 1-based.
    local windows_entry="" default_entry=1 timeout=2 cfg dst
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        windows_entry=$'/Windows Boot Manager\n    protocol: efi\n    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi\n\n'
        default_entry=2
        timeout=5
    fi
    cfg="timeout: $timeout
interface_branding: NiiX Arch
interface_branding_colour: 6
interface_help_hidden: yes
default_entry: $default_entry

${windows_entry}/NiiX Arch
    protocol: linux
    path: boot():/vmlinuz-linux
    cmdline: $CMDLINE
    module_path: boot():/initramfs-linux.img"

    # Written to every location Limine searches.
    mkdir -p /mnt/boot/limine
    for dst in /mnt/boot/EFI/limine/limine.cfg /mnt/boot/EFI/limine/limine.conf \
               /mnt/boot/EFI/BOOT/limine.cfg  /mnt/boot/EFI/BOOT/limine.conf \
               /mnt/boot/limine/limine.cfg    /mnt/boot/limine/limine.conf \
               /mnt/boot/limine.cfg; do
        printf '%s\n' "$cfg" > "$dst" || err "Could not write the Limine config ($dst)"
    done
    log "limine.cfg written to all search locations"

    # -- 4. Purge all stale NiiX Arch / Limine NVRAM entries --
    # Previous installs leave entries pointing to GPT GUIDs that no longer
    # exist. These shadow the new entry and break the boot order silently.
    info "Removing stale NiiX Arch / Limine NVRAM entries..."
    remove_boot_entries "NiiX Arch|Limine"

    # -- 5. Register a single clean NVRAM entry ---------------
    if efibootmgr --create --disk "$EFI_DRIVE" --part "$EFI_PART_NUM" \
            --label "NiiX Arch (Limine)" --loader '\EFI\limine\BOOTX64.EFI' --unicode >/dev/null; then
        log "Limine registered in UEFI NVRAM"
    else
        warn "efibootmgr failed - BIOS will use fallback \EFI\BOOT\BOOTX64.EFI"
    fi

    # Pacman hooks
    mkdir -p /mnt/etc/pacman.d/hooks
    cat > /mnt/etc/pacman.d/hooks/limine.hook <<'HOOKEOF'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = limine

[Action]
Description = Updating Limine EFI binary...
When = PostTransaction
Exec = /bin/sh -c 'cp /usr/share/limine/BOOTX64.EFI /boot/EFI/limine/'
HOOKEOF

    cat > /mnt/etc/pacman.d/hooks/niixarch-limine.hook <<'HOOKEOF'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux
Target = linux-cachyos
Target = limine

[Action]
Description = Re-applying NiiX Arch Limine branding...
When = PostTransaction
Exec = /bin/bash -c "for f in /boot/limine.conf /boot/limine/limine.conf; do [ -f \"$f\" ] && sed -i 's|^/Arch Linux.*|/NiiX Arch|' \"$f\"; done"
HOOKEOF

    log "Pacman hooks created"
}

# -- First-boot script (AUR, GNOME settings, flatpaks) --------
setup_firstboot() {
    hr "First-Boot Setup"
    log "Setting up first-boot script..."

    # Temporary passwordless sudo for first-boot only.
    # Scoped to the specific user; removed by the firstboot script itself on completion.
    cat > /mnt/etc/sudoers.d/niixarch-firstboot <<SUDOEOF
# Temporary - grants ${USERNAME} passwordless sudo during first-boot setup.
# This file is automatically deleted when first-boot completes.
${USERNAME} ALL=(ALL) NOPASSWD: ALL
SUDOEOF
    chmod 440 /mnt/etc/sudoers.d/niixarch-firstboot
    arch-chroot /mnt visudo -cf /etc/sudoers.d/niixarch-firstboot >/dev/null \
        || { rm -f /mnt/etc/sudoers.d/niixarch-firstboot; err "Temporary first-boot sudo rule failed validation"; }
    log "Temporary passwordless sudo configured for first-boot"

    # Belt-and-suspenders: force-remove the drop-in 2h after boot regardless
    # of whether firstboot ever actually ran. The EXIT trap inside the
    # firstboot script (removes it on script death) and the cleanup at the
    # end of a successful run both only fire if firstboot actually launched -
    # neither covers "the autostart never fired at all", which would
    # otherwise leave passwordless root sitting there indefinitely.
    # The check never pulls sudo out from under a first boot that is still
    # running (a slow connection can push it past 2h), but has a hard 12h cap
    # so a first boot stuck waiting for a network can't hold root open forever.
    # First boot disables the timer itself when it finishes.
    install -d -m 755 /mnt/usr/local/lib/niixarch
    cat > /mnt/usr/local/lib/niixarch/sudo-expiry-check <<'EXPCEOF'
#!/bin/sh
# exit 0 = remove the temporary first-boot sudo rule now; 1 = not yet.
up=$(cut -d. -f1 /proc/uptime)
[ "$up" -ge 7200 ] || exit 1
[ "$up" -ge 43200 ] && exit 0
pgrep -f 'niixarch-firstboot[.]sh' >/dev/null 2>&1 && exit 1
exit 0
EXPCEOF
    chmod 755 /mnt/usr/local/lib/niixarch/sudo-expiry-check
    cat > /mnt/etc/systemd/system/niixarch-sudo-expiry.service <<'EXPEOF'
[Unit]
Description=NiiX first-boot passwordless sudo expiry (safety net)

[Service]
Type=oneshot
ExecCondition=/usr/local/lib/niixarch/sudo-expiry-check
ExecStart=/usr/bin/rm -f /etc/sudoers.d/niixarch-firstboot
EXPEOF
    cat > /mnt/etc/systemd/system/niixarch-sudo-expiry.timer <<'EXPTEOF'
[Unit]
Description=NiiX first-boot passwordless sudo expiry timer (safety net)

[Timer]
OnBootSec=2h
OnCalendar=*:0/15
AccuracySec=1min

[Install]
WantedBy=timers.target
EXPTEOF
    arch-chroot /mnt systemctl enable niixarch-sudo-expiry.timer 2>/dev/null || true
    log "Passwordless sudo expires after first boot (safety net: 2h if it never runs, 12h hard cap)"

    # Save hardware config for first-boot script
    # First boot 'source's this file, so every value is shell-quoted (%q): a
    # quote or '$' in a hardware name can never break it or run as code.
    {
        printf 'HAS_NVIDIA=%q\n' "$HAS_NVIDIA"
        printf 'FORM=%q\n' "$FORM"
        printf 'HANDHELD=%q\n' "$HANDHELD"
        printf 'IS_DUALBOOT=%s\n' "$([[ "$INSTALL_MODE" == "dualboot" ]] && echo true || echo false)"
    } > /mnt/etc/niixarch.conf

    # Write the first-boot script
    cat > /mnt/usr/local/bin/niixarch-firstboot.sh <<'FBEOF'
#!/bin/bash
# NiiX Arch First-Boot - CachyOS kernel, AUR packages, GNOME settings
# Run via autostart, or manually: bash /usr/local/bin/niixarch-firstboot.sh
set +e

source /etc/niixarch.conf 2>/dev/null || true

# Fail-safe: the temporary passwordless-sudo drop-in must never survive first-boot,
# however this script exits (success, error, or interruption). It is also removed
# explicitly at the end; this trap covers every early-exit path.
# sudo -n: if the rule is already gone, fail silently instead of prompting.
trap 'sudo -n rm -f /etc/sudoers.d/niixarch-firstboot 2>/dev/null || true' EXIT

GREEN='\033[38;5;118m'
PINK='\033[38;5;205m'
CYAN='\033[0;36m'; WHITE='\033[1;37m'; BOLD='\033[1m'; NC='\033[0m'
# -- UI kit (identical look to the installer phase) ----------------------------
C_GREEN=$'\033[38;5;118m'; C_PINK=$'\033[38;5;205m'; C_WHITE=$'\033[38;5;255m'
C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_YEL=$'\033[38;5;215m'; C_NC=$'\033[0m'
if { exec 3>/dev/tty; } 2>/dev/null; then :; else exec 3>&1; fi
ui_hr()    { printf '  %s────────────────────────────────────────────────%s\n' "$C_GREEN" "$C_NC"; }
ui_ok()    { printf '  %s✔%s  %s%s%s\n' "$C_GREEN" "$C_NC" "$C_WHITE" "$*" "$C_NC"; }
ui_info()  { printf '  %s•%s  %s%s%s\n' "$C_PINK"  "$C_NC" "$C_WHITE" "$*" "$C_NC"; }
ui_warn()  { printf '  %s!%s  %s%s%s\n' "$C_YEL"   "$C_NC" "$C_WHITE" "$*" "$C_NC"; }
ui_bar() {
    local cur=$1 tot=$2 label=${3:-} width=28 i fill pct done_="" todo_=""
    [ "$tot" -gt 0 ] 2>/dev/null || tot=1
    [ "$cur" -gt "$tot" ] 2>/dev/null && cur=$tot
    pct=$(( cur * 100 / tot )); fill=$(( cur * width / tot ))
    for ((i=0;i<fill;i++)); do done_+='█'; done
    for ((i=fill;i<width;i++)); do todo_+='░'; done
    printf '\r  %s[%s%s%s%s%s]%s %s%3d%%%s  %s%s%s' \
        "$C_PINK" "$C_GREEN" "$done_" "$C_DIM" "$todo_" "$C_NC" "$C_PINK" \
        "$C_WHITE" "$pct" "$C_NC" "$C_DIM" "$label" "$C_NC" >&3
    [ "$cur" -ge "$tot" ] && printf '\n' >&3
}
niixa_banner() {
    clear 2>/dev/null || true
    local g="$C_GREEN" p="$C_PINK" n="$C_NC" w="$C_WHITE" d="$C_DIM" b="$C_BOLD"
    printf '\n'
    printf '  %s███╗   ██╗██╗██╗██╗  ██╗ █████╗ %s██████╗ ███████╗%s\n' "$g" "$p" "$n"
    printf '  %s████╗  ██║██║██║╚██╗██╔╝██╔══██╗%s██╔═══██╗██╔════╝%s\n' "$g" "$p" "$n"
    printf '  %s██╔██╗ ██║██║██║ ╚███╔╝ ███████║%s██║   ██║███████╗%s\n' "$g" "$p" "$n"
    printf '  %s██║╚██╗██║██║██║ ██╔██╗ ██╔══██║%s██║   ██║╚════██║%s\n' "$g" "$p" "$n"
    printf '  %s██║ ╚████║██║██║██╔╝ ██╗██║  ██║%s╚██████╔╝███████║%s\n' "$g" "$p" "$n"
    printf '  %s╚═╝  ╚═══╝╚═╝╚═╝╚═╝  ╚═╝╚═╝  ╚═╝%s ╚═════╝ ╚══════╝%s\n' "$g" "$p" "$n"
    printf '\n'
    printf '  %s%s%s%s   %sluks2 · cachyos · limine · btrfs · gnome%s\n' "$b" "$w" "${1:-first boot}" "$n" "$d" "$n"
    ui_hr
    printf '\n'
}
log()  { ui_ok "$@"; }
warn() { ui_warn "$@"; }
info() { ui_info "$@"; }

# Retry pacman for transient mirror/CDN errors (e.g. CachyOS 404s). Refreshes the
# package databases between attempts; pacman is transactional, so a failed attempt
# installs nothing and a retry starts clean.
pac_retry() {
    local n=1
    until sudo pacman "$@"; do
        if [ "$n" -ge 3 ]; then
            warn "pacman failed after $n attempts: $*"
            return 1
        fi
        warn "Mirror error - refreshing databases and retrying ($n/3)..."
        # force-refresh DBs AND upgrade (never -Syy alone: re-running -S after a
        # bare refresh is a partial upgrade). This only runs on the retry path.
        sudo pacman -Syyu --noconfirm 2>/dev/null || true
        sleep 3
        n=$((n + 1))
    done
    return 0
}

LOG="$HOME/niixarch-firstboot-$(date +%Y%m%d-%H%M%S).log"
# Private: the log can contain a generated hotspot password.
( umask 077; : > "$LOG" )
exec > >(tee -a "$LOG") 2>&1

niixa_banner "first boot"

# -- Resumable state --------------------------------------
# First-boot re-runs on the next login if it crashes before writing its
# done-marker. Stamp each expensive step so a resumed run skips work that
# already succeeded instead of repeating a 15-minute package storm.
STATE_DIR="$HOME/.local/state/niixarch"
mkdir -p "$STATE_DIR"
step_done() { [ -f "$STATE_DIR/$1.done" ]; }
mark_step()  { touch "$STATE_DIR/$1.done"; }
# run_once STAMP cmd... : skip if already done, else run and stamp on success.
run_once() {
    local stamp="$1"; shift
    if step_done "$stamp"; then
        info "Already done: $stamp - skipping"
        return 0
    fi
    if "$@"; then
        mark_step "$stamp"
        return 0
    fi
    return 1
}

# retry3 LABEL cmd... : up to 3 tries, 5s apart - for network installs where
# a DNS hiccup or CDN timeout is the usual reason for a failure.
retry3() {
    local label="$1" attempt; shift
    for attempt in 1 2 3; do
        "$@" && return 0
        (( attempt < 3 )) || break
        warn "$label: attempt $attempt/3 failed, retrying in 5s..."
        sleep 5
    done
    warn "$label failed after 3 attempts"
    return 1
}

# -- Disable CoW on the Steam library (Btrfs) -------------
# Large, frequently-rewritten game files fragment badly under Btrfs copy-on-write.
# +C only affects NEW files and only when set on an EMPTY dir, so create the
# library dir now (before Steam's first run) and flag it so every game inherits
# nodatacow. Existing files are never retro-converted; safe if not on Btrfs.
if [ ! -d "$HOME/.local/share/Steam" ] && { stat -f -c %T "$HOME" 2>/dev/null | grep -qi btrfs; }; then
    mkdir -p "$HOME/.local/share/Steam"
    if chattr +C "$HOME/.local/share/Steam" 2>/dev/null; then
        log "Btrfs CoW disabled on Steam library (less fragmentation, faster game IO)"
    else
        warn "Could not set nodatacow on the Steam library - continuing"
    fi
fi

# ========================================================
# PHASE 1 - Offline setup (no internet required)
# Runs immediately so the desktop looks right straight away.
# ========================================================

# -- GNOME settings ---------------------------------------
info "Applying GNOME settings..."
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark' 2>/dev/null || true
gsettings set org.gnome.desktop.interface icon-theme 'NiiX' 2>/dev/null || true
# Desktop: animations on, standard dynamic workspaces.
gsettings set org.gnome.desktop.interface enable-animations true 2>/dev/null || true
# Laptops and handhelds: tap the touchpad to click.
case "${FORM:-}" in
    laptop|handheld) gsettings set org.gnome.desktop.peripherals.touchpad tap-to-click true 2>/dev/null || true ;;
esac
# Fractional scaling (125%, 150%...) and variable refresh rate: built in from
# GNOME 50, experimental switches before that. Only names this GNOME knows are
# written - an unknown one would make GNOME ignore the whole setting.
niix_mutter_features=()
for feature in scale-monitor-framebuffer xwayland-native-scaling variable-refresh-rate; do
    gsettings range org.gnome.mutter experimental-features 2>/dev/null | grep -qxE "'?$feature'?" \
        && niix_mutter_features+=("'$feature'")
done
if (( ${#niix_mutter_features[@]} )); then
    gsettings set org.gnome.mutter experimental-features \
        "[$(IFS=,; echo "${niix_mutter_features[*]}")]" 2>/dev/null || true
fi
gsettings set org.gnome.desktop.sound event-sounds false 2>/dev/null || true
# Disable GNOME's donation-reminder popup
gsettings set org.gnome.settings-daemon.plugins.housekeeping donation-reminder-enabled false 2>/dev/null || true
gsettings set org.gnome.desktop.session idle-delay 0 2>/dev/null || true
gsettings set org.gnome.settings-daemon.plugins.power power-button-action 'interactive' 2>/dev/null || true
gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing' 2>/dev/null || true
gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'suspend' 2>/dev/null || true
gsettings set org.gnome.mutter dynamic-workspaces false 2>/dev/null || true
gsettings set org.gnome.desktop.wm.preferences num-workspaces 1 2>/dev/null || true
gsettings set org.gnome.mutter edge-tiling true 2>/dev/null || true
gsettings set org.gnome.desktop.interface enable-hot-corners false 2>/dev/null || true
gsettings set org.gnome.desktop.notifications show-in-lock-screen false 2>/dev/null || true
# Pink accent (NiiX).
gsettings set org.gnome.desktop.interface accent-color 'pink' 2>/dev/null || true
gsettings set org.gnome.desktop.interface show-battery-percentage true 2>/dev/null || true
gsettings set org.gnome.desktop.interface clock-show-weekday true 2>/dev/null || true
# Windows-style titlebar buttons (min/max/close) - matches dash-to-panel look.
gsettings set org.gnome.desktop.wm.preferences button-layout 'appmenu:minimize,maximize,close' 2>/dev/null || true

# ddterm (drop-down terminal) is bound to F12 and Ctrl+Alt+T in PHASE 3,
# after the extension is installed from the AUR.

# Enable AppIndicator (tray icons). The panel and auto-rotate
# extensions are installed + enabled in PHASE 3 (need internet).
gnome-extensions enable appindicatorsupport@rgcjonas.gmail.com 2>/dev/null || true
log "GNOME settings applied"

# -- Wi-Fi hotspot: optional auto mode -------------------
# Kept up from boot by a root service (niix-hotspot-watchdog): internet checked
# every 2 min (every 5s while offline), hotspot restored as soon as the
# internet is back. Change later with: niix-hotspot auto on|off
echo ""
read -rp "Keep a Wi-Fi hotspot up automatically (from boot, restored after internet outages)? Needs Ethernet or USB tethering as the internet source. [y/N]: " HOTSPOT_ENABLE
if [[ "$HOTSPOT_ENABLE" =~ ^[Yy]$ ]]; then
    while true; do
        read -rp "Hotspot SSID [NiiX-Arch]: " HOTSPOT_SSID
        HOTSPOT_SSID="${HOTSPOT_SSID:-NiiX-Arch}"
        [ "$(printf '%s' "$HOTSPOT_SSID" | wc -c)" -le 32 ] && break
        echo "SSID must be at most 32 bytes - try again."
    done
    while true; do
        read -rsp "Hotspot password, 8-63 characters [leave blank for a random one]: " HOTSPOT_PASS
        echo ""
        [ -z "$HOTSPOT_PASS" ] && break
        [ "${#HOTSPOT_PASS}" -ge 8 ] && [ "${#HOTSPOT_PASS}" -le 63 ] && break
        echo "Password must be 8-63 characters - try again."
    done
    # Saved only in NetworkManager's root-only profile. 'setup' does NOT bring
    # the hotspot up: switching Wi-Fi to hotspot mode now could cut the
    # internet the rest of this first-boot needs. It comes up after the reboot.
    if sudo niix-hotspot setup "$HOTSPOT_SSID" "$HOTSPOT_PASS"; then
        # Exactly the command a user runs later - one code path, one behaviour.
        if sudo niix-hotspot auto on; then
            log "Hotspot '${HOTSPOT_SSID}' auto mode ON (show password: niix-hotspot password)"
        else
            warn "Could not enable hotspot auto mode - enable later: niix-hotspot auto on"
        fi
    else
        warn "Hotspot setup failed (no Wi-Fi adapter?) - set it up later: niix-hotspot start [SSID] [PASSWORD]"
    fi
    unset HOTSPOT_PASS
else
    log "Hotspot auto mode skipped - turn it on any time with: niix-hotspot start [SSID] [PASSWORD]"
    log "  (that also enables auto mode, so it behaves exactly as if chosen here)"
fi

# -- vim: not part of NiiX (GNOME Text Editor + nano are the editors) --------
# Only removed when nothing else needs it - an -Rns that would cascade into
# other packages is not worth it for a text editor.
if pacman -Q vim &>/dev/null; then
    if ! pacman -Qi vim 2>/dev/null | grep -q '^Required By *: *None'; then
        info "vim kept: another installed package requires it"
    elif sudo pacman -Rns --noconfirm vim >/dev/null 2>&1; then
        log "vim removed (Text Editor and nano are the defaults)"
    else
        warn "Could not remove vim - harmless, it is just unused"
    fi
fi

