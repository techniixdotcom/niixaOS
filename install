# -- Wait for network --------------------------------------
info "Checking network connectivity..."

_nm_connected() {
    nmcli -t -f CONNECTIVITY general 2>/dev/null | grep -q "^full$"
}

if _nm_connected; then
    log "Network ready"
else
    info "Waiting for network connectivity (no timeout - will wait as long as needed)..."
    attempt=0
    until _nm_connected; do
        attempt=$(( attempt + 1 ))
        echo -ne "\r  -  Waiting for network... (attempt $attempt)"
        sleep 3
    done
    echo ""
    log "Network ready"
fi

# ========================================================
# PHASE 3 - Internet-dependent setup
# ========================================================

# -- Pre-storm restore point (Btrfs) ----------------------
# Take a read-only snapshot of the freshly-installed base RIGHT BEFORE the risky
# online storm (kernel swap, AUR builds, GPU drivers). The @clean snapshot made
# later is the "known-good final state"; this one covers the window before it
# exists, so a wedged storm can be rolled back. Snapshots are instant and nearly
# free on Btrfs. Non-fatal and taken once (survives a resumed run).
if ! step_done pre-apps-snapshot && stat -f -c %T / 2>/dev/null | grep -qi btrfs; then
    SNAP="/.snapshots/pre-apps-$(date +%Y%m%d-%H%M%S)"
    if sudo btrfs subvolume snapshot -r / "$SNAP" 2>/dev/null; then
        mark_step pre-apps-snapshot
        log "Pre-install restore point: $SNAP"
        info "Roll back later from a live ISO or the 'clean state' boot entry if needed."
    else
        warn "Could not create pre-install snapshot - continuing"
    fi
fi

# -- Wallpaper ---------------------------------------------
# curl's own --retry only covers HTTP/timeout errors, NOT DNS resolution
# failures (exit code 6) - which is exactly the failure class that's bitten
# this install before. Wrap it in an outer retry loop too.
info "Downloading NiiX Arch wallpaper..."
mkdir -p "$HOME/Pictures"
WALLPAPER_OK=false
for n in 1 2 3; do
    if curl -fL --retry 3 --retry-delay 2 -o "$HOME/Pictures/niix-background.png" \
        "https://niixa.org/niix-background.png" 2>/dev/null \
        && [ -s "$HOME/Pictures/niix-background.png" ]; then
        WALLPAPER_OK=true
        break
    fi
    [ "$n" -lt 3 ] && sleep 3
done
if [ "$WALLPAPER_OK" = "true" ]; then
    log "Wallpaper downloaded"
else
    warn "Could not download wallpaper after retries - set manually later"
fi

if [ -f "$HOME/Pictures/niix-background.png" ]; then
    gsettings set org.gnome.desktop.background picture-uri \
        "file://$HOME/Pictures/niix-background.png" 2>/dev/null || true
    gsettings set org.gnome.desktop.background picture-uri-dark \
        "file://$HOME/Pictures/niix-background.png" 2>/dev/null || true
    gsettings set org.gnome.desktop.background picture-options 'zoom' 2>/dev/null || true
    log "Wallpaper set"
fi

# -- NiiX desktop (panel + start menu + flat icons) -------
# dash-to-panel (bottom taskbar) + ArcMenu (start menu, NiiX logo) + Screen Autorotate
# Screen Autorotate (360 deg laptops). Extensions are pulled
# from extensions.gnome.org at the version matching the running GNOME Shell,
# so this stays correct as GNOME updates.
info "Installing NiiX desktop extensions..."
SHELL_VER=$(gnome-shell --version 2>/dev/null | grep -oE '[0-9]+' | head -1)
EXT_DIR="$HOME/.local/share/gnome-shell/extensions"
mkdir -p "$EXT_DIR"

ego_install() {
    # $1 = extension UUID; installs the version compatible with $SHELL_VER.
    # Retries through transient extensions.gnome.org/CDN blips instead of
    # giving up after one failed curl - this exact failure killed
    # dash-to-panel on a prior run (single fetch attempt, no retry).
    local uuid="$1" meta url n
    for n in 1 2 3; do
        meta=$(curl -sf "https://extensions.gnome.org/extension-info/?uuid=${uuid}&shell_version=${SHELL_VER}" 2>/dev/null)
        if [ -n "$meta" ]; then
            url=$(printf '%s' "$meta" | python3 -c 'import sys,json
try:
    print(json.load(sys.stdin).get("download_url","") or "")
except Exception:
    print("")' 2>/dev/null)
            if [ -n "$url" ] \
                && curl -sfL -o "/tmp/${uuid}.zip" "https://extensions.gnome.org${url}" 2>/dev/null; then
                gnome-extensions install --force "/tmp/${uuid}.zip" 2>/dev/null
                local rc=$?
                rm -f "/tmp/${uuid}.zip"
                return $rc
            fi
        fi
        [ "$n" -lt 3 ] && sleep 3
    done
    return 1
}

EXT_LIST=(
    dash-to-panel@jderose9.github.com
    arcmenu@arcmenu.com
    screen-rotate@shyzus.github.io
    tiling-assistant@leleat-on-github
)
ext_total=${#EXT_LIST[@]}; ext_i=0; ext_failed=()
ui_bar 0 "$ext_total" "extensions"
for ext in "${EXT_LIST[@]}"; do
    ego_install "$ext" >>"$LOG" 2>&1 || ext_failed+=("$ext")
    ext_i=$((ext_i + 1))
    ui_bar "$ext_i" "$ext_total" "${ext%%@*}"
done
if [ "${#ext_failed[@]}" -eq 0 ]; then
    log "Extensions installed: dash-to-panel, ArcMenu, screen-rotate, Tiling Assistant"
else
    for e in "${ext_failed[@]}"; do warn "Could not fetch $e from extensions.gnome.org"; done
    # Fallback: dash-to-panel and ArcMenu are also packaged (signed) in Arch's
    # extra repo under the same UUIDs, installed system-wide - so the NiiX
    # panel still comes up if extensions.gnome.org is down or has no build
    # for this Shell version yet. (screen-rotate has its own fallback below.)
    for e in "${ext_failed[@]}"; do
        case "$e" in
            dash-to-panel@jderose9.github.com) fb_pkg=gnome-shell-extension-dash-to-panel ;;
            arcmenu@arcmenu.com)               fb_pkg=gnome-shell-extension-arc-menu ;;
            *)                                 fb_pkg="" ;;
        esac
        [ -n "$fb_pkg" ] || continue
        if pac_retry -S --noconfirm --needed "$fb_pkg"; then
            log "Installed $e from the Arch repos ($fb_pkg)"
        else
            warn "$e unavailable from both extensions.gnome.org and the repos - panel will be vanilla GNOME until it is installed"
        fi
    done
fi

# Source fallbacks for the two extensions not packaged in the repos. Their
# upstream build step is only schema compilation, so a checked-out copy is a
# complete extension. Tiling Assistant is pinned to a release tag.
# ext_from_git UUID REPO [TAG]
ext_from_git() {
    local uuid="$1" repo="$2" tag="${3:-}" tmp
    [ -d "$EXT_DIR/$uuid" ] && return 0
    info "Installing $uuid from source (fallback)..."
    tmp=$(mktemp -d) || return 1
    if git clone --depth 1 ${tag:+--branch "$tag"} "$repo" "$tmp/src" 2>/dev/null \
        && [ -f "$tmp/src/$uuid/metadata.json" ]; then
        cp -r "$tmp/src/$uuid" "$EXT_DIR/"
        [ -d "$EXT_DIR/$uuid/schemas" ] && glib-compile-schemas "$EXT_DIR/$uuid/schemas" 2>/dev/null
        log "$uuid installed from source"
    else
        warn "$uuid unavailable from source as well"
    fi
    rm -rf "$tmp"
}
ext_from_git screen-rotate@shyzus.github.io \
    https://github.com/shyzus/gnome-shell-extension-screen-autorotate.git
ext_from_git tiling-assistant@leleat-on-github \
    https://github.com/Leleat/Tiling-Assistant.git v55 \
    || true

