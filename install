class AccountPage(Page):
    title = "Your account"

    def __init__(self, win):
        super().__init__(win)
        grid = Gtk.Grid(column_spacing=16, row_spacing=10)
        self.hostname = Gtk.Entry(text=DEFAULT_HOSTNAME, placeholder_text=DEFAULT_HOSTNAME, hexpand=True)
        self.username = Gtk.Entry(placeholder_text="e.g. alex", hexpand=True)
        self.password = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
        self.again = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
        rows = (("Computer name", self.hostname), ("Username", self.username),
                ("Password", self.password), ("Password again", self.again))
        for i, (text, entry) in enumerate(rows):
            grid.attach(label(text, wrap=False), 0, i, 1, 1)
            grid.attach(entry, 1, i, 1, 1)
            entry.connect("changed", self.changed)
        self.append(grid)
        self.append(label("The password is for logging in, for administrator tasks (sudo) and "
                          "for the root account. After the disk password at startup, the "
                          "desktop opens without asking for it.", ("dim",)))
        self.problem = label(css=("error",))
        self.append(self.problem)

    def host(self):
        return self.hostname.get_text().strip() or DEFAULT_HOSTNAME

    def changed(self, *_args):
        password, again = self.password.get_text(), self.again.get_text()
        if again and password != again:
            self.problem.set_text("The passwords do not match.")
        elif any(c in password for c in "\r\n"):
            self.problem.set_text("The password cannot contain line breaks.")
        else:
            self.problem.set_text("")
        super().changed()

    def ready(self):
        password = self.password.get_text()
        return bool(self.username.get_text().strip() and password and password == self.again.get_text()
                    and not any(c in password for c in "\r\n"))

    def validate(self):
        problem = check_account(self.win.installer, self.host(), self.username.get_text().strip())
        if problem is None:
            return True
        field, text = problem
        self.problem.set_text(("Computer name: " if field == "hostname" else "Username: ") + text)
        (self.hostname if field == "hostname" else self.username).grab_focus()
        return False


class DiskPasswordPage(Page):
    title = "Disk password"

    def __init__(self, win):
        super().__init__(win)
        self.append(label("The whole install is encrypted. This password is asked every time the "
                          "computer starts, before anything else loads - without it nobody can read "
                          "your files, and nobody can recover them if it is lost.", ("dim",)))
        grid = Gtk.Grid(column_spacing=16, row_spacing=10)
        self.password = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
        self.again = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
        for i, (text, entry) in enumerate((("Disk password", self.password), ("Password again", self.again))):
            grid.attach(label(text, wrap=False), 0, i, 1, 1)
            grid.attach(entry, 1, i, 1, 1)
            entry.connect("changed", self.changed)
        self.append(grid)
        self.layout = label(css=("dim",))
        self.append(self.layout)
        self.problem = label(css=("error",))
        self.append(self.problem)

    def enter(self):
        name, layout = self.win.pages["keyboard"].choice()
        typed = "US English" if layout == "us" else name
        self.layout.set_text(f"At startup it is typed with the {typed} keyboard layout - "
                             "the layout you are typing with now.")

    def changed(self, *_args):
        password, again = self.password.get_text(), self.again.get_text()
        if password and len(password) < MIN_DISK_PASSWORD:
            self.problem.set_text(f"Use at least {MIN_DISK_PASSWORD} characters - "
                                  "it is the only thing protecting the disk.")
        elif again and password != again:
            self.problem.set_text("The passwords do not match.")
        elif any(c in password for c in "\r\n"):
            self.problem.set_text("The password cannot contain line breaks.")
        else:
            self.problem.set_text("")
        super().changed()

    def ready(self):
        password = self.password.get_text()
        return (len(password) >= MIN_DISK_PASSWORD and password == self.again.get_text()
                and not any(c in password for c in "\r\n"))


class PerformancePage(Page):
    title = "CPU vulnerability mitigations"

    def __init__(self, win):
        super().__init__(win)
        self.append(label("Modern CPUs have protections against side-channel attacks that cost "
                          "some speed. There is no default - pick one.", ("dim",)))
        self.off = Gtk.CheckButton(label="OFF - maximum performance (about 5-10% more FPS)")
        self.on = Gtk.CheckButton(label="ON - keep the protections (safer for banking and crypto)")
        self.on.set_group(self.off)
        for check in (self.off, self.on):
            check.connect("toggled", self.changed)
            self.append(check)
        self.append(label("Turning them off reduces protection against side-channel attacks.", ("dim",)))

    def choice(self):
        if self.off.get_active():
            return "off"
        if self.on.get_active():
            return "on"
        return None

    def ready(self):
        return self.choice() is not None


HOTSPOT_NAME = re.compile(r"[A-Za-z0-9._-](?:[A-Za-z0-9 ._-]{0,30}[A-Za-z0-9._-])?")


def hotspot_problem(name, password):
    """None when the hotspot settings work, else what is wrong (the installer checks the same)."""
    if not HOTSPOT_NAME.fullmatch(name):
        return ("The name must be 1-32 letters, digits, spaces, dots, dashes or underscores "
                "(no space at the start or end).")
    if (not 8 <= len(password) <= 63 or any(not " " <= c <= "~" for c in password)
            or password != password.strip(" ")):
        return "The password must be 8-63 characters (letters, digits and symbols - no space at the start or end)."
    return None


def random_password(length=16):
    alphabet = string.ascii_letters + string.digits
    return "".join(secrets.choice(alphabet) for _ in range(length))


class HotspotPage(Page):
    title = "Wi-Fi hotspot"

    def __init__(self, win):
        super().__init__(win)
        self.append(label("Share this computer's internet with phones, consoles and other devices. "
                          "Once set up, the hotspot comes on by itself whenever this computer is online.",
                          ("dim",)))
        self.off = Gtk.CheckButton(label="No hotspot")
        self.on = Gtk.CheckButton(label="Set up a hotspot")
        self.on.set_group(self.off)
        self.off.set_active(True)
        for check in (self.off, self.on):
            check.connect("toggled", self.changed)
            self.append(check)
        self.grid = Gtk.Grid(column_spacing=16, row_spacing=10, margin_start=28)
        self.name = Gtk.Entry(text=DEFAULT_HOTSPOT_NAME, max_length=32, hexpand=True)
        self.password = Gtk.Entry(text=random_password(), max_length=63, hexpand=True)
        for i, (text, entry) in enumerate((("Name", self.name), ("Password", self.password))):
            self.grid.attach(label(text, wrap=False), 0, i, 1, 1)
            self.grid.attach(entry, 1, i, 1, 1)
            entry.connect("changed", self.changed)
        self.append(self.grid)
        self.append(label("When this computer is on Wi-Fi itself, the hotspot shares that connection "
                          "on the same card - most cards can do this. Cards that can't need Ethernet "
                          "or USB tethering for the hotspot to come on. Show the password later with: "
                          "niix-hotspot password", ("dim",)))
        self.problem = label(css=("error",))
        self.append(self.problem)
        self.grid.set_sensitive(False)

    def wanted(self):
        return self.on.get_active()

    def changed(self, *_args):
        self.grid.set_sensitive(self.wanted())
        problem = hotspot_problem(self.name.get_text(), self.password.get_text()) if self.wanted() else None
        self.problem.set_text(problem or "")
        super().changed()

    def ready(self):
        return not self.wanted() or hotspot_problem(self.name.get_text(), self.password.get_text()) is None

    def answers(self):
        if not self.wanted():
            return {}
        return {"HOTSPOT_SSID": self.name.get_text(), "HOTSPOT_PASS": self.password.get_text()}

    def summary(self):
        if not self.wanted():
            return "Off"
        return f"'{self.name.get_text()}' - password {self.password.get_text()}"


class SummaryPage(Page):
    title = "Ready to install"
    next_label = "Install"

    def __init__(self, win):
        super().__init__(win)
        self.grid = Gtk.Grid(column_spacing=24, row_spacing=6, margin_start=14, margin_top=10, margin_bottom=10)
        self.append(scrolled(self.grid, 200))
        self.notes = label(css=("warning",))
        self.append(self.notes)
        self.warning = label(css=("error",))
        self.append(self.warning)
        self.agree = Gtk.CheckButton(label="I understand - start the install")
        self.agree.connect("toggled", self.changed)
        self.append(self.agree)

    def enter(self):
        win, probe = self.win, self.win.probe
        pages = win.pages
        mode = win.mode()
        mitigations = pages["performance"].choice()
        rows = [
            ("Computer", probe.machine or "unknown"),
            ("Graphics", probe.gpu or "not detected"),
            ("Install", "Next to Windows (dual-boot)" if mode == "dualboot" else "NiiX Arch only (single-boot)"),
            ("Disk", pages["disk"].summary()),
            ("Encryption", "LUKS2, Btrfs with snapshots"),
            ("Keyboard", pages["keyboard"].choice()[0]),
            ("Time zone", pages["timezone"].choice()),
            ("Computer name", pages["account"].host()),
            ("Username", pages["account"].username.get_text().strip()),
            ("Mitigations", "OFF (maximum performance)" if mitigations == "off" else "ON"),
        ]
        if "hotspot" in pages:
            rows.append(("Wi-Fi hotspot", pages["hotspot"].summary()))
        while child := self.grid.get_first_child():
            self.grid.remove(child)
        for i, (name, value) in enumerate(rows):
            self.grid.attach(label(name, ("dim",), wrap=False), 0, i, 1, 1)
            self.grid.attach(label(value), 1, i, 1, 1)
        notes = [f"Auto-login: after the disk password the desktop opens as "
                 f"'{pages['account'].username.get_text().strip()}' (an administrator) without a second password."]
        if mitigations == "off":
            notes.append("CPU mitigations are OFF: side-channel protections are disabled for FPS.")
        if pages["disk"].kernels:
            notes.append("The other Linux install's boot files on the EFI partition are replaced.")
        self.notes.set_text("\n".join(notes))
        if mode == "dualboot" and pages["disk"].kind == "region":
            self.warning.remove_css_class("error")
            self.warning.add_css_class("dim")
            self.warning.set_text("Only the free space is used - Windows and your files are safe.")
        else:
            self.warning.remove_css_class("dim")
            self.warning.add_css_class("error")
            self.warning.set_text(pages["disk"].summary() + ". This cannot be undone.")
        self.agree.set_active(False)

    def ready(self):
        return self.agree.get_active()


class ProgressPage(Page):
    title = "Installing NiiX Arch"

    def __init__(self, win):
        super().__init__(win)
        self.step = label("Starting...", ("step",))
        self.append(self.step)
        self.bar = GradientBar()
        self.bar.set_margin_top(10)
        self.append(self.bar)
        self.percent = label("0%", ("percent",))
        self.append(self.percent)
        self.append(label("This takes about 10-30 minutes. Keep the computer plugged in and online.", ("dim",)))
        self.view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                 wrap_mode=Gtk.WrapMode.CHAR, top_margin=8, left_margin=8, right_margin=8)
        self.view.add_css_class("log")
        self.buffer = self.view.get_buffer()
        self.end = self.buffer.create_mark("end", self.buffer.get_end_iter(), False)
        self.details = Gtk.Expander(label="Details", vexpand=True)
        self.details.set_child(scrolled(self.view, 180))
        self.append(self.details)

    def add_lines(self, lines):
        self.buffer.insert(self.buffer.get_end_iter(), "\n".join(lines) + "\n")
        extra = self.buffer.get_line_count() - LOG_VIEW_LINES
        if extra > 0:
            self.buffer.delete(self.buffer.get_start_iter(), self.buffer.get_iter_at_line(extra)[1])
        if self.details.get_expanded():
            self.view.scroll_to_mark(self.end, 0.0, False, 0.0, 1.0)

    def report(self, step, fraction):
        if step:
            self.step.set_text(step)
        self.bar.set_fraction(fraction)
        self.percent.set_text(f"{int(self.bar.target * 100)}%")


class FinishedPage(Page):
    def __init__(self, win, success, message=""):
        self.title = "NiiX Arch is installed" if success else "The install stopped"
        super().__init__(win)
        if success:
            bar = GradientBar()
            bar.target = bar.shown = 1.0
            self.append(bar)
            self.append(label(
                "Restart the computer and remove the USB stick when the screen goes dark.\n\n"
                "At the boot menu pick NiiX Arch, then type your disk password - everything is "
                "already set up, the desktop opens ready to use.", ("dim",)))
        else:
            self.append(label(message or "The installer stopped unexpectedly.", ("error",)))
            self.append(label("Nothing more will be changed. Save the log if you want to ask for help, "
                              "then start the installer again.", ("dim",)))
            view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                wrap_mode=Gtk.WrapMode.CHAR, top_margin=8, left_margin=8, right_margin=8)
            view.add_css_class("log")
            buffer = view.get_buffer()
            buffer.set_text("\n".join(win.log[-300:]))
            end = buffer.create_mark(None, buffer.get_end_iter(), False)
            view.connect("map", lambda v: GLib.idle_add(v.scroll_to_mark, end, 0.0, False, 0.0, 1.0))
            self.append(scrolled(view, 160))
        self.problem = label(css=("error",))
        self.append(self.problem)
        buttons = Gtk.Box(spacing=10, margin_top=10)
        if success:
            restart = Gtk.Button(label="Restart now")
            restart.add_css_class("primary")
            restart.connect("clicked", self.restart)
            buttons.append(restart)
        else:
            again = Gtk.Button(label="Start over")
            again.add_css_class("primary")
            again.connect("clicked", lambda *_: win.start_over())
            buttons.append(again)
        save = Gtk.Button(label="Save the log...")
        save.connect("clicked", self.save_log)
        buttons.append(save)
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda *_: win.close())
        buttons.append(close)
        self.append(buttons)

    def restart(self, _button):
        try:
            subprocess.Popen(as_root(["/usr/bin/systemctl", "reboot"]))
        except OSError as e:
            self.problem.set_text(f"Could not restart: {e}")

    def save_log(self, _button):
        dialog = Gtk.FileDialog(title="Save the install log", initial_name="niixarch-install.log")
        dialog.save(self.win, None, self.saved)

    def saved(self, dialog, result):
        try:
            file = dialog.save_finish(result)
        except GLib.Error:
            return      # cancelled
        try:
            data = ("\n".join(self.win.log) + "\n").encode()
            file.replace_contents(data, None, False, Gio.FileCreateFlags.REPLACE_DESTINATION, None)
        except GLib.Error as e:
            self.problem.set_text(f"Could not save the log: {e.message}")


# -- The window ----------------------------------------------------------------
class InstallerWindow(Gtk.ApplicationWindow):
    QUESTIONS = ("mode", "disk", "keyboard", "timezone", "account", "diskpass", "performance", "hotspot",
                 "summary")

    def __init__(self, app):
        super().__init__(application=app, title="Install NiiX Arch", default_width=860, default_height=660)
        self.add_css_class("niix")
        self.installer = self.sha = self.probe = None
        self.pages = {}
        self.order = ["welcome"]
        self.current = 0
        self.process = None
        self.log = []
        self.inhibit = 0

        header = Gtk.HeaderBar()
        if os.path.isfile(LOGO):
            logo = Gtk.Image.new_from_file(LOGO)
            logo.set_pixel_size(28)
            header.pack_start(logo)
        header.set_title_widget(label("NiiX Arch Installer", ("app-title",), wrap=False))
        self.counter = label(css=("dim",), wrap=False)
        header.pack_end(self.counter)
        self.set_titlebar(header)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, vexpand=True)

        self.back = Gtk.Button(label="Back")
        self.back.connect("clicked", lambda *_: self.go(-1))
        self.next = Gtk.Button(label="Next")
        self.next.add_css_class("primary")
        self.next.connect("clicked", lambda *_: self.go(1))
        nav = Gtk.Box(spacing=10, margin_top=12, margin_bottom=12, margin_start=20, margin_end=20, hexpand=True)
        nav.append(self.back)
        nav.append(Gtk.Box(hexpand=True))
        nav.append(self.next)
        self.nav = Gtk.Box()
        self.nav.add_css_class("bar-bottom")
        self.nav.append(nav)

        layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        layout.add_css_class("content")
        layout.append(self.stack)
        layout.append(self.nav)
        self.set_child(layout)
        self.connect("close-request", self.closing)

        welcome = WelcomePage(self)
        self.add_page("welcome", welcome)
        self.show_page()
        welcome.start()

    def add_page(self, name, page):
        self.pages[name] = page
        self.stack.add_named(page, name)

    def build_pages(self):
        """After the probe: one page per question (no mode question without Windows)."""
        kinds = {"mode": ModePage, "disk": DiskPage, "keyboard": KeyboardPage, "timezone": TimezonePage,
                 "account": AccountPage, "diskpass": DiskPasswordPage, "performance": PerformancePage,
                 "hotspot": HotspotPage, "summary": SummaryPage}
        for name in self.QUESTIONS:
            if name == "mode" and not self.probe.windows:
                continue
            if name == "hotspot" and not self.probe.wifi_ap:
                continue
            self.add_page(name, kinds[name](self))
            self.order.append(name)

    def mode(self):
        page = self.pages.get("mode")
        return page.mode() if page else "singleboot"

    def page(self):
        return self.pages[self.order[self.current]]

    def show_page(self):
        page = self.page()
        page.enter()
        self.stack.set_visible_child(page)
        questions = len(self.order) - 1
        self.counter.set_text(f"Step {self.current} of {questions}" if self.current and questions else "")
        self.update_nav()

    def update_nav(self):
        page = self.page()
        self.back.set_visible(self.current > 0)
        self.next.set_label(page.next_label)
        self.next.set_sensitive(page.ready())

    def go(self, step):
        page = self.page()
        if step > 0:
            if not page.ready() or not page.validate():
                return
            if self.order[self.current] == "summary":
                self.install()
                return
        self.current = max(0, min(len(self.order) - 1, self.current + step))
        self.show_page()

    # -- Running the install ---------------------------------------------------
    def answers(self):
        pages = self.pages
        values = {
            "MODE": self.mode(),
            "KEYBOARD": pages["keyboard"].choice()[0],
            "TIMEZONE": pages["timezone"].choice(),
            "HOSTNAME": pages["account"].host(),
            "USERNAME": pages["account"].username.get_text().strip(),
            "USER_PASS": pages["account"].password.get_text(),
            "LUKS_PASS": pages["diskpass"].password.get_text(),
            "MITIGATIONS": pages["performance"].choice(),
            **pages["disk"].answers(),
            **(pages["hotspot"].answers() if "hotspot" in pages else {}),
        }
        if any("\n" in v or "\r" in v for v in values.values()):
            raise ValueError("an answer contains a line break")
        return "".join(f"{key}={value}\n" for key, value in values.items())

    def install(self):
        try:
            answers = self.answers()
        except ValueError:
            Gtk.AlertDialog(message="An answer contains a line break - please check your entries.").show(self)
            return
        for name in ("account", "diskpass"):
            for entry in (self.pages[name].password, self.pages[name].again):
                entry.set_text("")
        self.progress = Progress(self.mode())
        self.error = ""
        self.finished = False
        self.lines = queue.Queue()
        page = ProgressPage(self)
        self.add_page("progress", page)
        self.stack.set_visible_child(page)
        self.counter.set_text("")
        self.nav.set_visible(False)
        self.inhibit = self.get_application().inhibit(
            self, Gtk.ApplicationInhibitFlags.LOGOUT | Gtk.ApplicationInhibitFlags.SUSPEND
            | Gtk.ApplicationInhibitFlags.IDLE, "NiiX Arch is being installed")
        try:
            self.process = subprocess.Popen(
                as_root([*installer_env(self.sha), BASH, self.installer, "--answers"]),
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
            self.process.stdin.write(answers.encode())
            self.process.stdin.close()
        except OSError as e:
            self.ended(f"The installer could not be started: {e}")
            return
        threading.Thread(target=self.read_output, daemon=True).start()
        GLib.timeout_add(100, self.update_progress)

    def read_output(self):
        """Worker thread: hand the installer's output to the main loop."""
        for raw in iter(self.process.stdout.readline, b""):
            text = raw.decode("utf-8", "replace").rstrip("\r\n")
            self.lines.put(ANSI.sub("", text.rsplit("\r", 1)[-1]))
        self.lines.put(None)

    def update_progress(self):
        page = self.pages["progress"]
        shown, step, exited = [], None, False
        while True:
            try:
                line = self.lines.get_nowait()
            except queue.Empty:
                break
            if line is None:
                exited = True
                break
            if line.startswith("@@step "):
                title = line[7:].strip()
                step = self.progress.step(title) or step
                shown.append(f"\n> {title}")
            elif line.startswith("@@error "):
                self.error = line[8:].strip()
            elif line == "@@done":
                self.finished = True
            elif line.startswith("@@substep "):
                value = line[10:].strip()
                if value.isdigit():
                    self.progress.substep(int(value))
            else:
                count = PACMAN_COUNT.match(line.strip())
                if count:
                    self.progress.pacman(int(count.group(1)), int(count.group(2)))
                shown.append(line)
        if shown:
            self.log.extend(shown)
            page.add_lines(shown)
        page.report(step, self.progress.fraction())
        if not exited:
            return GLib.SOURCE_CONTINUE
        code = self.process.wait()
        if code == 0 and self.finished:
            page.report("Done", 1.0)
            self.ended(None)
        else:
            self.ended(self.error or f"The installer stopped unexpectedly (exit code {code}).")
        return GLib.SOURCE_REMOVE

    def ended(self, error):
        self.process = None
        if self.inhibit:
            self.get_application().uninhibit(self.inhibit)
            self.inhibit = 0
        page = FinishedPage(self, error is None, error or "")
        if "finished" in self.pages:
            self.stack.remove(self.pages.pop("finished"))
        self.add_page("finished", page)
        # Let the full bar be seen for a moment before the last page.
        GLib.timeout_add(1200 if error is None else 0, self.show_finished)

    def show_finished(self):
        self.stack.set_visible_child(self.pages["finished"])
        return GLib.SOURCE_REMOVE

    def start_over(self):
        app = self.get_application()
        app.window = InstallerWindow(app)
        app.window.present()
        self.destroy()

    def closing(self, _window):
        if self.process is None:
            return False
        alert = Gtk.AlertDialog(message="NiiX Arch is still being installed",
                                detail="Closing now would leave the computer without a working system. "
                                       "Please wait until the install is finished.")
        alert.show(self)
        return True


class InstallerApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.niixa.Installer", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.window = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        if self.window is None:
            self.window = InstallerWindow(self)
        self.window.present()


if __name__ == "__main__":
    raise SystemExit(InstallerApp().run(None))
NIIXGUIEOF
}

# ============================================================
#  MAIN
# ============================================================
case "${1:-}" in
    --build-iso)     shift; build_iso_command "$@"; exit $? ;;
    --probe)         probe; exit 0 ;;
    --check-account) check_account "${2:-}" "${3:-}"; exit 0 ;;
    --answers)       read_answers ;;
esac

dbg "Started $(date), kernel $(uname -r), from $0"

# Interrupted or killed: unmount and close the encrypted disk again.
trap 'cleanup_on_fail' INT TERM

$GUI_MODE || banner
check_prereqs          # brings the network up if needed
verify_installer       # before anything is touched
auto_detect_mode

# -- Which disk, and the questions ------------------------------
[[ "$INSTALL_MODE" == "dualboot" ]] && detect_efi
detect_hardware
dump_state "after hardware detection"
if [[ "$INSTALL_MODE" == "dualboot" ]]; then
    detect_free_spaces
else
    select_single_drive
fi
gather_input
confirm

# -- The disk ---------------------------------------------------
if [[ "$INSTALL_MODE" == "dualboot" ]]; then
    create_partition
else
    wipe_single_drive
    create_singleboot_partitions
fi
dump_state "after partitioning"
setup_luks
setup_btrfs
clean_efi
dump_state "after the file system"

# -- The system -------------------------------------------------
copy_system
configure_pacman
update_system
install_gpu_drivers
configure_system
install_desktop
setup_storage
setup_controllers
setup_hardware_tools
setup_desktop_apps
rebuild_initramfs
install_limine
log_boot_config
dump_state "final state"

# Done: from here Ctrl+C leaves /mnt mounted for a look around.
trap - INT TERM
finish
cp "$LOGFILE" /mnt/var/log/niixarch-install.log 2>/dev/null || true

if $GUI_MODE; then
    release_target
    echo "@@done"
    exit 0
fi

copy_logs_to_usb
echo
echo -e "  ${CYAN}Log file:${NC}"
echo -e "    Live ISO:    ${YELLOW}${LOGFILE}${NC}"
echo -e "    Installed:   ${YELLOW}/var/log/niixarch-install.log${NC}"
echo
echo -e "  ${PINK}--------------------------------------------------------${NC}"
read -rp "$(echo -e "  ${GREEN}Press Enter to reboot${NC} ${DIM}(or Ctrl+C to stay at the shell)${NC}  ")" _
echo -e "  ${CYAN}Unmounting and rebooting...${NC}"
release_target
sync
reboot

