# -- Talking to the installer --------------------------------------------------
def as_root(args):
    """The command, run as root: the live user may use sudo without a password."""
    return args if os.geteuid() == 0 else ["sudo", "-n", "--", *args]


def recorded_checksum(path):
    with open(path, encoding="utf-8") as f:
        for line in f:
            fields = line.split()
            if len(fields) == 2 and re.fullmatch(r"[0-9a-f]{64}", fields[0]):
                return fields[0]
    return ""


def locate_installer():
    """The installer on the ISO and its sha256, checked against the checksum
    recorded when the ISO was built (a damaged USB stick shows up here)."""
    path = os.environ.get("NIIX_INSTALLER") or BUNDLED_INSTALLER
    try:
        with open(path, "rb") as f:
            sha = hashlib.sha256(f.read()).hexdigest()
    except OSError as e:
        raise RuntimeError(f"The installer {path} could not be read: {e.strerror}.") from None
    if os.environ.get("NIIX_SKIP_VERIFY") == "1":
        return path, sha
    try:
        recorded = recorded_checksum(path + ".sha256")
    except OSError:
        recorded = ""
    if sha != recorded:
        raise RuntimeError(
            "The installer on this USB stick is damaged (its checksum does not match). "
            "Write the ISO to the stick again - check the ISO's checksum first.")
    return path, sha


def internet_up():
    """The same check the installer makes before it starts."""
    for attempt in range(3):
        if subprocess.run(["ping", "-c1", "-W3", "archlinux.org"], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0:
            return True
        if attempt < 2:
            time.sleep(2)
    return False


def installer_env(sha):
    env = ["/usr/bin/env", f"NIIX_VERIFIED_SHA={sha}"]
    if os.environ.get("NIIX_SKIP_VERIFY") == "1":
        env.append("NIIX_SKIP_VERIFY=1")
    return env


class Probe:
    """What the installer found on this computer (its --probe output)."""

    def __init__(self, text):
        self.windows = False
        self.efi = ""
        self.efi_bytes = 0
        self.foreign_kernels = False
        self.regions = []       # (drive, start, end, gib, model)
        self.partitions = []    # (path, size, label, drive)
        self.drives = []        # (path, size, model)
        self.keyboards = []     # (name, typing layout)
        self.machine = ""
        self.gpu = ""
        self.wifi_ap = False
        self.complete = False
        self.error = ""
        for line in text.splitlines():
            if line.startswith("@@error "):
                self.error = line[8:].strip()
                continue
            if not line.startswith("@@"):
                continue
            key, _, value = line[2:].partition("=")
            fields = value.split("|")
            if key == "windows":
                self.windows = value == "yes"
            elif key == "efi" and len(fields) == 2:
                self.efi = fields[0]
                self.efi_bytes = int(fields[1]) if fields[1].isdigit() else 0
            elif key == "foreign_kernels":
                self.foreign_kernels = value == "yes"
            elif key == "region" and len(fields) == 5:
                self.regions.append(tuple(fields))
            elif key == "partition" and len(fields) == 4:
                self.partitions.append(tuple(fields))
            elif key == "drive" and len(fields) == 3:
                self.drives.append(tuple(fields))
            elif key == "keyboard" and len(fields) == 2:
                self.keyboards.append(tuple(fields))
            elif key == "machine":
                self.machine = value
            elif key == "gpu":
                self.gpu = value
            elif key == "wifi_ap":
                self.wifi_ap = value == "yes"
            elif key == "probe_done":
                self.complete = True


class CheckFailed(RuntimeError):
    """A failed check, with the output that explains it."""

    def __init__(self, message, details=""):
        super().__init__(message)
        self.details = details


def run_probe(path):
    command = as_root([BASH, path, "--probe"])
    try:
        result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True,
                                text=True, errors="replace", timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise RuntimeError(f"Checking this computer failed: {e}") from None
    if "password is required" in result.stderr or "a terminal is required" in result.stderr:
        raise RuntimeError("The installer needs administrator rights (sudo) to look at the drives.")
    probe = Probe(result.stdout)
    if not probe.complete:
        details = (f"$ {' '.join(command)}\nexit code {result.returncode}\n\n"
                   f"{ANSI.sub('', result.stdout + result.stderr).strip()}")
        raise CheckFailed(probe.error or f"Checking this computer failed (exit code {result.returncode}).",
                          details)
    if not probe.drives:
        raise RuntimeError("No internal drive was found to install NiiX Arch on.")
    return probe


def check_account(path, hostname, username):
    """None when both names are fine, else (field, problem)."""
    try:
        out = subprocess.run([BASH, path, "--check-account", hostname, username], capture_output=True,
                             text=True, errors="replace", timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ("username", "The names could not be checked - please try again.")
    for line in out.splitlines():
        if line == "@@ok":
            return None
        if line.startswith("@@problem "):
            field, _, problem = line[10:].partition(" ")
            return (field, problem)
    return ("username", "The names could not be checked - please try again.")


def set_desktop_layout(layout):
    """Switch the live desktop to the layout the disk-unlock prompt will use,
    so the passwords typed here are the ones typed at every boot."""
    schemas = Gio.SettingsSchemaSource.get_default()
    if schemas is None or schemas.lookup("org.gnome.desktop.input-sources", True) is None:
        return
    settings = Gio.Settings.new("org.gnome.desktop.input-sources")
    settings.set_value("sources", GLib.Variant("a(ss)", [("xkb", layout)]))
    Gio.Settings.sync()


def list_timezones():
    try:
        zones = subprocess.run(["timedatectl", "list-timezones", "--no-pager"], capture_output=True,
                               text=True, timeout=15).stdout.split()
    except (OSError, subprocess.SubprocessError):
        zones = []
    if not zones:
        zones = sorted(zoneinfo.available_timezones())
    # The installer links /etc/localtime to the zone file - it has to exist.
    return [z for z in zones if z != "Factory" and ".." not in z and os.path.isfile(f"/usr/share/zoneinfo/{z}")]


# -- Small widget helpers ------------------------------------------------------
def label(text="", css=(), wrap=True, xalign=0.0):
    widget = Gtk.Label(label=text, xalign=xalign, wrap=wrap)
    if wrap:
        widget.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
    for name in css:
        widget.add_css_class(name)
    return widget


def scrolled(child, height):
    window = Gtk.ScrolledWindow(child=child, vexpand=True, min_content_height=height)
    window.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    window.add_css_class("framed")
    return window


def text_row(text, subtitle=""):
    row = Gtk.ListBoxRow()
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    box.append(label(text))
    if subtitle:
        box.append(label(subtitle, ("dim",)))
    row.set_child(box)
    return row


def scroll_to_row(listbox, row, tries=40):
    """Bring the selected row into view as soon as the list has its size."""
    window = listbox.get_ancestor(Gtk.ScrolledWindow)
    if row is None or window is None:
        return
    ok, bounds = row.compute_bounds(listbox)
    adj = window.get_vadjustment()
    if ok and adj.get_page_size() > 0 and bounds.get_height() > 0:
        adj.set_value(max(0, bounds.get_y() - adj.get_page_size() / 3))
    elif tries:
        GLib.timeout_add(25, lambda: scroll_to_row(listbox, row, tries - 1) or GLib.SOURCE_REMOVE)


def confirm_entry(phrase):
    entry = Gtk.Entry(placeholder_text=f"Type {phrase} to confirm", hexpand=False, width_chars=24)
    entry.set_halign(Gtk.Align.START)
    return entry


# -- The gradient bar ----------------------------------------------------------
def _linear(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _srgb(c):
    c = min(1.0, max(0.0, c))
    return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def _to_oklab(rgb):
    r, g, b = map(_linear, rgb)
    lc, mc, sc = (x ** (1 / 3) for x in (
        0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b,
        0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b,
        0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b))
    return (0.2104542553 * lc + 0.7936177850 * mc - 0.0040720468 * sc,
            1.9779984951 * lc - 2.4285922050 * mc + 0.4505937099 * sc,
            0.0259040371 * lc + 0.7827717662 * mc - 0.8086757660 * sc)


def _from_oklab(lab):
    lightness, a, b = lab
    lc = (lightness + 0.3963377774 * a + 0.2158037573 * b) ** 3
    mc = (lightness - 0.1055613458 * a - 0.0638541728 * b) ** 3
    sc = (lightness - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (_srgb(4.0767416621 * lc - 3.3077115913 * mc + 0.2309699292 * sc),
            _srgb(-1.2684380046 * lc + 2.6097574011 * mc - 0.3413193965 * sc),
            _srgb(-0.0041960863 * lc - 0.7034186147 * mc + 1.7076147010 * sc))


def gradient_stops(start, end, count=16):
    """Pink to green mixed in OKLab: a plain RGB mix turns grey in the middle."""
    a, b = _to_oklab(start), _to_oklab(end)
    return [(i / count, _from_oklab([x + (y - x) * i / count for x, y in zip(a, b)])) for i in range(count + 1)]


class GradientBar(Gtk.DrawingArea):
    """A rounded bar; the fill reveals a fixed pink-to-green gradient, so the
    colour at any point is the colour of that percentage."""

    def __init__(self):
        super().__init__(hexpand=True, content_height=26)
        self.stops = gradient_stops(PINK, GREEN)
        self.target = 0.0
        self.shown = 0.0
        self.tick = None
        self.set_draw_func(self.draw)

    def set_fraction(self, fraction):
        fraction = min(1.0, max(self.target, fraction))     # never backwards
        if fraction == self.target:
            return
        self.target = fraction
        if self.tick is None:
            self.tick = self.add_tick_callback(self.animate)

    def animate(self, _widget, _clock):
        gap = self.target - self.shown
        if gap < 0.0005:
            self.shown = self.target
            self.tick = None
            self.queue_draw()
            return GLib.SOURCE_REMOVE
        self.shown += max(gap * 0.12, 0.0005)
        self.queue_draw()
        return GLib.SOURCE_CONTINUE

    @staticmethod
    def rounded(cr, width, height):
        radius = height / 2
        cr.new_sub_path()
        cr.arc(width - radius, radius, radius, -math.pi / 2, math.pi / 2)
        cr.arc(radius, radius, radius, math.pi / 2, 3 * math.pi / 2)
        cr.close_path()

    def draw(self, _area, cr, width, height):
        if width < height:
            return
        self.rounded(cr, width, height)
        cr.set_source_rgb(*TRACK)
        cr.fill_preserve()
        if self.shown <= 0:
            cr.new_path()
            return
        cr.clip()
        cr.rectangle(0, 0, width * self.shown, height)
        cr.clip()
        gradient = cairo.LinearGradient(0, 0, width, 0)
        for offset, colour in self.stops:
            gradient.add_color_stop_rgb(offset, *colour)
        cr.set_source(gradient)
        cr.paint()


class Progress:
    """Turns the installer's steps and pacman's (n/m) counts into a fraction."""

    def __init__(self, mode):
        self.steps = STEPS[mode]
        self.total = sum(seconds for _, seconds, _ in self.steps)
        self.index = -1
        self.started = time.monotonic()
        self.count = 0.0

    def step(self, title):
        """The page text for this installer section (None when it is unknown)."""
        for i, (name, _, text) in enumerate(self.steps):
            if name == title:
                if i > self.index:
                    self.index = i
                    self.started = time.monotonic()
                    self.count = 0.0
                return text
        return None

    def pacman(self, done, total):
        if total > 0:
            self.count = max(self.count, done / total)

    def substep(self, percent):
        """How far the current section is, as the installer reports it."""
        self.count = max(self.count, min(100, percent) / 100)

    def fraction(self):
        if self.index < 0:
            return 0.0
        before = sum(seconds for _, seconds, _ in self.steps[:self.index])
        seconds = self.steps[self.index][1]
        # Between counts the bar keeps creeping, slower the longer it takes.
        creep = 0.9 * (1 - math.exp(-(time.monotonic() - self.started) / seconds))
        within = min(0.97, max(self.count, creep))
        return (before + seconds * within) / self.total


# -- Pages ---------------------------------------------------------------------
class Page(Gtk.Box):
    title = ""
    next_label = "Next"

    def __init__(self, win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                         margin_top=28, margin_bottom=20, margin_start=40, margin_end=40)
        self.win = win
        self.append(label(self.title, ("page-title",)))

    def ready(self):
        return True

    def enter(self):
        pass

    def validate(self):
        """Last check when Next is pressed; False keeps the page open."""
        return True

    def changed(self, *_args):
        self.win.update_nav()


class WelcomePage(Page):
    title = "Welcome to NiiX Arch"

    def __init__(self, win):
        super().__init__(win)
        self.append(label("This installs NiiX Arch - Arch Linux set up for gaming, tuned "
                          "automatically for this computer. It takes about 10-30 minutes, depending on the "
                          "internet speed; the connection must stay on the whole time.", ("dim",)))
        status = Gtk.Box(spacing=10, margin_top=16)
        self.spinner = Gtk.Spinner(spinning=True)
        self.status = label()
        status.append(self.spinner)
        status.append(self.status)
        self.append(status)
        self.retry = Gtk.Button(label="Try again", halign=Gtk.Align.START)
        self.retry.connect("clicked", lambda *_: self.start())
        self.append(self.retry)
        self.found = label(css=("card",))
        self.append(self.found)
        self.view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                 wrap_mode=Gtk.WrapMode.CHAR, top_margin=8, left_margin=8, right_margin=8)
        self.view.add_css_class("log")
        self.details = Gtk.Expander(label="Details", vexpand=True)
        self.details.set_child(scrolled(self.view, 160))
        self.append(self.details)
        self.done = False

    def ready(self):
        return self.done

    def start(self):
        self.done = False
        self.retry.set_visible(False)
        self.found.set_visible(False)
        self.details.set_visible(False)
        self.spinner.set_visible(True)
        self.status.remove_css_class("error")
        self.status.set_text("Checking the internet connection...")
        self.changed()
        threading.Thread(target=self.prepare, daemon=True).start()

    def prepare(self):
        try:
            path, sha = locate_installer()
            if not internet_up():
                raise RuntimeError(
                    "There is no internet connection - the install downloads the newest packages. "
                    "Connect to a network with the menu at the top right of the screen, then try again.")
            GLib.idle_add(self.status.set_text, "Checking this computer...")
            probe = run_probe(path)
        except (RuntimeError, OSError) as e:
            GLib.idle_add(self.failed, str(e), getattr(e, "details", ""))
            return
        GLib.idle_add(self.prepared, path, sha, probe)

    def failed(self, message, details):
        self.spinner.set_visible(False)
        self.status.add_css_class("error")
        self.status.set_text(message)
        self.retry.set_visible(True)
        if details:
            self.view.get_buffer().set_text(details)
            self.details.set_expanded(True)
            self.details.set_visible(True)

    def prepared(self, path, sha, probe):
        self.win.installer, self.win.sha, self.win.probe = path, sha, probe
        self.spinner.set_visible(False)
        self.status.set_text("Ready to go.")
        lines = [f"This computer:  {probe.machine or 'unknown'}",
                 f"Graphics:  {probe.gpu or 'not detected'}"]
        if probe.windows:
            lines.append("Windows is installed - you can keep it.")
        self.found.set_text("\n".join(lines))
        self.found.set_visible(True)
        self.done = True
        self.win.build_pages()
        self.changed()


class ModePage(Page):
    title = "Windows is installed on this computer"

    def __init__(self, win):
        super().__init__(win)
        probe = win.probe
        self.dual = Gtk.CheckButton(label="Install next to Windows (dual-boot) - recommended")
        self.single = Gtk.CheckButton(label="Erase a drive and install only NiiX Arch", group=self.dual)
        self.append(self.dual)
        self.append(label("Windows and your files stay. NiiX Arch goes into free space; "
                          "a menu at startup lets you choose.", ("dim",)))
        if probe.efi:
            self.dual.set_active(True)
        else:
            self.dual.set_sensitive(False)
            self.append(label("Dual-boot is not possible here: no EFI system partition was found "
                              "on an internal drive.", ("warning",)))
        self.append(self.single)
        self.append(label("Everything on the drive you pick is deleted - including Windows "
                          "if it is on that drive. There is no undo.", ("dim",)))
        self.erase = confirm_entry("ERASE WINDOWS")
        self.append(self.erase)
        for widget, signal in ((self.dual, "toggled"), (self.single, "toggled"), (self.erase, "changed")):
            widget.connect(signal, self.changed)
        self.changed()

    def changed(self, *_args):
        self.erase.set_visible(self.single.get_active())
        super().changed()

    def mode(self):
        if self.single.get_active() and self.erase.get_text() == "ERASE WINDOWS":
            return "singleboot"
        if self.dual.get_active():
            return "dualboot"
        return None

    def ready(self):
        return self.mode() is not None


class DiskPage(Page):
    title = "Where should NiiX Arch go?"

    def __init__(self, win):
        super().__init__(win)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, vexpand=True)
        self.append(self.body)
        self.built_for = None
        self.list = self.confirm = self.phrase = self.small_efi = self.kernels = self.kind = None

    def enter(self):
        mode = self.win.mode()
        if mode == self.built_for:
            return
        self.built_for = mode
        while child := self.body.get_first_child():
            self.body.remove(child)
        self.list = self.confirm = self.phrase = self.small_efi = self.kernels = self.kind = None
        if mode == "dualboot":
            self.build_dualboot()
        else:
            self.build_singleboot()
        self.changed()

    def add_list(self, rows, preselect):
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        for row in rows:
            self.list.append(row)
        if preselect:
            self.list.select_row(self.list.get_row_at_index(0))
        self.list.connect("row-selected", self.changed)
        self.body.append(scrolled(self.list, 150))

    def add_confirm(self, phrase):
        self.phrase = phrase
        self.confirm = confirm_entry(phrase)
        self.confirm.connect("changed", self.changed)
        self.body.append(self.confirm)

    def add_check(self, text):
        check = Gtk.CheckButton(label=text)
        check.connect("toggled", self.changed)
        self.body.append(check)
        return check

    def build_dualboot(self):
        probe = self.win.probe
        if probe.efi_bytes and probe.efi_bytes < MIN_EFI_BYTES:
            self.body.append(label(
                f"The EFI partition {probe.efi} is only {probe.efi_bytes // 1048576} MiB - it may be "
                "too small for the Linux boot files. Enlarge it first if you can.", ("warning",)))
            self.small_efi = self.add_check("Continue anyway")
        if probe.foreign_kernels:
            self.body.append(label(
                f"The EFI partition {probe.efi} holds the boot files of another Linux install. "
                "NiiX Arch uses the same file names: that install will stop booting.", ("warning",)))
            self.kernels = self.add_check("Replace them")
        if probe.regions:
            self.kind = "region"
            self.body.append(label("NiiX Arch goes into free (unallocated) space. Nothing else is touched.", ("dim",)))
            self.add_list([text_row(f"{float(gib):.1f} GiB free on {drive}", model)
                           for drive, _, _, gib, model in probe.regions], True)
        elif probe.partitions:
            self.kind = "partition"
            self.body.append(label(
                "There is no free space of 40 GiB or more. You can delete a partition to make room - "
                "Windows, EFI, recovery and reserved partitions are never listed.", ("dim",)))
            self.add_list([text_row(f"{path}   {size}", f"{label_} on {drive}")
                           for path, size, label_, drive in probe.partitions], False)
            self.body.append(label("The partition you pick and everything on it is deleted for good.", ("error",)))
            self.add_confirm("DELETE")
        else:
            self.body.append(label(
                "There is no free space for NiiX Arch. In Windows, open Disk Management, shrink a "
                "volume to leave at least 40 GiB (100 GiB or more recommended) unallocated, then "
                "start this installer again.", ("error",)))

    def build_singleboot(self):
        self.kind = "drive"
        self.body.append(label("Pick the drive for NiiX Arch. The WHOLE drive is erased: every "
                               "partition, system and file on it.", ("error",)))
        self.add_list([text_row(f"{path}   {size}", model) for path, size, model in self.win.probe.drives], False)
        self.add_confirm("WIPE")

    def selected(self):
        row = self.list.get_selected_row() if self.list else None
        return row.get_index() if row else None

    def ready(self):
        if self.kind is None or self.selected() is None:
            return False
        if self.confirm and self.confirm.get_text() != self.phrase:
            return False
        return all(check.get_active() for check in (self.small_efi, self.kernels) if check)

    def answers(self):
        probe, index = self.win.probe, self.selected()
        if self.kind == "region":
            drive, start, end, _, _ = probe.regions[index]
            result = {"TARGET_REGION": f"{drive}|{start}|{end}"}
        elif self.kind == "partition":
            result = {"DELETE_PART": probe.partitions[index][0]}
        else:
            return {"SINGLE_DRIVE": probe.drives[index][0]}
        if self.kernels:
            result["REPLACE_KERNELS"] = "yes"
        return result

    def summary(self):
        probe, index = self.win.probe, self.selected()
        if self.kind == "region":
            drive, _, _, gib, model = probe.regions[index]
            return f"{float(gib):.1f} GiB of free space on {drive} ({model})"
        if self.kind == "partition":
            path, size, label_, _ = probe.partitions[index]
            return f"{path} ({size}, {label_}) is DELETED and replaced"
        path, size, model = probe.drives[index]
        return f"{path} ({size}, {model}) is COMPLETELY ERASED"


class KeyboardPage(Page):
    title = "Keyboard layout"

    def __init__(self, win):
        super().__init__(win)
        self.append(label("Used everywhere, including the password prompt when the computer starts. "
                          "Layouts marked (+ English) keep US English at that prompt; on the desktop "
                          "switch between both with Super+Space.", ("dim",)))
        self.search = Gtk.SearchEntry(placeholder_text="Search layouts")
        self.append(self.search)
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        default = None
        for name, layout in win.probe.keyboards:
            row = text_row(name)
            row.niix = (name, layout)
            self.list.append(row)
            if name == DEFAULT_KEYBOARD:
                default = row
        self.list.set_filter_func(self.matches)
        self.search.connect("search-changed", lambda *_: self.list.invalidate_filter())
        self.append(scrolled(self.list, 200))
        self.test = Gtk.Entry(placeholder_text="Type here to try the layout")
        self.append(self.test)
        self.list.connect("row-selected", self.changed)
        self.applied = None
        if default:
            self.list.select_row(default)

    def matches(self, row):
        return self.search.get_text().strip().lower() in row.niix[0].lower()

    def enter(self):
        scroll_to_row(self.list, self.list.get_selected_row())
        self.changed()

    def changed(self, *_args):
        # The live desktop follows the selection while this page is open.
        choice = self.choice()
        if choice and choice[1] != self.applied and self.win.page() is self:
            self.applied = choice[1]
            set_desktop_layout(self.applied)
        super().changed()

    def choice(self):
        row = self.list.get_selected_row()
        return row.niix if row else None

    def ready(self):
        return self.choice() is not None


