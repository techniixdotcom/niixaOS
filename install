menu-separator-color='rgba(255, 107, 129, 0.25)'
menu-item-hover-bg-color='rgba(255, 107, 129, 0.30)'
menu-item-hover-fg-color='rgba(255, 255, 255, 1)'
menu-item-active-bg-color='rgba(255, 107, 129, 0.45)'
menu-item-active-fg-color='rgba(255, 255, 255, 1)'

[org/gnome/shell/extensions/screen-rotate]
flip-orientation=false
hide-lock-rotate=false
debug-logging=false

[org/gnome/shell/extensions/tiling-assistant]
enable-layout-picker=false
enable-tiling-popup=false
enable-raise-tile-group=false
toggle-maximize-tophalf-timer=2147483647
NIIXDCONF
}

# The defaults above, plus what is only for installed systems or depends on
# this machine. (The live ISO writes its own extension and dock list.)
write_desktop_defaults() {
    local d=/mnt/etc/dconf/db/local.d feature
    local -a features=()
    mkdir -p "$d" /mnt/etc/dconf/profile
    grep -qs 'system-db:local' /mnt/etc/dconf/profile/user \
        || printf 'user-db:user\nsystem-db:local\n' > /mnt/etc/dconf/profile/user
    niix_dconf_defaults > "$d/00-niix-desktop"

    # Fractional scaling (125%, 150%...) and variable refresh rate: built in
    # from GNOME 50, experimental switches before that. Only names this GNOME
    # knows are written - an unknown one makes GNOME ignore the whole setting.
    for feature in scale-monitor-framebuffer xwayland-native-scaling variable-refresh-rate; do
        arch-chroot /mnt gsettings range org.gnome.mutter experimental-features 2>/dev/null \
            | grep -qxE "'?$feature'?" && features+=("'$feature'")
    done
    {
        cat <<'SYSDCONF'
[org/gnome/shell]
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com', 'dash-to-panel@jderose9.github.com', 'arcmenu@arcmenu.com', 'screen-rotate@shyzus.github.io', 'tiling-assistant@leleat-on-github', 'ddterm@amezin.github.com', 'system-monitor@gnome-shell-extensions.gcampax.github.com', 'niix-osk@niixa.org']
favorite-apps=['org.gnome.Nautilus.desktop', 'helium.desktop', 'org.gnome.TextEditor.desktop', 'net.lutris.Lutris.desktop', 'steam.desktop', 'com.heroicgameslauncher.hgl.desktop', 'com.ktechpit.whatsie.desktop', 'signal-desktop.desktop', 'com.stremio.Stremio.desktop']

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-battery-type='suspend'
SYSDCONF
        if (( ${#features[@]} )); then
            printf '\n[org/gnome/mutter]\nexperimental-features=[%s]\n' "$(IFS=,; echo "${features[*]}")"
        fi
        # Laptops and handhelds: tap the touchpad to click.
        case "$FORM" in
            laptop|handheld) printf '\n[org/gnome/desktop/peripherals/touchpad]\ntap-to-click=true\n' ;;
        esac
    } > "$d/01-niix-system"
    chmod 644 "$d/00-niix-desktop" "$d/01-niix-system"
    arch-chroot /mnt dconf update || err "dconf update failed - the desktop defaults would not apply"
    log "Desktop defaults written (theme, panel, start menu, terminal, shortcuts)"
}

# -- niix-panel-fix: keeps the panel layout in place at every login ---
# dash-to-panel stores its layout per monitor and falls back to defaults -
# with GNOME's app grid button visible - for any monitor it hasn't seen. This
# helper computes the monitor IDs exactly like dash-to-panel (via Mutter's
# DisplayConfig), keeps Show Apps + Activities hidden and the system menu
# visible on every one, and re-applies the ArcMenu button and the pink
# accents. It runs for ~45s at each login to outlast dash-to-panel's own
# start-up save.
niix_panel_fix_script() {
    cat <<'NIIXPANELFIX'
#!/usr/bin/env python3
# niix-panel-fix - keep the NiiX panel layout in place at every login:
#   * dash-to-panel: Show Apps/Activities hidden, system menu VISIBLE, per monitor
#   * ArcMenu: NiiX-branded menu button (Icon+Text 'NiiX', NiiX logo icon)
#   niix-panel-fix           apply once
#   niix-panel-fix --watch   apply repeatedly for ~45s (used at login)
import ast, json, os, subprocess, sys, time

BASE = "/org/gnome/shell/extensions/dash-to-panel/"
HIDE = ("showAppsButton", "activitiesButton")
NIIX_ELEMENTS = [
    {"element": "showAppsButton", "visible": False, "position": "stackedTL"},
    {"element": "activitiesButton", "visible": False, "position": "stackedTL"},
    {"element": "leftBox", "visible": True, "position": "stackedTL"},
    {"element": "taskbar", "visible": True, "position": "stackedTL"},
    {"element": "centerBox", "visible": True, "position": "stackedBR"},
    {"element": "rightBox", "visible": True, "position": "stackedBR"},
    {"element": "dateMenu", "visible": True, "position": "stackedBR"},
    {"element": "systemMenu", "visible": True, "position": "stackedBR"},
    {"element": "desktopButton", "visible": True, "position": "stackedBR"},
]
MISSING_DEFAULTS = {
    "panel-positions": "BOTTOM",
    "panel-sizes": 44,
    "panel-lengths": 100,
    "panel-anchors": "LEFT",
}
# Elements that must stay visible - enforced at every login (e.g. the system
# menu is part of the NiiX layout and must not end up hidden by a stale
# panel-element-positions entry or an extension reset).
SHOW = ("leftBox", "taskbar", "centerBox", "rightBox", "dateMenu",
        "systemMenu", "desktopButton")


def dconf_read(key):
    try:
        out = subprocess.run(["dconf", "read", BASE + key], capture_output=True,
                             text=True, timeout=10).stdout.strip()
    except Exception:
        return None
    if not out:
        return {}
    try:
        data = json.loads(ast.literal_eval(out))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def dconf_write(key, value):
    text = json.dumps(value, separators=(",", ":"))
    gvariant = "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"
    subprocess.run(["dconf", "write", BASE + key, gvariant], timeout=10,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def monitor_ids():
    # Same derivation as dash-to-panel's panelSettings.js: vendor-serial,
    # else the connector on a clash, else the logical-monitor index.
    try:
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        reply = bus.call_sync("org.gnome.Mutter.DisplayConfig",
                              "/org/gnome/Mutter/DisplayConfig",
                              "org.gnome.Mutter.DisplayConfig",
                              "GetCurrentState", None, None,
                              Gio.DBusCallFlags.NONE, 5000, None)
        logical = reply.unpack()[2]
    except Exception:
        return []
    ids, seen = [], set()
    for i, lm in enumerate(logical):
        try:
            connector, vendor, _product, serial = lm[5][0]
        except Exception:
            connector = vendor = serial = ""
        mid = "%s-%s" % (vendor, serial) if vendor and serial else str(i)
        if mid in seen:
            mid = connector if connector and connector not in seen else str(i)
        seen.add(mid)
        ids.append(mid)
    return ids


def fixed_elements(current):
    if not isinstance(current, list) or not all(isinstance(e, dict) for e in current):
        current = [dict(e) for e in NIIX_ELEMENTS]
    else:
        current = [dict(e) for e in current]
    names = [e.get("element") for e in current]
    if "showAppsButton" not in names:
        current.insert(0, {"element": "showAppsButton", "visible": False, "position": "stackedTL"})
    for e in current:
        if e.get("element") in HIDE:
            e["visible"] = False
        elif e.get("element") in SHOW:
            e["visible"] = True
    return current


ARCMENU_BASE = "/org/gnome/shell/extensions/arcmenu/"
NIIX_LOGO = "/usr/share/pixmaps/niixarch-logo.png"


def gv_str(text):
    return "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"


# Values are GVariant text, exactly as 'dconf read' prints them - so a bool
# is written as a bool and a number as a number. (Writing them as strings
# makes GNOME ignore the setting.)
def arcmenu_wanted():
    # Without the logo file (its download failed), the GNOME logo stands in
    # rather than an empty square.
    icon = NIIX_LOGO if os.path.isfile(NIIX_LOGO) else "start-here-symbolic"
    return [
        ("menu-button-appearance", "'Icon_Text'"),
        ("menu-button-text", "'NiiX'"),
        ("menu-button-icon", gv_str(icon)),
        ("menu-button-icon-size", "28"),
        ("position-in-panel", "'Left'"),
        ("menu-layout", "'Default'"),
        # Pink accent theme (must match the dconf load block)
        ("override-menu-theme", "true"),
        ("menu-background-color", "'rgba(40, 24, 32, 0.98)'"),
        ("menu-foreground-color", "'rgba(255, 255, 255, 1)'"),
        ("menu-border-color", "'rgba(255, 107, 129, 0.40)'"),
        ("menu-border-width", "1"),
        ("menu-border-radius", "8"),
        ("menu-separator-color", "'rgba(255, 107, 129, 0.25)'"),
        ("menu-item-hover-bg-color", "'rgba(255, 107, 129, 0.30)'"),
        ("menu-item-hover-fg-color", "'rgba(255, 255, 255, 1)'"),
        ("menu-item-active-bg-color", "'rgba(255, 107, 129, 0.45)'"),
        ("menu-item-active-fg-color", "'rgba(255, 255, 255, 1)'"),
    ]


# Dash-to-panel settings it resets on first load, and the pink accent
# colours (must match the dconf load block). Enforcing them keeps the layout
# locked even if the settings GUI is used and not changed back.
DTP_WANTED = [
    ("multi-monitors", "false"),
    ("focus-highlight", "true"),
    ("focus-highlight-color", "'rgba(255, 107, 129, 0.35)'"),
    ("focus-highlight-opacity", "35"),
    ("dot-color-override", "true"),
    ("dot-color-1", "'#ff6b81'"),
    ("dot-color-2", "'#ff6b81'"),
    ("dot-color-3", "'#ff6b81'"),
    ("dot-color-4", "'#ff6b81'"),
    ("highlight-appicon-hover", "true"),
    ("highlight-appicon-hover-background-color", "'rgba(255, 107, 129, 0.15)'"),
    ("highlight-appicon-pressed-background-color", "'rgba(255, 107, 129, 0.25)'"),
]


def enforce(base, wanted):
    # Writes only what differs - cheap at login, and outlasts the extensions'
    # own first-run settings resets.
    for key, value in wanted:
        try:
            cur = subprocess.run(["dconf", "read", base + key], capture_output=True,
                                 text=True, timeout=10).stdout.strip()
        except Exception:
            continue
        if cur != value:
            subprocess.run(["dconf", "write", base + key, value], timeout=10,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply_arcmenu():
    enforce(ARCMENU_BASE, arcmenu_wanted())


def apply_dtp_settings():
    enforce(BASE, DTP_WANTED)


def apply():
    ids = monitor_ids()
    positions = dconf_read("panel-element-positions")
    if positions is None:
        return
    keys = list(positions.keys())
    for k in ids or (["0"] if not keys else []):
        if k not in keys:
            keys.append(k)
    wanted = {k: fixed_elements(positions.get(k)) for k in keys}
    if wanted != positions:
        dconf_write("panel-element-positions", wanted)
    for key, default in MISSING_DEFAULTS.items():
        cur = dconf_read(key)
        if cur is None:
            continue
        new = dict(cur)
        for k in keys:
            new.setdefault(k, default)
        if new != cur:
            dconf_write(key, new)


def main():
    if "--watch" in sys.argv[1:]:
        for _ in range(15):
            apply()
            apply_arcmenu()
            apply_dtp_settings()
            time.sleep(3)
    else:
        apply()
        apply_arcmenu()
        apply_dtp_settings()


if __name__ == "__main__":
    main()
NIIXPANELFIX
}

install_panel_fix() {
    niix_panel_fix_script > /mnt/usr/local/bin/niix-panel-fix
    chmod 755 /mnt/usr/local/bin/niix-panel-fix
    cat > /mnt/etc/xdg/autostart/niix-panel-fix.desktop <<'PANELFIXDT'
[Desktop Entry]
Type=Application
Name=NiiX Panel: hide Show Apps button
Exec=/usr/local/bin/niix-panel-fix --watch
X-GNOME-Autostart-enabled=true
NoDisplay=true
PANELFIXDT
}

# -- Steam: warm start + one-time first-launch notice ---------------
# Steam bundles a Chromium browser (steamwebhelper) that makes cold starts slow.
#  1) Pre-load Steam minimized to the tray 10s after login, once the desktop
#     has settled - opening it then only shows the window. Only once Steam
#     is set up and signed in: the very first start downloads the Steam
#     client, and its update window with the progress bar must be seen.
#  2) A PATH wrapper (terminal) + desktop override (icon clicks) shows a
#     one-time popup explaining the first-launch wait, then hands off to the
#     real Steam. The -silent autostart bypasses the wrapper entirely, so the
#     notice only ever appears on the user's own first real launch.
setup_steam() {
    cat > /mnt/usr/local/bin/steam <<'STEAMWRAPEOF'
#!/bin/bash
# NiiX wrapper: loads the GPU settings from niix-gpu, shows a one-time
# first-launch notice, then hands off to the real Steam.
# Remove with: sudo rm /usr/local/bin/steam ~/.local/share/applications/steam.desktop
# The desktop session already has the GPU settings; loading them here as well
# covers Steam started from a TTY, or right after niix-gpu changed its mind.
if [ -r /etc/environment.d/90-niix-gpu.conf ]; then
    set -a
    . /etc/environment.d/90-niix-gpu.conf
    set +a
fi
for arg in "$@"; do
    [ "$arg" = "-silent" ] && exec /usr/bin/steam "$@"
done
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/niix"
FLAG="$STATE_DIR/steam-notice-shown"
if [ ! -e "$FLAG" ]; then
    mkdir -p "$STATE_DIR" && touch "$FLAG"
    MSG="This first time, Steam downloads its client before it opens - a small window shows the progress. It takes a few minutes, depending on the connection.

One-time setup for the best experience: in Steam go to Settings -> Compatibility, turn on \"Enable Steam Play for all other titles\", and pick Proton-CachyOS (already installed; GE-Proton is there too as an alternative) as the default tool. Steam will restart once.

Tip: NiiX pre-loads Steam in the background shortly after each login, so future launches are much faster."
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --title="Steam is starting..." --width=420 --text="$MSG" &
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal "Steam is starting..." "$MSG" &
    fi
fi
exec /usr/bin/steam "$@"
STEAMWRAPEOF
    chmod 755 /mnt/usr/local/bin/steam

    # Arch's steam.desktop uses an absolute Exec path, so the PATH wrapper
    # alone would not catch icon clicks. /usr/local/share overrides
    # /usr/share under the same file ID, so the dock pin keeps working and
    # Steam updates don't undo it.
    if [[ -f /mnt/usr/share/applications/steam.desktop ]]; then
        mkdir -p /mnt/usr/local/share/applications
        sed 's|^Exec=/usr/bin/steam|Exec=/usr/local/bin/steam|' \
            /mnt/usr/share/applications/steam.desktop > /mnt/usr/local/share/applications/steam.desktop
    fi
    cat > /mnt/usr/local/bin/niix-steam-warmstart <<'STEAMWARMEOF'
#!/bin/sh
# Pre-loads Steam minimized after login, once it is set up and signed in.
sleep 10
[ -s "$HOME/.local/share/Steam/config/loginusers.vdf" ] || exit 0
pgrep -u "$(id -u)" -x steam >/dev/null && exit 0
exec /usr/local/bin/steam -silent >/dev/null 2>&1
STEAMWARMEOF
    chmod 755 /mnt/usr/local/bin/niix-steam-warmstart
    cat > /mnt/etc/xdg/autostart/niix-steam-warmstart.desktop <<'STEAMAUTOEOF'
[Desktop Entry]
Type=Application
Name=Steam (pre-load, minimized)
Comment=Added by NiiX - delete this file to disable
Exec=/usr/local/bin/niix-steam-warmstart
X-GNOME-Autostart-enabled=true
STEAMAUTOEOF
    log "Steam: warm start at login + one-time first-launch notice"
}

# -- VR: ready for wireless and wired headsets -------------------------
#  Standalone headsets (Quest, Pico, Vive Focus) stream from the PC with
#  WiVRn, over Wi-Fi or a USB cable: open "WiVRn" from the menu and install
#  its app on the headset. Avahi lets the headset find the PC. OpenVR games
#  reach WiVRn through xrizer, which WiVRn picks up by itself.
#  PC headsets (Valve Index, Vive, Bigscreen Beyond) use SteamVR, installed
#  from Steam when wanted. GNOME lends it the headset's display (DRM lease),
#  and game-devices-udev gives the user access to the headset.
#  - Steam runs games in a container (pressure-vessel), which has to see
#    WiVRn's socket and the system's OpenXR runtime. Set for every game in
#    the session environment, so no per-game launch options are needed.
#  - SteamVR's compositor needs CAP_SYS_NICE for asynchronous reprojection.
#    SteamVR asks for the password to set it on first start, and again after
#    each update that replaces the file. A path unit sets it instead, whenever
#    the file appears or changes - only on a regular file owned by the user.
setup_vr() {
    local home
    home=$(arch-chroot /mnt getent passwd "$USERNAME" | cut -d: -f6)
    [[ -n "$home" ]] || home=/home/$USERNAME

    mkdir -p /mnt/etc/environment.d
    cat > /mnt/etc/environment.d/60-niix-vr.conf <<'VRENVEOF'
PRESSURE_VESSEL_IMPORT_OPENXR_1_RUNTIMES=1
PRESSURE_VESSEL_FILESYSTEMS_RW=${XDG_RUNTIME_DIR}/wivrn/comp_ipc
VRENVEOF

    cat > /mnt/usr/local/bin/niix-steamvr-caps <<'VRCAPSEOF'
#!/bin/sh
# NiiX: gives SteamVR's compositor CAP_SYS_NICE (asynchronous reprojection),
# as SteamVR's own password prompt would. Run by niix-steamvr-caps.path.
# Usage: niix-steamvr-caps USER
user=$1
home=$(getent passwd "$user" | cut -d: -f6)
[ -n "$home" ] || exit 0
f="$home/.local/share/Steam/steamapps/common/SteamVR/bin/linux64/vrcompositor-launcher"
[ -f "$f" ] && [ ! -L "$f" ] || exit 0
[ "$(stat -c %U "$f")" = "$user" ] || exit 0
getcap "$f" | grep -q cap_sys_nice && exit 0
setcap CAP_SYS_NICE=eip "$f" && echo "SteamVR compositor: CAP_SYS_NICE set"
VRCAPSEOF
    chmod 755 /mnt/usr/local/bin/niix-steamvr-caps

    cat > /mnt/etc/systemd/system/niix-steamvr-caps.service <<VRCAPSSVCEOF
[Unit]
Description=Give SteamVR's compositor the priority it needs (NiiX)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/niix-steamvr-caps $USERNAME

[Install]
WantedBy=multi-user.target
VRCAPSSVCEOF

    cat > /mnt/etc/systemd/system/niix-steamvr-caps.path <<VRCAPSPATHEOF
[Unit]
Description=Watch SteamVR's compositor for installs and updates (NiiX)

[Path]
PathChanged=$home/.local/share/Steam/steamapps/common/SteamVR/bin/linux64/vrcompositor-launcher
Unit=niix-steamvr-caps.service

[Install]
WantedBy=multi-user.target
VRCAPSPATHEOF

    arch-chroot /mnt systemctl enable avahi-daemon.service niix-steamvr-caps.service niix-steamvr-caps.path \
        2>/dev/null || warn "VR: could not enable Avahi or the SteamVR helper"
    log "VR: WiVRn (Quest/Pico) + xrizer, SteamVR helper, Steam container settings"
}

# -- System-wide app settings ---------------------------------------
write_app_config() {
    # GameMode
    cat > /mnt/etc/gamemode.ini <<'GMEOF'
[general]
renice = 10
ioprio = 0
inhibit_screensaver = 1

[gpu]
apply_gpu_optimisations = accept-responsibility
amd_performance_level = high

[cpu]
pin_cores = yes

[custom]
start = notify-send "GameMode" "Gaming optimizations ON"
end = notify-send "GameMode" "Gaming optimizations OFF"
GMEOF

    # Bluetooth headset audio (WirePlumber). Roles and codecs are deliberately
    # NOT restricted: WirePlumber's defaults already enable A2DP (music) + HFP
    # (microphone) + BAP (LE Audio) and every compiled codec (aptX, LDAC, AAC,
    # LC3...). What is set:
    #   enable-msbc      -> 16 kHz wideband mic instead of 8 kHz telephone quality
    #   enable-sbc-xq    -> higher-bitrate SBC for headsets without a better codec
    #   enable-hw-volume -> volume keys control the headset's own amplifier
    #   auto-connect     -> bring up both music and mic profiles on connect
    mkdir -p /mnt/etc/wireplumber/wireplumber.conf.d
    cat > /mnt/etc/wireplumber/wireplumber.conf.d/51-niix-bluetooth-headsets.conf <<'BTEOF'
monitor.bluez.properties = {
  bluez5.enable-msbc = true
  bluez5.enable-sbc-xq = true
  bluez5.enable-hw-volume = true
  bluez5.hfphsp-backend = "native"
  bluez5.auto-connect = [ hfp_hf hsp_hs a2dp_sink ]
}
BTEOF

    # fastfetch, in NiiX colours (shown when a terminal opens)
    mkdir -p /mnt/etc/xdg/fastfetch
    cat > /mnt/etc/xdg/fastfetch/config.jsonc <<'FFEOF'
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": { "1": "38;5;118", "2": "38;5;205" }
  },
  "display": { "separator": " -> ", "color": { "keys": "38;5;118", "title": "38;5;205" } },
  "modules": [
    { "type": "title", "format": "{user-name}@niixarch" }, "separator",
    { "type": "os", "key": "OS", "format": "NiiX Arch" },
    { "type": "kernel", "key": "Kernel" }, { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" }, { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "DE" }, { "type": "terminal", "key": "Terminal" }, "separator",
    { "type": "cpu", "key": "CPU" }, { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" }, { "type": "disk", "key": "Disk", "folders": "/" }
  ]
}
FFEOF
}

# -- The user's own files -------------------------------------------
write_user_files() {
    # Btrfs: no copy-on-write for the Steam library - large, often rewritten
    # game files fragment badly with it. +C only applies to new files in an
    # empty directory, so it is set before Steam ever runs.
    arch-chroot /mnt runuser -u "$USERNAME" -- env HOME="/home/$USERNAME" bash <<'USEREOF'
set -u
mkdir -p "$HOME/.config" "$HOME/.local/share/Steam"
chattr +C "$HOME/.local/share/Steam" 2>/dev/null || true
grep -qx 'fastfetch' "$HOME/.bashrc" 2>/dev/null || echo 'fastfetch' >> "$HOME/.bashrc"
touch "$HOME/.config/gnome-initial-setup-done"
USEREOF
}

# -- Extensions from extensions.gnome.org -------------------------
# Screen Autorotate and Tiling Assistant aren't packaged, so they come from
# extensions.gnome.org. In the user's own folder GNOME keeps them updated.
# The ISO carries them; when it doesn't (no build for its GNOME version
# then), they are downloaded - from the source repository as a last resort.
install_user_extensions() {
    local dest="/mnt/home/$USERNAME/.local/share/gnome-shell/extensions" uuid
    local -a missing=()
    mkdir -p "$dest"
    for uuid in screen-rotate@shyzus.github.io tiling-assistant@leleat-on-github; do
        if [[ -d "/mnt/usr/share/gnome-shell/extensions/$uuid" ]]; then
            rm -rf "${dest:?}/$uuid"
            mv "/mnt/usr/share/gnome-shell/extensions/$uuid" "$dest/"
        else
            missing+=("$uuid")
        fi
    done
    if (( ${#missing[@]} )); then
        ego_install "${missing[@]}"
    fi
    chown -R "$USER_UID:$USER_GID" "/mnt/home/$USERNAME/.local"
}

# ego_install UUID... : the build of each extension for this GNOME version,
# into the user's extension folder.
ego_install() {
    local dest="/mnt/home/$USERNAME/.local/share/gnome-shell/extensions" shell_ver uuid meta url tmp
    shell_ver=$(arch-chroot /mnt gnome-shell --version 2>/dev/null | grep -oE '[0-9]+' | head -1)
    for uuid in "$@"; do
        url=""
        meta=$(curl -fsS --retry 3 --retry-delay 2 \
            "https://extensions.gnome.org/extension-info/?uuid=${uuid}&shell_version=${shell_ver}" 2>/dev/null) || true
        url=$(python3 -c 'import json, sys
try:
    print(json.load(sys.stdin).get("download_url") or "")
except ValueError:
    print("")' <<< "$meta")
        tmp=$(mktemp -d) || continue
        if [[ -n "$url" ]] \
            && curl -fsSL --retry 3 --retry-delay 2 -o "$tmp/ext.zip" "https://extensions.gnome.org$url" \
            && mkdir -p "$dest/$uuid" && bsdtar -xf "$tmp/ext.zip" -C "$dest/$uuid"; then
            log "$uuid installed from extensions.gnome.org"
        else
            ext_from_git "$uuid" "$tmp"
        fi
        if [[ -d "$dest/$uuid/schemas" ]]; then
            glib-compile-schemas "$dest/$uuid/schemas" 2>/dev/null || true
        fi
        rm -rf "$tmp"
    done
}

# ext_from_git UUID TMPDIR : the extension from its source repository. Their
# upstream build step is only schema compilation, so a checked-out copy is a
# complete extension. Tiling Assistant is pinned to a release tag.
ext_from_git() {
    local uuid=$1 tmp=$2 repo tag=""
    local dest="/mnt/home/$USERNAME/.local/share/gnome-shell/extensions"
    case "$uuid" in
        screen-rotate@shyzus.github.io)   repo=https://github.com/shyzus/gnome-shell-extension-screen-autorotate.git ;;
        tiling-assistant@leleat-on-github) repo=https://github.com/Leleat/Tiling-Assistant.git; tag=v55 ;;
        *) warn "$uuid could not be downloaded"; return 1 ;;
    esac
    rm -rf "${dest:?}/$uuid"
    if git clone --depth 1 ${tag:+--branch "$tag"} "$repo" "$tmp/src" 2>/dev/null \
        && [[ -f "$tmp/src/$uuid/metadata.json" ]] && cp -r "$tmp/src/$uuid" "$dest/"; then
        log "$uuid installed from its source repository"
    else
        warn "$uuid could not be downloaded - install it later from the Extensions app"
        return 1
    fi
}

# -- Scheduler, power mode, handheld controls ------------------------
enable_extras() {
    # LAVD: CachyOS's sched-ext scheduler tuned for games (low latency under
    # load). Newer packages start it through scx_loader, older ones through
    # scx.service - both are configured, and exactly one is enabled.
    printf 'default_sched = "scx_lavd"\ndefault_mode = "Auto"\n' > /mnt/etc/scx_loader.toml
    mkdir -p /mnt/etc/default
    printf 'SCX_SCHEDULER=scx_lavd\nSCX_FLAGS=\n' > /mnt/etc/default/scx
    local scx_unit=""
    if arch-chroot /mnt systemctl cat scx_loader.service &>/dev/null; then
        scx_unit=scx_loader.service
        arch-chroot /mnt systemctl disable scx.service &>/dev/null || true
    elif arch-chroot /mnt systemctl cat scx.service &>/dev/null; then
        scx_unit=scx.service
    fi
    if [[ -n "$scx_unit" ]] && arch-chroot /mnt systemctl enable "$scx_unit" &>/dev/null; then
        log "LAVD CPU scheduler enabled"
    else
        warn "LAVD scheduler not enabled - the kernel's default scheduler is used"
    fi

    # Performance power mode from the first boot on - laptops too. Set once:
    # whatever is chosen later in the system menu is kept.
    cat > /mnt/etc/systemd/system/niix-performance-mode.service <<'PERFEOF'
[Unit]
Description=NiiX: start in the performance power mode
Requires=power-profiles-daemon.service
After=power-profiles-daemon.service
ConditionPathExists=!/var/lib/niix/performance-mode-set

[Service]
Type=oneshot
ExecStart=/usr/bin/powerprofilesctl set performance
ExecStartPost=/usr/bin/mkdir -p /var/lib/niix
ExecStartPost=/usr/bin/touch /var/lib/niix/performance-mode-set

[Install]
WantedBy=multi-user.target
PERFEOF
    arch-chroot /mnt systemctl enable niix-performance-mode.service &>/dev/null \
        || warn "Could not enable the performance power mode"

    if arch-chroot /mnt pacman -Q hhd &>/dev/null; then
        if arch-chroot /mnt systemctl enable "hhd@$USERNAME.service" &>/dev/null; then
            log "Handheld Daemon on - the built-in controls work as a controller"
        else
            warn "Could not enable Handheld Daemon"
        fi
    fi
}

# -- Wi-Fi hotspot (chosen in the installer) ---------------------------
# Saved straight into NetworkManager's profile store, the same profile
# 'niix-hotspot setup' makes; the keeper service brings it up from the first
# boot on, whenever this computer is online.
setup_hotspot() {
    [[ -n "$HOTSPOT_SSID" ]] || return 0
    local file=/mnt/etc/NetworkManager/system-connections/niix-hotspot.nmconnection uuid psk
    uuid=$(cat /proc/sys/kernel/random/uuid)
    psk=${HOTSPOT_PASS//\\/\\\\}
    mkdir -p /mnt/etc/NetworkManager/system-connections
    (
        umask 077
        cat > "$file" <<HSKEYEOF
[connection]
id=niix-hotspot
uuid=$uuid
type=wifi
autoconnect=false

[wifi]
band=bg
channel=7
mode=ap
powersave=2
ssid=$HOTSPOT_SSID

[wifi-security]
group=ccmp;
key-mgmt=wpa-psk
pairwise=ccmp;
pmf=2
proto=rsn;
psk=$psk

[ipv4]
method=shared

[ipv6]
method=ignore
HSKEYEOF
    ) || { warn "Could not save the hotspot - set it up later: niix-hotspot start"; return 0; }
    chown root:root "$file"
    chmod 600 "$file"
    if arch-chroot /mnt systemctl enable NetworkManager-dispatcher.service niix-hotspot-watchdog.service &>/dev/null; then
        log "Wi-Fi hotspot '$HOTSPOT_SSID' ready - it comes on whenever this computer is online"
    else
        warn "Hotspot saved, but auto mode could not be enabled - start it with: niix-hotspot start"
    fi
}

# -- Flatpak apps ----------------------------------------------------
# Heroic and ProtonUp-Qt come from Flathub rather than the AUR: signed,
# CDN-backed, and no third-party binary build step to break. They were
# downloaded in the background; anything that failed there is tried again.
install_flatpaks() {
    local app
    local -a missing=()
    for app in "${FLATPAK_APPS[@]}"; do
        target_flatpak info "$app" &>/dev/null || missing+=("$app")
    done
    if (( ${#missing[@]} )); then
        info "Installing the Flatpak apps still missing: ${missing[*]}"
        download_flatpaks "${missing[@]}" \
            || warn "Flathub unreachable - install the apps later from GNOME Software"
        for app in "${missing[@]}"; do
            target_flatpak info "$app" &>/dev/null \
                || warn "$app not installed - install it later from GNOME Software"
        done
    fi
    log "Flatpak apps ready (Heroic, ProtonUp-Qt, Stremio, Whatsie)"
}

# -- GE-Proton (latest, sha512-verified) -------------------------------
# Resolve the real release-asset URLs from the GitHub API instead of guessing
# them: hand-built URLs break whenever the asset naming changes. Anonymous
# api.github.com is capped at 60 req/h per IP; export GITHUB_TOKEN (or
# GH_TOKEN) before running to raise it to 5000/h. Verification is mandatory -
# an unverified archive is never extracted.
download_ge_proton() {
    local api="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
    local token="${GITHUB_TOKEN:-${GH_TOKEN:-}}" json tag urls tar_url sum_url tar_base rel_name
    local -a hdr=(-H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28")
    [[ -n "$token" ]] && hdr+=(-H "Authorization: Bearer $token")

    rm -rf "$GE_DIR"
    mkdir -p "$GE_DIR" || return 1
    json=$(curl -fsSL --retry 5 --retry-delay 3 --retry-connrefused \
        --connect-timeout 15 --max-time 120 -A "niixarch-installer" \
        "${hdr[@]}" "$api" 2>/dev/null) || {
        warn "GE-Proton: GitHub unreachable or rate-limited"
        return 1
    }
    tag=$(printf '%s\n' "$json" | grep -m1 '"tag_name"' | cut -d'"' -f4)
    [[ -n "$tag" ]] || { warn "GE-Proton: could not read the latest release"; return 1; }

    # The asset for x86_64 (releases also ship aarch64), and the checksum that
    # belongs to it. Older releases had no architecture in the name.
    urls=$(printf '%s\n' "$json" | grep -oE '"browser_download_url": *"[^"]*"' | cut -d'"' -f4)
    tar_url=$(printf '%s\n' "$urls" | grep -E 'x86_64\.tar\.gz$' | head -n1)
    [[ -n "$tar_url" ]] || tar_url=$(printf '%s\n' "$urls" | grep -E '\.tar\.gz$' | grep -viE 'aarch64|arm64' | head -n1)
    tar_base=$(basename "$tar_url")
    rel_name=${tar_base%.tar.gz}
    sum_url=$(printf '%s\n' "$urls" | grep -E "/${rel_name}\.sha512sum$" | head -n1)
    [[ -n "$sum_url" ]] || sum_url=$(printf '%s\n' "$urls" | grep -E '\.sha512sum$' | grep -viE 'aarch64|arm64' | head -n1)
    if [[ -z "$tar_url" || -z "$sum_url" ]]; then
        warn "GE-Proton: no x86_64 download in release $tag"
        return 1
    fi

    # The checksum comes from the same GitHub release, so it proves the
    # download is intact, not who published it; GE-Proton publishes no
    # signatures. The .sha512sum names the bare file, so it is checked from
    # inside the download directory.
    if curl -fL --retry 5 --retry-delay 3 --retry-connrefused --connect-timeout 15 --max-time 1800 \
            -sS -o "$GE_DIR/$tar_base" "$tar_url" \
        && curl -fL --retry 5 --retry-delay 3 --retry-connrefused --connect-timeout 15 --max-time 120 \
            -sS -o "$GE_DIR/$(basename "$sum_url")" "$sum_url" \
        && ( cd "$GE_DIR" && sha512sum -c "$(basename "$sum_url")" ); then
        printf '%s\n%s\n' "$tar_base" "$tag" > "$GE_DIR/ready"
        return 0
    fi
    warn "GE-Proton: download or checksum check failed"
    rm -rf "$GE_DIR"
    return 1
}

# install_ge_proton : into the user's Steam, from the background download - or
# downloaded now if that failed. Verification is mandatory: an unverified
# archive is never extracted.
install_ge_proton() {
    local compat_dir="/mnt/home/$USERNAME/.local/share/Steam/compatibilitytools.d" tar_base tag rc=1
    if [[ ! -f "$GE_DIR/ready" ]]; then
        info "Downloading GE-Proton..."
        download_ge_proton || true
    fi
    if [[ -f "$GE_DIR/ready" ]]; then
        { read -r tar_base; read -r tag; } < "$GE_DIR/ready"
        mkdir -p "$compat_dir"
        if tar -xzf "$GE_DIR/$tar_base" -C "$compat_dir"; then
            log "GE-Proton $tag installed (sha512 verified)"
            rc=0
        else
            warn "GE-Proton could not be unpacked - skipped (use ProtonUp-Qt later)"
        fi
        chown -R "$USER_UID:$USER_GID" "/mnt/home/$USERNAME/.local"
    else
        warn "GE-Proton skipped - install it later with ProtonUp-Qt"
    fi
    return "$rc"
}

# -- Tidy app menu ----------------------------------------------------
# Hidden per user (niix-hide-app: reversible with niix-unhide-app, nothing is
# uninstalled). Each app is looked up by its desktop ID first, then by a
# case-insensitive part of its name - upstream names often differ from what
# the menu shows (Totem is "Videos", baobab is "Disk Usage Analyzer").
hide_menu_apps() {
    arch-chroot /mnt runuser -u "$USERNAME" -- env HOME="/home/$USERNAME" bash <<'HIDEAPPSEOF'
set -u
hidden=0 total=0
for pair in \
    "org.gnome.Music::Music" \
    "bssh::Avahi SSH Server Browser" \
    "bvnc::Avahi VNC Server Browser" \
    "avahi-discover::Avahi Zeroconf Browser" \
    "org.gnome.Snapshot::Camera" \
    "org.corectrl.CoreCtrl::CoreCtrl" \
    "com.github.amezin.ddterm::ddterm" \
    "org.gnome.baobab::Disk Usage Analy" \
    "lstopo::Hardware Locality" \
    "org.gnome.Logs::Logs" \
    "org.freedesktop.MalcontentControl::Parental Controls" \
    "net.davidotek.pupgui2::ProtonUp" \
    "assistant::Qt Assistant" \
    "qdbusviewer::Qt D-Bus Viewer" \
    "linguist::Qt Linguist" \
    "qv4l2::Qt V4L2 test" \
    "qvidcap::Qt V4L2 video capture" \
    "designer::Qt Widgets Designer" \
    "org.gnome.SystemMonitor::System Monitor" \
    "org.gnome.Terminal::Terminal" \
    "org.gnome.Console::Console" \
    "org.gnome.Totem::Video" \
    "org.gnome.Weather::Weather" \
    "winetricks::Winetricks" \
    "org.gnome.Tour::Tour"
do
    id=${pair%%::*} name=${pair##*::} found=""
    total=$((total + 1))
    for dir in /usr/share/applications /var/lib/flatpak/exports/share/applications; do
        [ -f "$dir/$id.desktop" ] && { found=$id; break; }
    done
    if [ -z "$found" ]; then
        found=$(grep -ils "^Name=.*${name}" /usr/share/applications/*.desktop \
            /var/lib/flatpak/exports/share/applications/*.desktop 2>/dev/null \
            | head -1 | xargs -r basename -s .desktop)
    fi
    if [ -n "$found" ] && /usr/local/bin/niix-hide-app "$found" >/dev/null 2>&1; then
        hidden=$((hidden + 1))
    fi
done
echo "  Menu: $hidden of $total listed apps hidden (the rest are not installed)"
HIDEAPPSEOF
}

# -- The desktop and apps, ready before the first boot ----------------
setup_desktop_apps() {
    hr "Desktop and Apps"
    USER_UID=$(arch-chroot /mnt id -u "$USERNAME") || err "Could not look up the user '$USERNAME'"
    USER_GID=$(arch-chroot /mnt id -g "$USERNAME") || err "Could not look up the user '$USERNAME'"

    write_desktop_defaults
    install_panel_fix
    setup_steam
    setup_vr
    write_app_config
    write_user_files
    install_user_extensions
    enable_extras
    setup_hotspot
    finish_downloads
    install_flatpaks
    install_ge_proton || true
    rm -rf "$DL_DIR"
    hide_menu_apps
    arch-chroot /mnt /usr/local/bin/niix-iconify --quiet 2>/dev/null || true
    log "Desktop and apps ready"
}

# log_boot_config : what the new system boots with, into the log.
log_boot_config() {
    {
        echo
        echo "==== BOOT CONFIGURATION ===="
        for f in /mnt/etc/mkinitcpio.conf /mnt/etc/fstab /mnt/etc/environment \
                 /mnt/etc/sysctl.d/99-niixarch.conf /mnt/boot/EFI/limine/limine.conf; do
            echo "--- ${f#/mnt} ---"
            cat "$f" 2>&1
        done
        echo "--- initramfs ---"
        lsinitcpio /mnt/boot/initramfs-linux-cachyos.img 2>&1 | grep -iE 'hooks/|cryptsetup'
        echo "--- EFI partition ---"
        find /mnt/boot -type f \( -name '*.img' -o -name 'vmlinuz*' -o -name '*.conf' -o -iname '*.efi' \) 2>&1 | head -40
        df -h /mnt/boot 2>&1
        echo "--- UEFI boot entries ---"
        efibootmgr -v 2>&1
    } >> "$LOGFILE" 2>&1
}

# -- Done -----------------------------------------------------
finish() {
    hr "Complete"
    step_done
    if (( ${#STEP_TIMES[@]} )); then
        info "Time per step:"
        printf '      %s\n' "${STEP_TIMES[@]}"
    fi
    echo
    echo
    echo -e "  ${PINK}========================================${NC}"
    echo -e "  ${GREEN}  niiXa${PINK}OS${NC}   ${WHITE}NiiX Arch${NC}"
    echo -e "  ${PINK}========================================${NC}"
    echo
    echo
    echo -e "  ${GREEN}installation complete!${NC}"
    echo -e "  ${PINK}--------------------------------------------------------${NC}"
    echo
    echo -e "  ${DIM}Remove the USB when the screen goes blank after reboot.${NC}"
    echo
    echo -e "  ${PINK}-- At the Limine menu ----------------------------${NC}"
    echo
    echo -e "  ${GREEN}+${NC}  ${WHITE}NiiX Arch${NC}               -> disk password -> desktop"
    echo -e "  ${GREEN}+${NC}  ${WHITE}NiiX Arch (clean state)${NC} -> the system as it was installed (fallback)"
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        echo -e "  ${GREEN}+${NC}  ${WHITE}Windows Boot Manager${NC}    -> boots Windows normally"
    fi
    echo
    echo -e "  ${PINK}-- After the first boot ---------------------------${NC}"
    echo
    echo -e "  ${CYAN}-${NC}  Everything is set up - the desktop opens ready to use."
    echo -e "  ${CYAN}-${NC}  Graphics: the most powerful GPU runs everything (${WHITE}niix-gpu status${NC})"
    echo -e "  ${CYAN}-${NC}  Steam one-time: Settings -> Compatibility -> Steam Play for all titles -> ${WHITE}Proton-CachyOS${NC}"
    echo -e "  ${CYAN}-${NC}  Update everything: ${WHITE}niix-update${NC}  -  Wi-Fi hotspot: ${WHITE}niix-hotspot start${NC}"
    echo -e "  ${CYAN}-${NC}  VR: Quest/Pico -> open ${WHITE}WiVRn${NC} and pair the headset  -  Index/Vive -> install ${WHITE}SteamVR${NC} in Steam"
    echo -e "  ${CYAN}-${NC}  Snapper snapshots before/after every update; refresh the clean state: ${WHITE}sudo niixarch-refresh-clean${NC}"
    echo
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        warn "If Limine doesn't appear: go into BIOS and move"
        warn "'NiiX Arch (Limine)' above Windows in the boot order."
    fi
    echo
}

# -- Install mode: dual-boot next to Windows, or single-boot --------
# windows_present : 0 when Windows is installed on an internal drive - an
# NTFS partition, or the Windows boot manager on an EFI partition.
windows_present() {
    local dev parent mnt found=1
    while IFS= read -r dev; do
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        [[ -n "$parent" ]] && is_removable "/dev/$parent" && continue
        if [[ "$(blkid -s TYPE -o value "$dev" 2>/dev/null)" == ntfs ]]; then
            log "Windows NTFS partition found: $dev"
            return 0
        fi
    done < <(lsblk -lno PATH,TYPE 2>/dev/null | awk '$2 == "part" { print $1 }')

    while IFS= read -r dev; do
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        [[ -n "$parent" ]] && is_removable "/dev/$parent" && continue
        mnt=$(mktemp -d) || return 1
        if mount -o ro "$dev" "$mnt" 2>/dev/null; then
            if [[ -f "$mnt/EFI/Microsoft/Boot/bootmgfw.efi" ]]; then
                log "Windows boot manager found: $dev"
                found=0
            fi
            umount "$mnt"
        fi
        rmdir "$mnt"
        (( found == 0 )) && return 0
    done < <(blkid -t PART_ENTRY_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" -o device 2>/dev/null)
    return 1
}

auto_detect_mode() {
    hr "Install Mode Detection"
    info "Scanning internal drives for existing operating systems..."
    local choice answer

    if $GUI_MODE; then
        case "${ANS[MODE]:-}" in
            dualboot)   windows_present || err "Dual-boot was chosen, but no Windows install was found." ;;
            singleboot) ;;
            *)          err "No install mode given." ;;
        esac
        INSTALL_MODE=${ANS[MODE]}
        log "Install mode: $INSTALL_MODE"
        return
    fi

    echo
    if windows_present; then
        echo -e "  ${GREEN}+${NC}  ${WHITE}${BOLD}Windows detected on an internal drive${NC}"
        echo
        echo -e "  ${WHITE}${BOLD}How do you want to install?${NC}"
        echo -e "  ${GREEN}[1]${NC}  ${WHITE}Dual-boot${NC}    - keep Windows, install NiiX next to it  ${DIM}(recommended)${NC}"
        echo -e "  ${GREEN}[2]${NC}  ${WHITE}Single-boot${NC}  - ${RED}ERASE an entire drive${NC} (including Windows) and use it for NiiX"
        echo
        echo -e "  ${DIM}Press Enter for the safe choice (dual-boot).${NC}"
        read -rp "  Choose [1/2]: " choice
        if [[ "$choice" == "2" ]]; then
            # A typed phrase, so a stray keypress can never erase Windows.
            echo
            warn "Single-boot ERASES a whole drive. Windows and everything on it will be gone."
            warn "There is no undo. You will still choose which drive and confirm again later."
            echo
            echo -e "  ${RED}${BOLD}Type exactly:  ERASE WINDOWS  to continue (anything else keeps Windows):${NC}"
            read -rp "  > " answer
            if [[ "$answer" == "ERASE WINDOWS" ]]; then
                INSTALL_MODE="singleboot"
                warn "Single-boot selected - you will pick the drive to erase next."
            else
                INSTALL_MODE="dualboot"
                log "Phrase did not match - keeping Windows (dual-boot)."
            fi
        else
            INSTALL_MODE="dualboot"
            echo -e "  ${GREEN}+${NC}  ${WHITE}${BOLD}Dual-boot - Windows will be preserved${NC}"
            echo -e "  ${DIM}  NiiX installs into free space. No existing data is touched.${NC}"
        fi
    else
        INSTALL_MODE="singleboot"
        echo -e "  ${CYAN}-${NC}  ${WHITE}${BOLD}No existing OS detected - installing in single-boot mode${NC}"
        echo -e "  ${DIM}  A drive of your choice will be fully wiped and used for NiiX.${NC}"
    fi
    echo
}

# -- Single-boot: choose, wipe and partition the drive --------
select_single_drive() {
    hr "Select Target Drive  (will be fully wiped)"
    if $GUI_MODE; then
        internal_disks | grep -qxF -- "${ANS[SINGLE_DRIVE]:-}" \
            || err "The drive chosen for the install is not an internal drive here."
        SINGLE_DRIVE=${ANS[SINGLE_DRIVE]}
        TARGET_DRIVE=$SINGLE_DRIVE
        log "Target drive: $SINGLE_DRIVE"
        return
    fi
    warn "The ENTIRE selected drive will be repartitioned and ALL data destroyed."
    warn "This includes any existing OS, partitions, and files on that drive."
    echo
    echo -e "  ${WHITE}${BOLD}Internal drives:${NC}"
    echo

    # Whole internal disks only: never USB, zram, md arrays, nbd or optical.
    local -a drives=()
    local path type size model i choice answer
    while read -r path type size model; do
        [[ "$type" == disk ]] || continue
        is_removable "$path" && continue
        big_enough "$path" || continue
        drives+=("$path")
        printf "  ${CYAN}[%s]${NC}  %-14s  %8s  %s\n" "$(( ${#drives[@]} - 1 ))" "$path" "$size" "$model"
    done < <(lsblk -dn -o PATH,TYPE,SIZE,MODEL 2>/dev/null)
    (( ${#drives[@]} )) || err "No internal drive of ${NIIX_MIN_GIB} GiB or more found"

    echo
    ask "Select drive to install on (will be COMPLETELY WIPED):"
    read -rp "  > " choice
    # Numbers only: bash would read anything else as index 0, the first drive.
    [[ "$choice" =~ ^[0-9]+$ && -n "${drives[choice]:-}" ]] || err "Invalid selection: $choice"

    SINGLE_DRIVE=${drives[choice]}
    TARGET_DRIVE=$SINGLE_DRIVE
    [[ -b "$SINGLE_DRIVE" ]] || err "Not a block device: $SINGLE_DRIVE"

    size=$(lsblk -dn -o SIZE "$SINGLE_DRIVE" 2>/dev/null | head -1 | tr -d '[:space:]')
    echo
    echo -e "  ${RED}${BOLD}You selected: $SINGLE_DRIVE ($size)${NC}"
    echo -e "  ${RED}${BOLD}ALL data on this drive will be permanently destroyed.${NC}"
    echo
    echo -e "  ${RED}Type  WIPE  (uppercase) to confirm:${NC}"
    read -rp "  > " answer
    [[ "$answer" == "WIPE" ]] || { echo "  Aborted. Nothing was changed."; exit 0; }

    log "Target drive confirmed: $SINGLE_DRIVE ($size)"
}

# wipe_single_drive : every partition table and file system signature on the
# drive gone - nothing on it can be mistaken for a former system later.
wipe_single_drive() {
    hr "Drive Wipe"
    info "Wiping $SINGLE_DRIVE - destroying all existing data..."

    # Close any open LUKS containers on this drive first
    lsblk -lno NAME,TYPE "$SINGLE_DRIVE" 2>/dev/null \
        | awk '$2=="crypt"{print $1}' \
        | while read -r cname; do
            info "Closing LUKS container /dev/mapper/$cname..."
            cryptsetup close "$cname" 2>/dev/null || true
        done

    # Unmount any mounted partitions on this drive
    lsblk -lno NAME,MOUNTPOINT "$SINGLE_DRIVE" 2>/dev/null \
        | awk '$2!=""{print $2}' \
        | while read -r mnt; do
            umount "$mnt" 2>/dev/null || true
        done

    # Wipe all filesystem and partition signatures
    wipefs -a "$SINGLE_DRIVE" || err "wipefs failed on $SINGLE_DRIVE"
    log "Filesystem signatures wiped"

    # Destroy the partition table (GPT + MBR backup)
    sgdisk --zap-all "$SINGLE_DRIVE" || err "sgdisk --zap-all failed on $SINGLE_DRIVE"
    log "Partition table destroyed"

    # Zero the first and last 10 MiB to eliminate any residual metadata
    dd if=/dev/zero of="$SINGLE_DRIVE" bs=1M count=10 conv=fsync 2>/dev/null \
        || err "Failed to zero the start of $SINGLE_DRIVE"
    dd if=/dev/zero of="$SINGLE_DRIVE" bs=1M count=10 conv=fsync \
        seek=$(( $(blockdev --getsz "$SINGLE_DRIVE") / 2048 - 10 )) 2>/dev/null || true

    partprobe "$SINGLE_DRIVE" 2>/dev/null || true
    udevadm settle --timeout=10 2>/dev/null || true
    log "Drive $SINGLE_DRIVE wiped - ready for partitioning"
}

# create_singleboot_partitions : a new EFI partition and the encrypted one,
# with the same variables dual-boot sets - everything after this is the same
# for both modes.
create_singleboot_partitions() {
    hr "Partition Creation  (single-boot)"
    info "Partitioning $SINGLE_DRIVE - same layout as dual-boot..."

    # -- GPT + EFI + LUKS -------------------------------------
    parted -s "$SINGLE_DRIVE" mklabel gpt || err "Failed to create GPT label on $SINGLE_DRIVE"
    log "New GPT partition table created"

    # Partition 1: EFI System Partition - 512 MiB
    # 1 MiB aligned start; large enough for kernel + initramfs + ucode + Limine
    parted -s "$SINGLE_DRIVE" mkpart "EFI" fat32 1MiB 513MiB || err "Failed to create EFI partition"
    parted -s "$SINGLE_DRIVE" set 1 esp on                    || err "Failed to set esp flag on partition 1"
    log "EFI partition: 1 MiB -> 513 MiB  (512 MiB, partition 1)"

    # Partition 2: Linux LUKS container - remainder of drive
    parted -s "$SINGLE_DRIVE" mkpart "arch" 513MiB 100% || err "Failed to create root partition"
    log "Root partition: 513 MiB -> 100%  (partition 2)"

    # Inform the kernel; the device nodes are waited for below.
    partprobe "$SINGLE_DRIVE" 2>/dev/null || true

    EFI_PART=$(part_path "$SINGLE_DRIVE" 1)
    LUKS_PART=$(part_path "$SINGLE_DRIVE" 2)

    # Wait for udev to publish both nodes (up to ~10s), then verify.
    local try
    for (( try = 0; try < 20; try++ )); do
        [[ -b "$EFI_PART" && -b "$LUKS_PART" ]] && break
        udevadm settle --timeout=5 2>/dev/null || true
        sleep 0.5
    done
    [[ -b "$EFI_PART"  ]] || err "EFI partition $EFI_PART not found after partprobe"
    [[ -b "$LUKS_PART" ]] || err "Root partition $LUKS_PART not found after partprobe"

    # Mirror the variables dual-boot sets - everything downstream is identical
    EFI_DRIVE="$SINGLE_DRIVE"
    EFI_PART_NUM=1
    TARGET_DRIVE="$SINGLE_DRIVE"

    # Format EFI partition as FAT32 (same as Windows creates)
    mkfs.fat -F32 -n "EFI" "$EFI_PART" || err "mkfs.fat failed on $EFI_PART"
    log "EFI partition formatted: $EFI_PART  (FAT32)"
    log "LUKS partition ready:    $LUKS_PART  (encryption next)"
}

# -- Installer integrity -----------------------------------------------------
# The ISO build records the installer's sha256 next to it on the ISO. A
# damaged USB stick or a changed copy shows up here, before anything is
# touched. (It protects against damage, not against a deliberately tampered
# ISO - verify the ISO's own checksum for that.)

verify_installer() {
    local expected actual
    if [[ "${NIIX_SKIP_VERIFY:-0}" == "1" ]]; then
        warn "Installer verification SKIPPED (NIIX_SKIP_VERIFY=1) - only do this for development."
        return 0
    fi

    # Already checked by the graphical installer: only still the same file.
    if [[ -n "${NIIX_VERIFIED_SHA:-}" && -f "$0" ]]; then
        actual=$(sha256sum "$0" 2>/dev/null | awk '{print $1}')
        if [[ "$actual" == "$NIIX_VERIFIED_SHA" ]]; then
            log "Installer verified (sha256 unchanged since it was checked)"
            return 0
        fi
    fi

    if [[ -f "$0.sha256" ]]; then
        expected=$(awk 'NR == 1 { print tolower($1) }' "$0.sha256")
        actual=$(sha256sum "$0" | awk '{print $1}')
        [[ "$actual" == "$expected" ]] \
            || err "The installer on this ISO is damaged (checksum mismatch) - write the ISO to the USB stick again."
        log "Installer verified (sha256 recorded when the ISO was built)"
        return 0
    fi

    err "No checksum next to the installer ($0.sha256) - start it from the NiiX live ISO."
}

# -- GUI installer entry points ---------------------------------
# read_answers : KEY=VALUE lines on stdin (from the GUI; never a file, so the
# passwords are never written to disk).
read_answers() {
    local line key
    GUI_MODE=true
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        key=${line%%=*}
        case "$key" in
            MODE|TARGET_REGION|DELETE_PART|SINGLE_DRIVE|KEYBOARD|TIMEZONE|\
            HOSTNAME|USERNAME|USER_PASS|LUKS_PASS|MITIGATIONS|REPLACE_KERNELS|\
            HOTSPOT_SSID|HOTSPOT_PASS)
                ANS[$key]=${line#*=} ;;
            *)
                err "Unknown answer '$key' from the GUI installer" ;;
        esac
    done
}

# efi_has_foreign_kernels : 0 when the ESP holds kernels of another Linux
# install - clean_efi needs the user's consent to replace them.
efi_has_foreign_kernels() {
    local mnt rc=1
    mnt=$(mktemp -d) || return 1
    if mount -o ro "$EFI_PART" "$mnt" 2>/dev/null; then
        [[ -n "$(esp_kernels "$mnt")" ]] && ! niix_owns_esp "$mnt" && rc=0
        umount "$mnt"
    fi
    rmdir "$mnt"
    return "$rc"
}

# probe : everything the GUI needs to ask its questions, as @@ lines.
# stdout carries only the @@ lines; everything the checks print goes to
# stderr, which the GUI shows when the probe fails.
probe() {
    local line path size model i
    [[ $EUID -eq 0 ]] || { echo "@@error The probe needs root"; exit 1; }
    trap 'echo "@@error The hardware check stopped unexpectedly (exit code $?)."' EXIT
    if windows_present >&2; then
        echo "@@windows=yes"
        if locate_efi >&2; then
            echo "@@efi=$EFI_PART|$(lsblk -bno SIZE "$EFI_PART" | head -1 | tr -d '[:space:]')"
            efi_has_foreign_kernels && echo "@@foreign_kernels=yes"
        fi
        while IFS= read -r line; do echo "@@region=$line"; done < <(list_free_regions)
        while IFS= read -r line; do echo "@@partition=$line"; done < <(list_deletable_partitions)
    else
        echo "@@windows=no"
    fi
    while IFS= read -r path; do
        big_enough "$path" || continue
        size=$(lsblk -dno SIZE "$path" 2>/dev/null | tr -d '[:space:]')
        model=$(lsblk -dno MODEL "$path" 2>/dev/null)
        echo "@@drive=$path|$size|${model:-Unknown}"
    done < <(internal_disks)
    load_keyboards
    for i in "${!KB_NAME[@]}"; do
        echo "@@keyboard=${KB_NAME[i]}|$(typing_layout "$i")"
    done
    detect_hardware >&2
    echo "@@machine=$(machine_description)"
    echo "@@gpu=${GPU_MODEL:-unknown}"
    if wifi_can_host; then echo "@@wifi_ap=yes"; else echo "@@wifi_ap=no"; fi
    trap - EXIT
    echo "@@probe_done"
}

# check_account HOSTNAME USERNAME : the GUI's check before it moves on.
check_account() {
    local problem
    problem=$(hostname_problem "${1:-}") || { echo "@@problem hostname $problem"; return; }
    problem=$(username_problem "${2:-}") || { echo "@@problem username $problem"; return; }
    echo "@@ok"
}

# ============================================================
#  The ISO builder and the graphical installer
# ============================================================
# Both live in this file so one file is all there is to keep up to date.
# --build-iso runs the builder; it puts the graphical installer (and this
# file) on the ISO.
build_iso_command() {
    local script rc
    script=$(mktemp "${TMPDIR:-/tmp}/niix-build-iso.XXXXXX") \
        || { echo "ERROR: could not create a temporary file" >&2; return 1; }
    niix_iso_builder > "$script"
    NIIX_SELF=$(readlink -f "$0") bash "$script" "$@"
    rc=$?
    rm -f "$script"
    return "$rc"
}

niix_iso_builder() {
    cat <<'NIIXBUILDEOF'
#!/usr/bin/env bash
# The NiiX ISO builder - builds the NiiX live ISO from scratch, unattended.
#
#   sudo bash install --build-iso
#
# Runs on any Linux machine with ~40 GB free disk. Everything happens inside
# a throwaway Arch Linux container (podman, or docker), so nothing on this
# machine changes except: podman gets installed if neither tool is present,
# and the ISO, a log and a package cache appear next to the install file:
#
#   out/niixaos-YYYY.MM.DD-x86_64.iso         the ISO
#   out/niixaos-YYYY.MM.DD-x86_64.iso.sha256  its checksum
#   out/build-YYYYMMDD-HHMMSS.log             everything the build printed
#   cache/                                    downloaded packages - makes the
#                                             next build much faster (safe to delete)
#
# The ISO is a complete NiiX system: every package of the installer's package
# list (CachyOS kernel, GNOME, Steam, Proton-CachyOS, apps, fonts) plus the
# AUR packages, built here. The installer copies it to the disk and downloads
# only what is newer, the NVIDIA driver, GE-Proton and the Flatpak apps. The
# package list, NiiX tools, desktop settings, icon theme and the graphical
# installer all come from the same install file, so the live ISO and
# installed systems always match.
#
# The live system boots straight into the NiiX desktop (user "niix", no
# password) with an "Install NiiX" icon on the desktop.
# Building needs internet: Arch and CachyOS mirrors, the AUR,
# extensions.gnome.org, niixa.org and GitHub.
set -Eeuo pipefail

# -- Settings ----------------------------------------------------------------
ISO_NAME="niixaos"
ISO_LABEL_PREFIX="NIIXAOS"
ISO_PUBLISHER="NiiX <https://niixa.org>"
ISO_APPLICATION="NiiX Arch live system and installer"
WALLPAPER_URL="https://niixa.org/niix-background.png"
LOGO_URL="https://raw.githubusercontent.com/techniixdotcom/niixarch-install/main/niixarch-logo.png"
SIZE_WARN_GIB=4            # warn when the ISO is bigger than this
CONTAINER_IMAGE="docker.io/archlinux/archlinux:latest"
# CachyOS's package signing key (full fingerprint, as published on
# wiki.cachyos.org); cachyos-keyring brings the complete set afterwards.
CACHYOS_KEY="882DCFE48E2051D48E2562ABF3B607488DB35A47"
# shellcheck disable=SC2016  # $arch and $repo are pacman's, not the shell's
CACHYOS_SERVER='https://mirror.cachyos.org/repo/$arch/$repo'
# Only the live session needs these; the installer removes them.
LIVE_ONLY_PACKAGES=(mkinitcpio-archiso pv squashfs-tools)
# Shell extensions without an Arch package: the build for this GNOME version
# comes from extensions.gnome.org. ding shows the installer icon on the live
# desktop only.
EGO_EXTENSIONS=(tiling-assistant@leleat-on-github screen-rotate@shyzus.github.io ding@rastersoft.com)
LIVE_ONLY_EXTENSIONS=(ding@rastersoft.com)

# -- Common ------------------------------------------------------------------
say()  { printf '\033[38;5;118m==>\033[0m %s\n' "$*"; }
note() { printf '\033[38;5;215m  !\033[0m %s\n' "$*"; }
die()  { printf '\033[38;5;203mERROR:\033[0m %s\n' "$*" >&2; exit 1; }
trap 'die "build stopped at line $LINENO: $BASH_COMMAND"' ERR

# retry CMD... : run a network command up to 3 times (mirror and DNS blips).
retry() {
    local n
    for n in 1 2 3; do
        "$@" && return 0
        (( n < 3 )) && { note "Attempt $n failed - trying again in 15 seconds..."; sleep 15; }
    done
    note "Gave up after 3 attempts: $*"
    return 1
}

# online : 0 when the Arch mirrors can be reached by name.
online() {
    getent hosts geo.mirror.pkgbuild.com >/dev/null 2>&1
}

# The install file this builder came from (install --build-iso sets it).
SELF=${NIIX_SELF:?run this as: sudo bash install --build-iso}
HERE=$(dirname "$SELF")
SELF_NAME=$(basename "$SELF")

# ============================================================================
#  Part 1 - on this machine: get a container tool, start the Arch container
# ============================================================================
install_container_tool() {
    say "Installing podman (needed to run the Arch build container)..."
    if command -v pacman >/dev/null; then pacman -Sy --noconfirm --needed podman
    elif command -v apt-get >/dev/null; then apt-get update && apt-get install -y podman
    elif command -v dnf >/dev/null; then dnf install -y podman
    elif command -v zypper >/dev/null; then zypper --non-interactive install podman
    else die "No supported package manager found - install podman or docker, then run this again."
    fi
}

run_host() {
    [[ "$(uname -m)" == x86_64 ]] || die "Build on an x86_64 machine (this one is $(uname -m))."
    if [[ $EUID -ne 0 ]]; then
        command -v sudo >/dev/null || die "Run as root."
        exec sudo bash "$SELF" --build-iso "$@"
    fi

    local free_gb engine
    free_gb=$(( $(df -Pk "$HERE" | awk 'NR==2 {print $4}') / 1024 / 1024 ))
    (( free_gb >= 40 )) || die "Only ${free_gb} GB free next to $SELF_NAME - the build needs about 40 GB."
    online || die "This machine cannot look up geo.mirror.pkgbuild.com - connect it to the internet (and check its DNS), then run this again."

    if command -v podman >/dev/null; then engine=podman
    elif command -v docker >/dev/null; then engine=docker
    else install_container_tool; engine=podman
    fi

    mkdir -p "$HERE/out" "$HERE/cache"
    local log
    log="$HERE/out/build-$(date +%Y%m%d-%H%M%S).log"
    say "Building in an Arch Linux container ($engine) - log: $log"
    say "This takes 30-90 minutes depending on the internet connection."

    # --privileged: the build mounts /proc etc. inside the image it creates.
    # --network host: the container uses this machine's network and DNS as
    # they are. A container's own network has no DNS on many setups (a local
    # resolver such as systemd-resolved at 127.0.0.53, VPNs, firewalls).
    # nofile limit: with the huge default some engines set, fakeroot (used by
    # makepkg for the AUR packages) becomes extremely slow.
    # --pids-limit -1: pacstrap runs pacman as PID 1 of its own namespace, so
    # the gpg helpers of every signature check stay behind as zombies. With
    # podman's default limit of 2048 processes the last of the ~1000+
    # packages fail their check ("GPGME error ... missing required signature").
    retry "$engine" pull "$CONTAINER_IMAGE"
    "$engine" run --rm --privileged --network host --pids-limit -1 \
        --ulimit nofile=1024:524288 \
        -e NIIX_IN_CONTAINER=1 \
        -v "$HERE:/build:Z" \
        -v "$HERE/cache:/var/cache/pacman/pkg:Z" \
        -w /build \
        "$CONTAINER_IMAGE" \
        bash "/build/$SELF_NAME" --build-iso 2>&1 | tee "$log"
    local rc=${PIPESTATUS[0]}
    (( rc == 0 )) || die "The build failed - see $log"

    # The container ran as root; give the results to whoever ran sudo.
    if [[ -n "${SUDO_UID:-}" ]]; then
        chown -R "$SUDO_UID:${SUDO_GID:-$SUDO_UID}" "$HERE/out"
    fi
    say "Done. The ISO is in $HERE/out/"
}

# ============================================================================
#  Part 2 - inside the Arch container
# ============================================================================
WORK=/build/work
PROFILE=$WORK/profile
AIROOT=$PROFILE/airootfs
LOCALREPO=$WORK/localrepo
INSTALLER=$WORK/install
RELENG=/usr/share/archiso/configs/releng   # a few files are taken from Arch's own ISO

# Filled from the installer's package list (read_manifest).
REQUIRED=(); OPTIONAL=(); MANIFEST_GROUPS=(); SKIP=(); AUR=(); AUR_BASES=(); AUR_PKGS=()
# Everything only the live session needs, for the installer to remove.
LIVE_FILES=()

# fetch_cachyos_key : CachyOS's signing key, from the first keyserver that
# has it. The full fingerprint makes pacman-key refuse any other key.
fetch_cachyos_key() {
    local server
    for server in hkps://keyserver.ubuntu.com hkps://keys.openpgp.org; do
        pacman-key --keyserver "$server" --recv-keys "$CACHYOS_KEY" && return 0
    done
    return 1
}

prepare_container() {
    say "Preparing the build container..."
    online || die "The build container cannot look up geo.mirror.pkgbuild.com (no DNS inside the container)."
    # The ISO is built from CachyOS's x86-64-v3 packages, and the build runs
    # some of them (kernel module and initramfs builds) - this CPU must run
    # v3 programs.
    /lib64/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q 'x86-64-v3 (supported, searched)' \
        || die "This CPU can't run x86-64-v3 programs - build the NiiX ISO on a computer with a newer CPU (AVX2)."
    pacman-key --init
    pacman-key --populate archlinux

    # CachyOS (above Arch's repos, as CachyOS installs it): the kernel,
    # Proton-CachyOS, chwd and yay. One server until cachyos-mirrorlist
    # brings the full list.
    say "Adding the CachyOS repository..."
    retry fetch_cachyos_key || die "Could not download CachyOS's signing key."
    pacman-key --lsign-key "$CACHYOS_KEY"
    [[ -f /etc/pacman.d/cachyos-mirrorlist ]] \
        || printf 'Server = %s\n' "$CACHYOS_SERVER" > /etc/pacman.d/cachyos-mirrorlist
    if ! grep -q '^\[cachyos\]' /etc/pacman.conf; then
        sed -i '/^\[core\]/i [cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n' /etc/pacman.conf
    fi
    # multilib for the build tools' own view of the repos (pacman -Si lookups)
    if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
        printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf
    fi
    sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 10/' /etc/pacman.conf
    retry pacman -Syu --noconfirm --needed --overwrite /etc/pacman.d/cachyos-mirrorlist \
        archiso git base-devel sudo curl python libarchive glib2 gtk-update-icon-cache \
        reflector cachyos-keyring cachyos-mirrorlist cachyos-v3-mirrorlist
    pacman-key --populate cachyos
    say "Picking the fastest Arch mirrors..."
    reflector --protocol https --age 12 --latest 25 --fastest 10 \
        --save /etc/pacman.d/mirrorlist || note "reflector failed - using the default mirrors"
    rm -rf "$WORK"
    mkdir -p "$WORK" "$LOCALREPO"
}

# get_installer : the install file this build runs from - the ISO carries
# exactly this one.
get_installer() {
    [[ -f "/build/$SELF_NAME" ]] || die "The install file is missing from the build folder."
    cp "/build/$SELF_NAME" "$INSTALLER"
}

# get_gui : the graphical installer, taken from the install file.
get_gui() {
    extract NIIXGUIEOF "$WORK/niix-installer"
    python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$WORK/niix-installer" \
        || die "The graphical installer in the install file is not valid Python."
}

# extract TAG FILE : copy the body of the installer's <<'TAG' heredoc to FILE.
# The live system gets exactly the tools and settings the installer writes.
extract() {
    extract_stdout "$1" > "$2"
    [[ -s "$2" ]] || die "The installer has no '$1' section - is the install file complete?"
}

extract_stdout() {
    awk -v tag="$1" 'on && $0 == tag { exit } on { print } $0 ~ ("<<\047" tag "\047$") { on = 1 }' "$INSTALLER"
}

# The installer's package list (niix_packages in the install file):
#   name  ?optional  @group  !not-from-the-group
read_manifest() {
    local line
    extract NIIXPKGSEOF "$WORK/manifest"
    while read -r line; do
        line=${line%%#*}
        line=${line//[[:space:]]/}
        case "$line" in
            '')   ;;
            '!'*) SKIP+=("${line:1}") ;;
            '@'*) MANIFEST_GROUPS+=("${line:1}") ;;
            '?'*) OPTIONAL+=("${line:1}") ;;
            *)    REQUIRED+=("$line") ;;
        esac
    done < "$WORK/manifest"
    extract NIIXAUREOF "$WORK/aur"
    mapfile -t AUR < <(sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$WORK/aur")
    (( ${#REQUIRED[@]} > 50 && ${#AUR[@]} )) || die "The installer's package list looks incomplete."
    local entry
    local -a names
    for line in "${AUR[@]}"; do
        entry=${line%%=*}
        AUR_BASES+=("$entry")
        if [[ "$line" == *=* ]]; then
            IFS=, read -ra names <<< "${line#*=}"
            AUR_PKGS+=("${names[@]}")
        else
            AUR_PKGS+=("$entry")
        fi
    done
}

# clone_aur PKG : a fresh clone of the package's AUR repository.
clone_aur() {
    rm -rf "/home/builder/$1"
    sudo -u builder git clone --depth 1 "https://aur.archlinux.org/$1.git" "/home/builder/$1"
}

# fetch_key FINGERPRINT : the public key, from the first keyserver that has it.
fetch_key() {
    local server
    for server in hkps://keyserver.ubuntu.com hkps://keys.openpgp.org; do
        sudo -u builder gpg --batch --keyserver "$server" --recv-keys "$1" && return 0
    done
    return 1
}

# import_signing_keys DIR : the keys the package's maintainer lists as the
# ones its download is signed with (validpgpkeys), so makepkg can check the
# signature instead of skipping it. Full fingerprints - gpg refuses a key
# that doesn't match.
import_signing_keys() {
    local key
    local -a keys
    mapfile -t keys < <(awk '$1 == "validpgpkeys" { print $3 }' "$1/.SRCINFO")
    for key in "${keys[@]}"; do
        [[ "$key" =~ ^[0-9A-Fa-f]{40}$ ]] || die "Unexpected signing key '$key' in $1/.SRCINFO"
        sudo -u builder gpg --batch --list-keys "$key" &>/dev/null && continue
        retry fetch_key "$key" || die "Could not download the signing key $key for $(basename "$1")."
    done
}

build_aur_packages() {
    local pkg built=0
    id builder &>/dev/null || useradd -m builder
    echo 'builder ALL=(ALL) NOPASSWD: /usr/bin/pacman' > /etc/sudoers.d/builder
    chown builder "$LOCALREPO"
    for pkg in "${AUR_BASES[@]}"; do
        # CachyOS packages some of these itself - prebuilt and signed, and
        # ahead of a local build in the repo order anyway.
        if pacman -Si "$pkg" &>/dev/null; then
            say "$pkg: in the repositories - using that build"
            continue
        fi
        say "Building $pkg from the AUR..."
        built=$(( built + 1 ))
        retry clone_aur "$pkg"
        import_signing_keys "/home/builder/$pkg"
        # Download and check the sources first, with retries - they come from
        # the package's own hosts (GitHub, Codeberg ...), not the mirrors.
        retry sudo -u builder env -C "/home/builder/$pkg" makepkg --verifysource --noconfirm
        sudo -u builder env -C "/home/builder/$pkg" PKGDEST="$LOCALREPO" makepkg -s --noconfirm --needed
    done
    if (( built )); then
        repo-add "$LOCALREPO/niix-local.db.tar.gz" "$LOCALREPO"/*.pkg.tar.*
    fi
}

# live_only PATH... : files that only the live session needs.
live_only() {
    LIVE_FILES+=("$@")
}

make_profile() {
    say "Creating the ISO profile..."
    local -a gnome pkgs=() missing=()
    local -A in_repos=()
    local pkg
    mkdir -p "$PROFILE/efiboot/loader/entries" "$AIROOT/etc/mkinitcpio.conf.d" \
             "$AIROOT/etc/systemd/system/multi-user.target.wants" "$AIROOT/etc/pacman.d/hooks" \
             "$AIROOT/usr/local/lib/niix"

    # Boot: UEFI only - NiiX installs with Limine on UEFI. Kernel: CachyOS.
    # No 'quiet': archiso reports a missing boot device only when it is off.
    # rootdelay=30 gives slow USB sticks time to appear (the default is 10s).
    # pv (live-only) shows the progress while the image is copied to RAM.
    # cow_spacesize: room for what the live session writes (archiso's 256M
    # fills up quickly); it is a limit, not memory set aside.
    cat > "$PROFILE/efiboot/loader/loader.conf" <<'EOF'
timeout 5
default 01-niix.conf
EOF
    cat > "$PROFILE/efiboot/loader/entries/01-niix.conf" <<'EOF'
title    NiiX Arch live
sort-key 01
linux    /%INSTALL_DIR%/boot/%ARCH%/vmlinuz-linux-cachyos
initrd   /%INSTALL_DIR%/boot/%ARCH%/initramfs-linux-cachyos.img
options  archisobasedir=%INSTALL_DIR% archisosearchuuid=%ARCHISO_UUID% rootdelay=30 cow_spacesize=1G loglevel=3 systemd.show_status=auto
EOF
    cat > "$PROFILE/efiboot/loader/entries/02-niix-safe-graphics.conf" <<'EOF'
title    NiiX Arch live (safe graphics)
sort-key 02
linux    /%INSTALL_DIR%/boot/%ARCH%/vmlinuz-linux-cachyos
initrd   /%INSTALL_DIR%/boot/%ARCH%/initramfs-linux-cachyos.img
options  archisobasedir=%INSTALL_DIR% archisosearchuuid=%ARCHISO_UUID% rootdelay=30 cow_spacesize=1G nomodeset
EOF

    # The live initramfs: archiso's hooks find and mount the image (also when
    # the ISO file itself is booted from a USB stick, archiso_loop_mnt).
    cat > "$AIROOT/etc/mkinitcpio.conf.d/archiso.conf" <<'EOF'
HOOKS=(base udev microcode modconf kms archiso archiso_loop_mnt block filesystems keyboard)
COMPRESSION="xz"
COMPRESSION_OPTIONS=(-9e)
EOF
    # From Arch's install medium: the keyring in RAM (initialised at boot)
    # and the build-time mirror hooks (they delete themselves from the image).
    cp "$RELENG/airootfs/etc/systemd/system/pacman-init.service" \
       "$RELENG/airootfs/etc/systemd/system/etc-pacman.d-gnupg.mount" "$AIROOT/etc/systemd/system/"
    ln -sf ../pacman-init.service "$AIROOT/etc/systemd/system/multi-user.target.wants/pacman-init.service"
    cp "$RELENG"/airootfs/etc/pacman.d/hooks/*.hook "$AIROOT/etc/pacman.d/hooks/"
    cp "$RELENG/airootfs/etc/locale.conf" "$AIROOT/etc/"
    echo niix-live > "$AIROOT/etc/hostname"
    # Time zone and console keymap set, and systemd's first-boot questions
    # off: the live system starts straight into the desktop. The installer
    # asks for the time zone and keyboard of the installed system.
    ln -sf /usr/share/zoneinfo/Europe/Zurich "$AIROOT/etc/localtime"
    echo KEYMAP=us > "$AIROOT/etc/vconsole.conf"
    ln -sf /dev/null "$AIROOT/etc/systemd/system/systemd-firstboot.service"
    : > "$AIROOT/etc/niix-live"
    live_only /etc/niix-live /etc/mkinitcpio.conf.d/archiso.conf \
        /etc/systemd/system/pacman-init.service /etc/systemd/system/etc-pacman.d-gnupg.mount \
        /etc/systemd/system/multi-user.target.wants/pacman-init.service \
        /etc/systemd/system/systemd-firstboot.service

    # Repositories: NiiX's own pacman.conf (CachyOS's x86-64-v3 builds above
    # CachyOS, Arch and multilib - as an install on a v3 CPU has it, so an
    # install downloads nothing again) plus the local repo with the AUR
    # packages built above. The live session uses the same pacman.conf
    # (copied at boot - pacman owns the file).
    NIIX_ARCH="x86_64 x86_64_v3" awk -v repos="$(printf '[%s]\nInclude = /etc/pacman.d/cachyos-v3-mirrorlist\n\n' \
            cachyos-v3 cachyos-core-v3 cachyos-extra-v3)" '
        /^Architecture = / { print "Architecture = " ENVIRON["NIIX_ARCH"]; next }
        /^#NIIX-OPTIMIZED-REPOS$/ { print repos; print ""; next }
        { print }' <(extract_stdout NIIXPACMANEOF) > "$WORK/pacman.conf"
    if ! grep -q '^\[cachyos-extra-v3\]' "$WORK/pacman.conf" \
        || ! grep -q '^Architecture = x86_64 x86_64_v3$' "$WORK/pacman.conf"; then
        die "Could not write the ISO's pacman.conf"
    fi
    install -m 644 "$WORK/pacman.conf" "$AIROOT/usr/local/lib/niix/pacman.conf"
    cp "$WORK/pacman.conf" "$PROFILE/pacman.conf"
    if [[ -f "$LOCALREPO/niix-local.db.tar.gz" ]]; then
        printf '\n[niix-local]\nSigLevel = Optional TrustAll\nServer = file://%s\n' "$LOCALREPO" \
            >> "$PROFILE/pacman.conf"
    fi

    # Packages: the installer's list, plus what only the live session needs.
    mapfile -t gnome < <(pacman -Sgq "${MANIFEST_GROUPS[@]}" | grep -vxF -f <(printf '%s\n' "${SKIP[@]}"))
    (( ${#gnome[@]} > 10 )) || die "Could not read the package groups: ${MANIFEST_GROUPS[*]}"
    while IFS= read -r pkg; do
        in_repos[$pkg]=1
    done < <(pacman -Slq)
    for pkg in "${REQUIRED[@]}" "${LIVE_ONLY_PACKAGES[@]}"; do
        if [[ -n "${in_repos[$pkg]:-}" ]]; then
            pkgs+=("$pkg")
        else
            missing+=("$pkg")
        fi
    done
    (( ${#missing[@]} == 0 )) || die "Not in the repositories (renamed or removed?): ${missing[*]}"
    for pkg in "${OPTIONAL[@]}"; do
        if [[ -n "${in_repos[$pkg]:-}" ]]; then
            pkgs+=("$pkg")
        else
            note "Optional package not in the repositories right now - left out: $pkg"
        fi
    done
    pkgs+=("${gnome[@]}" "${AUR_PKGS[@]}")
    printf '%s\n' "${pkgs[@]}" | sort -u > "$PROFILE/packages.x86_64"
    local p
    for p in "${LIVE_ONLY_PACKAGES[@]}"; do
        live_only "pkg:$p"
    done
    say "$(wc -l < "$PROFILE/packages.x86_64") packages on the ISO"
}

add_niix_tools() {
    say "Adding the NiiX tools (taken from the installer)..."
    local bin=$AIROOT/usr/local/bin sys=$AIROOT/etc/systemd/system user=$AIROOT/etc/systemd/user
    mkdir -p "$bin" "$sys/multi-user.target.wants" "$user/graphical-session.target.wants" \
             "$AIROOT/etc/udev/rules.d" "$AIROOT/etc/modules-load.d"

    extract NIIXGPUEOF   "$bin/niix-gpu"
    extract NIIXHWEOF    "$bin/niix-hardware"
    extract NIIXDISPEOF  "$bin/niix-display"
    extract NIIXPADEOF   "$bin/niix-padnav"
    extract RIPEOF       "$bin/rip"
    extract NIIXPANELFIX "$bin/niix-panel-fix"
    extract HSEOF        "$bin/niix-hotspot"
    local osk=$AIROOT/usr/share/gnome-shell/extensions/niix-osk@niixa.org
    mkdir -p "$osk"
    extract NIIXOSKMETA  "$osk/metadata.json"
    extract NIIXOSKJS    "$osk/extension.js"
    extract GPUSVCEOF    "$sys/niix-gpu.service"
    extract HWSVCEOF     "$sys/niix-hardware.service"
    extract PADUNITEOF   "$user/niix-padnav.service"
    extract DISPSVCEOF   "$user/niix-display.service"
    extract UINPUTEOF    "$AIROOT/etc/udev/rules.d/60-niix-uinput.rules"
    extract ETHRULEEOF   "$AIROOT/etc/udev/rules.d/70-niix-ethernet.rules"
    chmod 755 "$bin"/*
    chmod 644 "$osk/metadata.json" "$osk/extension.js"
    echo uinput > "$AIROOT/etc/modules-load.d/uinput.conf"

    ln -sf /etc/systemd/system/niix-gpu.service      "$sys/multi-user.target.wants/"
    ln -sf /etc/systemd/system/niix-hardware.service "$sys/multi-user.target.wants/"
    ln -sf /etc/systemd/user/niix-padnav.service     "$user/graphical-session.target.wants/"
    ln -sf /etc/systemd/user/niix-display.service    "$user/graphical-session.target.wants/"
}

add_branding() {
    say "Adding the NiiX logo, wallpaper and icon theme..."
    mkdir -p "$AIROOT/usr/share/pixmaps" "$AIROOT/usr/share/backgrounds/niix"
    retry curl -fsSL "$LOGO_URL" -o "$AIROOT/usr/share/pixmaps/niixarch-logo.png"
    retry curl -fsSL "$WALLPAPER_URL" -o "$AIROOT/usr/share/backgrounds/niix/niix-background.png"

    extract NIIX_ICONS_PY "$WORK/icons.py"
    NIIX_ICON_DEST="$AIROOT/usr/share/icons/NiiX" python3 "$WORK/icons.py" >/dev/null
    [[ -f "$AIROOT/usr/share/icons/NiiX/index.theme" ]] || die "The NiiX icon theme was not generated."
    gtk-update-icon-cache -f "$AIROOT/usr/share/icons/NiiX"
}

add_extensions() {
    local shell_ver uuid meta url dest
    # "Version : 1:49.1-1" -> 49 (the epoch before ':' is not part of it)
    shell_ver=$(pacman -Si gnome-shell | sed -n 's/^Version *: *\([0-9]*:\)\{0,1\}\([0-9]*\).*/\2/p' | head -1)
    [[ "$shell_ver" =~ ^[0-9]+$ ]] || die "Could not read the GNOME Shell version."
    say "Downloading GNOME Shell extensions for GNOME $shell_ver..."
    dest=$AIROOT/usr/share/gnome-shell/extensions
    mkdir -p "$dest"
    for uuid in "${EGO_EXTENSIONS[@]}"; do
        meta=$(curl -fsS --retry 3 "https://extensions.gnome.org/extension-info/?uuid=$uuid&shell_version=$shell_ver" || true)
        url=$(python3 -c 'import json, sys
try:
    print(json.load(sys.stdin).get("download_url") or "")
except ValueError:
    print("")' <<< "$meta")
        if [[ -z "$url" ]]; then
            note "$uuid has no build for GNOME $shell_ver yet - left out (the installer retries it)"
            continue
        fi
        mkdir -p "$dest/$uuid"
        retry curl -fsSL "https://extensions.gnome.org$url" -o "$WORK/ext.zip"
        bsdtar -xf "$WORK/ext.zip" -C "$dest/$uuid"
        if [[ -d "$dest/$uuid/schemas" ]]; then
            glib-compile-schemas "$dest/$uuid/schemas"
        fi
        echo "    $uuid"
    done
    for uuid in "${LIVE_ONLY_EXTENSIONS[@]}"; do
        live_only "/usr/share/gnome-shell/extensions/$uuid"
    done
}

# The extensions the live session runs, as a GSettings list: the packaged
# ones, and those that came from extensions.gnome.org.
enabled_extensions() {
    local list="'appindicatorsupport@rgcjonas.gmail.com', 'system-monitor@gnome-shell-extensions.gcampax.github.com', 'dash-to-panel@jderose9.github.com', 'arcmenu@arcmenu.com', 'ddterm@amezin.github.com', 'niix-osk@niixa.org'"
    local uuid
    for uuid in "${EGO_EXTENSIONS[@]}"; do
        [[ -d "$AIROOT/usr/share/gnome-shell/extensions/$uuid" ]] && list+=", '$uuid'"
    done
    printf '[%s]' "$list"
}

add_live_session() {
    say "Setting up the live desktop session..."
    local lib=$AIROOT/usr/local/lib/niix d=$AIROOT/etc/dconf/db/local.d
    mkdir -p "$lib" "$d" "$AIROOT/etc/sudoers.d" "$AIROOT/etc/xdg/autostart"

    # Desktop defaults: the installer's own file, plus what is different in
    # the live session (the installer icon, no screen lock, no suspend).
    extract NIIXDCONF "$d/00-niix-desktop"
    cat > "$d/90-niix-live" <<EOF
[org/gnome/shell]
enabled-extensions=$(enabled_extensions)
favorite-apps=['org.niixa.Installer.desktop', 'org.gnome.Nautilus.desktop', 'helium.desktop', 'steam.desktop', 'org.gnome.Terminal.desktop']

[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-battery-type='nothing'

[org/gnome/shell/extensions/ding]
show-home=false
show-trash=false
show-volumes=false
EOF

    # Runs at every boot of the live system, before the login screen: the
    # live user, auto-login, and everything that lives in files that
    # packages own (written here, not in the image, so no package conflicts).
    cat > "$lib/live-setup" <<'EOF'
#!/bin/bash
# Prepares the live session: user "niix" without a password, auto-login,
# desktop defaults, pacman.conf and the installer icon on the desktop.
set -u
if ! id niix &>/dev/null; then
    useradd -m -G wheel,audio,video,input,storage -s /bin/bash -c "NiiX Live" niix
fi
passwd -d niix >/dev/null
install -d -o niix -g niix /home/niix/.config /home/niix/Desktop
touch /home/niix/.config/gnome-initial-setup-done
install -m 755 -o niix -g niix /usr/share/applications/org.niixa.Installer.desktop /home/niix/Desktop/
install -m 644 /usr/local/lib/niix/pacman.conf /etc/pacman.conf
printf '[daemon]\nAutomaticLoginEnable=True\nAutomaticLogin=niix\n' > /etc/gdm/custom.conf
printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
dconf update
EOF
    cat > "$AIROOT/etc/systemd/system/niix-live-setup.service" <<'EOF'
[Unit]
Description=NiiX live session setup
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/niix/live-setup

[Install]
WantedBy=multi-user.target
EOF

    # In the session: let the desktop icon launch (GNOME asks otherwise) and
    # keep the panel layout in place, as on an installed system.
    cat > "$lib/live-session" <<'EOF'
#!/bin/bash
gio set "$HOME/Desktop/org.niixa.Installer.desktop" metadata::trusted true 2>/dev/null
exec /usr/local/bin/niix-panel-fix --watch
EOF
    chmod 755 "$lib/live-setup" "$lib/live-session"
    cat > "$AIROOT/etc/xdg/autostart/niix-live-session.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=NiiX live session
Exec=/usr/local/lib/niix/live-session
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF

    echo 'niix ALL=(ALL) NOPASSWD: ALL' > "$AIROOT/etc/sudoers.d/niix-live"

    # Services, enabled the way systemctl would.
    local sys=$AIROOT/etc/systemd/system
    mkdir -p "$sys/multi-user.target.wants" "$sys/bluetooth.target.wants"
    ln -sf /usr/lib/systemd/system/gdm.service "$sys/display-manager.service"
    ln -sf /usr/lib/systemd/system/NetworkManager.service "$sys/multi-user.target.wants/"
    ln -sf /usr/lib/systemd/system/power-profiles-daemon.service "$sys/multi-user.target.wants/"
    ln -sf /usr/lib/systemd/system/bluetooth.service "$sys/bluetooth.target.wants/"
    ln -sf /usr/lib/systemd/system/bluetooth.service "$sys/dbus-org.bluez.service"
    ln -sf /etc/systemd/system/niix-live-setup.service "$sys/multi-user.target.wants/"
    ln -sf /usr/lib/systemd/system/graphical.target "$sys/default.target"

    live_only /usr/local/lib/niix /etc/sudoers.d/niix-live /etc/dconf/db/local.d/90-niix-live \
        /etc/systemd/system/niix-live-setup.service \
        /etc/systemd/system/multi-user.target.wants/niix-live-setup.service \
        /etc/xdg/autostart/niix-live-session.desktop
}

# The installer the ISO's window runs: a copy of the one used for this build,
# with its checksum, so a damaged USB stick is caught before anything starts.
add_installer() {
    say "Adding the installer and its window..."
    local lib=$AIROOT/usr/local/lib/niix
    mkdir -p "$lib" "$AIROOT/usr/local/bin" "$AIROOT/usr/share/applications"
    install -m 644 "$INSTALLER" "$lib/install"
    (cd "$lib" && sha256sum install > install.sha256)
    install -m 755 "$WORK/niix-installer" "$AIROOT/usr/local/bin/niix-installer"
    cat > "$AIROOT/usr/share/applications/org.niixa.Installer.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Install NiiX
Comment=Install NiiX Arch on this computer
Icon=/usr/share/pixmaps/niixarch-logo.png
Exec=/usr/local/bin/niix-installer
Terminal=false
StartupNotify=true
Categories=System;
EOF
    live_only /usr/local/bin/niix-installer /usr/share/applications/org.niixa.Installer.desktop
}

# The list the installer works through to remove the live session.
write_live_files() {
    printf '%s\n' "# Only the live session needs these - the installer removes them." \
        "${LIVE_FILES[@]}" > "$AIROOT/usr/local/lib/niix/live-files"
}

# profiledef.sh: name, boot mode, compression, and file permissions -
# mkarchiso resets file modes when it copies airootfs, so every executable
# in it (the NiiX tools, the helper programs some extensions ship) is listed.
write_profiledef() {
    local path
    {
        cat <<EOF
#!/usr/bin/env bash
# shellcheck disable=SC2034
iso_name="$ISO_NAME"
iso_publisher="$ISO_PUBLISHER"
iso_application="$ISO_APPLICATION"
install_dir="niix"
bootmodes=('uefi.systemd-boot')
pacman_conf="pacman.conf"
airootfs_image_type="squashfs"
airootfs_image_tool_options=('-comp' 'zstd' '-Xcompression-level' '19' '-b' '1M')
EOF
        # shellcheck disable=SC2016  # expanded by mkarchiso, at build time
        printf '%s\n' \
            "iso_label=\"${ISO_LABEL_PREFIX}_\$(date --date=\"@\${SOURCE_DATE_EPOCH:-\$(date +%s)}\" +%Y%m)\"" \
            'iso_version="$(date --date="@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y.%m.%d)"' \
            'file_permissions=(' \
            '  ["/etc/sudoers.d/niix-live"]="0:0:440"'
        while IFS= read -r path; do
            printf '  ["/%s"]="0:0:755"\n' "$path"
        done < <(find "$AIROOT" -type f -perm -u+x -printf '%P\n' | sort)
        echo ')'
    } > "$PROFILE/profiledef.sh"
    grep -q '/usr/local/lib/niix/live-setup' "$PROFILE/profiledef.sh" \
        || die "Could not write the file permissions to profiledef.sh"
}

build_iso() {
    say "Building the ISO image (this is the long part)..."
    # A cached package whose file name now belongs to a different repo's
    # build (CachyOS rebuilds some Arch packages with the same version, and
    # older builds cached the Arch ones) fails its signature check. pacman
    # deletes it then; the next attempt downloads the right one and carries on
    # where the build stopped.
    retry mkarchiso -v -w "$WORK/archiso" -o /build/out "$PROFILE"

    local iso size_gib
    iso=$(find /build/out -maxdepth 1 -name "$ISO_NAME-*.iso" -printf '%T@ %p\n' \
        | sort -nr | head -1 | cut -d' ' -f2-)
    [[ -f "$iso" ]] || die "mkarchiso finished but no ISO was found in out/"
    (cd /build/out && sha256sum "$(basename "$iso")" > "$(basename "$iso").sha256")
    size_gib=$(awk -v b="$(stat -c %s "$iso")" 'BEGIN { printf "%.2f", b / 1073741824 }')
    say "ISO: out/$(basename "$iso")  ($size_gib GiB)"
    if awk -v s="$size_gib" -v w="$SIZE_WARN_GIB" 'BEGIN { exit !(s > w) }'; then
        note "The ISO is bigger than $SIZE_WARN_GIB GiB - some older USB tools can't copy files over 4 GiB (Rufus, Etcher, Ventoy and dd can)."
    fi
    note "Over 2 GiB: too big for a GitHub release - host it on niixa.org or SourceForge."
    rm -rf "$WORK"
}

run_container() {
    prepare_container
    get_installer
    get_gui
    read_manifest
    build_aur_packages
    make_profile
    add_niix_tools
    add_branding
    add_extensions
    add_live_session
    add_installer
    write_live_files
    write_profiledef
    build_iso
}

if [[ "${NIIX_IN_CONTAINER:-}" == 1 ]]; then
    run_container
else
    run_host "$@"
fi
NIIXBUILDEOF
}

niix_gui_installer() {
    cat <<'NIIXGUIEOF'
#!/usr/bin/env python3
# niix-installer - the graphical NiiX Arch installer for the live desktop.
#
# Part of the install file (the ISO builder takes it from there). Asks the
# same questions as the text installer, then runs the installer that ships on
# the ISO with the answers on its stdin and shows its progress. The installer
# reports back with @@ lines - see "GUI installer entry points" in the
# install script.
#
# Development: NIIX_INSTALLER=/path/to/install runs another copy, and
# NIIX_SKIP_VERIFY=1 skips the checksum check (never on a real install).

import hashlib
import math
import os
import queue
import re
import secrets
import string
import subprocess
import threading
import time
import zoneinfo

import cairo
import gi

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

BUNDLED_INSTALLER = "/usr/local/lib/niix/install"   # with install.sha256 next to it, from the ISO build
LOGO = "/usr/share/pixmaps/niixarch-logo.png"
BASH = "/usr/bin/bash"

PINK = (0xFF / 255, 0x0A / 255, 0x6C / 255)    # #ff0a6c - 0 %
GREEN = (0x0A / 255, 0xFF / 255, 0x9E / 255)   # #0aff9e - 100 %
TRACK = (0x2D / 255, 0x2D / 255, 0x2D / 255)

DEFAULT_KEYBOARD = "English (US)"
DEFAULT_TIMEZONE = "Europe/Zurich"
DEFAULT_HOSTNAME = "niixarch"
DEFAULT_HOTSPOT_NAME = "NiiX Arch"
MIN_EFI_BYTES = 200 * 1024 * 1024
MIN_DISK_PASSWORD = 8
LOG_VIEW_LINES = 4000

ANSI = re.compile(r"\x1b(?:\[[0-9;?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[()][A-Za-z0-9]|[=>])")
PACMAN_COUNT = re.compile(r"^\(\s*(\d+)/(\d+)\) (?:installing|upgrading|reinstalling) ")

# The installer's sections (its "@@step" titles) in the order they run, with
# a typical duration in seconds - the share of the bar each one gets - and
# what the progress page says while it runs.
FIRST_STEPS = [
    ("Pre-flight Checks", 10, "Checking the system"),
    ("Install Mode Detection", 5, "Looking for installed systems"),
]
DUALBOOT_STEPS = [
    ("EFI Partition Detection", 2, "Finding the boot partition"),
    ("Hardware Detection", 5, "Detecting your hardware"),
    ("Free Space / Partition Selection", 5, "Preparing the free space"),
    ("Installation Config", 2, "Applying your choices"),
    ("Summary & Confirmation", 1, "Getting ready"),
    ("Partition Creation", 5, "Creating the partition"),
]
SINGLEBOOT_STEPS = [
    ("Hardware Detection", 5, "Detecting your hardware"),
    ("Select Target Drive  (will be fully wiped)", 2, "Preparing the drive"),
    ("Installation Config", 2, "Applying your choices"),
    ("Summary & Confirmation", 1, "Getting ready"),
    ("Drive Wipe", 10, "Wiping the drive"),
    ("Partition Creation  (single-boot)", 5, "Creating the partitions"),
]
LAST_STEPS = [
    ("LUKS2 Encryption Setup", 10, "Encrypting the disk"),
    ("Btrfs Filesystem", 3, "Creating the file system"),
    ("EFI Partition Cleanup", 3, "Cleaning up old boot entries"),
    ("Copying the System", 120, "Copying NiiX to the disk"),
    ("Package Sources", 30, "Finding the fastest download servers"),
    ("System Update", 120, "Downloading updates newer than this ISO"),
    ("Graphics Drivers", 40, "Setting up the graphics drivers"),
    ("System Configuration", 40, "Configuring the system"),
    ("GNOME + Branding", 20, "Setting up the desktop"),
    ("Storage: NTFS and removable media", 5, "Setting up drives and USB sticks"),
    ("Game Controllers", 5, "Setting up game controllers"),
    ("Hardware Profile and Displays", 5, "Tuning for your hardware"),
    ("Desktop and Apps", 150, "Installing apps and GE-Proton"),
    ("Initramfs Rebuild", 40, "Building the boot image"),
    ("Limine Bootloader", 15, "Installing the boot menu"),
    ("Complete", 5, "Finishing"),
]
STEPS = {
    "dualboot": FIRST_STEPS + DUALBOOT_STEPS + LAST_STEPS,
    "singleboot": FIRST_STEPS + SINGLEBOOT_STEPS + LAST_STEPS,
}

CSS = """
window.niix, window.niix .content { background-color: #1f1f1f; color: #ffffff; }
window.niix label { color: #ffffff; }
window.niix .dim, window.niix .dim label { color: #b3b3b3; }
window.niix .error { color: #ff7a8a; }
window.niix .warning { color: #ffcf70; }
window.niix .app-title { font-weight: 700; }
window.niix .page-title { font-size: 20pt; font-weight: 800; }
window.niix .percent { font-size: 30pt; font-weight: 800; }
window.niix .step { font-size: 13pt; }
window.niix headerbar {
    background-color: #191919; background-image: none; color: #ffffff;
    border-bottom: 1px solid #2c2c2c; box-shadow: none;
}
window.niix headerbar windowcontrols button { color: #ffffff; }
window.niix .bar-bottom { background-color: #191919; border-top: 1px solid #2c2c2c; }
window.niix .card { background-color: #262626; border-radius: 10px; padding: 14px; }
