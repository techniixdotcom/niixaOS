favorite-apps=['org.gnome.Nautilus.desktop', 'helium.desktop', 'org.gnome.TextEditor.desktop', 'net.lutris.Lutris.desktop', 'steam.desktop', 'com.heroicgameslauncher.hgl.desktop', 'com.ktechpit.whatsie.desktop', 'signal-desktop.desktop', 'com.stremio.Stremio.desktop']
SHELLD

# System Monitor is bundled with gnome-shell-extensions (already installed) -
# no download needed, just enable it. Same belt-and-suspenders as below:
# dconf load above only applies after the reboot at the end of this script,
# this flips the live setting too.
gnome-extensions enable system-monitor@gnome-shell-extensions.gcampax.github.com 2>/dev/null || true

log "NiiX desktop configured (fully applies after the reboot below)"

mkdir -p "$HOME/.config/autostart"

# -- Hide dash-to-panel's 9-dot "Show Applications" button (every login) --
# ArcMenu is the start menu; the GNOME app-grid button must not appear too.
# dash-to-panel stores per-monitor layout under each monitor's ID
# (vendor-serial) and falls back to defaults - with Show Apps VISIBLE - for any
# monitor without an entry. This helper computes the IDs exactly like
# dash-to-panel (via Mutter's DisplayConfig), forces Show Apps + Activities
# hidden for every monitor, and writes only when something differs. It runs
# for ~45s at each login to outlast dash-to-panel's own start-up save.
sudo tee /usr/local/bin/niix-panel-fix > /dev/null <<'NIIXPANELFIX'
#!/usr/bin/env python3
# niix-panel-fix - keep the NiiX panel layout in place at every login:
#   * dash-to-panel: Show Apps/Activities hidden, system menu VISIBLE, per monitor
#   * ArcMenu: NiiX-branded menu button (Icon+Text 'NiiX', NiiX logo icon)
#   niix-panel-fix           apply once
#   niix-panel-fix --watch   apply repeatedly for ~45s (used at login)
import ast, json, os, subprocess, sys, time

BASE = "/org/gnome/shell/extensions/dash-to-panel/"
HIDE = ("showAppsButton", "activitiesButton")
NIIX_ELEMENTS = [
    {"element": "showAppsButton", "visible": False, "position": "stackedTL"},
    {"element": "activitiesButton", "visible": False, "position": "stackedTL"},
    {"element": "leftBox", "visible": True, "position": "stackedTL"},
    {"element": "taskbar", "visible": True, "position": "stackedTL"},
    {"element": "centerBox", "visible": True, "position": "stackedBR"},
    {"element": "rightBox", "visible": True, "position": "stackedBR"},
    {"element": "dateMenu", "visible": True, "position": "stackedBR"},
    {"element": "systemMenu", "visible": True, "position": "stackedBR"},
    {"element": "desktopButton", "visible": True, "position": "stackedBR"},
]
MISSING_DEFAULTS = {
    "panel-positions": "BOTTOM",
    "panel-sizes": 44,
    "panel-lengths": 100,
    "panel-anchors": "LEFT",
}
# Elements that must stay visible - enforced at every login (e.g. the system
# menu is part of the NiiX layout and must not end up hidden by a stale
# panel-element-positions entry or an extension reset).
SHOW = ("leftBox", "taskbar", "centerBox", "rightBox", "dateMenu",
        "systemMenu", "desktopButton")


def dconf_read(key):
    try:
        out = subprocess.run(["dconf", "read", BASE + key], capture_output=True,
                             text=True, timeout=10).stdout.strip()
    except Exception:
        return None
    if not out:
        return {}
    try:
        data = json.loads(ast.literal_eval(out))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def dconf_write(key, value):
    text = json.dumps(value, separators=(",", ":"))
    gvariant = "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"
    subprocess.run(["dconf", "write", BASE + key, gvariant], timeout=10,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def monitor_ids():
    # Same derivation as dash-to-panel's panelSettings.js: vendor-serial,
    # else the connector on a clash, else the logical-monitor index.
    try:
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        reply = bus.call_sync("org.gnome.Mutter.DisplayConfig",
                              "/org/gnome/Mutter/DisplayConfig",
                              "org.gnome.Mutter.DisplayConfig",
                              "GetCurrentState", None, None,
                              Gio.DBusCallFlags.NONE, 5000, None)
        logical = reply.unpack()[2]
    except Exception:
        return []
    ids, seen = [], set()
    for i, lm in enumerate(logical):
        try:
            connector, vendor, _product, serial = lm[5][0]
        except Exception:
            connector = vendor = serial = ""
        mid = "%s-%s" % (vendor, serial) if vendor and serial else str(i)
        if mid in seen:
            mid = connector if connector and connector not in seen else str(i)
        seen.add(mid)
        ids.append(mid)
    return ids


def fixed_elements(current):
    if not isinstance(current, list) or not all(isinstance(e, dict) for e in current):
        current = [dict(e) for e in NIIX_ELEMENTS]
    else:
        current = [dict(e) for e in current]
    names = [e.get("element") for e in current]
    if "showAppsButton" not in names:
        current.insert(0, {"element": "showAppsButton", "visible": False, "position": "stackedTL"})
    for e in current:
        if e.get("element") in HIDE:
            e["visible"] = False
        elif e.get("element") in SHOW:
            e["visible"] = True
    return current


ARCMENU_BASE = "/org/gnome/shell/extensions/arcmenu/"
NIIX_LOGO = "/usr/share/pixmaps/niixarch-logo.png"


def gv_str(text):
    return "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"


# Values are GVariant text, exactly as 'dconf read' prints them - so a bool
# is written as a bool and a number as a number. (Writing them as strings
# makes GNOME ignore the setting.)
def arcmenu_wanted():
    # Without the logo file (its download failed), the GNOME logo stands in
    # rather than an empty square.
    icon = NIIX_LOGO if os.path.isfile(NIIX_LOGO) else "start-here-symbolic"
    return [
        ("menu-button-appearance", "'Icon_Text'"),
        ("menu-button-text", "'NiiX'"),
        ("menu-button-icon", gv_str(icon)),
        ("menu-button-icon-size", "28"),
        ("position-in-panel", "'Left'"),
        ("menu-layout", "'redmond'"),
        # Pink accent theme (must match the dconf load block)
        ("override-menu-theme", "true"),
        ("menu-background-color", "'rgba(40, 24, 32, 0.98)'"),
        ("menu-foreground-color", "'rgba(255, 255, 255, 1)'"),
        ("menu-border-color", "'rgba(255, 107, 129, 0.40)'"),
        ("menu-border-width", "1"),
        ("menu-border-radius", "8"),
        ("menu-separator-color", "'rgba(255, 107, 129, 0.25)'"),
        ("menu-item-hover-bg-color", "'rgba(255, 107, 129, 0.30)'"),
        ("menu-item-hover-fg-color", "'rgba(255, 255, 255, 1)'"),
        ("menu-item-active-bg-color", "'rgba(255, 107, 129, 0.45)'"),
        ("menu-item-active-fg-color", "'rgba(255, 255, 255, 1)'"),
    ]


# Dash-to-panel settings it resets on first load, and the pink accent
# colours (must match the dconf load block). Enforcing them keeps the layout
# locked even if the settings GUI is used and not changed back.
DTP_WANTED = [
    ("multi-monitors", "false"),
    ("focus-highlight", "true"),
    ("focus-highlight-color", "'rgba(255, 107, 129, 0.35)'"),
    ("focus-highlight-opacity", "35"),
    ("dot-color-override", "true"),
    ("dot-color-1", "'#ff6b81'"),
    ("dot-color-2", "'#ff6b81'"),
    ("dot-color-3", "'#ff6b81'"),
    ("dot-color-4", "'#ff6b81'"),
    ("highlight-appicon-hover", "true"),
    ("highlight-appicon-hover-background-color", "'rgba(255, 107, 129, 0.15)'"),
    ("highlight-appicon-pressed-background-color", "'rgba(255, 107, 129, 0.25)'"),
]


def enforce(base, wanted):
    # Writes only what differs - cheap at login, and outlasts the extensions'
    # own first-run settings resets.
    for key, value in wanted:
        try:
            cur = subprocess.run(["dconf", "read", base + key], capture_output=True,
                                 text=True, timeout=10).stdout.strip()
        except Exception:
            continue
        if cur != value:
            subprocess.run(["dconf", "write", base + key, value], timeout=10,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply_arcmenu():
    enforce(ARCMENU_BASE, arcmenu_wanted())


def apply_dtp_settings():
    enforce(BASE, DTP_WANTED)


def apply():
    ids = monitor_ids()
    positions = dconf_read("panel-element-positions")
    if positions is None:
        return
    keys = list(positions.keys())
    for k in ids or (["0"] if not keys else []):
        if k not in keys:
            keys.append(k)
    wanted = {k: fixed_elements(positions.get(k)) for k in keys}
    if wanted != positions:
        dconf_write("panel-element-positions", wanted)
    for key, default in MISSING_DEFAULTS.items():
        cur = dconf_read(key)
        if cur is None:
            continue
        new = dict(cur)
        for k in keys:
            new.setdefault(k, default)
        if new != cur:
            dconf_write(key, new)


def main():
    if "--watch" in sys.argv[1:]:
        for _ in range(15):
            apply()
            apply_arcmenu()
            apply_dtp_settings()
            time.sleep(3)
    else:
        apply()
        apply_arcmenu()
        apply_dtp_settings()


if __name__ == "__main__":
    main()
NIIXPANELFIX
sudo chmod 755 /usr/local/bin/niix-panel-fix
cat > "$HOME/.config/autostart/niix-panel-fix.desktop" <<'PANELFIXDT'
[Desktop Entry]
Type=Application
Name=NiiX Panel: hide Show Apps button
Exec=/usr/local/bin/niix-panel-fix --watch
X-GNOME-Autostart-enabled=true
NoDisplay=true
PANELFIXDT
/usr/local/bin/niix-panel-fix 2>/dev/null || true
log "NiiX panel locked in: Show Apps hidden, system menu visible, ArcMenu NiiX button (re-checked at each login)"

# -- initramfs hook sets ------------------------------------
# encrypt  (busybox) reads cryptdevice=   - what the installer's Limine entry uses
# sd-encrypt (systemd) reads rd.luks.name= - what the CachyOS Limine entry uses
# The hook set and the Limine cmdline must ALWAYS match, or nothing can unlock root.
NIIX_ENCRYPT_HOOKS='HOOKS=(base udev autodetect microcode modconf kms keyboard keymap block encrypt btrfs filesystems fsck)'
NIIX_SD_HOOKS='HOOKS=(base systemd autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt btrfs filesystems fsck)'
niix_write_mkinitcpio() {
    printf 'MODULES=()\nBINARIES=()\nFILES=()\n%s\n' "$1" | sudo tee /etc/mkinitcpio.conf > /dev/null
}
niix_sd_hooks_active() {
    grep -Eq '^HOOKS=.*[( ]sd-encrypt[ )]' /etc/mkinitcpio.conf 2>/dev/null
}
# Captured into a variable before grepping: a pipe into grep -q can SIGPIPE
# lsinitcpio on large images and report a false failure.
niix_initrd_has_sd_crypt() {
    local listing
    [ -s "$1" ] || return 1
    listing=$(sudo lsinitcpio "$1" 2>/dev/null) || return 1
    grep -q 'systemd-cryptsetup' <<<"$listing"
}

# -- CachyOS kernel ----------------------------------------
if ! pacman -Q linux-cachyos &>/dev/null; then
    info "Setting up CachyOS repository..."
    CACHY_TMP=$(mktemp -d /tmp/niix-cachyos.XXXXXX) || CACHY_TMP=""
    if [ -n "$CACHY_TMP" ] \
        && curl -fL --retry 5 --retry-delay 3 -o "$CACHY_TMP/cachyos-repo.tar.xz" \
            https://mirror.cachyos.org/cachyos-repo.tar.xz \
        && tar xf "$CACHY_TMP/cachyos-repo.tar.xz" -C "$CACHY_TMP" \
        && [ -f "$CACHY_TMP/cachyos-repo/cachyos-repo.sh" ]; then
        # Upstream has no non-interactive flag, and piping 'yes' into it hangs
        # forever on any numbered provider prompt ("y" is never a valid number).
        # Instead, a private shim makes every pacman call it runs use
        # --noconfirm (pacman's own defaults), and stdin is closed so an
        # unexpected prompt fails fast instead of blocking the first boot.
        mkdir -p "$CACHY_TMP/shim"
        printf '#!/bin/sh\nexec /usr/bin/pacman --noconfirm "$@"\n' > "$CACHY_TMP/shim/pacman"
        chmod 755 "$CACHY_TMP/shim/pacman"
        ( cd "$CACHY_TMP/cachyos-repo" \
          && sudo env PATH="$CACHY_TMP/shim:/usr/local/sbin:/usr/local/bin:/usr/bin" \
                ./cachyos-repo.sh --install < /dev/null ) \
            || warn "cachyos-repo.sh reported an error - checking whether the repo was added anyway..."
    else
        warn "Could not download/extract the CachyOS repo installer."
    fi
    [ -n "$CACHY_TMP" ] && rm -rf "$CACHY_TMP"
    if ! grep -q '^\[cachyos' /etc/pacman.conf; then
        warn "CachyOS repository is not configured - staying on the stock kernel."
        warn "Re-run later: bash /usr/local/bin/niixarch-firstboot.sh"
    fi

    # cachyos-repo.sh runs its own full upgrade, which frequently dies on the
    # stale cdn77.cachyos.org mirror (a known CachyOS issue: 404 on glibc/gcc/lib32).
    # Re-rank to working mirrors so this run AND the user's future 'pacman -Syu' work.
    info "Ranking CachyOS mirrors (avoids the stale cdn77 default)..."
    pac_retry -Sy --noconfirm --needed cachyos-rate-mirrors || true
    if command -v cachyos-rate-mirrors >/dev/null 2>&1; then
        sudo cachyos-rate-mirrors || warn "Mirror ranking failed - continuing with current mirrors."
    fi

    # Drop the flaky cdn77 mirror and prefer archlinux.cachyos.org. rate-mirrors
    # ranks by raw speed, so cdn77 (quick to connect but 404s on individual
    # x86_64_v4 packages) can still land at the top and stall every pacman run
    # with retries. Comment it out of every CachyOS mirrorlist, float the
    # reliable primary to the front, and NEVER leave a list with zero servers.
    info "Preferring reliable CachyOS mirrors (dropping flaky cdn77)..."
    for ml in /etc/pacman.d/cachyos-mirrorlist \
              /etc/pacman.d/cachyos-v3-mirrorlist \
              /etc/pacman.d/cachyos-v4-mirrorlist \
              /etc/pacman.d/cachyos-znver4-mirrorlist; do
        [ -f "$ml" ] || continue
        tmp="/tmp/niix-cml.$$"
        if awk '
            {
              if ($0 ~ /^[[:space:]]*Server[[:space:]]*=[[:space:]]*https?:\/\/cdn77\.cachyos\.org/)     { cdn[++c]=$0; next }
              if ($0 ~ /^[[:space:]]*Server[[:space:]]*=[[:space:]]*https?:\/\/archlinux\.cachyos\.org/) { prim[++p]=$0; next }
              if ($0 ~ /^[[:space:]]*Server[[:space:]]*=/)                                               { oth[++o]=$0; next }
              head[++h]=$0
            }
            END {
              for (i=1;i<=h;i++) print head[i]
              if (p + o > 0) {
                for (i=1;i<=p;i++) print prim[i]
                for (i=1;i<=o;i++) print oth[i]
                for (i=1;i<=c;i++) print "#" cdn[i] "  # disabled by niixaOS (flaky cdn77)"
              } else {
                for (i=1;i<=c;i++) print cdn[i]
              }
            }' "$ml" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
            sudo cp "$tmp" "$ml" && log "Preferred reliable mirrors in $(basename "$ml")"
        fi
        rm -f "$tmp"
    done
    info "Completing CachyOS system upgrade..."
    pac_retry -Syu --noconfirm \
        || warn "System upgrade incomplete - run 'sudo cachyos-rate-mirrors && sudo pacman -Syu' once mirrors sync."

    info "Installing CachyOS kernel..."
    if grep -q '^\[cachyos' /etc/pacman.conf; then
        pac_retry -Sy --noconfirm --needed linux-cachyos linux-cachyos-headers \
            || warn "CachyOS kernel install failed - staying on the stock linux kernel for now."
    fi
    pacman -Q linux-cachyos &>/dev/null && log "CachyOS kernel installed"
else
    log "CachyOS kernel already installed"
fi

# -- Switch initramfs to systemd hooks (only with the CachyOS kernel present) --
# Runs on every (re-)run until it has happened, independent of the install step
# above. A failed rebuild is reverted immediately so the stock kernel - which
# Limine still boots with cryptdevice= at this point - always stays bootable.
# No GPU modules are forced here: chwd (below) installs the driver and its
# pacman hook rebuilds the initramfs for the detected topology.
if pacman -Q linux-cachyos &>/dev/null && ! niix_sd_hooks_active; then
    info "Switching to systemd initramfs hooks for CachyOS..."
    sudo cp -a /etc/mkinitcpio.conf /etc/mkinitcpio.conf.niix-encrypt.bak 2>/dev/null || true
    niix_write_mkinitcpio "$NIIX_SD_HOOKS"
    if sudo mkinitcpio -P; then
        log "initramfs rebuilt with systemd hooks"
    else
        warn "initramfs build with systemd hooks FAILED - reverting to the encrypt hooks so the current boot entry keeps working."
        niix_write_mkinitcpio "$NIIX_ENCRYPT_HOOKS"
        sudo mkinitcpio -P \
            || warn "Reverted initramfs rebuild also failed - do NOT reboot until 'sudo mkinitcpio -P' succeeds."
    fi
fi

# -- GPU drivers ------------------------------------------
# Gated on its own completion marker, not on "is the kernel installed": if chwd
# failed on a mirror blip in an earlier run, the CachyOS kernel can already be
# there while the GPU driver never arrived - a re-run must still retry it.
#
# CachyOS hardware detection (chwd) picks the tested driver profile:
#   NVIDIA Turing+ -> nvidia-open-dkms    Maxwell/Pascal -> nvidia-dkms-580xx
#   NVIDIA Kepler  -> nvidia-dkms-470xx    AMD / Intel    -> Mesa profile
# Which card then runs the desktop, apps and games is not decided here:
# niix-gpu does that at every boot, and it only hands NVIDIA the work once the
# proprietary driver is really loaded.
GPU_MARKER=/etc/niix/.chwd-configured
if [ ! -f "$GPU_MARKER" ]; then
    info "Detecting and installing GPU drivers (CachyOS chwd)..."
    pac_retry -S --noconfirm --needed chwd || true
    CHWD_OK=false
    if command -v chwd >/dev/null 2>&1; then
        # Retry once (force) on failure - first-boot mirror/CDN blips are common.
        if sudo chwd -a 0300 || { sleep 3; sudo chwd -f -a 0300; }; then
            log "chwd GPU configuration complete"
            CHWD_OK=true
        else
            warn "chwd autoconfigure reported issues (see 'sudo chwd --list')."
        fi
    else
        warn "chwd unavailable from the CachyOS repo - NVIDIA stays on nouveau for now."
    fi

    if [ "${HAS_NVIDIA:-0}" -gt 0 ]; then
        # nvidia-utils comes only with chwd's proprietary profiles, never with the
        # nouveau one - so it tells us which way this went.
        if pacman -Qq nvidia-utils >/dev/null 2>&1; then
            pac_retry -S --noconfirm --needed nvidia-prime || true
            sudo rm -f /etc/modprobe.d/no-nvidia.conf /etc/modprobe.d/niix-disable-nvidia.conf \
                       /etc/modprobe.d/nouveau-blacklist.conf 2>/dev/null || true

            # GDM only starts a Wayland session on NVIDIA when video memory is
            # preserved across suspend and NVIDIA's suspend services are on -
            # and GNOME has no X11 session left to fall back to. These settings
            # are what NVIDIA documents for Wayland; chwd usually sets them
            # already, writing them again is harmless.
            sudo tee /etc/modprobe.d/niix-nvidia.conf > /dev/null <<'NVMODEOF'
# NiiX: what GNOME on Wayland needs from the NVIDIA driver.
options nvidia_drm modeset=1 fbdev=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
NVMODEOF
            sudo systemctl enable nvidia-suspend.service nvidia-hibernate.service \
                nvidia-resume.service 2>/dev/null || true
            # chwd may have put the NVIDIA modules into the initramfs; rebuild
            # so they load with the options above. The initramfs check further
            # down verifies the result before Limine is touched.
            if [ -n "$(ls /etc/mkinitcpio.conf.d/ 2>/dev/null)" ] || grep -q '^MODULES=(.*nvidia' /etc/mkinitcpio.conf; then
                sudo mkinitcpio -P || warn "initramfs rebuild after the NVIDIA driver failed - checked again below"
            fi
            log "NVIDIA proprietary driver installed - it takes over all rendering after the reboot"
        else
            # The proprietary driver never landed: nouveau keeps the desktop
            # working, and niix-gpu keeps using the integrated GPU (or nouveau,
            # if it is the only GPU) until it does.
            warn "NVIDIA proprietary driver not installed - staying on nouveau."
            pac_retry -S --noconfirm --needed \
                mesa lib32-mesa vulkan-nouveau lib32-vulkan-nouveau \
                vulkan-icd-loader lib32-vulkan-icd-loader \
                || warn "Some nouveau/Vulkan packages failed - desktop should still work."
            sudo rm -f /etc/mkinitcpio.conf.d/10-chwd.conf 2>/dev/null || true
            warn "Run 'sudo chwd -a 0300' once online, then reboot, to switch to the NVIDIA driver."
        fi
    fi

    # Only mark this step done if chwd actually succeeded (or wasn't needed,
    # e.g. no NVIDIA card, where Mesa is already enough) - a hard chwd failure
    # must let the next first-boot run try again, not skip forever.
    if [ "$CHWD_OK" = "true" ] || [ "${HAS_NVIDIA:-0}" -eq 0 ]; then
        sudo mkdir -p /etc/niix
        sudo touch "$GPU_MARKER"
    fi
else
    log "GPU drivers already configured (chwd) - skipping"
fi

# -- LAVD scheduler ----------------------------------------
# sched-ext scheduler tuned for games (low latency under load). Newer
# packages start it through scx_loader, older ones through scx.service -
# both are configured, and exactly one of them is enabled.
if ! step_done scx-lavd; then
    info "Setting up the LAVD CPU scheduler..."
    pac_retry -S --noconfirm --needed scx-scheds || true
    pacman -Si scx-tools >/dev/null 2>&1 && { pac_retry -S --noconfirm --needed scx-tools || true; }
    printf 'default_sched = "scx_lavd"\ndefault_mode = "Auto"\n' | sudo tee /etc/scx_loader.toml > /dev/null
    printf 'SCX_SCHEDULER=scx_lavd\nSCX_FLAGS=\n' | sudo tee /etc/default/scx > /dev/null
    if systemctl cat scx_loader.service >/dev/null 2>&1; then
        sudo systemctl disable --now scx.service 2>/dev/null || true
        sudo systemctl enable --now scx_loader.service && mark_step scx-lavd
    elif systemctl cat scx.service >/dev/null 2>&1; then
        sudo systemctl enable --now scx.service && mark_step scx-lavd
    fi
    if step_done scx-lavd; then
        log "LAVD scheduler enabled (active from the next boot on the CachyOS kernel)"
    else
        warn "LAVD scheduler could not be enabled - the default kernel scheduler is used"
    fi
fi

# -- @clean: bootable fallback snapshot --------------------
# Created BEFORE the Limine update so the "clean state" menu entry is only
# ever written when the @clean subvolume really exists. The same helper
# refreshes it later (sudo niixarch-refresh-clean).
sudo tee /usr/local/bin/niixarch-refresh-clean > /dev/null <<'REFRESHEOF'
#!/bin/bash
# Replace the @clean snapshot with the current system state.
set -euo pipefail
dev=$(findmnt -n --nofsroot -o SOURCE / | head -1)
top=$(mktemp -d)
trap 'umount "$top" 2>/dev/null; rmdir "$top"' EXIT
mount -o subvol=/ "$dev" "$top"
if btrfs subvolume show "$top/@clean" &>/dev/null; then
    btrfs subvolume delete "$top/@clean" >/dev/null
fi
btrfs subvolume snapshot "$top/@" "$top/@clean" >/dev/null
echo "Done - 'NiiX Arch (clean state)' in Limine now boots this system state."
REFRESHEOF
sudo chmod 755 /usr/local/bin/niixarch-refresh-clean

info "Creating @clean Btrfs fallback snapshot..."
CLEAN_OK=false
if sudo /usr/local/bin/niixarch-refresh-clean; then
    CLEAN_OK=true
    log "@clean snapshot created - bootable from Limine as 'NiiX Arch (clean state)'"
else
    warn "@clean snapshot failed - run later: sudo niixarch-refresh-clean"
fi

# -- Verify the CachyOS initramfs BEFORE Limine is pointed at it --
# Limine is only switched to the CachyOS kernel (rd.luks.name=) once its
# initramfs provably contains systemd-cryptsetup. Otherwise nothing is rewritten
# and, if the hooks were already switched, they are reverted so the existing
# cryptdevice= entry keeps booting.
LIMINE_CONF=""
for f in /boot/EFI/limine/limine.conf /boot/limine/limine.cfg /boot/limine.cfg /boot/EFI/limine/limine.cfg; do
    [ -f "$f" ] && LIMINE_CONF="$f" && break
done
CURRENT_CMDLINE=""
[ -n "$LIMINE_CONF" ] && CURRENT_CMDLINE=$(grep -m1 "cmdline:" "$LIMINE_CONF" | sed 's/.*cmdline: //')

INITRAMFS_OK=false
if pacman -Q linux-cachyos &>/dev/null \
    && [ -f /boot/vmlinuz-linux-cachyos ] \
    && niix_sd_hooks_active \
    && niix_initrd_has_sd_crypt /boot/initramfs-linux-cachyos.img; then
    INITRAMFS_OK=true
    log "CachyOS initramfs verified (systemd-cryptsetup present)"
elif pacman -Q linux-cachyos &>/dev/null; then
    warn "Could not verify LUKS support in the CachyOS initramfs - Limine will NOT be switched to it."
fi

if [ "$INITRAMFS_OK" != "true" ] && niix_sd_hooks_active; then
    if printf '%s' "$CURRENT_CMDLINE" | grep -q 'cryptdevice='; then
        warn "Reverting to encrypt hooks so the current Limine entry (cryptdevice=) stays bootable..."
        niix_write_mkinitcpio "$NIIX_ENCRYPT_HOOKS"
        sudo mkinitcpio -P \
            || warn "Revert rebuild failed - do NOT reboot until 'sudo mkinitcpio -P' succeeds."
    else
        warn "Limine already uses rd.luks.name= but the initramfs could not be verified - run 'sudo mkinitcpio -P' and check it before rebooting."
    fi
fi

# -- Update Limine for CachyOS + @clean -------------------
LIMINE_UPDATED=false
if [ "$INITRAMFS_OK" = "true" ] && [ -n "$LIMINE_CONF" ] && [ -n "$CURRENT_CMDLINE" ]; then
    info "Updating Limine config..."
    NEW_CMDLINE=$(printf '%s\n' "$CURRENT_CMDLINE" | sed 's|cryptdevice=UUID=\([^:]*\):\([^ ]*\)|rd.luks.name=\1=\2|')
    # NOTE: 'subvol=@\b' can never match '@' followed by a space (\b needs a
    # word char after '@'). Match '@' followed by a space or EOL.
    CLEAN_CMDLINE=$(printf '%s\n' "$NEW_CMDLINE" | sed -E 's/rootflags=subvol=@( |$)/rootflags=subvol=@clean\1/')

    if [ "$IS_DUALBOOT" = "true" ]; then
        WIN_ENTRY="/Windows Boot Manager
    protocol: efi
    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi

"
    else
        WIN_ENTRY=""
    fi

    # Only offer the clean-state entry if the snapshot actually exists -
    # otherwise selecting it would fail to mount root and drop to emergency.
    CLEAN_ENTRY=""
    if [ "$CLEAN_OK" = "true" ]; then
        CLEAN_ENTRY="

/NiiX Arch (clean state)
    protocol: linux
    path: boot():/vmlinuz-linux-cachyos
    cmdline: $CLEAN_CMDLINE
    module_path: boot():/initramfs-linux-cachyos.img"
    fi

    # default_entry is 1-based: with the Windows entry present, NiiX Arch is
    # entry 2; in single-boot it is entry 1. Fallback entries come after it.
    DEFAULT_ENTRY=1
    [ -n "$WIN_ENTRY" ] && DEFAULT_ENTRY=2
    # 2s is enough to press a key and pick another entry; with Windows in
    # the menu there's more time to choose.
    LIMINE_TIMEOUT=2
    [ -n "$WIN_ENTRY" ] && LIMINE_TIMEOUT=5

    # $1 = true -> keep a stock-kernel fallback entry (used until the stock
    # kernel is removed, so there is never a moment with only one bootable
    # kernel in the menu).
    niix_write_limine() {
        local stock_entry="" tmp dst copied=0
        if [ "$1" = "true" ]; then
            stock_entry="

/NiiX Arch (stock kernel fallback)
    protocol: linux
    path: boot():/vmlinuz-linux
    cmdline: $NEW_CMDLINE
    module_path: boot():/initramfs-linux.img"
        fi
        tmp=$(mktemp) || return 1
        cat > "$tmp" <<LIMEOF
timeout: $LIMINE_TIMEOUT
interface_branding: NiiX Arch
interface_branding_colour: 6
interface_help_hidden: yes
default_entry: $DEFAULT_ENTRY

${WIN_ENTRY}/NiiX Arch
    protocol: linux
    path: boot():/vmlinuz-linux-cachyos
    cmdline: $NEW_CMDLINE
    module_path: boot():/initramfs-linux-cachyos.img${stock_entry}${CLEAN_ENTRY}
LIMEOF
        for dst in /boot/EFI/limine/limine.cfg /boot/EFI/limine/limine.conf \
                   /boot/EFI/BOOT/limine.cfg   /boot/EFI/BOOT/limine.conf \
                   /boot/limine/limine.cfg     /boot/limine/limine.conf \
                   /boot/limine.cfg; do
            sudo cp "$tmp" "$dst" 2>/dev/null && copied=$(( copied + 1 ))
        done
        rm -f "$tmp"
        [ "$copied" -gt 0 ]
    }

    # The stock initramfs was rebuilt with the same sd-encrypt hooks, so it
    # takes rd.luks.name= too - offer it only once that is verified.
    STOCK_FALLBACK=false
    if [ -f /boot/vmlinuz-linux ] && niix_initrd_has_sd_crypt /boot/initramfs-linux.img; then
        STOCK_FALLBACK=true
    fi

    if niix_write_limine "$STOCK_FALLBACK"; then
        LIMINE_UPDATED=true
        log "Limine updated - CachyOS kernel$([ "$STOCK_FALLBACK" = "true" ] && echo ' + stock fallback')$([ "$CLEAN_OK" = "true" ] && echo ' + @clean fallback')"
    else
        warn "Could not write any Limine config - Limine left unchanged"
    fi
elif [ "$INITRAMFS_OK" = "true" ]; then
    warn "Could not find/read the Limine config - update Limine manually"
fi

# -- Remove stock linux kernel -----------------------------
# Only once the CachyOS kernel is installed, its initramfs is verified to
# unlock LUKS, AND Limine already boots it. The fallback entry is dropped from
# Limine only after the removal has actually succeeded.
if [ "$INITRAMFS_OK" = "true" ] && [ "$LIMINE_UPDATED" = "true" ] && pacman -Q linux &>/dev/null; then
    info "Removing stock linux kernel..."
    RM_PKGS=(linux)
    pacman -Q linux-headers &>/dev/null && RM_PKGS+=(linux-headers)
    if sudo pacman -Rns --noconfirm "${RM_PKGS[@]}"; then
        log "Stock kernel removed - CachyOS only"
        if niix_write_limine false; then
            log "Limine: stock-kernel fallback entry removed"
        else
            warn "Could not drop the stock fallback entry from Limine (it now points at a removed kernel)"
        fi
    else
        warn "Could not remove stock kernel - it stays as the Limine fallback. Remove later: sudo pacman -Rns ${RM_PKGS[*]}"
    fi
elif pacman -Q linux &>/dev/null; then
    warn "Keeping the stock linux kernel (CachyOS kernel, Limine update, or initramfs LUKS support not confirmed)."
fi

# -- yay ---------------------------------------------------
# Prefer the CachyOS repo's yay: prebuilt and signed, so no Go toolchain
# download and no compile. Fall back to building it from the AUR, with
# retries, and only report success when the binary really exists.
if ! command -v yay &>/dev/null; then
    info "Installing yay (AUR helper)..."
    if grep -q '^\[cachyos\]' /etc/pacman.conf \
        && pac_retry -S --noconfirm --needed yay \
        && command -v yay &>/dev/null; then
        log "yay installed (prebuilt, signed - CachyOS repo)"
    else
        info "Prebuilt yay unavailable - building it from the AUR..."
        YAY_TMP=$(mktemp -d /tmp/niix-yay-XXXXXX)
        for attempt in 1 2 3; do
            rm -rf "$YAY_TMP/yay"
            if git clone --depth 1 https://aur.archlinux.org/yay.git "$YAY_TMP/yay" \
                && ( cd "$YAY_TMP/yay" && makepkg -si --noconfirm ) \
                && command -v yay &>/dev/null; then
                break
            fi
            warn "yay build attempt $attempt/3 failed, retrying..."
            sleep 5
        done
        rm -rf "$YAY_TMP"
        if command -v yay &>/dev/null; then
            log "yay installed (built from the AUR)"
        else
            warn "yay could not be installed - AUR packages will be skipped (retry: re-run this script)"
        fi
    fi
fi

aur_install() {
    command -v yay &>/dev/null || { warn "$1 skipped - yay is not installed"; return 1; }
    retry3 "$1" yay -S --noconfirm --needed "$1"
}

# -- Flatpak apps: started FIRST, in the background ---------------------------
# Flatpak downloads are network-bound and AUR builds are CPU-bound, so running
# them at the same time cuts several minutes off first boot. Flatpak never
# touches the pacman database or lock, so there is nothing to race. Output goes
# to a file and is printed in full once it finishes, so the log stays readable
# instead of interleaved.
# sudo: a system-wide flatpak install from a user session pops an interactive
# polkit password dialog, which stalls the unattended first-boot flow.
info "Starting Flatpak downloads in the background (they run while the AUR packages build)..."
sudo flatpak remote-add --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo || warn "Could not add Flathub remote"

FLATPAK_APPS=(com.stremio.Stremio com.ktechpit.whatsie com.heroicgameslauncher.hgl net.davidotek.pupgui2)

# Retry each app a few times: a transient DNS hiccup ("Could not resolve
# hostname") or a CDN timeout mid-pull must not silently kill the install.
# Partial pulls resume, so retries are cheap.
flatpak_install() {
    retry3 "$1" sudo flatpak install -y --noninteractive flathub "$1"
}

# NetworkManager can report 'full' connectivity while a fresh lookup for
# dl.flathub.org still fails - starting the downloads against a half-ready
# resolver is what caused the long stalls. Wait for the CDN for real.
wait_for_flathub() {
    local attempt=1
    until curl -fsI --max-time 10 https://dl.flathub.org/repo/config &>/dev/null; do
        if [ "$attempt" -ge 12 ]; then
            warn "flathub not reachable after ~1 minute - trying anyway"
            return 1
        fi
        echo -ne "\r  -  Waiting for flathub (DNS/CDN)... ($attempt/12)"
        sleep 5
        attempt=$(( attempt + 1 ))
    done
    echo ""
    return 0
}

FLATPAK_LOG=$(mktemp /tmp/niix-flatpak-XXXXXX.log 2>/dev/null) || FLATPAK_LOG=""
FLATPAK_PID=""
flatpak_batch() {
    wait_for_flathub || true
    # ONE transaction for all apps: a single metadata fetch and all shared
    # runtimes resolved once, instead of re-checking per app. Flatpak keeps
    # going if a single ref fails; whatever is missing afterwards is retried
    # per app (partial pulls resume).
    retry3 "Flatpak batch" sudo flatpak install -y --noninteractive flathub "${FLATPAK_APPS[@]}" && return 0
    warn "Batch incomplete - retrying per app..."
    local app
    for app in "${FLATPAK_APPS[@]}"; do
        sudo flatpak info "$app" &>/dev/null && continue
        run_once "flatpak-$(echo "$app" | cut -d. -f2- | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')" \
            flatpak_install "$app" \
            || warn "$app failed - retry later: flatpak install flathub $app"
    done
}
# Background only while passwordless sudo is active: a background job has no
# terminal, so on a resumed run (rule already removed) sudo could not ask for
# the password and every install would fail. Then it runs in the foreground.
if [ -n "$FLATPAK_LOG" ] && sudo -n true 2>/dev/null; then
    flatpak_batch > "$FLATPAK_LOG" 2>&1 &
    FLATPAK_PID=$!
else
    [ -n "$FLATPAK_LOG" ] && rm -f "$FLATPAK_LOG"
    flatpak_batch
fi

# -- AUR packages (only what isn't in the repos or on Flathub) ----------------
# Heroic and ProtonUp-Qt are installed from Flatpak above instead of AUR -bin
# packages: signed, CDN-backed, and no third-party binary build step to break.
info "Installing AUR packages..."
run_once aur-dxvk          aur_install dxvk-mingw          || true
run_once aur-ananicy-rules aur_install ananicy-rules-git   || true
run_once aur-helium        aur_install helium-browser-bin  || true
# ddterm: Wayland-native drop-down terminal (GNOME Shell extension), replaces Yakuake.
if run_once aur-ddterm aur_install gnome-shell-extension-ddterm; then
    gnome-extensions enable ddterm@amezin.github.com 2>/dev/null || true
    # Bind the drop-down toggle to BOTH F12 and Ctrl+Alt+T.
    dconf write /com/github/amezin/ddterm/ddterm-toggle-hotkey "['F12', '<Control><Alt>t']" 2>/dev/null || true
    dconf write /com/github/amezin/ddterm/window-above true 2>/dev/null || true
    dconf write /com/github/amezin/ddterm/hide-when-focus-lost false 2>/dev/null || true
    dconf write /com/github/amezin/ddterm/use-system-font false 2>/dev/null || true
    dconf write /com/github/amezin/ddterm/custom-font "'Hack Nerd Font Bold 12'" 2>/dev/null || true
    log "ddterm drop-down terminal installed (F12 / Ctrl+Alt+T, Hack Nerd Font Bold)"
else
    warn "ddterm failed to install from the AUR - drop-down terminal unavailable."
fi
log "AUR packages done"

# -- Game controller drivers --------------------------------
# The kernel already drives wired Xbox, PlayStation and Switch Pro controllers
# (xpad, hid-playstation, hid-nintendo) and PlayStation/Switch over Bluetooth.
#   game-devices-udev  access rules for many more pads (8BitDo, Nacon, PowerA,
#                      Hori, Logitech, Google Stadia, ...)
#   xpadneo            Xbox One / Series controllers over Bluetooth: correct
#                      button layout, rumble and battery level
#   xone               ONLY when an Xbox Wireless Adapter (the USB dongle) is
#                      plugged in: it replaces the kernel's xpad driver, which
#                      would cost Xbox 360 pads their support for nothing
info "Installing game controller drivers..."
run_once aur-game-devices-udev aur_install game-devices-udev \
    || warn "game-devices-udev not installed - common controllers still work"
run_once aur-xpadneo aur_install xpadneo-dkms \
    || warn "xpadneo not installed - Xbox controllers over Bluetooth still work, with fewer features"

XBOX_DONGLE=false
for usbdev in /sys/bus/usb/devices/*; do
    [ "$(cat "$usbdev/idVendor" 2>/dev/null)" = "045e" ] || continue
    case "$(cat "$usbdev/idProduct" 2>/dev/null)" in
        02e6|02f9|02fe|091e) XBOX_DONGLE=true; break ;;
    esac
done
if [ "$XBOX_DONGLE" = true ] && ! step_done xone; then
    info "Xbox Wireless Adapter found - installing the xone driver..."
    # The AUR has carried xone under a few names; take the first that builds.
    for xone_pkg in xone-dkms xone-dkms-git xone-dlundqvist-dkms-git; do
        if aur_install "$xone_pkg"; then
            mark_step xone
            log "xone installed ($xone_pkg) - pair a controller: press the button on the adapter, then on the controller"
            break
        fi
    done
    step_done xone || warn "xone could not be installed - the Xbox Wireless Adapter won't work until it is (yay -S xone-dkms)"
fi
sudo udevadm control --reload 2>/dev/null || true
sudo udevadm trigger --subsystem-match=input --subsystem-match=hidraw --subsystem-match=usb 2>/dev/null || true

# -- Handheld PCs ------------------------------------------
# ROG Ally, Legion Go, MSI Claw and other handhelds: Handheld Daemon makes the
# built-in controls work as a normal controller, with the extra buttons, gyro
# and TDP (power) controls. The Steam Deck needs none of this - Steam drives
# its controls, and the kernel already turns its screen the right way.
if [ "${FORM:-}" = handheld ] && [ "${HANDHELD:-}" != steamdeck ] && ! step_done hhd; then
    info "Handheld found (${HANDHELD:-unknown model}) - installing Handheld Daemon..."
    if { pacman -Si hhd >/dev/null 2>&1 && pac_retry -S --noconfirm --needed hhd; } || aur_install hhd; then
        sudo systemctl enable --now "hhd@$USER.service" && mark_step hhd \
            && log "Handheld Daemon running - the built-in controls work as a controller"
    fi
    step_done hhd || warn "Handheld Daemon could not be installed - the built-in controls may not all work (yay -S hhd)"
fi

# -- Collect the background Flatpak downloads ---------------------------------
if [ -n "$FLATPAK_PID" ]; then
    info "Waiting for the Flatpak downloads to finish..."
    wait "$FLATPAK_PID" 2>/dev/null || true
    [ -s "$FLATPAK_LOG" ] && cat "$FLATPAK_LOG"
    rm -f "$FLATPAK_LOG"
fi
log "Flatpak apps installed"

# -- Retry packages deferred from the base install --------
# The ISO installer defers optional apps (Steam/Lutris/fastfetch) here instead of
# aborting when a transient DNS/mirror blip hits one of them. Now that first-boot
# has a solid network, retry from the repo; fall back to Flatpak for Lutris if
# the repo is still unreachable. Each success clears its deferral (resumable).
DEFER=/var/lib/niixarch/deferred
if [ -s "$DEFER" ]; then
    info "Retrying packages deferred from the base install..."
    still_missing=()
    while IFS= read -r pkg; do
        [ -n "$pkg" ] || continue
        if pacman -Q "$pkg" &>/dev/null; then
            continue
        elif pac_retry -S --noconfirm --needed "$pkg"; then
            log "Deferred package installed from repo: $pkg"
        elif [ "$pkg" = "lutris" ] && flatpak_install net.lutris.Lutris; then
            log "Lutris installed from Flatpak (repo was unavailable)"
        else
            warn "Deferred package still unavailable: $pkg - retry later"
            still_missing+=("$pkg")
        fi
    done < "$DEFER"
    # Rewritten once the list has been read - never while reading it.
    if (( ${#still_missing[@]} )); then
        printf '%s\n' "${still_missing[@]}" | sudo tee "$DEFER" > /dev/null
    else
        sudo rm -f "$DEFER"
    fi
fi

# -- Proton-CachyOS (recommended default) -----------------
# From the CachyOS repos enabled above: Proton 11 base with NTSync enabled by
# default (the ntsync kernel module is already loaded by the installer), plus
# per-game upscaler DLL upgrades (PROTON_FSR4_UPGRADE / PROTON_DLSS_UPGRADE /
# PROTON_XESS_UPGRADE) and winewayland improvements. umu-launcher lets Lutris
# and Heroic use the same Proton builds. Fails gracefully if the CachyOS repos
# never came up - GE-Proton below remains the fallback.
info "Installing Proton-CachyOS + umu-launcher..."
if run_once proton-cachyos pac_retry -S --noconfirm --needed proton-cachyos umu-launcher; then
    log "Proton-CachyOS installed - recommended default in Steam -> Settings -> Compatibility"
else
    warn "Proton-CachyOS not available (CachyOS repos missing?) - use GE-Proton instead"
fi

# -- GE-Proton (latest, sha512-verified) -------------------
# Resolve the real release-asset URLs from the GitHub API instead of guessing
# them: hand-built URLs break whenever the asset naming changes, which is what
# skipped GE-Proton before. Anonymous api.github.com is capped at 60 req/h per
# IP; export GITHUB_TOKEN (or GH_TOKEN) before running to raise it to 5000/h.
# Verification is mandatory - an unverified archive is never extracted.
info "Installing latest GE-Proton..."
install_ge_proton() {
    local api="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
    local compat_dir="$HOME/.local/share/Steam/compatibilitytools.d"
    local token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
    local -a hdr=(-H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28")
    [ -n "$token" ] && hdr+=(-H "Authorization: Bearer $token")

    local json
    json=$(curl -fsSL --retry 5 --retry-delay 3 --retry-connrefused \
        --connect-timeout 15 --max-time 120 -A "niixarch-installer" \
        "${hdr[@]}" "$api" 2>/dev/null) || {
        warn "GE-Proton: GitHub API unreachable or rate-limited - skipped (install later with ProtonUp-Qt)"
        return 1
    }

    local tag
    tag=$(printf '%s\n' "$json" | grep -m1 '"tag_name"' | cut -d'"' -f4)
    [ -n "$tag" ] || { warn "GE-Proton: could not read latest release tag - skipped (use ProtonUp-Qt later)"; return 1; }

    mkdir -p "$compat_dir"
    [ -d "$compat_dir/$tag" ] && { log "GE-Proton $tag already installed - skipping"; return 0; }

    # Read the actual download URLs straight from the API response, picking the
    # asset for THIS machine's architecture. Recent GE-Proton releases ship both
    # -x86_64.tar.gz and -aarch64.tar.gz, so a blind "first .tar.gz" grabs the
    # ARM build on an x86_64 box (which is what happened). Match upstream's own
    # download script: pick by uname -m, and match the checksum to that tarball.
    local tar_url sum_url arch pat urls tar_base rel_name
    arch=$(uname -m)
    case "$arch" in
        x86_64)        pat='x86_64\.tar\.gz$' ;;
        aarch64|arm64) pat='aarch64\.tar\.gz$' ;;
        *) warn "GE-Proton: unsupported architecture '$arch' - skipped"; return 1 ;;
    esac
    urls=$(printf '%s\n' "$json" | grep -oE '"browser_download_url": *"[^"]*"' | cut -d'"' -f4)
    tar_url=$(printf '%s\n' "$urls" | grep -E "$pat" | head -n1)
    # Fallback for older releases that shipped x86_64 with no arch suffix.
    if [ -z "$tar_url" ] && [ "$arch" = "x86_64" ]; then
        tar_url=$(printf '%s\n' "$urls" | grep -E '\.tar\.gz$' | grep -viE 'aarch64|arm64' | head -n1)
    fi
    tar_base=$(basename "$tar_url")
    rel_name=${tar_base%.tar.gz}
    # Checksum that matches the chosen tarball; fall back to a non-ARM .sha512sum.
    sum_url=$(printf '%s\n' "$urls" | grep -E "/${rel_name}\.sha512sum$" | head -n1)
    [ -z "$sum_url" ] && sum_url=$(printf '%s\n' "$urls" | grep -E '\.sha512sum$' | grep -viE 'aarch64|arm64' | head -n1)
    if [ -z "$tar_url" ] || [ -z "$sum_url" ]; then
        warn "GE-Proton: no ${arch} release asset found in API response - skipped (use ProtonUp-Qt later)"
        return 1
    fi

    local dir
    dir=$(mktemp -d /tmp/ge-proton.XXXXXX) || { warn "GE-Proton: could not create temp dir - skipped"; return 1; }
    local tar_file="$dir/$tar_base" sum_file
    sum_file="$dir/$(basename "$sum_url")"

    # Verify sha512 BEFORE extracting - never unpack an unverified archive into
    # the Steam runtime. Note: the checksum comes from the same GitHub release,
    # so it proves the download is intact, not who published it; GE-Proton
    # publishes no signatures to check against. The .sha512sum names the bare
    # tarball file, so the check runs from inside the download directory.
    local rc
    if curl -fL --retry 5 --retry-delay 3 --retry-connrefused --connect-timeout 15 --max-time 1800 -o "$tar_file" "$tar_url" \
    && curl -fL --retry 5 --retry-delay 3 --retry-connrefused --connect-timeout 15 --max-time 120  -o "$sum_file" "$sum_url" \
    && ( cd "$dir" && sha512sum -c "${sum_file##*/}" ) \
    && tar -xzf "$tar_file" -C "$compat_dir"; then
        log "GE-Proton $tag installed (sha512 verified)"
        rc=0
    else
        warn "GE-Proton download or checksum verification failed - skipped (use ProtonUp-Qt later)"
        rc=1
    fi
    rm -rf "$dir"
    return $rc
}
run_once ge-proton install_ge_proton || true

# -- NiiX icons for AUR/flatpak apps just installed -------
info "Generating NiiX icons for newly installed apps..."
sudo /usr/local/bin/niix-iconify --quiet 2>/dev/null || true
log "App icons reconciled"

# -- Hide everything except the requested visible app set ------
# Visible set kept in the menu: Calculator, VLC, Disks, Clocks, Calendar,
# Text Editor, Software, Settings, Image Viewer, Extensions, Document Viewer
# (Papers), Tweaks.
#
# Try the real desktop ID first (reliable, doesn't depend on wording), then
# fall back to a case-insensitive SUBSTRING match on Name (not an exact
# anchored match - upstream Name fields often differ from what shows in the
# menu, e.g. Totem's Name is "Videos" not "Video Player", gnome-music's is
# "Music" not "Audio Player", baobab's is "Disk Usage Analyzer" with a z).
# Runs un-privileged as the real user so it writes to the real $HOME - do not
# wrap this whole script in sudo, or the override lands in /root instead.
info "Hiding non-essential apps from the menu..."
niix_hide_by_id_or_name() {
    local id="$1" name="$2" found=""
    for dir in /usr/share/applications /var/lib/flatpak/exports/share/applications; do
        [ -f "${dir}/${id}.desktop" ] && { found="$id"; break; }
    done
    if [ -z "$found" ]; then
        found=$(grep -ils "^Name=.*${name}" /usr/share/applications/*.desktop \
             /var/lib/flatpak/exports/share/applications/*.desktop 2>/dev/null \
             | head -1 | xargs -r basename -s .desktop)
    fi
    if [ -n "$found" ]; then
        /usr/local/bin/niix-hide-app "$found" >/dev/null 2>&1 && echo "  hidden: $name -> $found" || echo "  FAILED to hide: $name (matched $found, niix-hide-app errored)"
    else
        echo "  NOT FOUND: $name (tried id '$id' and name match - not installed, or its .desktop ID/Name differs from what's hardcoded here)"
    fi
}

# id_guess::name_substring (id tried first, name is a case-insensitive fallback)
HIDE_COUNT=0
HIDE_TOTAL=0
for pair in \
    "org.gnome.Music::Music" \
    "bssh::Avahi SSH Server Browser" \
    "bvnc::Avahi VNC Server Browser" \
    "avahi-discover::Avahi Zeroconf Browser" \
    "org.gnome.Snapshot::Camera" \
    "org.corectrl.CoreCtrl::CoreCtrl" \
    "com.github.amezin.ddterm::ddterm" \
    "org.gnome.baobab::Disk Usage Analy" \
    "lstopo::Hardware Locality" \
    "org.gnome.Logs::Logs" \
    "org.freedesktop.MalcontentControl::Parental Controls" \
    "net.davidotek.pupgui2::ProtonUp" \
    "assistant::Qt Assistant" \
    "qdbusviewer::Qt D-Bus Viewer" \
    "linguist::Qt Linguist" \
    "qv4l2::Qt V4L2 test" \
    "qvidcap::Qt V4L2 video capture" \
    "designer::Qt Widgets Designer" \
    "org.gnome.SystemMonitor::System Monitor" \
    "org.gnome.Terminal::Terminal" \
    "org.gnome.Console::Console" \
    "org.gnome.Totem::Video" \
    "org.gnome.Weather::Weather" \
    "winetricks::Winetricks" \
    "org.gnome.Tour::Tour"
do
    HIDE_TOTAL=$((HIDE_TOTAL + 1))
    out=$(niix_hide_by_id_or_name "${pair%%::*}" "${pair##*::}")
    echo "$out"
    [[ "$out" == "  hidden:"* ]] && HIDE_COUNT=$((HIDE_COUNT + 1))
done
log "Menu cleanup: ${HIDE_COUNT}/${HIDE_TOTAL} apps hidden - see lines above for any NOT FOUND/FAILED"

# -- System-wide defaults ---------------------------------
# Pinned apps, extensions and theme are already in this user's settings
# (above). These are the defaults nothing else sets: removable media and the
# terminal profile.
info "Writing system-wide desktop defaults..."
sudo mkdir -p /etc/dconf/db/local.d /etc/dconf/profile
if ! grep -q "system-db:local" /etc/dconf/profile/user 2>/dev/null; then
    printf 'user-db:user\nsystem-db:local\n' | sudo tee /etc/dconf/profile/user > /dev/null
fi
sudo tee /etc/dconf/db/local.d/00-niixarch-dash > /dev/null << 'DCONFEOF'
[org/gnome/desktop/media-handling]
automount=true
automount-open=false
autorun-never=false

[org/gnome/terminal/legacy/profiles:]
default='b1dcc9dd-5262-4d8d-a863-c897e6d979b9'
list=['b1dcc9dd-5262-4d8d-a863-c897e6d979b9']

[org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9]
visible-name='NiiX'
use-system-font=false
font='Hack Nerd Font Bold 12'
audible-bell=false
scrollback-unlimited=true
DCONFEOF
if sudo dconf update 2>/dev/null; then
    log "System defaults written (removable media, terminal profile)"
else
    warn "dconf update failed - removable-media and terminal defaults may not apply"
fi

# -- Cleanup -----------------------------------------------
# Order matters: every privileged step runs while passwordless sudo still
# exists, and removing that rule is the LAST sudo call. Anything after it
# would stop at a password prompt - the countdown reboot included.
sudo rm -f /etc/xdg/autostart/niixarch-firstboot.desktop
sudo touch /var/lib/niixarch-firstboot-done
sudo systemctl disable --now niixarch-sudo-expiry.timer >/dev/null 2>&1 || true
sudo rm -f /etc/sudoers.d/niixarch-firstboot   # remove temporary passwordless sudo

echo ""
echo -e "  ${GREEN}+${NC}  ${WHITE}${BOLD}First-boot setup complete!${NC}"
echo -e "  ${PINK}------------------------------------------------${NC}"
echo -e "  ${CYAN}-${NC}  Graphics: the most powerful GPU runs everything - check with ${GREEN}niix-gpu status${NC}"
echo -e "  ${CYAN}-${NC}  Steam launch options, optional extras: ${GREEN}gamemoderun mangohud %command%${NC}"
echo -e "  ${CYAN}-${NC}  Controllers: left stick = pointer, A = click, Start = menu; Guide/PS button turns it off"
echo -e "  ${CYAN}-${NC}  Steam one-time: Settings -> Compatibility -> Steam Play for all titles -> ${GREEN}Proton-CachyOS${NC}"
echo -e "  ${CYAN}-${NC}  Monitors: highest refresh rate + FreeSync/G-Sync set up automatically (${GREEN}niix-display status${NC})"
echo -e "  ${CYAN}-${NC}  Update everything: ${GREEN}niix-update${NC}  (checks Arch news first; ${GREEN}--firmware${NC} for firmware)"
echo -e "  ${CYAN}-${NC}  NTFS drives: auto-mounted under ${GREEN}/media${NC}  (${GREEN}niix-ntfs list${NC})"
echo -e "  ${CYAN}-${NC}  Wi-Fi hotspot: ${GREEN}niix-hotspot start${NC}  (stays on across reboots; off: ${GREEN}niix-hotspot auto off${NC})"
echo -e "  ${CYAN}-${NC}  Refresh clean snapshot: ${GREEN}sudo niixarch-refresh-clean${NC}"
echo -e "  ${CYAN}-${NC}  Log saved to: $LOG"
echo ""
warn "Rebooting in 10 seconds to load the CachyOS kernel..."
info "Press Ctrl+C to cancel."
for (( i = 10; i > 0; i-- )); do
    echo -ne "\r  -  Rebooting in ${i}s... "
    sleep 1
done
echo ""
# No sudo needed (and none left): logind lets the active local session reboot.
systemctl reboot || sudo reboot
FBEOF

    chmod +x /mnt/usr/local/bin/niixarch-firstboot.sh

    # -- Launcher wrapper ----------------------------------
    # A separate script handles terminal detection and the done-file guard.
    # This avoids shell quoting issues inside the .desktop Exec field.
    cat > /mnt/usr/local/bin/niixarch-firstboot-launcher.sh <<'LAUNCHEOF'
#!/bin/bash
# Exit silently if first-boot already completed
[ -f /var/lib/niixarch-firstboot-done ] && exit 0

# Give GNOME Shell a moment to fully settle
sleep 5

# Launch in best available terminal (gnome-terminal is explicitly installed)
if command -v gnome-terminal &>/dev/null; then
    exec gnome-terminal -- bash -c '/usr/local/bin/niixarch-firstboot.sh; exec bash'
elif command -v kgx &>/dev/null; then
    exec kgx -- bash -c '/usr/local/bin/niixarch-firstboot.sh; exec bash'
elif command -v xterm &>/dev/null; then
    exec xterm -e bash -c '/usr/local/bin/niixarch-firstboot.sh; exec bash'
fi
LAUNCHEOF
    chmod +x /mnt/usr/local/bin/niixarch-firstboot-launcher.sh

    # -- Autostart .desktop --------------------------------
    # Exec points directly to the launcher - no shell quoting needed.
    # NoDisplay=false  : ensures GNOME's autostart actually processes it.
    # Terminal=false   : launcher opens its own terminal; don't wrap in another.
    # OnlyShowIn left out intentionally - the restriction can silently block
    # the entry if XDG_CURRENT_DESKTOP doesn't match the exact string.
    mkdir -p /mnt/etc/xdg/autostart
    cat > /mnt/etc/xdg/autostart/niixarch-firstboot.desktop <<'DTEOF'
[Desktop Entry]
Type=Application
Name=NiiX Arch First-Boot Setup
Exec=/usr/local/bin/niixarch-firstboot-launcher.sh
NoDisplay=false
Terminal=false
X-GNOME-Autostart-enabled=true
DTEOF

    log "First-boot script installed (runs automatically on first login)"
}

# -- Step 12: Done --------------------------------------------
finish() {
    hr "Complete"
    echo
    echo
    echo -e "  ${PINK}========================================${NC}"
    echo -e "  ${GREEN}  niiXa${PINK}OS${NC}   ${WHITE}Arch Installer${NC}"
    echo -e "  ${PINK}========================================${NC}"
    echo
    echo
    echo -e "  ${GREEN}installation complete!${NC}"
    echo -e "  ${PINK}--------------------------------------------------------${NC}"
    echo
    echo -e "  ${DIM}Logs are saved next, then you'll be prompted to reboot.${NC}"
    echo -e "  ${DIM}Remove the USB when the screen goes blank after reboot.${NC}"
    echo
    echo -e "  ${PINK}-- At the Limine menu ----------------------------${NC}"
    echo
    echo -e "  ${GREEN}+${NC}  ${WHITE}NiiX Arch${NC}              -> LUKS passphrase -> GDM login"
    echo -e "  ${GREEN}+${NC}  ${WHITE}NiiX Arch (clean state)${NC} -> boots @clean fallback (after first-boot)"
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        echo -e "  ${GREEN}+${NC}  ${WHITE}Windows Boot Manager${NC}   -> boots Windows normally"
    fi
    echo
    echo -e "  ${PINK}-- On first login --------------------------------${NC}"
    echo
    echo -e "  ${CYAN}-${NC}  A terminal opens automatically and runs the first-boot setup."
    echo -e "  ${CYAN}-${NC}  It installs: CachyOS kernel - removes stock linux - AUR packages - GE-Proton"
    echo -e "  ${CYAN}-${NC}  Creates the ${WHITE}@clean${NC} Btrfs snapshot - bootable from Limine as a fallback."
    echo -e "  ${CYAN}-${NC}  This takes 10-20 minutes. Let it complete, then reboot."
    echo -e "  ${CYAN}-${NC}  Snapper auto-snapshots before/after every pacman update (snap-pac)."
    echo -e "  ${CYAN}-${NC}  Refresh the clean state any time: ${WHITE}sudo niixarch-refresh-clean${NC}"
    echo
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        warn "If Limine doesn't appear: go into BIOS and move"
        warn "'NiiX Arch (Limine)' above Windows in the boot order."
    fi
    echo

    # -- Anonymous install counter ----------------------------
    # Fires only here, at confirmed success - not at launch - so it counts
    # completed installs, not attempts or abandoned runs. Run synchronously
    # with a short timeout (not backgrounded) so it can't be killed by the
    # script exiting or the machine rebooting before the request lands.
    curl -sf "https://niixa.org/counter.php?action=hit&secret=e6975a19b1e7638effbba0d33f862e2ed1bb0fdc" \
        --max-time 8 --retry 2 --retry-delay 1 -o /dev/null 2>/dev/null || true
}

# -- Auto-detect install mode ---------------------------------
# Scans internal drives for Windows (NTFS partitions or EFI/Microsoft).
# Windows found  -> dual-boot (automatically, no menu)
# Nothing found  -> single-boot (automatically, no menu)
auto_detect_mode() {
    hr "Install Mode Detection"
    info "Scanning internal drives for existing operating systems..."

    local windows_found=false dev parent fstype efi_dev tmp_mnt choice answer

    # Pass 1: look for NTFS partitions on internal (non-USB) drives
    while IFS= read -r dev; do
        [[ -b "$dev" ]] || continue
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        [[ -n "$parent" ]] && is_removable "/dev/$parent" && continue
        fstype=$(blkid -s TYPE -o value "$dev" 2>/dev/null)
        if [[ "$fstype" == "ntfs" ]]; then
            windows_found=true
            log "Windows NTFS partition found: $dev"
            break
        fi
    done < <(lsblk -lno PATH,TYPE 2>/dev/null | awk '$2=="part"{print $1}')

    # Pass 2: look for the Windows EFI bootloader on any internal EFI partition
    if [[ "$windows_found" == false ]]; then
        while IFS= read -r efi_dev; do
            [[ -b "$efi_dev" ]] || continue
            parent=$(lsblk -no PKNAME "$efi_dev" 2>/dev/null)
            [[ -n "$parent" ]] && is_removable "/dev/$parent" && continue
            tmp_mnt="/tmp/niix_efi_check_$$"
            mkdir -p "$tmp_mnt"
            if mount -o ro "$efi_dev" "$tmp_mnt" 2>/dev/null; then
                if [[ -f "$tmp_mnt/EFI/Microsoft/Boot/bootmgfw.efi" ]]; then
                    windows_found=true
                    log "Windows EFI bootloader found: $efi_dev"
                fi
                umount "$tmp_mnt" 2>/dev/null
            fi
            rmdir "$tmp_mnt" 2>/dev/null || true
            [[ "$windows_found" == true ]] && break
        done < <(blkid -t PART_ENTRY_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" \
                      -o device 2>/dev/null)
    fi

    echo
    if [[ "$windows_found" == true ]]; then
        echo -e "  ${GREEN}+${NC}  ${WHITE}${BOLD}Windows detected on an internal drive${NC}"
        echo
        echo -e "  ${WHITE}${BOLD}How do you want to install?${NC}"
        echo -e "  ${GREEN}[1]${NC}  ${WHITE}Dual-boot${NC}    - keep Windows, install Arch alongside it  ${DIM}(recommended)${NC}"
        echo -e "  ${GREEN}[2]${NC}  ${WHITE}Single-boot${NC}  - ${RED}ERASE an entire drive${NC} (including Windows) and use it for Arch"
        echo
        echo -e "  ${DIM}Press Enter for the safe choice (dual-boot).${NC}"
        read -rp "  Choose [1/2]: " choice
        if [[ "$choice" == "2" ]]; then
            # Beginner-safety gate: an explicit typed phrase, not just a number,
            # so this can never be triggered by an accidental keypress.
            echo
            warn "Single-boot ERASES a whole drive. Windows and everything on it will be gone."
            warn "There is no undo. You will still choose which drive and confirm again later."
            echo
            echo -e "  ${RED}${BOLD}Type exactly:  ERASE WINDOWS  to continue (anything else keeps Windows):${NC}"
            read -rp "  > " answer
            if [[ "$answer" == "ERASE WINDOWS" ]]; then
                INSTALL_MODE="singleboot"
                warn "Single-boot selected - you will pick the drive to erase next."
            else
                INSTALL_MODE="dualboot"
                log "Phrase did not match - keeping Windows (dual-boot)."
            fi
        else
            INSTALL_MODE="dualboot"
            echo -e "  ${GREEN}+${NC}  ${WHITE}${BOLD}Dual-boot - Windows will be preserved${NC}"
            echo -e "  ${DIM}  Arch installs into free space. No existing data is touched.${NC}"
        fi
    else
        INSTALL_MODE="singleboot"
        echo -e "  ${CYAN}-${NC}  ${WHITE}${BOLD}No existing OS detected - installing in single-boot mode${NC}"
        echo -e "  ${DIM}  A drive of your choice will be fully wiped and used for Arch.${NC}"
    fi
    echo
}

# -- Single-boot step 1: choose the target drive -------------
select_single_drive() {
    hr "Select Target Drive  (will be fully wiped)"
    warn "The ENTIRE selected drive will be repartitioned and ALL data destroyed."
    warn "This includes any existing OS, partitions, and files on that drive."
    echo
    echo -e "  ${WHITE}${BOLD}Internal drives:${NC}"
    echo

    # Whole internal disks only: never USB, zram, md arrays, nbd or optical.
    local -a drives=()
    local path type size model i choice answer
    while read -r path type size model; do
        [[ "$type" == disk ]] || continue
        is_removable "$path" && continue
        drives+=("$path")
        printf "  ${CYAN}[%s]${NC}  %-14s  %8s  %s\n" "$(( ${#drives[@]} - 1 ))" "$path" "$size" "$model"
    done < <(lsblk -dn -o PATH,TYPE,SIZE,MODEL 2>/dev/null)
    (( ${#drives[@]} )) || err "No internal drives found"

    echo
    ask "Select drive to install on (will be COMPLETELY WIPED):"
    read -rp "  > " choice
    # Strict numeric check: bash treats a non-numeric index as a variable name
    # that evaluates to 0, which would silently select the FIRST drive.
    [[ "$choice" =~ ^[0-9]+$ && -n "${drives[choice]:-}" ]] || err "Invalid selection: $choice"

    SINGLE_DRIVE=${drives[choice]}
    TARGET_DRIVE=$SINGLE_DRIVE
    [[ -b "$SINGLE_DRIVE" ]] || err "Not a block device: $SINGLE_DRIVE"

    size=$(lsblk -dn -o SIZE "$SINGLE_DRIVE" 2>/dev/null | head -1 | tr -d '[:space:]')
    echo
    echo -e "  ${RED}${BOLD}You selected: $SINGLE_DRIVE ($size)${NC}"
    echo -e "  ${RED}${BOLD}ALL data on this drive will be permanently destroyed.${NC}"
    echo
    echo -e "  ${RED}Type  WIPE  (uppercase) to confirm:${NC}"
    read -rp "  > " answer
    [[ "$answer" == "WIPE" ]] || { echo "  Aborted. Nothing was changed."; exit 0; }

    log "Target drive confirmed: $SINGLE_DRIVE ($size)"
}

# -- Single-boot step 2: wipe the drive -----------------------
# Completely destroys all existing data, partition tables, and
# filesystem signatures. Run BEFORE partitioning.
wipe_single_drive() {
    hr "Drive Wipe"
    info "Wiping $SINGLE_DRIVE - destroying all existing data..."

    # Close any open LUKS containers on this drive first
    lsblk -lno NAME,TYPE "$SINGLE_DRIVE" 2>/dev/null \
        | awk '$2=="crypt"{print $1}' \
        | while read -r cname; do
            info "Closing LUKS container /dev/mapper/$cname..."
            cryptsetup close "$cname" 2>/dev/null || true
        done

    # Unmount any mounted partitions on this drive
    lsblk -lno NAME,MOUNTPOINT "$SINGLE_DRIVE" 2>/dev/null \
        | awk '$2!=""{print $2}' \
        | while read -r mnt; do
            umount "$mnt" 2>/dev/null || true
        done

    # Wipe all filesystem and partition signatures
    wipefs -a "$SINGLE_DRIVE" || err "wipefs failed on $SINGLE_DRIVE"
    log "Filesystem signatures wiped"

    # Destroy the partition table (GPT + MBR backup)
    sgdisk --zap-all "$SINGLE_DRIVE" || err "sgdisk --zap-all failed on $SINGLE_DRIVE"
    log "Partition table destroyed"

    # Zero the first and last 10 MiB to eliminate any residual metadata
    dd if=/dev/zero of="$SINGLE_DRIVE" bs=1M count=10 conv=fsync 2>/dev/null \
        || err "Failed to zero the start of $SINGLE_DRIVE"
    dd if=/dev/zero of="$SINGLE_DRIVE" bs=1M count=10 conv=fsync \
        seek=$(( $(blockdev --getsz "$SINGLE_DRIVE") / 2048 - 10 )) 2>/dev/null || true

    partprobe "$SINGLE_DRIVE" 2>/dev/null || true
    udevadm settle --timeout=10 2>/dev/null || true
    log "Drive $SINGLE_DRIVE wiped - ready for partitioning"
}

# -- Single-boot step 3: partition the drive -------------------
# Creates the same GPT layout dual-boot uses (EFI + LUKS),
# then sets the identical variables so all downstream functions
# (setup_luks, setup_btrfs, clean_efi, install_limine) run unchanged.
create_singleboot_partitions() {
    hr "Partition Creation  (single-boot)"
    info "Partitioning $SINGLE_DRIVE - same layout as dual-boot..."

    # -- GPT + EFI + LUKS -------------------------------------
    parted -s "$SINGLE_DRIVE" mklabel gpt || err "Failed to create GPT label on $SINGLE_DRIVE"
    log "New GPT partition table created"

    # Partition 1: EFI System Partition - 512 MiB
    # 1 MiB aligned start; large enough for kernel + initramfs + ucode + Limine
    parted -s "$SINGLE_DRIVE" mkpart "EFI" fat32 1MiB 513MiB || err "Failed to create EFI partition"
    parted -s "$SINGLE_DRIVE" set 1 esp on                    || err "Failed to set esp flag on partition 1"
    log "EFI partition: 1 MiB -> 513 MiB  (512 MiB, partition 1)"

    # Partition 2: Linux LUKS container - remainder of drive
    parted -s "$SINGLE_DRIVE" mkpart "arch" 513MiB 100% || err "Failed to create root partition"
    log "Root partition: 513 MiB -> 100%  (partition 2)"

    # Inform the kernel; the device nodes are waited for below.
    partprobe "$SINGLE_DRIVE" 2>/dev/null || true

    EFI_PART=$(part_path "$SINGLE_DRIVE" 1)
    LUKS_PART=$(part_path "$SINGLE_DRIVE" 2)

    # Wait for udev to publish both nodes (up to ~10s), then verify.
    local try
    for (( try = 0; try < 20; try++ )); do
        [[ -b "$EFI_PART" && -b "$LUKS_PART" ]] && break
        udevadm settle --timeout=5 2>/dev/null || true
        sleep 0.5
    done
    [[ -b "$EFI_PART"  ]] || err "EFI partition $EFI_PART not found after partprobe"
    [[ -b "$LUKS_PART" ]] || err "Root partition $LUKS_PART not found after partprobe"

    # Mirror the variables dual-boot sets - everything downstream is identical
    EFI_DRIVE="$SINGLE_DRIVE"
    EFI_PART_NUM=1
    TARGET_DRIVE="$SINGLE_DRIVE"

    # Format EFI partition as FAT32 (same as Windows creates)
    mkfs.fat -F32 -n "EFI" "$EFI_PART" || err "mkfs.fat failed on $EFI_PART"
    log "EFI partition formatted: $EFI_PART  (FAT32)"
    log "LUKS partition ready:    $LUKS_PART  (encryption next)"
}

# -- Installer integrity -----------------------------------------------------
# The expected sha256 lives on GitHub, not on niixa.org, so a modified or
# damaged installer has to match a file on a second, independent host.
# What this protects against: corrupted/truncated/re-encoded downloads, stale
# caches, and niixa.org and GitHub being out of sync. Against a deliberately
# tampered installer only the verify-before-running command in the header
# helps - a tampered copy could simply delete this function.
NIIX_INSTALL_URL="https://niixa.org/install"
NIIX_HASH_URL="https://raw.githubusercontent.com/techniixdotcom/niixarch-install/main/install.sha256"

verify_installer() {
    local expected actual self="" tmp=""
    if [[ "${NIIX_SKIP_VERIFY:-0}" == "1" ]]; then
        warn "Installer verification SKIPPED (NIIX_SKIP_VERIFY=1) - only do this for development."
        return 0
    fi

    # A verified copy that re-executed itself only needs to prove it is
    # still the same file - no second download.
    if [[ -n "${NIIX_VERIFIED_SHA:-}" && -f "$0" ]]; then
        actual=$(sha256sum "$0" 2>/dev/null | awk '{print $1}')
        if [[ "$actual" == "$NIIX_VERIFIED_SHA" ]]; then
            log "Installer verified (sha256 matches GitHub)"
            return 0
        fi
    fi

    info "Verifying the installer against the checksum published on GitHub..."
    expected=$(curl -fsSL --retry 3 --max-time 20 "$NIIX_HASH_URL" 2>/dev/null \
        | awk '$2 == "install" || $2 == "*install" { print tolower($1); exit }')
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] \
        || err "Could not read the installer checksum from GitHub ($NIIX_HASH_URL). Check the connection and run the installer again."

    if [[ -f "$0" && -r "$0" ]]; then
        self=$0
    else
        # Started through a pipe (bash <(curl ...) or curl | bash): the bytes
        # being executed can't be read back, so download the installer to a
        # file, verify THAT, and carry on from the verified copy.
        tmp=$(mktemp /tmp/niix-install.XXXXXX) || err "Could not create a temporary file"
        curl -fsSL --retry 3 --max-time 120 "$NIIX_INSTALL_URL" -o "$tmp" \
            || err "Could not download the installer from $NIIX_INSTALL_URL for verification"
        self=$tmp
    fi

    actual=$(sha256sum "$self" | awk '{print $1}')
    if [[ "$actual" != "$expected" ]]; then
        [[ -n "$tmp" ]] && rm -f "$tmp"
        echo
        echo -e "  ${RED}${BOLD}INSTALLER CHECKSUM MISMATCH - nothing has been changed.${NC}"
        echo -e "  expected (GitHub): $expected"
        echo -e "  this installer:    $actual"
        echo -e "  If a new version was published in the last few minutes, GitHub may still"
        echo -e "  be serving the old checksum - wait 5 minutes and try again. Otherwise do"
        echo -e "  NOT run this file."
        err "Installer checksum does not match the one published on GitHub"
    fi
    log "Installer verified (sha256 matches GitHub)"

    if [[ -n "$tmp" ]]; then
        info "Continuing from the verified copy..."
        exec env NIIX_VERIFIED_SHA="$actual" bash "$tmp" "$@"
    fi
}

# ============================================================
#  MAIN
# ============================================================
dbg "Script started: $(date)"
dbg "Script source: $0"
dbg "Kernel: $(uname -r)"

# Unwind mounts/encryption if the install is interrupted or killed midway.
trap 'cleanup_on_fail' INT TERM

banner
check_prereqs          # brings the network up if needed
verify_installer "$@"  # before anything is touched
auto_detect_mode

# -- Hardware + drive detection (mode-dependent) --------------
if [[ "$INSTALL_MODE" == "dualboot" ]]; then
    detect_efi
fi
detect_hardware
dump_state "after hardware detection"

if [[ "$INSTALL_MODE" == "dualboot" ]]; then
    detect_free_spaces
    dump_state "after detect_free_spaces"
else
    select_single_drive   # step 1: choose drive + confirm WIPE
fi

# -- User input + confirmation --------------------------------
gather_input
confirm

# -- Disk setup -----------------------------------------------
if [[ "$INSTALL_MODE" == "dualboot" ]]; then
    # Dual-boot: carve a partition out of existing free space
    create_partition
    dump_state "after create_partition"
else
    # Single-boot: wipe -> partition -> same layout as dual-boot
    wipe_single_drive                        # step 2: destroy everything
    dump_state "after wipe"
    create_singleboot_partitions             # step 3: GPT + EFI + LUKS
    dump_state "after singleboot_partitions"
fi

# -- From here both modes are identical -----------------------
setup_luks
dump_state "after setup_luks"
setup_btrfs
clean_efi       # purges stale NVRAM entries + old Arch/Limine files
dump_state "after btrfs + clean_efi"

# -- Install + configure (same for both modes) ----------------
install_base
enable_multilib
install_gpu_drivers
install_packages

configure_system
# Dump boot-critical files to log
{
    echo ""
    echo "==== BOOT CONFIG DUMP ===="
    echo ""
    echo "--- /mnt/etc/mkinitcpio.conf ---"
    cat /mnt/etc/mkinitcpio.conf 2>&1 || true
    echo ""
    echo "--- /mnt/etc/fstab ---"
    cat /mnt/etc/fstab 2>&1 || true
    echo ""
    echo "--- /mnt/etc/environment ---"
    cat /mnt/etc/environment 2>&1 || echo "(not present)"
    echo ""
    echo "--- /mnt/etc/sysctl.d/99-niixarch.conf ---"
    cat /mnt/etc/sysctl.d/99-niixarch.conf 2>&1 || true
    echo ""
    echo "--- initramfs hooks ---"
    lsinitcpio /mnt/boot/initramfs-linux.img 2>&1 | grep -i "hooks/\|cryptsetup" || echo "(no hooks/crypt)"
    echo ""
    echo "--- EFI partition contents ---"
    find /mnt/boot -type f -name "*.img" -o -name "vmlinuz*" -o -name "*.cfg" -o -name "*.conf" -o -name "*.EFI" -o -name "*.efi" 2>&1 | head -30 || true
    echo ""
    echo "--- EFI partition space ---"
    df -h /mnt/boot 2>&1 || true
    echo ""
    echo "==== END BOOT CONFIG DUMP ===="
} >> "$LOGFILE" 2>&1

install_desktop
setup_storage
setup_controllers
setup_hardware_tools
rebuild_initramfs
install_limine
setup_firstboot

# Dump final limine config to log
{
    echo ""
    echo "==== LIMINE CONFIG DUMP ===="
    echo ""
    echo "--- /mnt/boot/limine/limine.cfg ---"
    cat /mnt/boot/limine/limine.cfg 2>&1 || true
    echo ""
    echo "--- efibootmgr ---"
    efibootmgr -v 2>&1 || true
    echo ""
    echo "==== END LIMINE CONFIG DUMP ===="
} >> "$LOGFILE" 2>&1

dump_state "final state"

# Install finished - stop unwinding on Ctrl+C so the user can stay in a shell
# with /mnt mounted for inspection if they cancel the reboot prompt.
trap - INT TERM

# Copy log to the installed system so it survives reboot
cp "$LOGFILE" /mnt/var/log/niixarch-install.log 2>/dev/null || true

finish


copy_logs_to_usb

# Show log locations
echo
echo -e "  ${CYAN}Log file:${NC}"
echo -e "    Live ISO:    ${YELLOW}${LOGFILE}${NC}"
echo -e "    Installed:   ${YELLOW}/var/log/niixarch-install.log${NC}"
echo

# -- Reboot on Enter ---------------------------------------
echo -e "  ${PINK}--------------------------------------------------------${NC}"
read -rp "$(echo -e "  ${GREEN}Press Enter to reboot${NC} ${DIM}(or Ctrl+C to stay at the shell)${NC}  ")" _
echo -e "  ${CYAN}Unmounting and rebooting...${NC}"
release_target
sync
reboot

