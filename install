# Window snapping (Tiling Assistant): drag to the top edge = full screen,
# left/right edge = half, any corner = quarter. It turns GNOME's own edge
# tiling off while it runs and back on if it is ever disabled.
#   enable-layout-picker=false          no Windows-11-style drop-down at the top
#   enable-tiling-popup=false           no "pick a window for the other half"
#   enable-raise-tile-group=false       clicking a tiled window raises only it
#   toggle-maximize-tophalf-timer=max   holding at the top never turns
#                                       "full screen" into "top half"
dconf load /org/gnome/shell/extensions/tiling-assistant/ <<'TILING'
