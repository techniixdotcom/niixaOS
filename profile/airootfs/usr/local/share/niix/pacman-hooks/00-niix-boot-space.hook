[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/lib/systemd/systemd-udevd
Target = usr/bin/cryptsetup
Target = usr/lib/libcryptsetup.so
Target = usr/lib/modprobe.d/
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = mkinitcpio

[Action]
Description = Checking the EFI partition before the boot image is rebuilt...
When = PreTransaction
Exec = /usr/local/lib/niix-system/boot-files-check pre
AbortOnFail
