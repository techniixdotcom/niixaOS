#!/bin/bash
# niix-usb-autofix DEVICE FSTYPE
# Run from udev the moment a USB filesystem appears and before udisks mounts
# it, so a stick left dirty by Windows (or by being yanked out) is repaired and
# mounts read-write instead of read-only.
# Deliberately conservative:
#   - never touches a filesystem that is already mounted
#   - checks first, and only writes when the check reports a problem
#   - a volume hibernated by Windows is left alone: clearing its dirty flag
#     would not make writing safe, and both NTFS drivers refuse it anyway
#   - every tool runs under a timeout so a udev worker can never wedge
# Turn it off with USB_AUTOFIX=0 in /etc/niix-ntfs.conf
# Log: journalctl -t niix-usb-autofix
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

USB_AUTOFIX=1
CONF=/etc/niix-ntfs.conf
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
[ "${USB_AUTOFIX:-1}" = "1" ] || exit 0
# Not on the live ISO - the stick it runs from must never be touched.
[ -e /etc/niix-live ] && exit 0

DEV="${1:-}"
FS="${2:-}"
[ -b "$DEV" ] || exit 0

say() { logger -t niix-usb-autofix -- "$*" 2>/dev/null || true; }

# Anything already mounted is off limits - repairing a mounted filesystem
# corrupts it.
findmnt -rn -S "$DEV" >/dev/null 2>&1 && exit 0

case "$FS" in
    ntfs)
        command -v ntfsfix >/dev/null 2>&1 || exit 0
        # Without the probe there is no safe way to tell "unclean" from
        # "hibernated", so do nothing rather than guess.
        command -v ntfs-3g.probe >/dev/null 2>&1 || exit 0
        timeout 20 ntfs-3g.probe --readwrite "$DEV" >/dev/null 2>&1
        rc=$?
        # ntfs-3g.probe(8): 0 mountable, 14 hibernated, 15 not cleanly
        # unmounted. Only 15 is repaired: that is the yanked-out / Windows-
        # crashed case ntfsfix exists for. Hibernated (Fast Startup), corrupt,
        # in-use or unknown volumes are left untouched.
        case "$rc" in
            0)  exit 0 ;;
            14) say "$DEV: hibernated by Windows - left alone (turn off Fast Startup and shut down fully)"
                exit 0 ;;
            15) ;;
            *)  say "$DEV: not repairable automatically (ntfs-3g.probe code $rc) - left alone"
                exit 0 ;;
        esac
        if out=$(timeout 45 ntfsfix -d "$DEV" 2>&1); then
            say "$DEV: NTFS was not cleanly unmounted - repaired, mounts read-write now"
        else
            say "$DEV: ntfsfix failed: $(printf '%s' "$out" | tail -1)"
        fi
        ;;
    vfat)
        command -v fsck.fat >/dev/null 2>&1 || exit 0
        timeout 20 fsck.fat -n "$DEV" >/dev/null 2>&1 && exit 0
        if out=$(timeout 45 fsck.fat -a "$DEV" 2>&1); then
            say "$DEV: FAT repaired"
        else
            say "$DEV: fsck.fat could not repair it: $(printf '%s' "$out" | tail -1)"
        fi
        ;;
    exfat)
        command -v fsck.exfat >/dev/null 2>&1 || exit 0
        timeout 20 fsck.exfat -n "$DEV" >/dev/null 2>&1 && exit 0
        if out=$(timeout 45 fsck.exfat -p "$DEV" 2>&1); then
            say "$DEV: exFAT repaired"
        else
            say "$DEV: fsck.exfat could not repair it: $(printf '%s' "$out" | tail -1)"
        fi
        ;;
esac
exit 0
