#!/bin/bash
# NiiX wrapper: loads the GPU settings from niix-gpu, shows a one-time
# first-launch notice, then hands off to the real Steam.
# Remove with: sudo rm /usr/local/bin/steam ~/.local/share/applications/steam.desktop
# The desktop session already has the GPU settings; loading them here as well
# covers Steam started from a TTY, or right after niix-gpu changed its mind.
if [ -r /etc/environment.d/90-niix-gpu.conf ]; then
    set -a
    . /etc/environment.d/90-niix-gpu.conf
    set +a
fi
for arg in "$@"; do
    [ "$arg" = "-silent" ] && exec /usr/bin/steam "$@"
done
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/niix"
FLAG="$STATE_DIR/steam-notice-shown"
if [ ! -e "$FLAG" ]; then
    mkdir -p "$STATE_DIR" && touch "$FLAG"
    MSG="This first time, Steam downloads its client before it opens - a small window shows the progress. It takes a few minutes, depending on the connection.

One-time setup for the best experience: in Steam go to Settings -> Compatibility, turn on \"Enable Steam Play for all other titles\", and pick Proton-CachyOS (already installed; GE-Proton is there too as an alternative) as the default tool. Steam will restart once.

Tip: NiiX pre-loads Steam in the background shortly after each login, so future launches are much faster."
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --title="Steam is starting..." --width=420 --text="$MSG" &
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal "Steam is starting..." "$MSG" &
    fi
fi
exec /usr/bin/steam "$@"
