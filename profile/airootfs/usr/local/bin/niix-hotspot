#!/bin/bash
# niix-hotspot - phone-friendly WPA2 Wi-Fi hotspot (NetworkManager)
#   niix-hotspot start [SSID] [PASSWORD]  create/update the hotspot and bring it up
#   niix-hotspot setup SSID [PASSWORD]    create/update it without bringing it up
#   niix-hotspot up                       bring the saved hotspot up
#   niix-hotspot stop                     take it down (auto mode paused until reboot)
#   niix-hotspot auto on|off              keep it up automatically (from boot, and
#                                         restored after internet outages)
#   niix-hotspot password                 show the saved password
#   niix-hotspot status
# PASSWORD: 8-63 characters; omit it to get a random one. It is stored only in
# NetworkManager's root-only profile.
# When Wi-Fi is the internet connection, the hotspot runs next to it on the
# same card (a second interface on the same channel) if the card supports
# that - most do. Otherwise it takes the card over: 2.4 GHz, channel 7,
# WPA2-AES, the combination phones connect to most reliably.
# Exit codes: 0 ok, 1 error, 2 refused (Wi-Fi is the only internet connection
#             and the card can't share it), 3 no saved hotspot
set -uo pipefail
CON="niix-hotspot"
SVC="niix-hotspot-watchdog.service"
AP_IF="niixap0"
ACTION="${1:-}"

# Wi-Fi interfaces and NetworkManager's system profiles need root.
if [ "$(id -u)" -ne 0 ]; then
    exec sudo -- "$0" "$@"
fi

usage() {
    echo "Usage: niix-hotspot {start [SSID] [PASSWORD]|setup SSID [PASSWORD]|up|stop|auto on|off|password|status}"
}

unit_exists() {
    systemctl cat "$SVC" >/dev/null 2>&1
}

# The Wi-Fi card (not the hotspot's own second interface).
wifi_dev() {
    nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: -v ap="$AP_IF" '$2=="wifi" && $1!=ap {print $1; exit}'
}

have_profile() {
    nmcli connection show "$CON" >/dev/null 2>&1
}

hotspot_active() {
    [ "$(nmcli -g GENERAL.STATE connection show "$CON" 2>/dev/null)" = "activated" ]
}

random_pass() {
    local p
    p=$(tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 16) || true
    printf '%s' "$p"
}

# client_on DEV : 0 when DEV is connected to a Wi-Fi network.
client_on() {
    local state conn
    state=$(nmcli -t -f DEVICE,STATE device 2>/dev/null | awk -F: -v d="$1" '$1==d{print $2; exit}')
    conn=$(nmcli -g GENERAL.CONNECTION device show "$1" 2>/dev/null)
    [ "$state" = "connected" ] && [ -n "$conn" ] && [ "$conn" != "$CON" ]
}

# other_uplink DEV : 0 when something other than Wi-Fi (Ethernet, USB
# tethering, a mobile modem) is connected.
other_uplink() {
    nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: -v d="$1" -v ap="$AP_IF" '
        $1!=d && $1!=ap && $3=="connected" && $2!~/^(wifi|wifi-p2p|loopback|tun|wireguard|dummy|bridge)$/ {f=1}
        END {exit !f}'
}

phy_of() {
    basename "$(readlink -f "/sys/class/net/$1/phy80211")"
}

# can_share PHY : 0 when the card can run an access point next to its normal
# Wi-Fi connection - a "valid interface combination" with both, two at once.
can_share() {
    iw phy "$1" info 2>/dev/null | awk '
        /valid interface combinations:/ { on = 1; next }
        on && /^\t[^\t]/ { on = 0 }
        on && /^\t\t \* / { if (cur != "") list[++n] = cur; cur = $0; next }
        on { cur = cur " " $0 }
        END {
            if (cur != "") list[++n] = cur
            for (i = 1; i <= n; i++) {
                rest = list[i]; managed = 0; ap = 0; total = 0
                while (match(rest, /#\{[^}]*\} <= [0-9]+/)) {
                    group = substr(rest, RSTART, RLENGTH)
                    rest = substr(rest, RSTART + RLENGTH)
                    limit = group; sub(/.*<= /, "", limit)
                    names = group; sub(/^#\{ */, "", names); sub(/ *\}.*/, "", names)
                    k = split(names, kind, / *, */)
                    has_m = 0; has_a = 0
                    for (j = 1; j <= k; j++) {
                        if (kind[j] == "managed") has_m = 1
                        if (kind[j] == "AP") has_a = 1
                    }
                    if (has_m && has_a) { if (limit + 0 >= 2) { managed = 1; ap = 1 } }
                    else {
                        if (has_m && limit + 0 >= 1) managed = 1
                        if (has_a && limit + 0 >= 1) ap = 1
                    }
                }
                if (match(list[i], /total <= [0-9]+/)) total = substr(list[i], RSTART + 9, RLENGTH - 9) + 0
                if (managed && ap && total >= 2) found = 1
            }
            exit !found
        }'
}

# band_channel FREQ : "bg N" or "a N" for the channel of FREQ (MHz). The
# hotspot must use the Wi-Fi connection's channel; 6 GHz can't host one.
band_channel() {
    local f="${1:-0}"
    if [ "$f" -ge 2412 ] && [ "$f" -le 2472 ]; then
        echo "bg $(( (f - 2407) / 5 ))"
    elif [ "$f" -eq 2484 ]; then
        echo "bg 14"
    elif [ "$f" -ge 5160 ] && [ "$f" -le 5885 ]; then
        echo "a $(( (f - 5000) / 5 ))"
    else
        return 1
    fi
}

client_freq() {
    iw dev "$1" link 2>/dev/null | awk '/freq:/ { print int($2); exit }'
}

remove_ap_if() {
    if [ -e "/sys/class/net/$AP_IF" ]; then
        iw dev "$AP_IF" del >/dev/null 2>&1 || true
    fi
}

# make_ap_if DEV : the second interface on DEV's card, with an address of its
# own (DEV's, marked as locally administered), ready in NetworkManager.
# Sets AP_MAC.
make_ap_if() {
    local dev="$1" mac first new state
    if [ ! -e "/sys/class/net/$AP_IF" ]; then
        iw phy "$(phy_of "$dev")" interface add "$AP_IF" type __ap >/dev/null 2>&1 || return 1
    fi
    mac=$(cat "/sys/class/net/$dev/address" 2>/dev/null) || return 1
    first=$(( 0x${mac%%:*} ))
    new=$(( first | 0x02 ))
    [ "$new" -eq "$first" ] && new=$(( first ^ 0x04 ))
    AP_MAC=$(printf '%02x:%s' "$new" "${mac#*:}")
    for _ in $(seq 1 30); do
        state=$(nmcli -t -f DEVICE,STATE device 2>/dev/null | awk -F: -v d="$AP_IF" '$1==d{print $2; exit}')
        case "$state" in
            disconnected) break ;;
            unmanaged) nmcli device set "$AP_IF" managed yes >/dev/null 2>&1 || true ;;
        esac
        sleep 0.5
    done
    [ -n "$state" ] || { remove_ap_if; return 1; }
    # Never let NetworkManager join a saved Wi-Fi network with it.
    nmcli device set "$AP_IF" autoconnect no >/dev/null 2>&1 || true
    return 0
}

create_profile() {
    local ssid="$1" pass="$2" ssid_bytes
    [ -n "$(wifi_dev)" ] || { echo "No Wi-Fi device found."; return 1; }
    ssid_bytes=$(printf '%s' "$ssid" | wc -c)
    if [ "$ssid_bytes" -lt 1 ] || [ "$ssid_bytes" -gt 32 ]; then
        echo "SSID must be 1-32 bytes."; return 1
    fi
    if [ "${#pass}" -lt 8 ] || [ "${#pass}" -gt 63 ]; then
        echo "Password must be 8-63 characters."; return 1
    fi
    nmcli connection delete "$CON" >/dev/null 2>&1 || true
    nmcli connection add type wifi ifname "$(wifi_dev)" con-name "$CON" \
        autoconnect no ssid "$ssid" \
        802-11-wireless.mode ap \
        802-11-wireless.band bg \
        802-11-wireless.channel 7 \
        802-11-wireless.powersave 2 \
        ipv4.method shared \
        ipv6.method ignore \
        wifi-sec.key-mgmt wpa-psk \
        wifi-sec.proto rsn \
        wifi-sec.pairwise ccmp \
        wifi-sec.group ccmp \
        wifi-sec.pmf optional \
        wifi-sec.psk "$pass" >/dev/null \
        || { echo "Could not create the hotspot profile."; return 1; }
}

# activate IFACE BAND CHANNEL MAC : point the profile at IFACE and bring it up.
activate() {
    nmcli connection modify "$CON" connection.interface-name "$1" \
        802-11-wireless.band "$2" 802-11-wireless.channel "$3" \
        802-11-wireless.cloned-mac-address "$4" >/dev/null 2>&1 || return 1
    nmcli connection up "$CON" >/dev/null 2>&1
}

bring_up() {
    local dev bc band channel ssid
    have_profile || { echo "No saved hotspot - run: niix-hotspot start [SSID] [PASSWORD]"; return 3; }
    dev=$(wifi_dev)
    [ -n "$dev" ] || { echo "No Wi-Fi device found."; return 1; }
    ssid=$(nmcli -g 802-11-wireless.ssid connection show "$CON" 2>/dev/null)

    if client_on "$dev"; then
        # Keep the Wi-Fi connection and share it on the same card, on its
        # channel - when the card can run both at once.
        if bc=$(band_channel "$(client_freq "$dev")") && can_share "$(phy_of "$dev")" && make_ap_if "$dev"; then
            band=${bc% *}
            channel=${bc#* }
            if activate "$AP_IF" "$band" "$channel" "$AP_MAC"; then
                echo "Hotspot '$ssid' is UP next to the Wi-Fi connection ($AP_IF, channel $channel, WPA2-AES)."
                return 0
            fi
            remove_ap_if
            echo "The Wi-Fi card refused a hotspot next to its connection on channel $channel."
        fi
        if ! other_uplink "$dev" && [ "${NIIX_HOTSPOT_FORCE:-0}" != "1" ]; then
            echo "Wi-Fi $dev is your internet connection, and this card can't share it."
            echo "Connect Ethernet or USB tethering - or take the card over: NIIX_HOTSPOT_FORCE=1 niix-hotspot up"
            return 2
        fi
    fi

    remove_ap_if
    if ! activate "$dev" bg 7 ""; then
        echo "Failed to start hotspot. Check: nmcli -f WIFI-PROPERTIES.AP device show $dev"
        return 1
    fi
    echo "Hotspot '$ssid' is UP on $dev (2.4GHz, channel 7, WPA2-AES)."
    return 0
}

# Turn on auto mode: the hotspot comes up at every boot and is restored after
# an internet outage. Used by 'auto on' AND by 'start', so starting the hotspot
# once keeps it coming back.
enable_auto() {
    have_profile || { echo "Set up the hotspot first: niix-hotspot setup SSID [PASSWORD]"; return 3; }
    unit_exists || { echo "Auto mode is part of the installed NiiX system."; return 1; }
    # The dispatcher runs the hook that wakes the keeper on network events.
    systemctl enable --now NetworkManager-dispatcher.service >/dev/null 2>&1 \
        || echo "Note: could not enable NetworkManager-dispatcher - the hotspot still recovers, just on the 15s timer."
    if systemctl enable --now "$SVC"; then
        echo "Auto hotspot ON: kept up from boot and restored after internet outages."
        return 0
    fi
    echo "Could not enable $SVC - the hotspot will not come back after a reboot." >&2
    return 1
}

# setup/start argument handling: SSID defaults to NiiX-Arch; a missing
# password is generated randomly and printed once.
prepare_profile() {
    local ssid="${1:-NiiX-Arch}" pass="${2:-}" generated=false
    if [ -z "$pass" ]; then
        pass=$(random_pass)
        generated=true
    fi
    create_profile "$ssid" "$pass" || return 1
    echo "Hotspot saved: SSID '$ssid'"
    if [ "$generated" = true ]; then
        echo "Generated password: $pass  (show it again any time: niix-hotspot password)"
    fi
    return 0
}

case "$ACTION" in
    start)
        if [ $# -ge 2 ] || ! have_profile; then
            prepare_profile "${2:-}" "${3:-}" || exit 1
        fi
        bring_up; rc=$?
        if [ "$rc" -eq 0 ] && unit_exists; then
            if systemctl is-enabled --quiet "$SVC" 2>/dev/null; then
                # Resume auto mode if it is enabled but was paused by 'stop'.
                systemctl is-active --quiet "$SVC" 2>/dev/null \
                    || systemctl start "$SVC" >/dev/null 2>&1 || true
            elif [ "${NIIX_HOTSPOT_ONCE:-0}" != "1" ]; then
                # Starting the hotspot keeps it on at every boot, with the
                # same connectivity checks. NIIX_HOTSPOT_ONCE=1 starts it just
                # once.
                echo "Turning on auto mode so the hotspot also comes back after a reboot..."
                enable_auto || true
            fi
        fi
        exit "$rc"
        ;;
    setup)
        [ $# -ge 2 ] || { usage; exit 1; }
        prepare_profile "$2" "${3:-}" || exit 1
        ;;
    up)
        bring_up; exit $?
        ;;
    stop)
        if systemctl is-active --quiet "$SVC" 2>/dev/null; then
            if systemctl stop "$SVC" >/dev/null 2>&1; then
                echo "Auto mode paused until the next boot ('niix-hotspot start' resumes it, 'niix-hotspot auto off' disables it)."
            else
                echo "Could not pause auto mode - it will bring the hotspot back."
            fi
        fi
        nmcli connection down "$CON" >/dev/null 2>&1 || true
        remove_ap_if
        echo "Hotspot stopped."
        ;;
    auto)
        case "${2:-}" in
            on)
                enable_auto || exit $? ;;
            off)
                systemctl disable --now "$SVC" && echo "Auto hotspot OFF." ;;
            *)
                auto_state=$(systemctl is-enabled "$SVC" 2>/dev/null) || true
                echo "Auto hotspot: ${auto_state:-unknown}"
                echo "Usage: niix-hotspot auto on|off" ;;
        esac
        ;;
    password)
        have_profile || { echo "No saved hotspot."; exit 3; }
        nmcli -s -g 802-11-wireless-security.psk connection show "$CON" 2>/dev/null \
            || { echo "Could not read the password."; exit 1; }
        ;;
    status)
        if hotspot_active; then
            echo "Hotspot: UP ('$(nmcli -g 802-11-wireless.ssid connection show "$CON" 2>/dev/null)' on $(nmcli -g connection.interface-name connection show "$CON" 2>/dev/null))"
        elif have_profile; then
            echo "Hotspot: down (saved as '$(nmcli -g 802-11-wireless.ssid connection show "$CON" 2>/dev/null)')"
        else
            echo "Hotspot: not set up - run: niix-hotspot start [SSID] [PASSWORD]"
        fi
        if unit_exists; then
            auto_state=$(systemctl is-enabled "$SVC" 2>/dev/null) || true
            run_state=$(systemctl is-active "$SVC" 2>/dev/null) || true
            echo "Auto mode: ${auto_state:-unknown} (${run_state:-unknown})"
        fi
        ;;
    *) usage; exit 1 ;;
esac
