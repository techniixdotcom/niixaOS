    "/usr/share/applications",
    "/usr/local/share/applications",
    "/var/lib/flatpak/exports/share/applications",
    *glob.glob("/home/*/.local/share/applications"),
    *glob.glob("/home/*/.local/share/flatpak/exports/share/applications"),
]

