#!/bin/sh
# NiiX: gives SteamVR's compositor CAP_SYS_NICE (asynchronous reprojection),
# as SteamVR's own password prompt would. Run by niix-steamvr-caps.path.
# Usage: niix-steamvr-caps USER
#
# The file lives in the user's home, so the user can swap it at any moment.
# It is opened once and every check and the setcap act on that open file
# (/proc/self/fd/3), never on the path again: a symlink or a file swapped in
# between can't get a system binary the capability - only a regular file
# the user owns can get it.
set -u
user=${1:-}
[ -n "$user" ] || exit 0
home=$(getent passwd "$user" | cut -d: -f6)
[ -n "$home" ] || exit 0
f="$home/.local/share/Steam/steamapps/common/SteamVR/bin/linux64/vrcompositor-launcher"
[ -f "$f" ] && [ ! -L "$f" ] || exit 0
exec 3<"$f" || exit 0
fd=/proc/self/fd/3
[ "$(stat -L -c %F "$fd")" = "regular file" ] || exit 0
[ "$(stat -L -c %U "$fd")" = "$user" ] || exit 0
# An ELF executable, nothing else.
[ "$(head -c 4 "$fd" | od -An -tx1 | tr -d ' \n')" = "7f454c46" ] || exit 0
getcap "$fd" | grep -q cap_sys_nice && exit 0
setcap CAP_SYS_NICE=eip "$fd" && echo "SteamVR compositor: CAP_SYS_NICE set"
