#!/bin/bash
# niix-gpu - find the most powerful graphics card and make the desktop use it.
#
#   niix-gpu status       list every GPU and show which one is in use
#   niix-gpu apply        pick the GPU and apply it (runs at every boot)
#   niix-gpu run CMD...   run one command with the chosen GPU's settings
#   niix-gpu flatpak-gl   fetch the Flatpak NVIDIA driver matching the host
#   niix-gpu detect       print the choice as KEY=VALUE lines (the installer)
#
# How the card is chosen: a discrete card always beats an integrated one, and
# between two cards of the same kind the one with more video memory wins. A
# card only counts when a working driver is loaded for it. An NVIDIA card on
# nouveau is not picked over the integrated GPU - on most NVIDIA cards nouveau
# is slower than a modern iGPU. Once the proprietary driver runs, it wins.
#
# What "use it" means:
#   - every app, game and Vulkan program renders on that card
#     (/etc/environment.d/90-niix-gpu.conf, read at login)
#   - GNOME draws the desktop on it too (a udev tag Mutter reads at start-up).
#     The one exception is an NVIDIA card with no screen plugged into it: a
#     laptop panel wired to the integrated GPU stays there, and games still
#     render on NVIDIA - the same way Windows handles those laptops.
#   - GameMode's GPU tweaks are pointed at that card (/etc/gamemode.ini)
#
# Turn it off: GPU_MODE=off in /etc/niix/gpu.conf. If the desktop ever fails
# to start, press E on the NiiX entry in the Limine menu and add niix.gpu=off
# to the cmdline line - that boot then uses the default GPU.
set -uo pipefail

SYS=${NIIX_SYSFS:-/sys}     # overridable so the logic can be tested
CONF=/etc/niix/gpu.conf
ENV_FILE=/etc/environment.d/90-niix-gpu.conf
RULE_FILE=/run/udev/rules.d/61-niix-gpu.rules
STATE_FILE=/run/niix/gpu.state
GAMEMODE_FILE=/etc/gamemode.ini
MASK_MARKER=/etc/niix/.switcheroo-masked

GPU_MODE=auto
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

CPU_IS_AMD=false
grep -qm1 AuthenticAMD /proc/cpuinfo 2>/dev/null && CPU_IS_AMD=true

G_SLOT=(); G_VENDOR=(); G_DRIVER=(); G_CARD=(); G_BOOT=(); G_VRAM=()
G_KIND=(); G_NAME=(); G_SCREEN=(); G_SCORE=(); G_RANK=()
CHOSEN=-1

vendor_name() {
    case "$1" in
        0x10de) echo nvidia ;;
        0x1002) echo amd ;;
        0x8086) echo intel ;;
        *)      echo other ;;
    esac
}

# Mesa drivers take DRI_PRIME; NVIDIA's own driver takes its PRIME variables.
is_mesa_driver() {
    case "$1" in amdgpu|radeon|i915|xe|nouveau) return 0 ;; esac
    return 1
}

gpu_name() {
    local slot=$1 vendor=$2 device=$3 line
    if command -v lspci >/dev/null 2>&1; then
        line=$(lspci -s "$slot" 2>/dev/null | head -1)
        line=${line#*: }
        [ -n "$line" ] && { printf '%s' "$line"; return; }
    fi
    printf '%s:%s' "${vendor#0x}" "${device#0x}"
}

nvidia_vram_mib() {
    local slot=$1 bus mem
    command -v nvidia-smi >/dev/null 2>&1 || { echo 0; return; }
    # nvidia-smi prints an 8-digit PCI domain, sysfs a 4-digit one - compare
    # only the bus:device.function part.
    while IFS=', ' read -r bus mem; do
        bus=${bus,,}
        if [ "${bus: -7}" = "${slot: -7}" ] && [[ "$mem" =~ ^[0-9]+$ ]]; then
            echo "$mem"; return
        fi
    done < <(nvidia-smi --query-gpu=pci.bus_id,memory.total --format=csv,noheader,nounits 2>/dev/null)
    echo 0
}

# Fills the G_* arrays with every display controller on the PCI bus.
#   $1 = hardware   score by what the card IS (the installer: nouveau or no
#                   driver at all must not hide an NVIDIA card)
#   $1 = runtime    score by what the card can do right now
collect_gpus() {
    local mode=$1 dev class slot vendor device driver card c boot vram kind status
    local i amd_count=0 amd_discrete=0 best=-1 best_vram=-1
    G_SLOT=(); G_VENDOR=(); G_DRIVER=(); G_CARD=(); G_BOOT=(); G_VRAM=()
    G_KIND=(); G_NAME=(); G_SCREEN=(); G_SCORE=(); G_RANK=()

    for dev in "$SYS"/bus/pci/devices/*; do
        class=$(cat "$dev/class" 2>/dev/null) || continue
        case "$class" in 0x0300*|0x0302*|0x0380*) ;; *) continue ;; esac
        slot=${dev##*/}
        vendor=$(vendor_name "$(cat "$dev/vendor" 2>/dev/null)")
        device=$(cat "$dev/device" 2>/dev/null)

        driver=""
        [ -e "$dev/driver" ] && driver=$(basename "$(readlink -f "$dev/driver")")

        card=""
        status=no
        for c in "$dev"/drm/card[0-9]*; do
            [ -d "$c" ] || continue
            card=${c##*/}
            if grep -qx connected "$c"/"$card"-*/status 2>/dev/null; then
                status=yes
            fi
            break
        done

        boot=$(cat "$dev/boot_vga" 2>/dev/null || echo 0)

        vram=0
        if [ "$driver" = amdgpu ] && [ -r "$dev/mem_info_vram_total" ]; then
            vram=$(( $(cat "$dev/mem_info_vram_total") / 1048576 ))
        elif [ "$driver" = nvidia ]; then
            vram=$(nvidia_vram_mib "$slot")
        fi

        case "$vendor" in
            nvidia)
                kind=discrete ;;
            intel)
                # Intel's integrated GPU always sits at 00:02.0; Arc cards don't.
                if [ "${slot#*:}" = "00:02.0" ]; then kind=integrated; else kind=discrete; fi ;;
            amd)
                # With an Intel CPU any Radeon is a separate card. With a Ryzen
                # CPU it may be the APU's graphics: amdgpu only reports a VRAM
                # vendor for cards with their own memory chips.
                if [ "$CPU_IS_AMD" = false ] || [ -e "$dev/mem_info_vram_vendor" ]; then
                    kind=discrete
                else
                    kind=integrated
                fi
                amd_count=$(( amd_count + 1 ))
                [ "$kind" = discrete ] && amd_discrete=$(( amd_discrete + 1 )) ;;
            *)
                kind=basic ;;
        esac

        G_SLOT+=("$slot"); G_VENDOR+=("$vendor"); G_DRIVER+=("$driver")
        G_CARD+=("$card"); G_BOOT+=("$boot"); G_VRAM+=("$vram")
        G_KIND+=("$kind"); G_SCREEN+=("$status")
        G_NAME+=("$(gpu_name "$slot" "$(cat "$dev/vendor" 2>/dev/null)" "$device")")
    done

    # Two Radeons with a Ryzen CPU and neither reported its memory vendor:
    # the one with more VRAM is the separate card.
    if [ "$amd_count" -ge 2 ] && [ "$amd_discrete" -eq 0 ]; then
        for i in "${!G_SLOT[@]}"; do
            [ "${G_VENDOR[i]}" = amd ] || continue
            if [ "${G_VRAM[i]}" -gt "$best_vram" ]; then best=$i; best_vram=${G_VRAM[i]}; fi
        done
        [ "$best" -ge 0 ] && G_KIND[best]=discrete
    fi

    score_gpus "$mode"
}

# Score = kind first, then VRAM, then the card the firmware booted on.
# 0 means "can't be used".
score_gpus() {
    local mode=$1 i rank score
    CHOSEN=-1
    for i in "${!G_SLOT[@]}"; do
        case "${G_KIND[i]}" in
            discrete)   rank=3 ;;
            integrated) rank=2 ;;
            *)          rank=1 ;;
        esac
        if [ "$mode" = runtime ]; then
            case "${G_DRIVER[i]}" in
                "")      rank=0 ;;
                nouveau) rank=2 ;;
                vfio-pci|pci-stub) rank=0 ;;
            esac
        fi
        score=0
        if [ "$rank" -gt 0 ]; then
            score=$(( rank * 1000000000 + G_VRAM[i] * 10 + G_BOOT[i] ))
        fi
        G_SCORE[i]=$score
        G_RANK[i]=$rank
        if [ "$score" -gt 0 ] && { [ "$CHOSEN" -lt 0 ] || [ "$score" -gt "${G_SCORE[CHOSEN]}" ]; }; then
            CHOSEN=$i
        fi
    done
}

usable_count() {
    local i n=0
    for i in "${!G_SCORE[@]}"; do
        [ "${G_SCORE[i]}" -gt 0 ] && n=$(( n + 1 ))
    done
    echo "$n"
}

need_root() {
    [ "$(id -u)" -eq 0 ] || { echo "niix-gpu $1 must run as root (try: sudo niix-gpu $1)" >&2; exit 1; }
}

# The boot service starts before the login screen; give the GPU drivers (the
# NVIDIA module in particular) a moment to finish loading first.
wait_for_drivers() {
    local dev vendor ready loaded_nvidia_drm=false
    command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=10 2>/dev/null
    for _ in $(seq 1 20); do
        ready=true
        for dev in "$SYS"/bus/pci/devices/*; do
            case "$(cat "$dev/class" 2>/dev/null)" in 0x0300*|0x0302*|0x0380*) ;; *) continue ;; esac
            vendor=$(cat "$dev/vendor" 2>/dev/null)
            case "$vendor" in 0x10de|0x1002|0x8086) ;; *) continue ;; esac
            if [ ! -e "$dev/driver" ]; then
                ready=false
            elif ! compgen -G "$dev/drm/card[0-9]*" >/dev/null; then
                # The NVIDIA driver only creates its DRM device once
                # nvidia-drm is loaded.
                if [ "$(basename "$(readlink -f "$dev/driver")")" = nvidia ] && [ "$loaded_nvidia_drm" = false ]; then
                    modprobe -q nvidia_drm 2>/dev/null
                    loaded_nvidia_drm=true
                fi
                ready=false
            fi
        done
        [ "$ready" = true ] && return 0
        sleep 0.5
    done
    echo "niix-gpu: not every GPU driver was ready after 10s - using what is there"
    return 0
}

write_if_changed() {
    local file=$1 content=$2
    if [ -f "$file" ] && [ "$(cat "$file")" = "$content" ]; then
        return 1
    fi
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$content" > "$file.tmp" && chmod 644 "$file.tmp" && mv -f "$file.tmp" "$file"
    return 0
}

# set_gamemode_gpu N : point GameMode's GPU tweaks at DRM card N. Only the
# gpu_device line in the [gpu] section changes; the rest of the file stays.
set_gamemode_gpu() {
    local want=$1
    [ -f "$GAMEMODE_FILE" ] || printf '[gpu]\n' > "$GAMEMODE_FILE"
    grep -qx "gpu_device=$want" "$GAMEMODE_FILE" && return 0
    awk -v dev="$want" '
        /^\[/ {
            if (in_gpu && !done) { print "gpu_device=" dev; done = 1 }
            in_gpu = ($0 == "[gpu]")
        }
        in_gpu && /^gpu_device=/ { if (!done) { print "gpu_device=" dev; done = 1 } next }
        { print }
        END {
            if (!done) {
                if (!in_gpu) print "[gpu]"
                print "gpu_device=" dev
            }
        }' "$GAMEMODE_FILE" > "$GAMEMODE_FILE.tmp" \
        && chmod 644 "$GAMEMODE_FILE.tmp" && mv -f "$GAMEMODE_FILE.tmp" "$GAMEMODE_FILE"
}

reload_drm_rules() {
    command -v udevadm >/dev/null 2>&1 || return 0
    udevadm control --reload 2>/dev/null
    udevadm trigger --action=change --subsystem-match=drm 2>/dev/null
    udevadm settle --timeout=10 2>/dev/null
    return 0
}

set_switcheroo() {
    # switcheroo-control makes GNOME launch some apps on the "other" GPU -
    # which is the integrated one on a desktop that booted on its graphics
    # card. With one GPU forced for everything it can only get in the way.
    local want=$1
    systemctl cat switcheroo-control.service >/dev/null 2>&1 || return 0
    if [ "$want" = off ] && [ ! -e "$MASK_MARKER" ]; then
        systemctl mask --now switcheroo-control.service >/dev/null 2>&1 \
            && mkdir -p "$(dirname "$MASK_MARKER")" && touch "$MASK_MARKER"
    elif [ "$want" = on ] && [ -e "$MASK_MARKER" ]; then
        systemctl unmask switcheroo-control.service >/dev/null 2>&1
        rm -f "$MASK_MARKER"
    fi
}

clear_settings() {
    local reason=$1
    rm -f "$ENV_FILE"
    if [ -e "$RULE_FILE" ]; then
        rm -f "$RULE_FILE"
        reload_drm_rules
    fi
    set_switcheroo on
    write_if_changed "$STATE_FILE" "mode=default
reason=$reason" >/dev/null
    echo "niix-gpu: $reason - nothing to force"
}

do_apply() {
    need_root apply
    mkdir -p /run/niix
    wait_for_drivers
    collect_gpus runtime

    if grep -qw 'niix.gpu=off' /proc/cmdline 2>/dev/null; then
        clear_settings "turned off on the kernel command line (niix.gpu=off)"
        return 0
    fi
    if [ "$GPU_MODE" = off ]; then
        clear_settings "turned off in $CONF"
        return 0
    fi

    # GameMode tweaks the card by its DRM number - not always card0, since
    # the boot framebuffer can take that number first.
    if [ "$CHOSEN" -ge 0 ] && [ -n "${G_CARD[CHOSEN]}" ]; then
        set_gamemode_gpu "${G_CARD[CHOSEN]#card}"
    fi

    if [ "$(usable_count)" -lt 2 ]; then
        clear_settings "only one usable GPU"
        return 0
    fi
    # Best usable card is an integrated one (e.g. the NVIDIA driver is not
    # running yet): the default choice is already right.
    if [ "${G_RANK[CHOSEN]}" -lt 3 ]; then
        clear_settings "no discrete GPU with a working driver yet"
        return 0
    fi

    local i=$CHOSEN slot driver env tag=no
    slot=${G_SLOT[i]}
    driver=${G_DRIVER[i]}

    if [ "$driver" = nvidia ]; then
        env="__NV_PRIME_RENDER_OFFLOAD=1
__NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
__GLX_VENDOR_LIBRARY_NAME=nvidia
__VK_LAYER_NV_optimus=NVIDIA_only"
        [ "${G_SCREEN[i]}" = yes ] && tag=yes
    elif is_mesa_driver "$driver"; then
        env="DRI_PRIME=pci-${slot//[:.]/_}"
        [ "$driver" != nouveau ] && tag=yes
    else
        clear_settings "the chosen GPU uses a driver niix-gpu does not know ($driver)"
        return 0
    fi

    write_if_changed "$ENV_FILE" "# Written at every boot by niix-gpu - every app renders on:
# ${G_NAME[i]} ($slot)
$env" >/dev/null

    if [ "$tag" = yes ]; then
        write_if_changed "$RULE_FILE" "# niix-gpu: GNOME draws the desktop on ${G_NAME[i]}
SUBSYSTEM==\"drm\", KERNEL==\"card[0-9]*\", KERNELS==\"$slot\", TAG+=\"mutter-device-preferred-primary\"" \
            && reload_drm_rules
    elif [ -e "$RULE_FILE" ]; then
        rm -f "$RULE_FILE"
        reload_drm_rules
    fi

    set_switcheroo off

    write_if_changed "$STATE_FILE" "mode=forced
slot=$slot
name=${G_NAME[i]}
driver=$driver
desktop=$tag" >/dev/null

    echo "niix-gpu: using ${G_NAME[i]} ($slot, $driver) for everything$([ "$tag" = yes ] && echo ', desktop included')"
}

do_status() {
    local i mark vram
    collect_gpus runtime
    printf '  %-13s %-11s %-9s %-8s %-6s %s\n' SLOT KIND DRIVER VRAM SCREEN NAME
    for i in "${!G_SLOT[@]}"; do
        mark=" "; [ "$i" -eq "$CHOSEN" ] && mark="*"
        vram="-"; [ "${G_VRAM[i]}" -gt 0 ] && vram="$(( G_VRAM[i] / 1024 ))G"
        [ "${G_VRAM[i]}" -gt 0 ] && [ "${G_VRAM[i]}" -lt 1024 ] && vram="${G_VRAM[i]}M"
        printf '%s %-13s %-11s %-9s %-8s %-6s %s\n' "$mark" "${G_SLOT[i]}" "${G_KIND[i]}" \
            "${G_DRIVER[i]:-none}" "$vram" "${G_SCREEN[i]}" "${G_NAME[i]}"
    done
    echo
    if [ -r "$STATE_FILE" ]; then
        if grep -q '^mode=forced' "$STATE_FILE"; then
            echo "In use for everything: $(sed -n 's/^name=//p' "$STATE_FILE")"
            grep -q '^desktop=yes' "$STATE_FILE" \
                && echo "GNOME draws the desktop on it as well." \
                || echo "GNOME draws on the GPU wired to the built-in screen; apps and games render on the card above."
        else
            echo "Not forcing a GPU: $(sed -n 's/^reason=//p' "$STATE_FILE")"
        fi
    else
        echo "niix-gpu has not run since boot (sudo niix-gpu apply)."
    fi
    if [ "$CHOSEN" -ge 0 ] && [ -r "$STATE_FILE" ] && grep -q '^mode=forced' "$STATE_FILE" \
        && [ "$(sed -n 's/^slot=//p' "$STATE_FILE")" != "${G_SLOT[CHOSEN]}" ]; then
        echo "A different card would be chosen now - it takes over at the next boot."
    fi
}

do_run() {
    [ $# -ge 1 ] || { echo "usage: niix-gpu run COMMAND [ARGS...]" >&2; exit 1; }
    if [ -r "$ENV_FILE" ]; then
        set -a
        # shellcheck source=/dev/null
        . "$ENV_FILE"
        set +a
    fi
    exec "$@"
}

# Flatpak apps bring their own copy of the NVIDIA user-space driver, and it
# has to be the same version as the kernel module. Flatpak fetches the right
# one by itself on 'flatpak update' - but only while the module is loaded,
# which is never the case during installation. Runs at every boot (cheap when
# nothing is missing), in the background.
do_flatpak_gl() {
    need_root flatpak-gl
    local ver ext
    [ -r /sys/module/nvidia/version ] || exit 0
    command -v flatpak >/dev/null 2>&1 || exit 0
    flatpak list --system --app --columns=application 2>/dev/null | grep -q . || exit 0
    ver=$(cat /sys/module/nvidia/version)
    ext="org.freedesktop.Platform.GL.nvidia-${ver//./-}"
    flatpak list --system --runtime --columns=application 2>/dev/null | grep -qxF "$ext" && exit 0

    echo "niix-gpu: Flatpak apps need $ext - waiting for the network..."
    for _ in $(seq 1 60); do
        curl -fsI --max-time 10 https://dl.flathub.org/repo/config >/dev/null 2>&1 && break
        sleep 10
    done
    if flatpak update --system -y --noninteractive; then
        echo "niix-gpu: Flatpak NVIDIA driver is up to date"
    else
        echo "niix-gpu: flatpak update failed - it is retried at the next boot"
        exit 1
    fi
}

do_detect() {
    local i v nvidia=0 amd=0 intel=0
    collect_gpus hardware
    for v in "${G_VENDOR[@]}"; do
        case "$v" in
            nvidia) nvidia=$(( nvidia + 1 )) ;;
            amd)    amd=$(( amd + 1 )) ;;
            intel)  intel=$(( intel + 1 )) ;;
        esac
    done
    echo "GPU_COUNT=${#G_SLOT[@]}"
    echo "GPU_NVIDIA=$nvidia"
    echo "GPU_AMD=$amd"
    echo "GPU_INTEL=$intel"
    [ "$CHOSEN" -ge 0 ] || return 0
    i=$CHOSEN
    echo "GPU_SLOT=${G_SLOT[i]}"
    echo "GPU_VENDOR=${G_VENDOR[i]}"
    echo "GPU_KIND=${G_KIND[i]}"
    echo "GPU_NAME=${G_NAME[i]}"
}

case "${1:-status}" in
    apply)      do_apply ;;
    status)     do_status ;;
    run)        shift; do_run "$@" ;;
    flatpak-gl) do_flatpak_gl ;;
    detect)     do_detect ;;
    *)
        echo "Usage: niix-gpu {status|apply|run COMMAND...|flatpak-gl|detect}" >&2
        exit 1 ;;
esac
