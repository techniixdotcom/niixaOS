                default = row
        self.list.set_filter_func(self.matches)
        self.search.connect("search-changed", lambda *_: self.list.invalidate_filter())
        self.list.connect("row-selected", self.changed)
        self.append(scrolled(self.list, 260))
        if default:
            self.list.select_row(default)

    def enter(self):
        scroll_to_row(self.list, self.list.get_selected_row())

