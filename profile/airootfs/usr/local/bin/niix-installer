#!/usr/bin/env python3
# niix-installer - the graphical NiiX Arch installer for the live desktop.
#
# Asks the questions, then runs the back end (niix-install) with the answers
# on its stdin and shows its progress. The back end reports with @@ lines -
# see the top of /usr/local/lib/niix/niix-install.
#
# Development: NIIX_INSTALLER=/path/to/niix-install runs another copy.

