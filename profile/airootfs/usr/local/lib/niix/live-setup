#!/bin/bash
# Live ISO, every boot, before the login screen: user "niix" without a
# password, auto-login, and the installer icon on the desktop.
set -u
if ! id niix &>/dev/null; then
    useradd -m -G wheel,audio,video,input,storage -s /bin/bash -c "NiiX Live" niix
fi
passwd -d niix >/dev/null
install -d -o niix -g niix /home/niix/Desktop
install -m 755 -o niix -g niix /usr/local/share/applications/org.niixa.Installer.desktop /home/niix/Desktop/
printf '[daemon]\nAutomaticLoginEnable=True\nAutomaticLogin=niix\n' > /etc/gdm/custom.conf
