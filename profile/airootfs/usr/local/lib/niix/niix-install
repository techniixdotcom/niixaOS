#!/bin/bash
# niix-install - installs NiiX Arch from the live ISO (runs as root).
#
# The graphical installer (niix-installer) asks the questions and runs this
# with the answers on stdin; it reports back with @@ lines:
#
#   niix-install --probe                     what is on this computer
#   niix-install --check-account HOST USER   are these names usable?
#   niix-install --answers < answers         install
#
# Answers, one KEY=VALUE per line (never written to disk):
#   MODE           dualboot | singleboot
#   TARGET_REGION  DRIVE|START_MIB|END_MIB   dual-boot into free space, or
#   DELETE_PART    /dev/PARTITION            dual-boot into a replaced partition
#   SINGLE_DRIVE   /dev/DRIVE                single-boot: the whole drive is wiped
#   KEYBOARD  TIMEZONE  HOSTNAME  USERNAME  USER_PASS  LUKS_PASS
#   MITIGATIONS    on | off
#   REPLACE_KERNELS=yes, HOTSPOT_SSID, HOTSPOT_PASS   (optional)
#
# The live image is already the finished system. This copies it to an
# encrypted Btrfs disk and adds what depends on the answers and the hardware:
# partitions, user, keyboard, time zone, GPU driver and boot menu.
#
# LUKS2, Btrfs (@ @home @snapshots @var_log), Limine (UEFI), linux-cachyos, ZRAM.
set -uo pipefail

# -- Settings
MAPPER=cryptroot
BTRFS_OPTS="noatime,compress=zstd,space_cache=v2"
NIIX_MIN_GIB=40          # smallest space NiiX installs into
NIIX_SHARE=/usr/local/share/niix
CACHYOS_KEY_FPR="882DCFE48E2051D48E2562ABF3B607488DB35A47"
FLATPAK_APPS=()          # packages/flatpak.txt, copied into the image by the build
[[ -r $NIIX_SHARE/flatpak-apps ]] && mapfile -t FLATPAK_APPS < <(grep -v '^#' "$NIIX_SHARE/flatpak-apps" | awk NF)
DL_DIR=/mnt/var/tmp/niix-downloads
# Inherited by pacman in the chroot: no snap-pac snapshots of a half-installed
# system, and its ps call fails in arch-chroot ("fatal library error, lookup self").
export SNAP_PAC_SKIP=y

case "${1:-}" in
    --probe|--check-account) LOGFILE=/dev/null ;;
    *)  LOGFILE="/root/niixarch-install-$(date +%Y%m%d-%H%M%S).log"
        exec > >(tee -a "$LOGFILE") 2>&1 ;;
esac

# -- State
declare -A ANS=()
INSTALL_MODE=""; SINGLE_DRIVE=""; TARGET_DRIVE=""; FREE_START=""; FREE_END=""
EFI_PART=""; EFI_DRIVE=""; EFI_PART_NUM=""; LUKS_PART=""; LUKS_UUID=""
HOSTNAME=""; USERNAME=""; USER_PASS=""; LUKS_PASS=""; TIMEZONE=""; USE_MITIGATIONS=false
HOTSPOT_SSID=""; HOTSPOT_PASS=""
KB_NAME=(); KB_XKB=(); KB_VAR=(); KB_KM=()
KEYBOARD_NAME=""; KEYMAP=us; KEYMAP_X11=us; KEYMAP_X11_VARIANT=""
CPU_VENDOR=""; CPU_MODEL=""; GPU_VENDOR=""; GPU_MODEL=""; GPU_KIND=""
HAS_NVIDIA=0; HAS_AMD=0; HAS_INTEL=0; GPU_COUNT=0
FORM=""; HANDHELD=""; VIRT=""; CPU_X3D=no; CPU_HYBRID=no; MEM_TOTAL_GB=0
CLEAN_OK=false; HHD_WANTED=false; DL_PIDS=()
STEP_NAME=""; STEP_START=0; STEP_TIMES=()

# -- Output
log()  { printf '  ✔  %s\n' "$*"; }
info() { printf '  •  %s\n' "$*"; }
warn() { printf '  !  %s\n' "$*"; }
dbg()  { echo "[DBG $(date +%H:%M:%S)] $*" >> "$LOGFILE"; }

# Starts a section; the GUI shows its title as the current step.
hr() {
    step_done
    STEP_NAME=$1
    STEP_START=$SECONDS
    printf '@@step %s\n\n== %s ==\n' "$1" "$1"
}

step_done() {
    local took
    [[ -n "$STEP_NAME" ]] || return 0
    took=$(( SECONDS - STEP_START ))
    STEP_TIMES+=("$(printf '%3dm %02ds  %s' $(( took / 60 )) $(( took % 60 )) "$STEP_NAME")")
    STEP_NAME=""
}

err() {
    printf '@@error %s\nERROR: %s\n' "$*" "$*"
    dump_state "ERROR: $*" 2>/dev/null || true
    release_target
    exit 1
}

release_target() {
    stop_downloads
    gpgconf --homedir /mnt/etc/pacman.d/gnupg --kill all 2>/dev/null || true
    umount -R /mnt 2>/dev/null || true
    cryptsetup close "$MAPPER" 2>/dev/null || true
}

dump_state() {
    {
        printf '\n==== %s (%s) ====\n' "$1" "$(date)"
        lsblk -f; echo; blkid; echo; efibootmgr -v; echo; findmnt -R /mnt
        printf 'EFI_PART=%s EFI_DRIVE=%s EFI_PART_NUM=%s TARGET_DRIVE=%s LUKS_PART=%s LUKS_UUID=%s FREE=%s-%s\n' \
            "$EFI_PART" "$EFI_DRIVE" "$EFI_PART_NUM" "$TARGET_DRIVE" "$LUKS_PART" "$LUKS_UUID" "$FREE_START" "$FREE_END"
    } >> "$LOGFILE" 2>&1
}

# -- Drives
# Partition N of a disk (NVMe and MMC put a 'p' before the number).
part_path() {
    if [[ "$1" == *nvme* || "$1" == *mmcblk* ]]; then printf '%sp%s' "$1" "$2"; else printf '%s%s' "$1" "$2"; fi
}

part_number() {
    local num
    num=$(lsblk -no PARTN "$1" 2>/dev/null | head -1 | tr -d '[:space:]')
    [[ -n "$num" ]] || num=$(grep -o '[0-9]*$' <<< "$1")
    printf '%s' "$num"
}

big_enough() {
    local bytes
    bytes=$(lsblk -bdno SIZE "$1" 2>/dev/null | head -1 | tr -d '[:space:]')
    (( ${bytes:-0} >= NIIX_MIN_GIB * 1073741824 ))
}

# USB, removable and virtual devices are never install targets.
is_removable() {
    local dev
    dev=$(basename "$1")
    case "$dev" in loop*|ram*|dm-*|zram*|nbd*|md*|sr*) return 0 ;; esac
    [[ "$(cat "/sys/block/$dev/removable" 2>/dev/null)" == 1 ]] && return 0
    [[ "$(lsblk -dn -o TRAN "/dev/$dev" 2>/dev/null | tr -d '[:space:]')" == usb ]]
}

internal_disks() {
    local path type
    while read -r path type; do
        [[ "$type" == disk ]] && ! is_removable "$path" && printf '%s\n' "$path"
    done < <(lsblk -dn -o PATH,TYPE 2>/dev/null)
}

# Sets EFI_PART, EFI_DRIVE and EFI_PART_NUM to the ESP on an internal drive.
locate_efi() {
    local dev parent drive partnum
    while IFS= read -r dev; do
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        [[ -b "$dev" ]] || continue
        [[ -n "$parent" ]] && is_removable "/dev/$parent" && continue
        EFI_PART=$dev
        break
    done < <(blkid -t PART_ENTRY_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" -o device 2>/dev/null)
    if [[ -z "$EFI_PART" ]]; then
        while IFS= read -r drive; do
            partnum=$(parted -m "$drive" print 2>/dev/null | awk -F: '$7 ~ /esp/ || $7 ~ /boot/ {print $1; exit}')
            [[ -n "$partnum" ]] && { EFI_PART=$(part_path "$drive" "$partnum"); break; }
        done < <(internal_disks)
    fi
    [[ -n "$EFI_PART" && -b "$EFI_PART" ]] || return 1
    EFI_DRIVE="/dev/$(lsblk -no PKNAME "$EFI_PART" 2>/dev/null)"
    EFI_PART_NUM=$(part_number "$EFI_PART")
}

# Windows on an internal drive: an NTFS partition, or its boot manager.
windows_present() {
    local dev parent mnt found=1
    while IFS= read -r dev; do
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        [[ -n "$parent" ]] && is_removable "/dev/$parent" && continue
        [[ "$(blkid -s TYPE -o value "$dev" 2>/dev/null)" == ntfs ]] && { log "Windows partition found: $dev"; return 0; }
    done < <(lsblk -lno PATH,TYPE 2>/dev/null | awk '$2 == "part" { print $1 }')
    while IFS= read -r dev; do
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        [[ -n "$parent" ]] && is_removable "/dev/$parent" && continue
        mnt=$(mktemp -d) || return 1
        if mount -o ro "$dev" "$mnt" 2>/dev/null; then
            [[ -f "$mnt/EFI/Microsoft/Boot/bootmgfw.efi" ]] && { log "Windows boot manager found: $dev"; found=0; }
            umount "$mnt"
        fi
        rmdir "$mnt"
        (( found == 0 )) && return 0
    done < <(blkid -t PART_ENTRY_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" -o device 2>/dev/null)
    return 1
}

# A BitLocker volume (also Windows' "Device encryption") on an internal drive.
bitlocker_present() {
    local dev parent
    while IFS= read -r dev; do
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        [[ -n "$parent" ]] && is_removable "/dev/$parent" && continue
        return 0
    done < <(blkid -t TYPE=BitLocker -o device 2>/dev/null)
    return 1
}

# Free space of NIIX_MIN_GIB or more: DRIVE|START_MIB|END_MIB|SIZE_GIB|MODEL
list_free_regions() {
    local drive model
    while IFS= read -r drive; do
        model=$(lsblk -dn -o MODEL "$drive" 2>/dev/null)
        timeout 5 parted -m "$drive" unit MiB print free 2>/dev/null \
            | awk -F: -v drive="$drive" -v model="${model:-Unknown}" -v min=$(( NIIX_MIN_GIB * 1024 )) '
                $NF ~ /free/ { s = $2; e = $3; sub(/MiB/, "", s); sub(/MiB/, "", e)
                    if (e - s >= min) printf "%s|%.0f|%.0f|%.1f|%s\n", drive, s, e, (e - s) / 1024, model }'
    done < <(internal_disks)
}

# Partition types needed to boot: EFI system, Microsoft reserved, Windows
# recovery, BIOS boot (GPT), and EFI / hidden recovery (MBR).
BOOT_PARTTYPES="c12a7328-f81f-11d2-ba4b-00a0c93ec93b e3c9e316-0b5c-4db8-817d-f92df00215ae de94bba4-06d1-4d40-a16a-bfd50179d6ac 21686148-6449-6e6f-744e-656564454649 0xef 0x27"

# The Windows system itself: NTFS with \Windows\System32, or BitLocker. An NTFS
# volume that can't be looked into (hibernated, damaged) counts as Windows.
is_windows_system() {
    local part=$1 fs=$2 mnt rc=0
    case "${fs,,}" in
        bitlocker) return 0 ;;
        ntfs) ;;
        *) return 1 ;;
    esac
    mnt=$(mktemp -d) || return 0
    if mount -t ntfs3 -o ro "$part" "$mnt" 2>/dev/null || mount -t ntfs-3g -o ro "$part" "$mnt" 2>/dev/null; then
        [[ -d "$mnt/Windows/System32" ]] || rc=1
        umount "$mnt"
    fi
    rmdir "$mnt"
    return "$rc"
}

# Partitions that may be replaced (another Linux, an old NiiX, a data
# partition): everything of NIIX_MIN_GIB or more except Windows and the boot
# partitions. PATH|SIZE|FSTYPE|DRIVE|NAME, NAME being a label if it has one.
list_deletable_partitions() {
    local disk path type size ptype fs name min=$(( NIIX_MIN_GIB * 1073741824 ))
    while IFS= read -r disk; do
        # PARTTYPE last: it is empty on disks without a partition table entry.
        while read -r path type size ptype; do
            [[ "$type" == part && "$size" =~ ^[0-9]+$ ]] || continue
            (( size >= min )) || continue
            [[ " $BOOT_PARTTYPES " == *" ${ptype,,} "* ]] && continue
            fs=$(blkid -s TYPE -o value "$path" 2>/dev/null)
            is_windows_system "$path" "$fs" && continue
            name=$(blkid -s LABEL -o value "$path" 2>/dev/null)
            [[ -n "$name" ]] || name=$(lsblk -dno PARTLABEL "$path" 2>/dev/null)
            printf '%s|%s|%s|%s|%s\n' "$path" "$(awk -v n="$size" 'BEGIN {
                    if (n >= 2^40) printf "%.1fT", n / 2^40; else printf "%.0fG", n / 2^30 }')" \
                "${fs:-unknown}" "$disk" "${name//|//}"
        done < <(lsblk -lnpb -o PATH,TYPE,SIZE,PARTTYPE "$disk" 2>/dev/null)
    done < <(internal_disks)
}

esp_kernels() {
    local f
    for f in "$1"/vmlinuz-linux* "$1"/initramfs-linux*.img; do [[ -e "$f" ]] && printf '%s\n' "$f"; done
}

niix_owns_esp() {
    grep -qs 'NiiX Arch' "$1"/limine.conf "$1"/limine/limine.conf "$1"/EFI/limine/limine.conf "$1"/EFI/BOOT/limine.conf
}

# Bytes the EFI partition has for NiiX: what is free plus the old kernels
# the install replaces.
efi_room() {
    local mnt room="" f
    mnt=$(mktemp -d) || return 1
    if mount -o ro "$EFI_PART" "$mnt" 2>/dev/null; then
        room=$(( $(stat -f -c '%a * %S' "$mnt") ))
        while IFS= read -r f; do room=$(( room + $(stat -c %s "$f") )); done < <(esp_kernels "$mnt")
        umount "$mnt"
    fi
    rmdir "$mnt"
    printf '%s\n' "$room"     # empty when it could not be read
}

efi_has_foreign_kernels() {
    local mnt rc=1
    mnt=$(mktemp -d) || return 1
    if mount -o ro "$EFI_PART" "$mnt" 2>/dev/null; then
        [[ -n "$(esp_kernels "$mnt")" ]] && ! niix_owns_esp "$mnt" && rc=0
        umount "$mnt"
    fi
    rmdir "$mnt"
    return "$rc"
}

