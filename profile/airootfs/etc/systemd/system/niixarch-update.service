[Unit]
Description=NiiX Arch System Update
Wants=network-online.target
After=network-online.target
# A laptop running flat mid-update can leave a half-installed kernel.
ConditionACPower=true
OnFailure=niixarch-update-failed.service

[Service]
Type=oneshot
# Skipped (not failed) while a game or another package operation runs.
ExecCondition=/usr/local/bin/niix-update-gate
# No shutdown or suspend from the desktop while packages are installed. A
# shutdown that happens anyway only interrupts pacman before it starts
# installing (SIGINT - pacman refuses it once it has begun) and waits for it
# to finish: the 15 s default of 90-niix-timeouts.conf would kill it halfway
# and leave a system that does not boot.
# The signing keys come first: after a few weeks without updates, packages
# signed by new keys are otherwise refused.
ExecStart=/usr/bin/systemd-inhibit --what=shutdown:sleep --who="NiiX update" --why="Installing system updates" --mode=block /usr/bin/pacman -Sy --needed --noconfirm archlinux-keyring cachyos-keyring
ExecStart=/usr/bin/systemd-inhibit --what=shutdown:sleep --who="NiiX update" --why="Installing system updates" --mode=block /usr/bin/pacman -Su --noconfirm
ExecStartPost=-/usr/local/lib/niix-system/update-notify done
KillSignal=SIGINT
TimeoutStopSec=30min
# Out of the way of games and the desktop.
Nice=10
IOSchedulingClass=idle
