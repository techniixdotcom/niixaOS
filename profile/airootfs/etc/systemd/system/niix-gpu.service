[Unit]
Description=NiiX: use the most powerful GPU for everything
After=systemd-udevd.service systemd-modules-load.service
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/niix-gpu apply
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
